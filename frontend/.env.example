# Copia a .env (ignorado por git). Solo variables PUBLIC_*: llegan al navegador; nunca pongas aqui claves secretas ni de servicio.
# Backend de Bugalu en desarrollo (uv run python -m bugalu)
PUBLIC_URL_API=http://127.0.0.1:8000
# API del stack local de Supabase de Bugalu (puerto 45621)
PUBLIC_URL_SUPABASE=http://127.0.0.1:45621
# PUBLISHABLE_KEY de `npx supabase status` (en la raiz del repositorio)
PUBLIC_CLAVE_PUBLICABLE_SUPABASE=
