---
import LayoutApp from '../../../layouts/LayoutApp.astro';
import EncabezadoPantalla from '../../../componentes/EncabezadoPantalla.astro';
import RegistroCambios from '../../../islas/RegistroCambios.astro';
---

<LayoutApp titulo="Registro de cambios">
  <EncabezadoPantalla
    titulo="Registro de cambios"
    indice="[A9] CONTROL / CAMBIOS"
