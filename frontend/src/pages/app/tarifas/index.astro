---
import LayoutApp from '../../../layouts/LayoutApp.astro';
import EncabezadoPantalla from '../../../componentes/EncabezadoPantalla.astro';
import Boton from '../../../componentes/Boton.astro';
import Tarifas from '../../../islas/Tarifas.astro';
---

<LayoutApp titulo="Tarifas">
  <EncabezadoPantalla
    titulo="Tarifas"
    indice="[A5] CATÁLOGO / TARIFAS"
    ruta={[{ etiqueta: 'Inicio', href: '/app/' }, { etiqueta: 'Tarifas' }]}
    descripcion="Lo que cuesta cada servicio y cada especialista. Con esto se calcula el precio de las reservas."
  >
    <Boton slot="acciones" variante="secundario" href="/app/tarifas/recargos">Recargos y feriados</Boton>
    <Boton slot="acciones" variante="secundario" href="/app/tarifas/impuestos">Impuestos</Boton>
  </EncabezadoPantalla>
  <Tarifas vista="lista" />
</LayoutApp>
