---
import LayoutApp from '../../../layouts/LayoutApp.astro';
import EncabezadoPantalla from '../../../componentes/EncabezadoPantalla.astro';
import Tarifas from '../../../islas/Tarifas.astro';
---

<LayoutApp titulo="Editar servicio">
  <EncabezadoPantalla
    titulo="Editar servicio"
    indice="[A5] CATÁLOGO / TARIFAS"
    ruta={[{ etiqueta: 'Inicio', href: '/app/' }, { etiqueta: 'Tarifas', href: '/app/tarifas' }, { etiqueta: 'Servicio' }]}
    descripcion="Tarifa por hora y quién va incluido en este servicio."
  />
  <Tarifas vista="servicio" />
</LayoutApp>
