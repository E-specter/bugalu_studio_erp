---
import LayoutApp from '../../../layouts/LayoutApp.astro';
import EncabezadoPantalla from '../../../componentes/EncabezadoPantalla.astro';
import Boton from '../../../componentes/Boton.astro';
import TextosLegales from '../../../islas/TextosLegales.astro';
---

<LayoutApp titulo="Ver versión">
  <EncabezadoPantalla
    titulo="Ver versión"
    indice="[A10] CONTROL / TEXTOS"
    ruta={[{ etiqueta: 'Inicio', href: '/app/' }, { etiqueta: 'Textos', href: '/app/textos' }, { etiqueta: 'Versión' }]}
    descripcion="Así la leen los clientes en la página pública."
  >
    <Boton slot="acciones" variante="secundario" href="/app/textos">Volver a textos</Boton>
  </EncabezadoPantalla>
  <TextosLegales vista="ver" />
</LayoutApp>
