import EncabezadoPantalla from '../../../componentes/EncabezadoPantalla.astro';
import Creditos from '../../../islas/Creditos.astro';
---

<LayoutApp titulo="Mis créditos">
  <EncabezadoPantalla
    titulo="MIS CRÉDITOS"
    indice="[P3] SALA / CRÉDITOS"
