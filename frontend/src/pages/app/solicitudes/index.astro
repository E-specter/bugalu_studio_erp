import EncabezadoPantalla from '../../../componentes/EncabezadoPantalla.astro';
import Solicitudes from '../../../islas/Solicitudes.astro';
---

<LayoutApp titulo="Solicitudes de acceso">
  <EncabezadoPantalla
    titulo="Solicitudes de acceso"
    indice="[A1] EQUIPO / ACCESOS"
