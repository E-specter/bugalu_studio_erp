---
import LayoutBase from './LayoutBase.astro';
import CabeceraApp from '../componentes/CabeceraApp.astro';
import NavegacionLateral from '../componentes/NavegacionLateral.astro';
import NavegacionTactil from '../componentes/NavegacionTactil.astro';
import Boton from '../componentes/Boton.astro';
import Aviso from '../componentes/Aviso.astro';
import PiePublico from '../componentes/PiePublico.astro';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
// Los destinos con `solo` (roles separados por espacio) nacen ocultos y el script los muestra según el rol del perfil (la API es la barrera real: 403).
// Etiquetas de 9 caracteres como máximo (navegación táctil). Orden de navegacion-lateral.md#variantes; la barra táctil admite cinco: del sexto en adelante del Administrador (Franjas, Tarifas, Cambios, Textos y Reclamos) van al menú de la cabecera.
const destinos = [
  { etiqueta: 'Inicio', href: '/app/', icono: 'house' as const },
  { etiqueta: 'Reservas', href: '/app/reservas/', icono: 'calendar-check' as const, solo: 'cliente' },
  { etiqueta: 'Agenda', href: '/app/agenda/', icono: 'calendar' as const, solo: 'personal administrador' },
  { etiqueta: 'Pagos', href: '/app/pagos/', icono: 'receipt' as const, solo: 'administrador', vivo: 'pagos' },
  { etiqueta: 'Accesos', href: '/app/solicitudes/', icono: 'user-plus' as const, solo: 'administrador' },
  { etiqueta: 'Usuarios', href: '/app/usuarios/', icono: 'users' as const, solo: 'administrador' },
  { etiqueta: 'Franjas', href: '/app/franjas/', icono: 'calendar-cog' as const, solo: 'administrador' },
  { etiqueta: 'Tarifas', href: '/app/tarifas/', icono: 'tag' as const, solo: 'administrador' },
  { etiqueta: 'Cambios', href: '/app/cambios/', icono: 'history' as const, solo: 'administrador' },
  { etiqueta: 'Textos', href: '/app/textos/', icono: 'file-text' as const, solo: 'administrador' },
  { etiqueta: 'Reclamos', href: '/app/reclamos/', icono: 'book-open' as const, solo: 'administrador' },
];
// Un destino queda actual también en sus subrutas (Revisar solicitud); gana la coincidencia más larga.
const actual = destinos.map((d) => d.href).filter((href) => href === Astro.url.pathname || (href !== '/app/' && Astro.url.pathname.startsWith(href))).sort((a, b) => b.length - a.length)[0] ?? Astro.url.pathname;
---

<LayoutBase titulo={titulo}>
  <div class="app">
    <CabeceraApp variante="estudio" producto="Bugalú Studio" area="Panel interno" neutro>
      <a slot="menu" href="/app/perfil">Mi perfil</a>
      <!-- RF-16: Mis reclamos solo para el cliente; el Administrador entra por RECLAMOS en la navegación. Nace oculto hasta conocer el rol. -->
      <a slot="menu" href="/app/reclamos/" data-solo="cliente" aria-current={Astro.url.pathname.startsWith('/app/reclamos') ? 'page' : undefined} hidden>Mis reclamos</a>
      <!-- El destino que no cabe en la barra táctil; solo < punto-quiebre-escritorio. Nace oculto hasta conocer el rol. -->
      {destinos.slice(-5).map((d) => (
        <a slot="menu" class="menu-solo-movil" href={d.href} data-solo={d.solo} aria-current={d.href === actual ? 'page' : undefined} hidden>{d.etiqueta}</a>
      ))}
      <!-- Sin JS no sirve: nace oculto y lo muestra el script. -->
      <div slot="menu"><Boton variante="secundario" data-cerrar-sesion hidden>Cerrar sesión</Boton></div>
    </CabeceraApp>

    <!-- < punto-quiebre-escritorio: fija bajo la fila 1 de la cabecera (estructura-app, "Lo fijo") -->
    <div class="app-nav-tactil"><NavegacionTactil destinos={destinos.slice(0, -5)} {actual} /></div>

    <!-- >= punto-quiebre-escritorio -->
    <div class="app-nav-lateral"><NavegacionLateral {destinos} {actual} neutro /></div>

    <div class="app-columna">
    <main id="contenido" tabindex="-1" class="app-principal">
      <!-- RF-17: textos por aceptar y confirmacion de haberlos aceptado; antes del encabezado, sin rol (no es resultado de una accion). -->
      <div class="app-avisos" data-avisos-app></div>
      <template data-aviso-textos><Aviso variante="aviso" titulo="Tienes textos por aceptar" texto="Mientras tanto no puedes hacer reservas nuevas. Puedes ver, pagar y cancelar las que ya tienes." accion={{ etiqueta: 'Revisar y aceptar', href: '#' }} /></template>
      <template data-aviso-exito><Aviso variante="exito" titulo="Listo. Ya puedes reservar." /></template>
      <slot />
    </main>
    <!-- RF-16 CA-01: el Libro de Reclamaciones siempre a la vista, al pie de la columna de contenido (pie-publico.md, variante Acceso) -->
    <PiePublico variante="acceso" class="app-pie" />
    </div>
  </div>
</LayoutBase>

<script>
  import { obtenerPerfil } from '../servicios/api.js';
  import { listarPagos } from '../servicios/pagos.js';
  import { obtenerToken, cerrarSesion, areaRecordada } from '../servicios/sesion.js';

  // Rol del perfil cargado: muestra los destinos del Administrador y fija la variante (Estudio o Portal).
  let rol: string | null = null;
  let avisos = 0;
  function aplicar(perfil: { rol: string }) {
    rol = perfil.rol;
    document.querySelectorAll<HTMLElement>('[data-solo]').forEach((e) => (e.hidden = !e.dataset.solo!.split(' ').includes(rol ?? '')));
    const portal = rol === 'cliente';
    // El título de sección y el área nacen neutros (vacíos y ocultos): aparecen solo al conocer el rol.
    document.querySelectorAll<HTMLElement>('[data-seccion]').forEach((e) => { e.textContent = portal ? 'Portal' : 'Estudio'; e.removeAttribute('data-neutro'); });
    avisarTextos(perfil as { pendientes?: { contexto: string }[] });
    if (rol === 'administrador') {
      const vistos = avisos; // un conteo que la pantalla ya avisó es más reciente que esta carga inicial: no se pisa
      listarPagos().then((l) => vistos === avisos && contarPagos(l.length), () => vistos === avisos && contarPagos(0));
    }
    document.querySelectorAll<HTMLElement>('[data-area]').forEach((e) => { e.textContent = portal ? 'Portal del artista' : 'Panel interno'; e.removeAttribute('data-neutro'); });
  }

  // Aviso de textos por aceptar (solo artistas: el Personal y el Administrador no aceptan textos) y, tras aceptarlos, el de exito. `?aviso=textos-aceptados` se lee una vez.
  const url = new URL(location.href);
  const aceptados = url.searchParams.get('aviso') === 'textos-aceptados';
  if (aceptados) {
    url.searchParams.delete('aviso');
    history.replaceState(null, '', url);
  }
  function avisarTextos(perfil: { pendientes?: { contexto: string }[] }) {
    const caja = document.querySelector('[data-avisos-app]')!;
    const pendientes = rol === 'cliente' && (perfil.pendientes ?? []).some((p) => p.contexto === 'registro');
    const nombre = pendientes ? 'textos' : aceptados ? 'exito' : null;
    const nodo = nombre && (document.querySelector<HTMLTemplateElement>(`template[data-aviso-${nombre}]`)!.content.cloneNode(true) as DocumentFragment);
    if (nodo && nombre === 'textos') {
      nodo.querySelector('.aviso')!.removeAttribute('role');
      nodo.querySelector<HTMLAnchorElement>('.aviso-accion')!.href = `/acceso/textos?${new URLSearchParams({ volver: location.pathname + location.search })}`;
    }
    caja.replaceChildren(...(nodo ? [nodo] : []));
  }

  // Contador de PAGOS (navegacion-lateral.md): 0 o error, sin contador. Más de 99: "99+".
  function contarPagos(n: unknown) {
    const total = Number(n);
    document.querySelectorAll<HTMLElement>('[data-contador="pagos"]').forEach((c) => {
      c.hidden = !(total > 0);
      c.querySelector('.etiqueta span:last-child')!.textContent = total > 99 ? '99+' : String(total);
      c.closest('a')!.querySelector('[data-contador-texto]')!.textContent = !(total > 0) ? '' : total > 99 ? 'más de 99 pagos por validar' : `${total} ${total === 1 ? 'pago por validar' : 'pagos por validar'}`;
    });
  }

  document.addEventListener('bugalu:pagos-por-validar', (e) => {
    avisos++;
    contarPagos((e as CustomEvent).detail);
  });
  document.addEventListener('bugalu:perfil', (e) => aplicar((e as CustomEvent).detail));
  // La pantalla de perfil ya pide los datos y avisa con el evento; las demás los piden aquí (solo con sesión).
  if (!document.querySelector('bugalu-perfil') && (await obtenerToken())) obtenerPerfil().then(aplicar, () => {});

  // CA-12: personal y Administrador vuelven al acceso interno.
  document.querySelectorAll<HTMLElement>('[data-cerrar-sesion]').forEach((boton) => {
    boton.hidden = false;
    boton.addEventListener('click', async () => {
      // Sin rol aún (perfil cargando o fallido) manda el área desde la que se entró.
      const interno = rol ? rol !== 'cliente' : areaRecordada() === 'estudio';
      await cerrarSesion();
      location.assign(`${interno ? '/acceso/interno' : '/acceso'}?aviso=sesion-cerrada`);
    });
  });
</script>

<style>
  /* El display del botón vence al atributo hidden. */
  :global(.boton[hidden]) {
    display: none;
  }
  .app {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: auto;
  }
  .app-nav-tactil {
    position: sticky;
    inset-block-start: var(--medida-cabecera-movil);
    z-index: 10;
  }
  .app-nav-lateral {
    display: none;
  }
  .app-columna {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }
  .app-principal {
    flex: 1;
    padding: var(--espacio-4);
  }
  .app-columna :global(.pie.app-pie) {
    padding: var(--espacio-4);
    border-block-start: var(--borde-grosor-base) solid var(--color-borde-fuerte);
  }
  .app-avisos:not(:empty) {
    margin-block-end: var(--espacio-4);
  }

  @media (min-width: 64em) { /* punto-quiebre-escritorio */
    .app {
      grid-template-columns: var(--medida-nav-lateral) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      min-block-size: 100vh; /* unidad de viewport, no un valor visual: la regla de la navegación lateral llega al pie */
    }
    .app-nav-tactil {
      display: none;
    }
    .app-nav-lateral {
      display: block;
    }
    .app-principal {
      padding: var(--espacio-8);
      max-inline-size: var(--medida-contenedor-max);
    }
    .app-columna :global(.pie.app-pie) {
      padding-inline: var(--espacio-8);
    }
  }
</style>
