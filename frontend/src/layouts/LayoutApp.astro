---
import LayoutBase from './LayoutBase.astro';
import CabeceraApp from '../componentes/CabeceraApp.astro';
import NavegacionLateral from '../componentes/NavegacionLateral.astro';
import NavegacionTactil from '../componentes/NavegacionTactil.astro';
import Boton from '../componentes/Boton.astro';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
// Los destinos con `solo` nacen ocultos y el script los muestra según el rol del perfil (la API es la barrera real: 403).
// Etiquetas de 9 caracteres como máximo (navegación táctil).
const destinos = [
  { etiqueta: 'Inicio', href: '/app/', icono: 'house' as const },
  { etiqueta: 'Accesos', href: '/app/solicitudes/', icono: 'user-plus' as const, solo: 'administrador' },
  { etiqueta: 'Usuarios', href: '/app/usuarios/', icono: 'users' as const, solo: 'administrador' },
];
// Un destino queda actual también en sus subrutas (Revisar solicitud); gana la coincidencia más larga.
const actual = destinos.map((d) => d.href).filter((href) => href === Astro.url.pathname || (href !== '/app/' && Astro.url.pathname.startsWith(href))).sort((a, b) => b.length - a.length)[0] ?? Astro.url.pathname;
---

<LayoutBase titulo={titulo}>
  <div class="app">
    <CabeceraApp variante="estudio" producto="Bugalú Studio" area="Panel interno" neutro>
      <a slot="menu" href="/app/perfil">Mi perfil</a>
      <!-- Sin JS no sirve: nace oculto y lo muestra el script. -->
      <div slot="menu"><Boton variante="secundario" data-cerrar-sesion hidden>Cerrar sesión</Boton></div>
    </CabeceraApp>

    <!-- < punto-quiebre-escritorio: fija bajo la fila 1 de la cabecera (estructura-app, "Lo fijo") -->
    <div class="app-nav-tactil"><NavegacionTactil {destinos} {actual} /></div>

    <!-- >= punto-quiebre-escritorio -->
    <div class="app-nav-lateral"><NavegacionLateral {destinos} {actual} neutro /></div>

    <main id="contenido" tabindex="-1" class="app-principal">
      <slot />
    </main>
  </div>
</LayoutBase>

<script>
  import { obtenerPerfil } from '../servicios/api.js';
  import { obtenerToken, cerrarSesion, areaRecordada } from '../servicios/sesion.js';

  // Rol del perfil cargado: muestra los destinos del Administrador y fija la variante (Estudio o Portal).
  let rol: string | null = null;
  function aplicar(perfil: { rol: string }) {
    rol = perfil.rol;
    document.querySelectorAll<HTMLElement>('[data-solo]').forEach((e) => (e.hidden = e.dataset.solo !== rol));
    const portal = rol === 'cliente';
    // El título de sección y el área nacen neutros (vacíos y ocultos): aparecen solo al conocer el rol.
    document.querySelectorAll<HTMLElement>('[data-seccion]').forEach((e) => { e.textContent = portal ? 'Portal' : 'Estudio'; e.removeAttribute('data-neutro'); });
    document.querySelectorAll<HTMLElement>('[data-area]').forEach((e) => { e.textContent = portal ? 'Portal del artista' : 'Panel interno'; e.removeAttribute('data-neutro'); });
  }

  document.addEventListener('bugalu:perfil', (e) => aplicar((e as CustomEvent).detail));
  // La pantalla de perfil ya pide los datos y avisa con el evento; las demás los piden aquí (solo con sesión).
  if (!document.querySelector('bugalu-perfil') && (await obtenerToken())) obtenerPerfil().then(aplicar, () => {});

  // CA-12: personal y Administrador vuelven al acceso interno.
  document.querySelectorAll<HTMLElement>('[data-cerrar-sesion]').forEach((boton) => {
    boton.hidden = false;
    boton.addEventListener('click', async () => {
      // Sin rol aún (perfil cargando o fallido) manda el área desde la que se entró.
      const interno = rol ? rol !== 'cliente' : areaRecordada() === 'estudio';
      await cerrarSesion();
      location.assign(`${interno ? '/acceso/interno' : '/acceso'}?aviso=sesion-cerrada`);
    });
  });
</script>

<style>
  /* El display del botón vence al atributo hidden. */
  :global(.boton[hidden]) {
    display: none;
  }
  .app {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: auto;
  }
  .app-nav-tactil {
    position: sticky;
    inset-block-start: var(--medida-cabecera-movil);
    z-index: 10;
  }
  .app-nav-lateral {
    display: none;
  }
  .app-principal {
    padding: var(--espacio-4);
  }

  @media (min-width: 64em) { /* punto-quiebre-escritorio */
    .app {
      grid-template-columns: var(--medida-nav-lateral) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      min-block-size: 100vh; /* unidad de viewport, no un valor visual: la regla de la navegación lateral llega al pie */
    }
    .app-nav-tactil {
      display: none;
    }
    .app-nav-lateral {
      display: block;
    }
    .app-principal {
      padding: var(--espacio-8);
      max-inline-size: var(--medida-contenedor-max);
    }
  }
</style>
