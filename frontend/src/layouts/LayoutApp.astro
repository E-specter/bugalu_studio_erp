---
import LayoutBase from './LayoutBase.astro';
import CabeceraApp from '../componentes/CabeceraApp.astro';
import NavegacionLateral from '../componentes/NavegacionLateral.astro';
import NavegacionTactil from '../componentes/NavegacionTactil.astro';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
// Destinos de la app: por ahora solo el inicio; el resto depende del rol (RF-01).
const destinos = [{ etiqueta: 'Inicio', href: '/app/', icono: 'house' as const }];
const actual = Astro.url.pathname;
---

<LayoutBase titulo={titulo}>
  <div class="app">
    <CabeceraApp variante="estudio" producto="Bugalú Studio" area="Panel interno">
      <a slot="menu" href="/app/perfil">Mi perfil</a>
    </CabeceraApp>

    <!-- < punto-quiebre-escritorio: fija bajo la fila 1 de la cabecera (estructura-app, "Lo fijo") -->
    <div class="app-nav-tactil"><NavegacionTactil {destinos} {actual} /></div>

    <!-- >= punto-quiebre-escritorio -->
    <div class="app-nav-lateral"><NavegacionLateral {destinos} {actual} /></div>

    <main id="contenido" tabindex="-1" class="app-principal">
      <slot />
    </main>
  </div>
</LayoutBase>

<style>
  .app {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: auto;
  }
  .app-nav-tactil {
    position: sticky;
    inset-block-start: var(--medida-cabecera-movil);
    z-index: 10;
  }
  .app-nav-lateral {
    display: none;
  }
  .app-principal {
    padding: var(--espacio-4);
  }

  @media (min-width: 64em) { /* punto-quiebre-escritorio */
    .app {
      grid-template-columns: var(--medida-nav-lateral) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      min-block-size: 100vh; /* unidad de viewport, no un valor visual: la regla de la navegación lateral llega al pie */
    }
    .app-nav-tactil {
      display: none;
    }
    .app-nav-lateral {
      display: block;
    }
    .app-principal {
      padding: var(--espacio-8);
      max-inline-size: var(--medida-contenedor-max);
    }
  }
</style>
