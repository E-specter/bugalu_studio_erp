    margin-block-end: var(--espacio-4);
  }
  .reservas-filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
    margin-block-end: var(--espacio-4);
  }
  .reservas-filtros[hidden] {
    display: none;
  }
  .reservas-total {
    margin-block-end: var(--espacio-3);
    color: var(--color-texto-secundario);
    font-family: var(--fuente-familia-tecnica);
    font-size: var(--fuente-tamano-micro);
    text-transform: uppercase;
  }
  .reservas-folio {
    display: block;
    color: var(--color-texto-principal);
    font-family: var(--fuente-familia-tecnica);
    font-weight: var(--fuente-peso-medio);
  }
  .reservas :global(.reservas-folio-titulo),
  :global(.reservas-folio-titulo) {
    white-space: nowrap;
  }
  /* El lateral (lo que toca y cancelar) va antes en el DOM: debajo del escritorio queda arriba; en escritorio, a la derecha. */
  @media (min-width: 64em) { /* punto-quiebre-escritorio */
    .reservas :global(.gestion-principal) {
      grid-column: 1;
      grid-row: 1;
    }
    .reservas :global(.gestion-lateral) {
      grid-column: 2;
      grid-row: 1;
    }
  }
  .reservas-accion {
    margin-block-start: var(--espacio-3);
  }
  .reservas-estado {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-3);
  }
  .reservas-estado[hidden] {
    display: none;
  }
  .reservas-nota,
  .reservas-resumen {
    margin: 0;
    color: var(--color-texto-cuerpo);
  }
  .reservas-nivel {
    margin: 0;
    color: var(--color-texto-principal);
    font-weight: var(--fuente-peso-titulo);
  }
  .reservas-enlace {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--medida-control-tactil);
    color: var(--color-texto-principal);
  }
  .reservas-texto {
    white-space: pre-line;
  }
  [data-previa] {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-3);
  }
  [data-previa-datos] {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-3);
  }
  .reservas-resumen,
  [data-consecuencia] {
    margin-block-end: 0;
  }
  .reservas-nota-precio {
    margin-block-start: var(--espacio-3);
  }
  .reservas-estados {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
  }
  .reservas-rechazo {
    color: var(--color-texto-cuerpo);
  }
</style>
