---
import Panel from '../componentes/Panel.astro';
import Aviso from '../componentes/Aviso.astro';
import Boton from '../componentes/Boton.astro';
import BarraAcciones from '../componentes/BarraAcciones.astro';
import Tabla from '../componentes/Tabla.astro';
import Campo from '../componentes/Campo.astro';
import Casilla from '../componentes/Casilla.astro';
import EtiquetaTecnica from '../componentes/EtiquetaTecnica.astro';
import IndicadorEstado from '../componentes/IndicadorEstado.astro';
import Icono from '../componentes/internos/Icono.astro';
import EstadosIsla from '../componentes/internos/EstadosIsla.astro';
import EstilosGestion from '../componentes/internos/EstilosGestion.astro';
import Calendario from './Calendario.astro';

interface Props {
  vista: 'lista' | 'detalle' | 'reprogramar';
  tipo?: 'asesoria'; // RF-15 B: la misma pantalla con la asesoria como objeto (GET /asesorias/...; la politica de RF-18 usa las rutas de /reservas/{id})
}
const { vista, tipo } = Astro.props;
const asesoria = tipo === 'asesoria';
// Panel de la vista mientras carga o falla (spec RF-04-mis-reservas).
const principal = vista === 'lista' ? { titulo: asesoria ? 'Asesorías' : 'Reservas' } : vista === 'reprogramar' ? { codigo: 'R1', titulo: 'Elige el nuevo horario' } : { codigo: 'D1', titulo: asesoria ? 'Asesoría' : 'Reserva' };
const base = asesoria ? '/app/asesorias/mias' : '/app/reservas/';
const filtros = [
  { clave: 'proximas', texto: 'Próximas', href: base },
  { clave: 'historial', texto: 'Historial', href: `${base}?ver=historial` },
];
---

<EstilosGestion />

<!-- Un bloque por estado (estados-sistema): la isla clona el que toca. Sin JS, el noscript oculta la carga y avisa. -->
<bugalu-reservas class="reservas" data-gestion vista={vista} tipo={tipo}>
  <div data-avisos></div>
  <!-- Región viva estable: anuncia la carga y los umbrales del plazo, nunca cada minuto. -->
  <p class="visualmente-oculto" role="status" data-anuncio></p>
  {vista === 'lista' && <nav class="reservas-filtros" aria-label={asesoria ? 'Filtrar asesorías' : 'Filtrar reservas'} data-filtros hidden></nav>}
  <EstadosIsla principal={principal} />

  {vista === 'lista' && (
    <>
      {filtros.flatMap((f) => [
        <template data-filtro={f.clave} data-aplicado="no"><EtiquetaTecnica variante="filtro" texto={f.texto} href={f.href} /></template>,
        <template data-filtro={f.clave} data-aplicado="si"><EtiquetaTecnica variante="filtro" texto={f.texto} href={f.href} aplicado /></template>,
      ])}
      <template data-estado="vacio">
        {asesoria ? (
          <Panel titulo="Asesorías">
            <p class="gestion-vacio-titulo">Aún no tienes asesorías</p>
            <p>Elige un profesional y agenda una orientación para tu proyecto.</p>
            <div class="reservas-accion"><Boton href="/asesorias/">Ver profesionales</Boton></div>
          </Panel>
        ) : (
          <Panel titulo="Reservas">
            <p class="gestion-vacio-titulo">Aún no tienes reservas</p>
            <p>Elige un horario libre y reserva la sala en unos pasos.</p>
            <div class="reservas-accion"><Boton href="/reservar/">Reservar sala</Boton></div>
          </Panel>
        )}
      </template>
      <template data-estado="vacio-filtro">
        <Panel titulo={asesoria ? 'Asesorías' : 'Reservas'}>
          <p class="gestion-vacio-titulo" data-vacio></p>
          <div class="reservas-accion"><Boton variante="secundario" href="#" data-otro></Boton></div>
        </Panel>
      </template>
      <template data-estado="datos">
        <Panel titulo={asesoria ? 'Asesorías' : 'Reservas'}>
          <p class="reservas-total" data-total></p>
          {asesoria
            ? <Tabla titulo="Asesorías" columnas={['Asesoría', 'Fecha', 'Modalidad', 'Estado', '']} />
            : <Tabla titulo="Reservas" columnas={['Reserva', 'Fecha', 'Estado', 'Total', 'Pago', '']} numericas={[3]} />}
        </Panel>
      </template>
      <template data-fila>
        {asesoria ? (
          <tr>
            <th scope="row"><span class="reservas-folio" data-folio></span><span class="gestion-motivo" data-servicio></span></th>
            <td data-etiqueta="Fecha"><span data-fecha></span><span class="gestion-motivo" data-horario></span></td>
            <td data-etiqueta="Modalidad"><span data-modalidad></span><span data-por-confirmar hidden><EtiquetaTecnica texto="Por confirmar" variante="aviso" /></span></td>
            <td data-etiqueta="Estado"><EtiquetaTecnica texto="Estado" /><span class="gestion-motivo" data-motivo hidden></span><span class="gestion-motivo" data-plazo hidden></span></td>
            <td><Boton variante="secundario" href="#" data-accion>Ver asesoría<span class="visualmente-oculto" data-objeto></span></Boton></td>
          </tr>
        ) : (
          <tr>
            <th scope="row"><span class="reservas-folio" data-folio></span><span class="gestion-motivo" data-servicio></span></th>
            <td data-etiqueta="Fecha"><span data-fecha></span><span class="gestion-motivo" data-horario></span></td>
            <td data-etiqueta="Estado"><EtiquetaTecnica texto="Estado" /><span class="gestion-motivo" data-motivo hidden></span></td>
            <td data-etiqueta="Total" class="tabla-num" data-total-fila></td>
            <td data-etiqueta="Pago">
              <span data-limite>—</span>
              <span class="gestion-motivo" data-plazo hidden></span>
            </td>
            <td><Boton variante="secundario" href="#" data-accion>Ver reserva<span class="visualmente-oculto" data-objeto></span></Boton></td>
          </tr>
        )}
      </template>
    </>
  )}

  {vista === 'reprogramar' && (
    <>
      <template data-estado="no-encontrada">
        <Panel codigo="[404]" titulo={asesoria ? 'Asesoría no encontrada' : 'Reserva no encontrada'}><Aviso variante="informacion" titulo=" " texto=" " accion={{ etiqueta: asesoria ? 'Volver a mis asesorías' : 'Volver a mis reservas', href: base }} /></Panel>
      </template>
      <template data-estado="no-permitida">
        <Panel codigo="R1" titulo="No se puede reprogramar"><Aviso variante="informacion" titulo=" " texto=" " accion={{ etiqueta: asesoria ? 'Volver a la asesoría' : 'Volver a la reserva', href: base }} /></Panel>
      </template>
      <template data-plantilla="calendario"><Calendario modo={asesoria ? 'asesoria' : 'reserva'} /></template>
      <template data-estado="datos">
        <div class="gestion-rejilla">
          <div class="gestion-principal">
            <div data-sin-costo hidden><Aviso variante="informacion" titulo="Sin costo: el estudio canceló tu sesión. Mantienes el precio y lo que pagaste." /></div>
            <Panel codigo="R1" titulo="Elige el nuevo horario" variante="sin-borde">
              <div data-calendario></div>
              <p class="reservas-nota" data-ayuda-duracion></p>
              <div data-error-horario hidden><Aviso variante="error" titulo=" " texto=" " /></div>
            </Panel>
            <div data-r2 hidden>
              <Panel codigo="R2" titulo="Cómo queda">
                <div class="reservas-r2">
                  <div data-r2-aviso></div>
                  <p class="reservas-nota" data-r2-carga hidden>Calculando cómo queda…</p>
                  <div class="reservas-r2" data-r2-datos hidden>
                    <p class="reservas-nivel" data-nuevo-horario></p>
                    <p class="reservas-nota" data-nivel-texto></p>
                    <p class="reservas-nota" data-nota-pago hidden></p>
                    <div data-tabla="precio"><Tabla titulo="Nuevo precio" columnas={['Concepto', 'Cantidad', 'Importe']} variante="partidas" numericas={[1, 2]} /></div>
                    <div data-tabla="saldo"><Tabla titulo="Saldo" columnas={['Concepto', 'Importe']} variante="partidas" numericas={[1]} /></div>
                    <p class="reservas-nota" data-restantes hidden></p>
                    <div data-recalculo><Aviso variante="informacion" titulo="El precio se recalcula con las tarifas vigentes del nuevo horario. Si sube, la diferencia va a tu saldo; si baja, lo pagado de más pasa a crédito, sin devolución." /></div>
                  </div>
                </div>
              </Panel>
            </div>
          </div>
          <div class="gestion-lateral">
            <Panel titulo={asesoria ? 'Asesoría actual' : 'Reserva actual'} variante="lateral" id="actual">
              <dl class="gestion-datos">
                <div><dt>Folio</dt><dd data-actual="folio"></dd></div>
                <div><dt>Fecha y horario</dt><dd data-actual="horario"></dd></div>
                <div><dt>{asesoria ? 'Profesional' : 'Servicio'}</dt><dd data-actual="servicio"></dd></div>
                <div data-fila="especialistas"><dt>Especialistas</dt><dd data-actual="especialistas"></dd></div>
                {asesoria && <div><dt>Duración</dt><dd data-actual="duracion"></dd></div>}
                {asesoria && <div><dt>Modalidad</dt><dd data-actual="modalidad"></dd></div>}
                <div><dt>Total</dt><dd data-actual="total"></dd></div>
                <div><dt>Pagado</dt><dd data-actual="pagado"></dd></div>
              </dl>
            </Panel>
          </div>
        </div>
        <form novalidate class="reservas-pie" data-accion="reprogramar">
          <p class="gestion-ayuda" id="reservas-ayuda-confirmar" data-ayuda-confirmar>Elige un horario para ver cómo queda.</p>
          <BarraAcciones variante="formulario">
            <Boton slot="secundaria" variante="secundario" href="#" data-volver-reprog>{asesoria ? 'Volver a la asesoría' : 'Volver a la reserva'}</Boton>
            <Boton slot="principal" tipo="submit" data-envio data-confirmar-reprog aria-disabled="true" aria-describedby="reservas-ayuda-confirmar">Confirmar reprogramación</Boton>
          </BarraAcciones>
        </form>
      </template>
    </>
  )}

  {vista === 'detalle' && (
    <>
      <template data-estado="no-encontrada">
        <Panel codigo="[404]" titulo={asesoria ? 'Asesoría no encontrada' : 'Reserva no encontrada'}><Aviso variante="informacion" titulo=" " texto=" " accion={{ etiqueta: asesoria ? 'Volver a mis asesorías' : 'Volver a mis reservas', href: base }} /></Panel>
      </template>
      <template data-estado="datos">
        <div class="gestion-rejilla">
          <div class="gestion-lateral">
            <div data-estado-reserva class="reservas-estado">
              <IndicadorEstado variante="barra" texto=" " dato=" " />
              <p class="reservas-nota" data-nota hidden></p>
              <p class="reservas-nota" data-nota-estudio hidden></p>
              <div data-menos-hora hidden><Aviso variante="aviso" titulo=" " texto=" " /></div>
            </div>
            <div data-pagar hidden><Boton href="#">Registrar pago</Boton></div>
            <!-- Asesoría virtual con enlace: entrar a la videollamada (pestaña nueva); si falta el lugar o el enlace, quién lo confirma. -->
            <div data-videollamada hidden><Boton href="#" target="_blank" rel="noopener noreferrer">Entrar a la videollamada<span class="visualmente-oculto"> (se abre en otra pestaña)</span><Icono nombre="external-link" /></Boton></div>
            <div class="reservas-estado" data-lugar-nota hidden>
              <p class="reservas-nota" data-lugar-texto></p>
              <p class="reservas-nota reservas-texto" data-contacto-estudio hidden></p>
            </div>

            {asesoria && (
              <>
                <!-- Profesional y Administrador (spec RF-15-gestion): el lugar o enlace de la cita y quién lo registra. -->
                <div class="reservas-estado" data-boton="lugar" hidden>
                  <div data-lugar-falta hidden><Aviso variante="aviso" titulo=" " texto=" " /></div>
                  <dl class="gestion-datos">
                    <div><dt data-lugar-dt>Lugar o enlace</dt><dd class="reservas-texto"><span data-lugar-valor></span><span data-lugar-pendiente hidden><EtiquetaTecnica texto="Por confirmar" variante="aviso" /></span></dd></div>
                  </dl>
                  <Boton variante="secundario" data-abrir="lugar">Registrar lugar</Boton>
                </div>
                <p class="reservas-nota" data-pide-admin hidden>¿No puedes darla? Pide al Administrador que la cancele por el estudio. El cliente podrá reprogramar contigo sin costo o pedir la devolución.</p>
                <div data-panel="lugar" hidden>
                  <Panel titulo="Lugar o enlace" variante="lateral" id="lugar">
                    <form novalidate class="gestion-formulario" data-accion="lugar">
                      <div class="campo">
                        <fieldset class="gestion-grupo">
                          <legend>Modalidad</legend>
                          <Casilla tipo="radio" nombre="modalidad" valor="presencial" id="lugar-presencial" aria-controls="lugar-campos-presencial" etiqueta="Presencial" />
                          <div class="gestion-grupo" id="lugar-campos-presencial" data-campos="presencial" hidden>
                            <Campo tipo="area" id="lugar-lugar" nombre="lugar" etiqueta="Lugar" maxlength="300" ayuda="Ambiente del estudio o dirección, con una referencia. Por ejemplo: «Ambiente 2 del estudio, segundo piso»." />
                          </div>
                          <Casilla tipo="radio" nombre="modalidad" valor="virtual" id="lugar-virtual" aria-controls="lugar-campos-virtual" etiqueta="Virtual (Google Meet)" />
                          <div class="gestion-grupo" id="lugar-campos-virtual" data-campos="virtual" hidden>
                            <Campo tipo="url" id="lugar-enlace" nombre="enlace" etiqueta="Enlace" inputmode="url" spellcheck="false" autocomplete="off" ayuda="Crea la reunión en Google Meet y pega aquí su enlace." />
                          </div>
                        </fieldset>
                      </div>
                      <p data-consecuencia></p>
                      <BarraAcciones variante="decision">
                        <Boton slot="secundaria" variante="secundario" data-envio data-volver>Volver a la asesoría</Boton>
                        <Boton slot="principal" tipo="submit" data-envio>Guardar y avisar</Boton>
                      </BarraAcciones>
                    </form>
                  </Panel>
                </div>
              </>
            )}

            <!-- Reprogramar (solo el dueño de una confirmada): botón con su ayuda, o la explicación de por qué no. -->
            <div class="reservas-estado" data-reprogramar hidden>
              <Boton variante="secundario" href="#" data-enlace-reprogramar aria-describedby="reservas-ayuda-reprogramar">Reprogramar</Boton>
              <p class="gestion-ayuda" id="reservas-ayuda-reprogramar" data-ayuda-reprogramar hidden></p>
            </div>
            <p class="reservas-nota" data-no-reprogramar hidden></p>

            <!-- Elección tras una cancelación del estudio: dos opciones del mismo peso, sin primario. -->
            <div class="reservas-estado" data-boton="devolucion" hidden>
              <div class="reservas-opcion">
                <Boton variante="secundario" href="#" data-sin-costo>Reprogramar sin costo</Boton>
                <p class="reservas-nota" data-texto-sin-costo></p>
              </div>
              <div class="reservas-opcion">
                <Boton variante="secundario" data-abrir="devolucion">Pedir la devolución íntegra</Boton>
                <p class="reservas-nota" data-texto-devolucion></p>
              </div>
              <p class="gestion-ayuda">Mientras no elijas, nada vence.</p>
            </div>

            <!-- Acciones del lateral: un botón por acción; al abrirla, su panel lo sustituye (una sola a la vez). -->
            <div class="reservas-estado" data-boton="inasistencia" hidden>
              <Boton variante="peligro" data-abrir="inasistencia">Marcar no asistió</Boton>
              <p class="gestion-ayuda" id="reservas-ayuda-inasistencia" data-ayuda-na hidden></p>
            </div>
            <div data-boton="excepcion" hidden><Boton variante="secundario" data-abrir="excepcion">Tratar como nivel 1</Boton></div>
            <div data-boton="cancelar" hidden><Boton variante="peligro" data-abrir="cancelar">Solicitar cancelación</Boton></div>

            <div data-panel="devolucion" hidden>
              <Panel titulo="Devolución íntegra" variante="lateral" id="devolucion">
                <form novalidate class="gestion-formulario" data-accion="devolucion">
                  <p data-consecuencia></p>
                  <BarraAcciones variante="decision">
                    <Boton slot="secundaria" variante="secundario" data-envio data-volver>Volver</Boton>
                    <Boton slot="principal" tipo="submit" data-envio>Confirmar devolución</Boton>
                  </BarraAcciones>
                </form>
              </Panel>
            </div>

            <div data-panel="inasistencia" hidden>
              <Panel titulo="Marcar inasistencia" variante="lateral" id="inasistencia">
                <form novalidate class="gestion-formulario" data-accion="inasistencia">
                  <p class="reservas-resumen" data-resumen-na></p>
                  <p data-consecuencia></p>
                  <BarraAcciones variante="decision">
                    <Boton slot="secundaria" variante="secundario" data-envio data-volver>{asesoria ? 'Volver a la asesoría' : 'Volver a la reserva'}</Boton>
                    <Boton slot="principal" variante="peligro" tipo="submit" data-envio>Marcar no asistió</Boton>
                  </BarraAcciones>
                </form>
              </Panel>
            </div>

            <div data-panel="excepcion" hidden>
              <Panel titulo="Tratar como nivel 1" variante="lateral" id="excepcion">
                <form novalidate class="gestion-formulario" data-accion="excepcion">
                  <p>Para emergencias de salud, duelos, desastres o paros que impidieron avisar a tiempo, con un sustento razonable.</p>
                  <dl class="gestion-datos"><div><dt>Retenido hoy</dt><dd data-retenido-hoy></dd></div></dl>
                  <Campo tipo="area" id="excepcion-motivo" nombre="motivo" etiqueta="Motivo" obligatorio minlength="10" maxlength="500" ayuda={`Qué pasó y qué sustento recibiste. El cliente lo verá en su ${asesoria ? 'asesoría' : 'reserva'}.`} />
                  <p data-consecuencia></p>
                  <BarraAcciones variante="decision">
                    <Boton slot="secundaria" variante="secundario" data-envio data-volver>{asesoria ? 'Volver a la asesoría' : 'Volver a la reserva'}</Boton>
                    <Boton slot="principal" tipo="submit" data-envio>Tratar como nivel 1</Boton>
                  </BarraAcciones>
                </form>
              </Panel>
            </div>

            <div data-panel="cancelar" hidden>
              <Panel titulo="Cancelar reserva" variante="lateral" id="cancelar">
                <form novalidate class="gestion-formulario" data-accion="cancelar">
                  <div data-panel-aviso></div>
                  <p class="reservas-resumen" data-resumen></p>
                  <div data-parte="admin" hidden>
                    <div class="campo">
                      <fieldset class="gestion-grupo">
                        <legend>¿Quién pide cancelar?</legend>
                        <Casilla tipo="radio" nombre="por" valor="estudio" id="cancelar-por-estudio" aria-controls="cancelar-campos-estudio" etiqueta="El estudio" detalle={asesoria ? 'El profesional no puede darla, falla técnica o fuerza mayor.' : 'Falla técnica, ausencia del especialista o fuerza mayor.'} />
                        <div class="gestion-grupo" id="cancelar-campos-estudio" data-campos="estudio" hidden>
                          <Campo tipo="area" id="cancelar-nota-estudio" nombre="nota-estudio" etiqueta="Nota para el cliente" maxlength="300" />
                        </div>
                        <Casilla tipo="radio" nombre="por" valor="cliente" id="cancelar-por-cliente" aria-controls="cancelar-campos-cliente" etiqueta="El cliente, por otro canal" detalle="Te escribió por WhatsApp, correo o teléfono." />
                        <div class="gestion-grupo" id="cancelar-campos-cliente" data-campos="cliente" hidden>
                          <div class="gestion-fila-campos">
                            <Campo tipo="date" id="cancelar-fecha" nombre="fecha" etiqueta="Fecha del aviso" obligatorio ayuda="Las de su mensaje, hora de Lima." />
                            <Campo tipo="time" id="cancelar-hora" nombre="hora" etiqueta="Hora del aviso" obligatorio step="60" />
                          </div>
                          <Campo tipo="area" id="cancelar-nota-cliente" nombre="nota-cliente" etiqueta="Nota" obligatorio maxlength="300" ayuda="Canal y lo que pidió. Por ejemplo: «WhatsApp: no puede venir por un viaje»." />
                        </div>
                      </fieldset>
                    </div>
                  </div>
                  <!-- Vista previa de la política: carga, datos o error; nunca se ofrece confirmar al cliente sin ella. -->
                  <div data-previa hidden>
                    <p class="reservas-nota" data-previa-carga hidden>Calculando qué pasa con tu pago…</p>
                    <div data-previa-datos hidden>
                      <p class="reservas-nivel" data-nivel></p>
                      <p class="reservas-nota" data-anticipacion></p>
                      <dl class="gestion-datos" data-dl></dl>
                      <p class="reservas-nota" data-validacion hidden></p>
                    </div>
                  </div>
                  <p data-consecuencia></p>
                  <p class="reservas-nota"><a class="reservas-enlace" href="/legal/condiciones-de-contratacion/" data-condiciones>Leer las condiciones de cancelación</a></p>
                  <p class="reservas-nota" data-en-lugar hidden><a class="reservas-enlace" href="#" data-enlace-en-lugar>Reprogramar en lugar de cancelar</a></p>
                  <BarraAcciones variante="decision">
                    <Boton slot="secundaria" variante="secundario" data-envio data-volver>{asesoria ? 'Volver a la asesoría' : 'Volver a la reserva'}</Boton>
                    <Boton slot="principal" variante="peligro" tipo="submit" data-envio data-confirmar-cancelar hidden>Confirmar cancelación</Boton>
                  </BarraAcciones>
                </form>
              </Panel>
            </div>
          </div>
          <div class="gestion-principal">
            {asesoria && (
              <div data-d0 hidden>
                <Panel codigo="D0" titulo="Cliente">
                  <dl class="gestion-datos">
                    <div><dt>Nombre</dt><dd data-d0="nombre"></dd></div>
                    <div data-fila="d0-telefono"><dt>Teléfono</dt><dd><a class="reservas-enlace" data-d0="telefono" href="#"></a></dd></div>
                    <div data-fila="d0-correo"><dt>Correo</dt><dd><a class="reservas-enlace" data-d0="correo" href="#"></a></dd></div>
                  </dl>
                </Panel>
              </div>
            )}
            <Panel codigo="D1" titulo={asesoria ? 'Asesoría' : 'Reserva'}>
              <dl class="gestion-datos">
                <div><dt>Estado</dt><dd class="reservas-estados"><EtiquetaTecnica texto="Estado" /><span data-pago-validar hidden><EtiquetaTecnica texto="Pago por validar" variante="aviso" /></span></dd></div>
                <div><dt>Fecha y horario</dt><dd data-campo="horario"></dd></div>
                <div><dt>Duración</dt><dd data-campo="duracion"></dd></div>
                <div data-fila="servicio"><dt>{asesoria ? 'Profesional' : 'Servicio'}</dt><dd data-campo="servicio"></dd></div>
                <div data-fila="especialistas"><dt>Especialistas</dt><dd data-campo="especialistas"></dd></div>
                <div data-fila="sala"><dt>Sala</dt><dd data-campo="sala"></dd></div>
                <div data-fila="modalidad"><dt>Modalidad</dt><dd data-campo="modalidad"></dd></div>
                <div data-fila="encuentro"><dt data-etiqueta-encuentro>Lugar</dt><dd class="reservas-texto" data-campo="encuentro"></dd></div>
                <div data-fila="cliente"><dt>Cliente</dt><dd data-campo="cliente"></dd></div>
                <div data-fila="condiciones"><dt>Condiciones</dt><dd data-campo="condiciones"></dd></div>
              </dl>
            </Panel>
            <div data-d2>
            <Panel codigo="D2" titulo="Precio">
              <div data-precio><Tabla titulo="Desglose del precio" columnas={asesoria ? ['Concepto', 'Importe'] : ['Concepto', 'Cantidad', 'Importe']} variante="partidas" numericas={asesoria ? [1] : [1, 2]} /></div>
              <p class="gestion-ayuda reservas-nota-precio">{asesoria ? 'Precio fijo con IGV, calculado al agendar.' : 'Precio calculado al reservar.'}</p>
            </Panel>
            </div>
            <div data-d3>
            <Panel codigo="D3" titulo="Cuotas">
              <div data-cuotas><Tabla titulo="Cuotas" columnas={['Cuota', 'Importe', 'Estado']} variante="partidas" numericas={[1]} /></div>
            </Panel>
            </div>
            <div data-d4 hidden>
              <Panel codigo="D4" titulo="Cancelación">
                <dl class="gestion-datos">
                  <div><dt>Aviso</dt><dd data-d4="aviso"></dd></div>
                  <div><dt>A pedido de</dt><dd data-d4="por"></dd></div>
                  <div data-fila="registrada"><dt>Registrada por</dt><dd data-d4="registrada"></dd></div>
                  <div><dt>Nivel</dt><dd data-d4="nivel"></dd></div>
                  <div><dt>Pagado</dt><dd data-d4="pagado"></dd></div>
                  <div><dt>Retenido</dt><dd data-d4="retenido"></dd></div>
                  <div><dt>Pasó a crédito</dt><dd><span data-d4="credito"></span> <a class="reservas-enlace" href="/app/reservas/creditos" data-d4-creditos hidden>Ver mis créditos</a></dd></div>
                  <div data-fila="nota"><dt>Nota del estudio</dt><dd class="reservas-texto" data-d4="nota"></dd></div>
                  <div data-fila="excepcion"><dt>Caso excepcional</dt><dd class="reservas-texto" data-d4="excepcion"></dd></div>
                </dl>
              </Panel>
            </div>
            <div data-d5 hidden>
              <Panel codigo="D5" titulo="Reprogramaciones">
                <Tabla titulo="Reprogramaciones" columnas={asesoria ? ['Fecha del cambio', 'Antes', 'Ahora', 'Nivel', 'Penalización'] : ['Fecha del cambio', 'Antes', 'Ahora', 'Nivel', 'Penalización', 'Total']} numericas={asesoria ? [4] : [4, 5]} />
              </Panel>
            </div>
          </div>
        </div>
      </template>
      <template data-fila-cuota>
        <tr>
          <th scope="row"><span data-concepto></span><span class="gestion-motivo reservas-rechazo" data-rechazo hidden></span></th>
          <td data-etiqueta="Importe" class="tabla-num" data-importe></td>
          <td data-etiqueta="Estado"><EtiquetaTecnica texto="Estado" /><span class="gestion-motivo" data-sub hidden></span></td>
        </tr>
      </template>
      <template data-fila-reprog>
        <tr>
          <th scope="row" data-en></th>
          <td data-etiqueta="Antes" data-antes></td>
          <td data-etiqueta="Ahora" data-ahora></td>
          <td data-etiqueta="Nivel" data-nivel-r></td>
          <td data-etiqueta="Penalización" class="tabla-num" data-penalizacion></td>
          {!asesoria && <td data-etiqueta="Total" class="tabla-num" data-total-r></td>}
        </tr>
      </template>
    </>
  )}
  <!-- Al final: sus plantillas van antes en el DOM que las del calendario que aloja la vista de reprogramar. -->
  <div data-salida><Panel {...principal} cargando /></div>
</bugalu-reservas>

<script>
  // @ts-nocheck
  import { IslaGestion, mensajeError } from '../servicios/isla-gestion.js';
  import { listarMisAsesorias, obtenerAsesoria, actualizarEncuentro, ESTADOS_ASESORIA, MODALIDADES, textoCuotaAsesoria, duracionTexto, pintarPartidasAsesoria } from '../servicios/asesorias.js';
  import { enlaceTexto } from '../servicios/aceptaciones.js';
  import { obtenerContacto } from '../servicios/pagos.js';
  import { listarMisReservas, obtenerReserva, cancelarReserva, verCancelacion, marcarInasistencia, aplicarExcepcion, simularReprogramacion, reprogramarReserva, elegirDevolucionEstudio, absoluta, faltan, textoCuota, ultimoRechazo, tienePagos } from '../servicios/reservas.js';
  import { consecuenciaCancelarAsesoria, FRANJA_ASESORIA, nivelTexto, consecuenciaCancelar, avisoValidacion, filasVista, anticipacionTexto, entradaReprogramar, nivelReprogramacion, sinReprogramar, FRANJA } from '../servicios/cancelacion.js';
  import { obtenerPerfil } from '../servicios/api.js';
  import { fechaDe, horaDe, diaMes, diaMesAnio, nombreDia, soles, porcentaje, duracionReserva, instante, pintarPartidas } from '../servicios/formatos.js';
  import { mostrarAviso as mostrarAvisoBase, enfocarAviso, llenarAviso as llenarAvisoBase, quitarError, limpiarAvisos } from '../servicios/formulario.js';

  // RF-15: la misma pantalla sirve a la asesoria; "reserva" pasa a "asesoria" en los textos de los avisos.
  let ASES = false;
  const T = (t) => (ASES && typeof t === 'string' ? t.replace(/\b([Rr])eservas\b/g, (_, c) => (c === 'R' ? 'Asesorías' : 'asesorías')).replace(/\b([Rr])eserva\b/g, (_, c) => (c === 'R' ? 'Asesoría' : 'asesoría')) : t);
  const mostrarAviso = (isla, variante, titulo, texto, opciones) => mostrarAvisoBase(isla, variante, T(titulo), T(texto), opciones);
  const llenarAviso = (aviso, titulo, texto) => llenarAvisoBase(aviso, T(titulo), T(texto));
  const RUTA = () => (ASES ? { lista: '/app/asesorias/mias', detalle: '/app/asesorias/detalle', pagar: '/app/asesorias/pagar', reprogramar: '/app/asesorias/reprogramar' } : { lista: '/app/reservas/', detalle: '/app/reservas/detalle', pagar: '/app/reservas/pagar', reprogramar: '/app/reservas/reprogramar' });
  const leer = (id) => (ASES ? obtenerAsesoria : obtenerReserva)(id);
  const totalDe = (r) => r.precio?.total ?? r.total;
  const nombreProf = (p) => p?.nombre_artistico || p?.nombre || 'Profesional';
  const porValidar = (r) => r.pago_por_validar === true || (ASES && (r.cuotas ?? []).some((c) => c.estado === 'en_validacion'));

  // Prefijo de cerrarSesion(): la cifra del aviso de reprogramar no sobrevive a la sesión.
  const claveReprogramada = (id) => `bugalu:reserva-detalle-reprogramada:${id}`;
  const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const MINUTO = 60e3;
  const filtrosOrden = ['proximas', 'historial'];
  // estado -> [texto, variante de la etiqueta]
  const ESTADOS = { pre_reservada: ['Pre-reservada', 'aviso'], confirmada: ['Confirmada', 'exito'], en_curso: ['En curso', 'activa'], finalizada: ['Finalizada', 'exito'], cancelada: ['Cancelada', 'alerta'], no_asistio: ['No asistió', 'alerta'] };
  const PROXIMAS = ['pre_reservada', 'confirmada', 'en_curso'];
  const CUOTAS = { pendiente: ['Pendiente', 'aviso'], en_validacion: ['En validación', 'aviso'], pagada: ['Pagada', 'exito'], anulada: ['Anulada', 'neutra'] };
  // Panel de acción -> título (el folio se suma aparte, sin partirse).
  const TITULOS = { cancelar: 'Cancelar reserva ', inasistencia: 'Marcar inasistencia · ', excepcion: 'Tratar como nivel 1 · ', devolucion: 'Devolución íntegra · ', lugar: 'Lugar o enlace · ' };
  const ENLACE_INVALIDO = 'Pega un enlace de Google Meet que empiece por https://meet.google.com/.';
  const ENLACE_MEET = /^https:\/\/meet\.google\.com\/[A-Za-z0-9/_?=&.%-]{1,200}$/;
  const AVISO_INVALIDO = 'El aviso no puede ser futuro ni anterior a cuando se hizo la reserva.';
  const MOTIVO_EXCEPCION = 'Escribe el motivo, de 10 a 500 caracteres.';

  const nombre = (v) => v?.nombre ?? v;
  const persona = (p) => p?.nombre_artistico || p?.nombre || 'Cliente';
  const horario = (r) => `${horaDe(r.inicio)}–${horaDe(r.fin)}`;
  const fecha = (r) => diaMesAnio(fechaDe(r.inicio));
  const duracion = (r) => {
    const min = Math.round((Date.parse(r.fin) - Date.parse(r.inicio)) / MINUTO);
    return [Math.floor(min / 60) && `${Math.floor(min / 60)} h`, min % 60 && `${min % 60} min`].filter(Boolean).join(' ') || '0 min';
  };
  // Umbrales del plazo (0 = vencido): solo al cruzarlos se anuncia.
  const umbral = (ms) => (ms <= 0 ? 0 : ms <= 15 * MINUTO ? 1 : ms <= 60 * MINUTO ? 2 : 3);
  const anuncios = [(f) => `La reserva ${f} venció sin pago.`, (f) => `La reserva ${f} vence en menos de 15 min.`, (f) => `La reserva ${f} vence en menos de 1 h.`];

  // Con un pago por validar el plazo no corre (RN-18).
  const resto = (r) => (r.estado === 'pre_reservada' && r.vence_pago && !porValidar(r) ? Date.parse(r.vence_pago) - Date.now() : null);
  // Una pre-reservada con el plazo vencido ya cuenta como caducada, aunque la API tarde en cancelarla.
  const caducada = (r) => resto(r) !== null && resto(r) <= 0;
  const estadoDe = (r) => (caducada(r) ? ['Caducada', 'alerta'] : ESTADOS[r.estado]);
  const motivo = (r) => {
    if (caducada(r)) return `Venció sin pago${r.vence_pago ? ` el ${absoluta(r.vence_pago)}` : ''}. El horario quedó libre.`;
    if (r.estado !== 'cancelada') return null;
    return { cliente: 'La cancelaste.', administrador: 'La canceló el estudio.' }[r.motivo_cancelacion] ?? `Caducó sin pago${r.vence_pago ? ` el ${absoluta(r.vence_pago)}` : ''}. El horario se liberó.`;
  };
  // Minutos de tolerancia de la inasistencia, de la política de la reserva; null si no llega.
  const tolerancia = (r) => (r.politica?.minutos_tolerancia_inasistencia == null ? null : Number(r.politica.minutos_tolerancia_inasistencia));
  const positivo = (monto) => Number(monto) > 0;

  // Columna PAGO de la lista: [texto, plazo restante o null].
  const pagoDe = (r, ms) => {
    if (r.estado === 'cancelada' || r.estado === 'no_asistio') return ['—', null];
    if (r.estado === 'pre_reservada') {
      if (r.pago_por_validar) return ['En validación', null];
      if (ms === null) return ['—', null];
      return ms <= 0 ? ['Venció sin pago', null] : [`Antes del ${absoluta(r.vence_pago)}`, faltan(ms)];
    }
    const resta = (r.cuotas ?? []).find((c) => c.hito === 'al_terminar');
    return [{ pendiente: `Resto: ${soles(resta?.monto)}`, en_validacion: 'En validación', pagada: 'Pagada' }[resta?.estado] ?? '—', null];
  };

  // Un dato fuera de la lista cerrada no se usa en plantillas: respuesta inesperada (cae en "Algo salió mal").
  const validar = (r) => {
    if (!r || typeof r !== 'object' || !Object.hasOwn(ESTADOS, r.estado)) throw new Error('respuesta_inesperada');
    return r;
  };

  const poner = (etiqueta, [texto, variante]) => {
    etiqueta.querySelector('span:last-child').textContent = texto;
    etiqueta.className = etiqueta.className.replace(/etiqueta-(neutra|activa|invertida|exito|aviso|alerta)/, `etiqueta-${variante}`);
  };
  const oculto = (nodo, texto) => {
    nodo.hidden = !texto;
    nodo.textContent = texto ?? '';
  };
  const folioTitulo = (folio) => Object.assign(document.createElement('span'), { className: 'reservas-folio-titulo', textContent: folio });

  class BugaluReservas extends IslaGestion {
    noEncontrada = ['No encontramos esta reserva.', ''];
    filas = [];
    reserva = null;
    rol = null;
    temporizador = 0;
    abierto = null; // panel de acción abierto: cancelar | inasistencia | excepcion
    previa = null; // VistaCancelacion mostrada (la última que llegó)
    secuencia = 0; // descarta vistas previas que llegan tarde
    vistaDesde = 0; // instante en que se pidió la última
    vistaCancel = null; // VistaCancelacion pedida al cargar el detalle (null si no aplica o falla)
    reprogramada = null; // viene de reprogramar: {credito} para el aviso de éxito
    sinCosto = false; // reprogramar tras una cancelación del estudio
    minutos = 0; // duración de la reserva que se reprograma
    inicioR = null; // inicio elegido en el calendario
    vistaR = null; // VistaReprogramacion mostrada (la última que llegó)
    avisoNa = false; // el botón de inasistencia se pulsó antes de tiempo (o la API dijo que aún no)

    connectedCallback() {
      ASES = this.getAttribute('tipo') === 'asesoria';
      if (ASES) {
        Object.assign(ESTADOS, ESTADOS_ASESORIA);
        this.noEncontrada = ['No encontramos esta asesoría.', ''];
      }
      super.connectedCallback();
    }

    iniciar() {
      this.addEventListener('click', (e) => {
        const abrir = e.target.closest('[data-abrir]');
        if (abrir) this.abrir(abrir.dataset.abrir, abrir);
        else if (e.target.closest('[data-volver]')) this.cerrar();
        else if (e.target.closest('[data-reintentar-previa]')) this.pedirVista(this.avisoReintento);
        else if (e.target.closest('[data-volver-reprog]') && this.ocupado) e.preventDefault();
      });
      this.addEventListener('calendario-inicio', (e) => this.alInicio(e.detail));
      this.addEventListener('change', (e) => {
        if (e.target.matches('input[name="por"]')) this.cambiarOpcion();
        else if (e.target.matches('input[name="modalidad"]')) this.cambiarModalidad();
        else if (e.target.matches('#cancelar-fecha, #cancelar-hora')) this.vistaDelAviso();
      });
      this.addEventListener('keydown', (e) => e.key === 'Escape' && this.abierto && !this.ocupado && this.cerrar());
    }

    disconnectedCallback() {
      clearInterval(this.temporizador);
    }

    alEnviar(formulario) {
      const accion = formulario.dataset.accion;
      if (accion === 'cancelar') this.cancelar();
      else if (accion === 'reprogramar') this.confirmarReprogramacion();
      else if (accion === 'devolucion') this.devolucion();
      else if (accion === 'inasistencia') this.inasistencia();
      else if (accion === 'lugar') this.lugar();
      else this.excepcion();
    }

    // Solo el detalle recibe ?aviso= (lista cerrada: el texto sale de aqui).
    avisoDeUrl() {
      if (this.vista === 'detalle') {
        // Reprogramar vuelve con el crédito que pasó, si lo hubo; el aviso se arma al tener la reserva (lleva su nuevo horario).
        const url = new URL(location.href);
        if (url.searchParams.get('aviso') === (ASES ? 'asesoria-reprogramada' : 'reserva-reprogramada')) {
          // La cifra sale de la vista previa que se confirmó (guardada por reserva), nunca de la URL.
          const id = url.searchParams.get('id') ?? '';
          let credito = null;
          try {
            credito = sessionStorage.getItem(claveReprogramada(id));
            sessionStorage.removeItem(claveReprogramada(id));
          } catch {}
          this.reprogramada = { credito: /^\d{1,9}\.\d{2}$/.test(credito ?? '') ? credito : null };
          url.searchParams.delete('aviso');
          url.searchParams.delete('credito');
          history.replaceState(null, '', url);
          return;
        }
        this.avisosUrl = ASES ? {
          'asesoria-cancelada': ['Asesoría cancelada'],
          'devolucion-elegida': ['Elegiste la devolución íntegra. Avisamos al estudio.'],
          'pago-registrado': ['Pago registrado. Queda pendiente de validación', 'Te avisaremos por correo cuando el estudio lo revise.'],
          'pagado-con-credito': ['Pagaste con tu crédito', 'Tu asesoría quedó confirmada.'],
        } : {
          'devolucion-elegida': ['Elegiste la devolución íntegra. Avisamos al estudio.'],
          'pago-registrado': ['Pago registrado. Queda pendiente de validación', 'Te avisaremos por correo cuando el estudio lo revise.'],
          'pagado-con-credito': ['Pagaste la cuota con tu crédito.'],
          'pagado-con-credito-confirmada': ['Pagaste la cuota con tu crédito', 'Tu reserva quedó confirmada.'],
        };
      }
      super.avisoDeUrl();
    }

    // 401 y 403 llevan el texto de esta pantalla y su propio enlace.
    mostrar(estado) {
      super.mostrar(estado);
      const aviso = this.querySelector('[data-salida] .aviso');
      if (estado === 'no-autenticado') {
        llenarAviso(aviso, 'Tu sesión no es válida', 'Inicia sesión para ver tus reservas.');
        const enlace = aviso.querySelector('.aviso-accion');
        enlace.textContent = 'Ir al acceso';
        enlace.href = `/acceso?${new URLSearchParams({ volver: location.pathname + location.search })}`;
      } else if (estado === 'sin-permiso') {
        aviso.querySelector('.aviso-titulo').textContent = ASES ? 'Esta sección es para artistas.' : this.vista !== 'lista' ? 'Esta reserva no es tuya.' : 'No tienes permiso para ver estas reservas.';
        aviso.querySelector('.aviso-texto')?.remove();
        const enlace = aviso.querySelector('.aviso-accion');
        enlace.textContent = ASES ? 'Volver al inicio' : 'Volver a mis reservas';
        enlace.href = ASES ? '/app/' : '/app/reservas/';
      }
    }

    // --- Lista ---

    async lista() {
      const ver = new URLSearchParams(location.search).get('ver') === 'historial' ? 'historial' : 'proximas';
      const todas = (await (ASES ? listarMisAsesorias : listarMisReservas)()).map(validar);
      const encabezado = document.querySelector('[data-accion-encabezado]');
      const nav = this.querySelector('[data-filtros]');
      if (!todas.length) {
        encabezado?.remove();
        nav.hidden = true;
        this.mostrar('vacio');
        return T('Aún no tienes reservas');
      }
      nav.replaceChildren(...filtrosOrden.map((clave) => this.querySelector(`template[data-filtro="${clave}"][data-aplicado="${clave === ver ? 'si' : 'no'}"]`).content.cloneNode(true)));
      nav.hidden = false;
      const mias = todas.filter((r) => PROXIMAS.includes(r.estado) === (ver === 'proximas')).sort((a, b) => (ver === 'proximas' ? 1 : -1) * (Date.parse(a.inicio) - Date.parse(b.inicio)));
      if (!mias.length) {
        this.mostrar('vacio-filtro');
        const proximas = ver === 'proximas';
        this.querySelector('[data-vacio]').textContent = T(proximas ? 'No tienes reservas próximas.' : 'Aún no hay reservas en tu historial.');
        const otro = this.querySelector('[data-otro]');
        otro.textContent = proximas ? 'Ver historial' : 'Ver próximas';
        otro.href = proximas ? `${RUTA().lista}?ver=historial` : RUTA().lista;
        return this.querySelector('[data-vacio]').textContent;
      }
      this.mostrar('datos');
      const plantilla = this.querySelector('template[data-fila]');
      this.filas = mias.map((r) => {
        const raiz = plantilla.content.cloneNode(true).firstElementChild;
        raiz.querySelector('[data-folio]').textContent = r.folio;
        raiz.querySelector('[data-servicio]').textContent = ASES ? nombreProf(r.profesional) : nombre(r.servicio);
        raiz.querySelector('[data-fecha]').textContent = fecha(r);
        raiz.querySelector('[data-horario]').textContent = `${horario(r)} · ${duracion(r)}`;
        if (ASES) raiz.querySelector('[data-modalidad]').textContent = MODALIDADES[r.modalidad] ?? r.modalidad ?? '';
        else raiz.querySelector('[data-total-fila]').textContent = soles(r.precio.total);
        raiz.querySelector('[data-objeto]').textContent = ` ${r.folio}`;
        raiz.querySelector('[data-accion]').href = `${RUTA().detalle}?id=${encodeURIComponent(r.id)}`;
        const fila = { raiz, r, umbral: umbral(resto(r) ?? Infinity) };
        this.pintarFila(fila);
        return fila;
      });
      this.querySelector('tbody').replaceChildren(...this.filas.map((f) => f.raiz));
      const n = mias.length;
      this.querySelector('[data-total]').textContent = T(`${n} ${n === 1 ? 'reserva' : 'reservas'}`);
      clearInterval(this.temporizador);
      this.temporizador = setInterval(() => this.tic(), MINUTO);
      const tipo = ver === 'proximas' ? ['próxima', 'próximas'] : ['en el historial', 'en el historial'];
      return T(`${n} ${n === 1 ? 'reserva' : 'reservas'} ${tipo[n === 1 ? 0 : 1]}`);
    }

    pintarFila({ raiz, r }) {
      poner(raiz.querySelector('td[data-etiqueta="Estado"] .etiqueta'), estadoDe(r));
      oculto(raiz.querySelector('[data-motivo]'), motivo(r));
      if (ASES) {
        const ms = resto(r);
        oculto(raiz.querySelector('[data-plazo]'), ms !== null && ms > 0 ? `Paga antes del ${absoluta(r.vence_pago)} · ${faltan(ms)}` : null);
        raiz.querySelector('[data-por-confirmar]').hidden = !(r.encuentro_pendiente && ['pre_reservada', 'confirmada'].includes(r.estado));
        return;
      }
      const [texto, plazo] = pagoDe(r, resto(r));
      raiz.querySelector('[data-limite]').textContent = texto;
      oculto(raiz.querySelector('[data-plazo]'), plazo);
    }

    // Cada minuto: recalcula sin anunciar; anuncia solo al cruzar 1 h, 15 min o el vencimiento.
    tic() {
      const avisos = [];
      for (const f of this.filas) {
        this.pintarFila(f);
        const u = umbral(resto(f.r) ?? Infinity);
        if (u < f.umbral) avisos.push(T(anuncios[u](f.r.folio)));
        f.umbral = u;
      }
      if (avisos.length) this.querySelector('[data-anuncio]').textContent = avisos.join(' ');
    }

    // --- Detalle ---

    async detalle() {
      if (!UUID.test(new URLSearchParams(location.search).get('id') ?? '')) return this.mostrar('no-encontrada');
      const id = new URLSearchParams(location.search).get('id');
      let r, yo;
      try {
        [r, yo] = await Promise.all([leer(id), obtenerPerfil().catch(() => null)]);
      } catch (error) {
        if (error.estado !== 404) throw error;
        this.mostrar('no-encontrada');
        // Una asesoría ajena es 404 (CA-16): el profesional y el Administrador vuelven a su agenda.
        const quien = ASES ? await obtenerPerfil().catch(() => null) : null;
        if (quien && quien.rol !== 'cliente') Object.assign(this.querySelector('[data-salida] .aviso-accion'), { textContent: 'Volver a asesorías', href: '/app/asesorias/agenda' });
        return null;
      }
      this.rol = yo?.rol ?? null;
      // La explicación de "Reprogramar" sale de la vista previa; si falla, se ofrece el botón y decide la API.
      // No bloquea el detalle: "Reprogramar" aparece cuando llega (undefined = pendiente) o falla (null).
      this.vistaCancel = null;
      if (this.rol === 'cliente' && (r.estado === 'confirmada' || (ASES && r.estado === 'pre_reservada')) && Date.parse(r.inicio) > Date.now()) {
        this.vistaCancel = undefined;
        this.pedirVistaCancel(id);
      }
      this.abierto = null;
      this.mostrar('datos');
      this.pintar(validar(r));
      const cita = `${fecha(r)}, ${horario(r)}`;
      const gestion = ASES && this.rol !== 'cliente';
      this.encabezado(gestion ? (this.admin ? `${persona(r.cliente)} con ${nombreProf(r.profesional)} · ${cita}` : `Con ${persona(r.cliente)} · ${cita}`) : ASES ? `Con ${nombreProf(r.profesional)} · ${cita}` : `${nombre(r.servicio)} · ${cita}`, r.folio);
      if (gestion) this.encabezadoGestion();
      // El folio no se parte en dos lineas.
      document.querySelector('.encabezado-titulo').replaceChildren(T('Reserva '), folioTitulo(r.folio));
      if (this.rol && this.rol !== 'cliente' && !ASES) {
        const enlace = document.querySelector('.encabezado-ruta a[href="/app/reservas/"]');
        if (enlace) Object.assign(enlace, { textContent: 'Agenda', href: '/app/agenda/' });
      }
      clearInterval(this.temporizador);
      this.temporizador = setInterval(() => this.ticDetalle(), MINUTO);
      this.abrirDeUrl();
      if (this.reprogramada) {
        const { credito } = this.reprogramada;
        this.reprogramada = null;
        // Sin la vista guardada no hay cifra que respalde: no se afirma crédito; se enlaza a Mis créditos.
        const texto = ASES ? `Te enviamos el correo con el nuevo horario para tu calendario.${positivo(credito) ? ` Tienes un pago de ${soles(credito)} pendiente.` : ''}` : `Te enviamos el correo con el nuevo horario para tu calendario.${credito === null ? ' Si quedó saldo a tu favor, lo verás en Mis créditos.' : positivo(credito) ? ` ${soles(credito)} pasaron a crédito.` : ''}`;
        enfocarAviso(mostrarAviso(this, 'exito', `Reserva reprogramada al ${absoluta(r.inicio)}`, texto, credito === null && !ASES ? { enlaces: [{ texto: 'Ver mis créditos', href: '/app/reservas/creditos' }] } : undefined));
      }
      return `Reserva ${r.folio}, ${estadoDe(r)[0].toLowerCase()}`;
    }

    // Profesional y Administrador: su ruta pasa por la agenda y el índice es el de esa pantalla.
    encabezadoGestion() {
      document.querySelector('.encabezado-indice').textContent = this.admin ? '[A15] ASESORÍAS / AGENDA' : '[E3] ASESORÍAS / AGENDA';
      const segundo = document.querySelector('.encabezado-ruta li:nth-child(2)');
      if (!segundo) return;
      if (this.admin) {
        segundo.querySelector('a').href = '/app/asesorias/';
        const agendadas = document.createElement('li');
        agendadas.append(Object.assign(document.createElement('a'), { href: '/app/asesorias/agenda', textContent: 'Agendadas' }));
        segundo.after(agendadas);
      } else segundo.querySelector('a').href = '/app/asesorias/agenda';
    }

    // ?accion=inasistencia (desde la agenda) abre su panel solo si el botón está habilitado; si no, se ignora y queda la ayuda.
    abrirDeUrl() {
      const url = new URL(location.href);
      if (!url.searchParams.has('accion')) return;
      const accion = url.searchParams.get('accion');
      url.searchParams.delete('accion');
      history.replaceState(null, '', url);
      const boton = this.querySelector('[data-abrir="inasistencia"]');
      if (accion === 'inasistencia' && boton && !boton.closest('[data-boton]').hidden && boton.getAttribute('aria-disabled') !== 'true') this.abrir('inasistencia', boton);
      const lugar = this.querySelector('[data-abrir="lugar"]');
      if (accion === 'lugar' && lugar && !lugar.closest('[data-boton]').hidden) this.abrir('lugar', lugar);
    }

    llenarCuotas(r) {
      const molde = this.querySelector('template[data-fila-cuota]');
      this.querySelector('[data-cuotas] tbody').replaceChildren(
        ...(r.cuotas ?? []).map((c) => {
          const fila = molde.content.cloneNode(true).firstElementChild;
          fila.querySelector('[data-concepto]').textContent = ASES ? textoCuotaAsesoria(c, totalDe(r)) : textoCuota(c, r.precio.total);
          fila.querySelector('[data-importe]').textContent = soles(c.monto);
          poner(fila.querySelector('.etiqueta'), CUOTAS[c.estado] ?? [String(c.estado).replace(/_/g, ' ').replace(/^./, (x) => x.toUpperCase()), 'neutra']);
          const rechazo = ultimoRechazo(c);
          oculto(fila.querySelector('[data-rechazo]'), rechazo && `Pago rechazado el ${diaMes(fechaDe(rechazo.registrado_en))}: ${rechazo.motivo_rechazo}`);
          // Anulada: por qué; pendiente con algo aplicado (crédito o captura): cuánto falta, en texto.
          const pagado = Math.round(Number(c.pagado ?? 0) * 100);
          const total = Math.round(Number(c.monto) * 100);
          oculto(
            fila.querySelector('[data-sub]'),
            c.estado === 'anulada' ? (r.estado === 'no_asistio' ? 'Se anuló por la inasistencia.' : 'Se anuló al cancelar.')
            : c.estado === 'pendiente' && pagado > 0 && pagado < total ? `Pagado ${soles(c.pagado)} · falta ${soles(((total - pagado) / 100).toFixed(2))}`
            : ASES && c.hito === 'al_terminar' && c.estado === 'pendiente' ? 'Págala hasta 48 h después de tu asesoría.'
            : null,
          );
          return fila;
        }),
      );
    }

    pintar(r) {
      this.reserva = r;
      // Lo que no viene quita su fila (y a la segunda pintada, tras cancelar, ya no esta).
      const campo = (c, v) => {
        const dd = this.querySelector(`[data-campo="${c}"]`);
        if (v) dd.textContent = v;
        else dd?.closest('[data-fila]')?.remove();
      };
      campo('horario', `${fecha(r)}, ${horario(r)}`);
      campo('duracion', duracion(r));
      campo('servicio', ASES ? nombreProf(r.profesional) : nombre(r.servicio));
      campo('sala', !ASES && nombre(r.sala));
      campo('especialistas', !ASES && (r.especialistas ?? []).map(nombre).join(', '));
      campo('cliente', r.cliente && !ASES && nombre(r.cliente));
      if (ASES) {
        this.pintarCliente(r);
        const prof = this.rol === 'profesional'; // CA-08: no ve pagos ni montos ni condiciones
        this.querySelector('[data-d2]').hidden = prof;
        this.querySelector('[data-d3]').hidden = prof;
        const virtual = r.modalidad === 'virtual';
        const dato = virtual ? r.enlace : r.lugar;
        campo('modalidad', MODALIDADES[r.modalidad] ?? r.modalidad);
        campo('encuentro', dato || (['pre_reservada', 'confirmada'].includes(r.estado) ? 'Por confirmar' : null));
        const etiquetaEncuentro = this.querySelector('[data-etiqueta-encuentro]');
        if (etiquetaEncuentro) etiquetaEncuentro.textContent = virtual ? 'Enlace' : 'Lugar';
        campo('condiciones', !prof && r.version_condiciones && `versión ${r.version_condiciones}`);
        const dd = this.querySelector('[data-campo="condiciones"]');
        if (dd && !prof && r.version_condiciones) dd.replaceChildren(Object.assign(document.createElement('a'), { className: 'reservas-enlace', href: enlaceTexto('condiciones_contratacion', r.version_condiciones), textContent: `versión ${r.version_condiciones}` }));
        pintarPartidasAsesoria(this.querySelector('[data-precio] .tabla'), `Asesoría de ${duracionTexto(r.duracion ?? Math.round((Date.parse(r.fin) - Date.parse(r.inicio)) / MINUTO))} con ${nombreProf(r.profesional)}`, totalDe(r), r.precio?.impuesto);
      } else pintarPartidas(this.querySelector('[data-precio] .tabla'), r.precio, r.parametros_aplicados?.porcentaje_adelanto);
      this.llenarCuotas(r);
      this.pintarCancelacion(r);
      this.pintarReprogramaciones(r);
      for (const [panel, texto] of Object.entries(TITULOS)) this.querySelector(`[data-panel="${panel}"] .panel-titulo`)?.replaceChildren(T(texto), folioTitulo(r.folio));
      this.pintarEstado();
    }

    // D0: los datos de contacto del cliente, para su profesional y el Administrador (CA-16).
    pintarCliente(r) {
      const d0 = this.querySelector('[data-d0]');
      d0.hidden = !(r.cliente && this.rol !== 'cliente');
      if (d0.hidden) return;
      const c = r.cliente;
      const quien = nombre(c);
      this.querySelector('[data-d0="nombre"]').replaceChildren(c.nombre_artistico || quien, ...(c.nombre_artistico && quien ? [Object.assign(document.createElement('span'), { className: 'gestion-motivo', textContent: quien })] : []));
      for (const [clave, valor, esquema] of [['telefono', c.telefono, 'tel:'], ['correo', c.correo, 'mailto:']]) {
        const enlace = this.querySelector(`[data-d0="${clave}"]`);
        enlace.closest('[data-fila]').hidden = !valor;
        if (valor) Object.assign(enlace, { textContent: valor, href: `${esquema}${valor.replace(/\s+/g, '')}` });
      }
    }

    // D4: lo que se aplicó al cancelar.
    pintarCancelacion(r) {
      const c = r.cancelacion;
      const bloque = this.querySelector('[data-d4]');
      bloque.hidden = !c;
      if (!c) return;
      const dueno = this.rol === 'cliente';
      const d4 = (clave, texto) => (this.querySelector(`[data-d4="${clave}"]`).textContent = texto);
      d4('aviso', absoluta(c.aviso_en));
      d4('por', c.por === 'estudio' ? 'Del estudio' : c.por === 'inasistencia' ? 'Inasistencia' : dueno ? 'Tuyo' : 'Del cliente');
      // El profesional ve solo el aviso y a pedido de quién: sin montos ni nota (CA-08).
      const solo = ASES && this.rol === 'profesional';
      bloque.querySelectorAll('dl > div:nth-child(n+3)').forEach((f) => (f.hidden = solo));
      if (solo) return;
      oculto(this.querySelector('[data-d4="registrada"]'), c.registrada_por?.nombre);
      this.querySelector('[data-d4="registrada"]').closest('div').hidden = !c.registrada_por?.nombre;
      d4('nivel', nivelTexto(c.nivel, r.politica).replace(/^Sin pagos: cancelas gratis\.$/, 'Sin pagos'));
      d4('pagado', soles(c.pagado));
      d4('retenido', soles(c.retenido));
      d4('credito', positivo(c.credito) ? soles(c.credito) : 'Nada');
      this.querySelector('[data-d4-creditos]').hidden = !(dueno && positivo(c.credito));
      const nota = this.querySelector('[data-d4="nota"]');
      oculto(nota, c.nota);
      nota.closest('div').hidden = !c.nota;
      const ex = this.querySelector('[data-d4="excepcion"]');
      oculto(ex, c.excepcion && `Tratada como nivel 1 el ${diaMes(fechaDe(c.excepcion.en))}: ${c.excepcion.motivo}`);
      ex.closest('div').hidden = !c.excepcion;
    }

    // D5: historial de reprogramaciones, la más reciente arriba.
    pintarReprogramaciones(r) {
      const lista = [...(r.reprogramaciones ?? [])].sort((a, b) => Date.parse(b.en) - Date.parse(a.en));
      this.querySelector('[data-d5]').hidden = !lista.length;
      const molde = this.querySelector('template[data-fila-reprog]');
      const dia = (iso) => `${diaMesAnio(fechaDe(iso))}, ${horaDe(iso)}`;
      this.querySelector('[data-d5] tbody').replaceChildren(
        ...lista.map((x) => {
          const fila = molde.content.cloneNode(true).firstElementChild;
          fila.querySelector('[data-en]').textContent = absoluta(x.en);
          fila.querySelector('[data-antes]').textContent = dia(x.anterior_inicio);
          fila.querySelector('[data-ahora]').textContent = dia(x.nuevo_inicio);
          fila.querySelector('[data-nivel-r]').textContent = x.nivel ? `Nivel ${x.nivel}` : 'Sin costo';
          fila.querySelector('[data-penalizacion]').textContent = soles(x.penalizacion);
          fila.querySelector('[data-total-r]')?.replaceChildren(`${soles(x.total_anterior)} → ${soles(x.total_nuevo)}`);
          return fila;
        }),
      );
      // El profesional ve fecha, antes y ahora; no el nivel ni la penalización.
      if (ASES && this.rol === 'profesional') this.querySelectorAll('[data-d5] :is(th, td):nth-child(n+4)').forEach((c) => c.remove());
    }

    // Lo que dice la barra de estado de una reserva cancelada o con inasistencia.
    datoTerminal(r) {
      const c = r.cancelacion;
      const dueno = this.rol === 'cliente';
      const t = tolerancia(r);
      if (r.estado === 'no_asistio') {
        return `${dueno ? 'No llegaste' : 'No llegó'}${t === null ? ' a la sesión' : ` en los primeros ${t} minutos`}. Se retuvo lo pagado (${soles(r.pagado ?? c?.pagado ?? '0.00')}); no hay crédito ni cobro adicional.`;
      }
      if (!c) return '';
      if (positivo(c.credito)) return `${soles(c.credito)} pasaron a crédito${dueno ? (ASES ? '. Úsalo en otra reserva o asesoría, sin devolución.' : '. Úsalo en otra reserva.') : ' del cliente.'}`;
      if (positivo(c.retenido)) return `Se retuvo lo pagado (${soles(c.retenido)}), como indican las condiciones.`;
      return '';
    }

    // Estado, barra de lo que toca y acciones segun el estado actual (y el plazo, que corre).
    pintarEstado() {
      const r = this.reserva;
      const ms = resto(r);
      const cuotas = r.cuotas ?? [];
      const resta = cuotas.find((c) => c.hito === 'al_terminar');
      const restoTexto = { en_validacion: 'Pago del resto en validación', pagada: 'Pagada' }[resta?.estado];
      poner(this.querySelector('dl .etiqueta'), estadoDe(r));
      this.querySelector('[data-pago-validar]').hidden = !porValidar(r);
      let tono = 'neutro', texto = estadoDe(r)[0], dato = '';
      const propio = ASES ? this.estadoAsesoria(r, ms) : null;
      if (propio) [tono, texto, dato] = propio;
      else if (r.estado === 'pre_reservada' && r.pago_por_validar) [tono, texto, dato] = ['pendiente', 'Pago en validación', 'Registraste tu pago. No caduca mientras el estudio lo revise; te avisaremos por correo.'];
      else if (ms > 0) [tono, texto, dato] = ['pendiente', `Paga el anticipo antes del ${absoluta(r.vence_pago)}`, faltan(ms)];
      else if (caducada(r)) tono = 'problema';
      else if (r.estado === 'no_asistio') [tono, dato] = ['problema', this.datoTerminal(r)];
      else if (this.eleccionPendiente(r)) [tono, texto] = ['pendiente', this.rol === 'cliente' ? 'El estudio canceló tu sesión · elige qué hacer' : 'El estudio canceló la sesión · elige por el cliente'];
      else if (r.estado === 'cancelada' && r.eleccion_estudio === 'devolucion') [texto, dato] = ['Cancelada por el estudio · devolución íntegra', this.textoDevolucion(r)];
      else if (r.estado === 'cancelada') dato = this.datoTerminal(r);
      else if (r.estado === 'confirmada') [tono, dato] = ['correcto', restoTexto ?? 'Pagas el resto al terminar la sesión.'];
      else if (r.estado === 'en_curso') dato = restoTexto ?? 'Pagas el resto al terminar.';
      else if (r.estado === 'finalizada') {
        if (resta?.estado === 'pagada') [tono, dato] = ['correcto', 'Pagada'];
        else if (resta?.estado === 'en_validacion') [tono, texto] = ['pendiente', 'Pago del resto en validación'];
        else if (resta) [tono, texto] = ['pendiente', `Falta pagar el resto: ${soles(resta.monto)}`];
        else tono = 'correcto';
      }
      const barra = this.querySelector('[data-estado-reserva] .indicador');
      barra.className = barra.className.replace(/indicador-(correcto|pendiente|problema|neutro)/, `indicador-${tono}`);
      barra.querySelector('.indicador-texto').textContent = texto;
      oculto(barra.querySelector('.indicador-dato'), dato);
      oculto(this.querySelector('[data-nota]'), motivo(r));
      const notaEstudio = this.eleccionPendiente(r) ? r.cancelacion?.nota ?? r.nota_cancelacion : !r.cancelacion && r.nota_cancelacion;
      oculto(this.querySelector('[data-nota-estudio]'), notaEstudio && `Nota del estudio: ${notaEstudio}`);
      const menos = this.querySelector('[data-menos-hora]');
      menos.hidden = !(ms > 0 && ms < 60 * MINUTO);
      if (!menos.hidden && !menos.dataset.listo) {
        menos.dataset.listo = '1';
        llenarAviso(menos.querySelector('.aviso'), `Tu reserva vence en ${Math.floor(ms / MINUTO)} min`, 'Si no registras el pago, se cancelará y el horario se liberará.');
      }
      // Registrar pago (solo el dueño): primario si la cuota toca ya; secundario si adelanta el resto.
      const pagable = this.rol === 'cliente' && !caducada(r) ? cuotas.find((c) => c.pagable) : null;
      const bloquePago = this.querySelector('[data-pagar]');
      bloquePago.hidden = !pagable;
      if (pagable) {
        const toca = ASES || pagable.hito === 'al_reservar' || r.estado === 'finalizada';
        const enlace = bloquePago.querySelector('a');
        enlace.href = `${RUTA().pagar}?id=${encodeURIComponent(r.id)}&cuota=${encodeURIComponent(pagable.id)}`;
        enlace.firstChild.textContent = toca ? 'Registrar pago' : 'Adelantar el pago del resto';
        enlace.className = enlace.className.replace(/boton-(primario|secundario)/, toca ? 'boton-primario' : 'boton-secundario');
      }
      this.pintarEncuentro(r);
      this.pintarAcciones();
    }

    // Asesoria: lo que el estado dice y lo que toca (spec RF-15-mis-asesorias, Estados); null deja el resto de los estados a RF-18.
    estadoAsesoria(r, ms) {
      const t = tolerancia(r);
      // Profesional y Administrador: lo mismo, dicho desde el estudio.
      if (this.rol !== 'cliente') {
        if (r.estado === 'pre_reservada') return porValidar(r) ? ['pendiente', 'Pago en validación', 'El cliente registró su pago; el estudio lo revisa y la cita no caduca mientras tanto.'] : ms > 0 ? ['pendiente', 'Pendiente de pago', `El cliente paga antes del ${absoluta(r.vence_pago)} · ${faltan(ms)}`] : null;
        if (r.estado === 'confirmada') return Date.parse(r.fin) < Date.now() ? ['pendiente', 'Por cerrar', 'Marca si se realizó o si el cliente no asistió.'] : ['correcto', 'Confirmada', `Cita el ${diaMes(fechaDe(r.inicio))}, a las ${horaDe(r.inicio)}.`];
        if (r.estado === 'realizada') return ['correcto', 'Realizada', ''];
        if (r.estado === 'no_asistio') return ['problema', 'No asistió', 'El cliente no asistió.'];
        return null;
      }
      if (r.estado === 'pre_reservada' && porValidar(r)) return ['pendiente', 'Pago en validación', 'Registraste tu pago. No caduca mientras el estudio lo revise; te avisaremos por correo.'];
      if (r.estado === 'pre_reservada' && ms > 0) return ['pendiente', `Paga antes del ${absoluta(r.vence_pago)}`, faltan(ms)];
      if (r.estado === 'confirmada') return Date.parse(r.fin) < Date.now() ? ['neutro', 'Terminó', `${nombreProf(r.profesional)} confirmará tu asistencia y te enviaremos la constancia por correo.`] : ['correcto', 'Confirmada', `Te esperamos el ${diaMes(fechaDe(r.inicio))}, a las ${horaDe(r.inicio)}.`];
      if (r.estado === 'realizada') return ['correcto', 'Realizada', r.constancia_disponible === false ? '' : 'Tu constancia de asistencia está lista.'];
      if (r.estado === 'no_asistio') return ['problema', 'No asistió', `No llegaste${t === null ? '' : ` en los primeros ${t} minutos`}. Lo pagado no se devuelve.${positivo(r.cancelacion?.credito) ? ` ${soles(r.cancelacion.credito)} pasaron a crédito, sin devolución.` : ''}`];
      return null;
    }

    // Asesoria: videollamada y quién confirma el lugar o el enlace.
    pintarEncuentro(r) {
      const videollamada = this.querySelector('[data-videollamada]');
      const nota = this.querySelector('[data-lugar-nota]');
      if (!ASES) return;
      const virtual = r.modalidad === 'virtual';
      const dato = virtual ? r.enlace : r.lugar;
      const entra = r.estado === 'confirmada' && virtual && r.enlace && Date.parse(r.fin) > Date.now();
      videollamada.hidden = !entra;
      if (entra) {
        const a = videollamada.querySelector('a');
        a.href = r.enlace;
        const conPago = !this.querySelector('[data-pagar]').hidden;
        a.className = a.className.replace(/boton-(primario|secundario)/, conPago ? 'boton-secundario' : 'boton-primario');
      }
      const vivo = ['pre_reservada', 'confirmada'].includes(r.estado) && !caducada(r);
      nota.hidden = !(vivo && this.rol === 'cliente');
      if (nota.hidden) return;
      const quien = nombreProf(r.profesional);
      const que = virtual ? 'el enlace' : 'el lugar';
      this.querySelector('[data-lugar-texto]').textContent = dato ? `¿Necesitas cambiarlo? Escríbenos y lo coordinamos con ${quien}:` : `${quien} y el estudio te confirmarán ${que} antes de la cita. Te avisaremos por correo.`;
      const linea = this.querySelector('[data-contacto-estudio]');
      linea.hidden = true;
      if (!dato) return;
      this.contacto ??= obtenerContacto().then((c) => c?.texto ?? null, () => null);
      this.contacto.then((texto) => {
        if (nota.hidden || !texto) return;
        linea.textContent = texto;
        linea.hidden = false;
      });
    }

    // Cancelada por el estudio, con la elección del cliente por hacer: la hace el dueño o el Administrador por él.
    eleccionPendiente(r) {
      return r.estado === 'cancelada' && r.eleccion_estudio === 'pendiente' && (this.rol === 'cliente' || this.rol === 'administrador');
    }

    // Estado de la devolución íntegra que eligió el cliente (`Reserva.devolucion`, con su límite de 7 días hábiles).
    textoDevolucion(r) {
      const d = r.devolucion;
      const dueno = this.rol === 'cliente';
      const monto = soles(d?.monto_aprobado ?? d?.monto_solicitado ?? r.pagado ?? '0.00');
      if (d?.estado === 'realizada') return `${dueno ? 'Te devolvimos' : 'Se devolvieron'} ${monto}${d.realizada_en ? ` el ${absoluta(d.realizada_en)}` : ''}.`;
      return `${dueno ? 'Te devolvemos' : 'Se devuelven al cliente'} ${monto} en un máximo de 7 días hábiles${d?.limite ? `, a más tardar el ${diaMesAnio(fechaDe(d.limite))}` : ''}. ${dueno ? 'Te avisaremos por correo cuando esté hecha.' : 'Se marca como realizada desde Devoluciones.'}`;
    }

    // Quién ve qué acción (spec RF-18-cancelar y RF-18-acciones-administrador). Se recalcula cada minuto: la ventana de la inasistencia corre.
    pintarAcciones() {
      const r = this.reserva;
      const admin = this.rol === 'administrador';
      const staff = admin || this.rol === 'personal';
      const ahora = Date.now();
      const inicio = Date.parse(r.inicio);
      const vivo = !caducada(r);
      const c = r.cancelacion;
      // Inasistencia: desde el inicio hasta el fin; habilitada pasada la tolerancia.
      const t = tolerancia(r);
      const habil = inicio + (t ?? 0) * MINUTO;
      const enVentana = !ASES && staff && vivo && ['pre_reservada', 'confirmada', 'en_curso'].includes(r.estado) && ahora >= inicio && ahora < Date.parse(r.fin);
      const esperar = enVentana && ahora < habil;
      const boton = this.querySelector('[data-abrir="inasistencia"]');
      const ayuda = this.querySelector('[data-ayuda-na]');
      const hora = horaDe(new Date(habil).toISOString());
      boton.toggleAttribute('aria-disabled', esperar);
      if (esperar) boton.setAttribute('aria-disabled', 'true');
      oculto(ayuda, esperar || this.avisoNa ? (this.avisoNa ? `Aún no pasaron ${t} minutos desde el inicio. Podrás marcarlo desde las ${hora}.` : `Podrás marcarlo desde las ${hora}, ${t} minutos después del inicio.`) : null);
      if (ayuda.hidden) boton.removeAttribute('aria-describedby');
      else boton.setAttribute('aria-describedby', ayuda.id);
      this.alternar('inasistencia', enVentana);
      // Tratar como nivel 1: solo el Administrador, una vez por reserva.
      const excepcion = admin && ((r.estado === 'cancelada' && c?.por === 'cliente' && [2, 3].includes(c.nivel) && positivo(c.retenido) && !c.excepcion) || (r.estado === 'no_asistio' && c?.por === 'inasistencia' && positivo(c.retenido) && !c.excepcion));
      this.alternar('excepcion', excepcion);
      // Cancelar: el dueño la solicita; el Administrador la hace por el estudio o a pedido del cliente. Solo antes del inicio.
      // Asesoría: el Administrador también cancela por el estudio tras el inicio, mientras no esté cerrada (CA-11).
      const cancelable = vivo && ['pre_reservada', 'confirmada'].includes(r.estado) && (inicio > ahora || (ASES && admin)) && (this.rol === 'cliente' || admin);
      this.querySelector('[data-abrir="cancelar"]').textContent = admin ? T('Cancelar reserva') : 'Solicitar cancelación';
      if (ASES) this.pintarLugar(r, ahora, vivo);
      this.alternar('cancelar', cancelable);
      // Elección tras la cancelación del estudio.
      const pendiente = this.eleccionPendiente(r);
      this.alternar('devolucion', pendiente);
      if (pendiente) {
        const dueno = this.rol === 'cliente';
        this.querySelector('[data-sin-costo]').href = `${RUTA().reprogramar}?id=${encodeURIComponent(r.id)}`;
        this.querySelector('[data-texto-sin-costo]').textContent = `Eliges otro horario libre ${ASES ? `de ${nombreProf(r.profesional)}` : 'de la misma sala'}. ${dueno ? 'Mantienes el precio y lo que pagaste.' : 'El cliente mantiene el precio y lo que pagó.'}`;
        if (ASES) this.querySelector('[data-boton="devolucion"] .gestion-ayuda').textContent = 'Mientras no elijas, nada vence. ¿Prefieres a otro profesional? Pide la devolución íntegra y agenda una asesoría nueva.';
        this.querySelector('[data-texto-devolucion]').textContent = `${dueno ? 'Te devolvemos' : 'Se devuelven al cliente'} ${soles(r.pagado ?? '0.00')} por el mismo medio, en un máximo de 7 días hábiles.`;
      }
      this.pintarReprogramar(r, ahora, inicio, vivo);
    }

    // "Reprogramar" del dueño de una confirmada con inicio futuro: botón con su ayuda, o por qué no.
    pintarReprogramar(r, ahora, inicio, vivo) {
      const bloque = this.querySelector('[data-reprogramar]');
      const nota = this.querySelector('[data-no-reprogramar]');
      bloque.hidden = true;
      oculto(nota, null);
      if (this.rol !== 'cliente' || !vivo || inicio <= ahora) return;
      if (r.estado === 'pre_reservada' && !ASES) return oculto(nota, 'Podrás reprogramarla cuando esté confirmada.');
      if (!(r.estado === 'confirmada' || (ASES && r.estado === 'pre_reservada')) || this.vistaCancel === undefined) return;
      const { puede, ayuda } = entradaReprogramar(this.vistaCancel, r.politica, ASES);
      if (puede) {
        bloque.hidden = false;
        bloque.querySelector('a').href = `${RUTA().reprogramar}?id=${encodeURIComponent(r.id)}`;
        const texto = this.querySelector('[data-ayuda-reprogramar]');
        oculto(texto, ayuda);
        const boton = bloque.querySelector('a');
        if (ayuda) boton.setAttribute('aria-describedby', texto.id);
        else boton.removeAttribute('aria-describedby');
      } else oculto(nota, ayuda);
    }

    // Muestra el botón de la acción (si aplica y su panel no está abierto) o su panel (si está abierto); si la acción ya no aplica, cierra su panel.
    alternar(nombre, aplica) {
      if (!aplica && this.abierto === nombre) this.abierto = null;
      this.querySelector(`[data-boton="${nombre}"]`).hidden = !aplica || this.abierto === nombre;
      this.querySelector(`[data-panel="${nombre}"]`).hidden = !(aplica && this.abierto === nombre);
    }

    // Pide la vista previa de cancelación; de ella salen la ayuda y la visibilidad de "Reprogramar".
    pedirVistaCancel(id) {
      this.vistaDesde = Date.now();
      verCancelacion(id).catch(() => null).then((v) => {
        if (this.reserva?.id !== id) return;
        this.vistaCancel = v;
        this.pintarAcciones();
      });
    }

    // Con la página abierta, cruzar un plazo de nivel (inicio menos horas_nivel_1 / horas_nivel_2) cambia lo que dice esa vista.
    cruzoPlazo(r) {
      const { horas_nivel_1: h1, horas_nivel_2: h2 } = r.politica ?? {};
      const ahora = Date.now();
      return [h1, h2].some((h) => {
        const limite = Date.parse(r.inicio) - Number(h) * 36e5;
        return Number.isFinite(limite) && this.vistaDesde < limite && limite <= ahora;
      });
    }

    ticDetalle() {
      if (!this.reserva || !this.querySelector('[data-estado-reserva]')) return;
      if (this.vistaCancel !== null && this.vistaCancel !== undefined && this.cruzoPlazo(this.reserva)) this.pedirVistaCancel(this.reserva.id);
      const vencia = !caducada(this.reserva);
      this.pintarEstado();
      if (vencia && caducada(this.reserva)) this.querySelector('[data-anuncio]').textContent = T(`La reserva ${this.reserva.folio} venció sin pago.`);
    }

    // --- Paneles de acción: confirmacion en la misma pantalla, con foco y Escape ---

    abrir(nombre, boton) {
      if (this.ocupado) return;
      if (boton?.getAttribute('aria-disabled') === 'true') {
        // Deshabilitado pero enfocable: explica por qué en lugar de abrir.
        this.avisoNa = true;
        this.pintarAcciones();
        this.querySelector('[data-anuncio]').textContent = this.querySelector('[data-ayuda-na]').textContent;
        return;
      }
      limpiarAvisos(this);
      this.abierto = nombre;
      this.pintarAcciones();
      const titulo = this.querySelector(`[data-panel="${nombre}"] .panel-titulo`);
      titulo.tabIndex = -1;
      titulo.focus();
      if (nombre === 'cancelar') this.prepararCancelar();
      else if (nombre === 'devolucion') this.prepararDevolucion();
      else if (nombre === 'inasistencia') this.prepararInasistencia();
      else if (nombre === 'lugar') this.prepararLugar();
      else this.prepararExcepcion();
    }

    cerrar() {
      if (this.ocupado) return;
      const nombre = this.abierto;
      this.abierto = null;
      this.pintarAcciones();
      this.querySelector(`[data-abrir="${nombre}"]`)?.focus();
    }

    // Aviso dentro del panel de cancelar (sobre su contenido); devuelve el nodo.
    avisoPanel(variante, titulo, texto, opciones) {
      const aviso = mostrarAviso(this, variante, titulo, texto, opciones);
      this.querySelector('[data-panel-aviso]').replaceChildren(aviso);
      return aviso;
    }

    // Tras una acción que cambia la reserva: se repinta con la respuesta y se avisa del resultado.
    despues(nueva, ...aviso) {
      this.abierto = null;
      limpiarAvisos(this);
      this.pintar(validar(nueva));
      enfocarAviso(mostrarAviso(this, 'exito', ...aviso));
    }

    // 409: la reserva cambió desde otra sesión; se vuelve a leer y se explica.
    async cambio(texto) {
      this.abierto = null;
      try {
        this.pintar(validar(await leer(this.reserva.id)));
      } catch {}
      enfocarAviso(mostrarAviso(this, 'informacion', typeof texto === 'function' ? texto(estadoDe(this.reserva)[0].toLowerCase()) : texto));
    }

    errorEnvio(error) {
      const accion = this.abierto;
      if (this.vista === 'reprogramar') return this.errorReprogramar(error, true);
      if (error.estado === 404) {
        this.sustituir('no-encontrada');
        return true;
      }
      if (accion === 'cancelar') return this.errorCancelar(error);
      if (accion === 'lugar') return this.errorLugar(error);
      if (accion === 'devolucion' && error.estado === 409) {
        this.cambio('Ya se eligió qué hacer con esta reserva, quizá desde otra sesión.');
        return true;
      }
      if (accion === 'inasistencia' && error.estado === 409) {
        if (error.codigo === 'tolerancia_no_cumplida') {
          this.abierto = null;
          this.avisoNa = true;
          this.pintarAcciones();
          this.querySelector('[data-abrir="inasistencia"]').focus();
        } else this.cambio((estado) => `Esta reserva ya no admite marcar la inasistencia: está ${estado}.`);
        return true;
      }
      if (accion === 'excepcion') {
        if (error.estado === 409) {
          this.cambio(error.codigo === 'excepcion_ya_aplicada' ? 'Esta reserva ya se trató como nivel 1, quizá desde otra sesión.' : 'Esta reserva no admite el caso excepcional.');
          return true;
        }
        if (error.estado === 422) {
          this.validar([{ entrada: this.querySelector('#excepcion-motivo'), mensaje: MOTIVO_EXCEPCION, texto: 'Motivo' }]);
          return true;
        }
      }
      return false;
    }

    // --- Lugar o enlace (CA-09): su profesional o el Administrador, antes del fin ---

    // El bloque del lateral, su aviso de "falta" (cita en menos de 48 h) y, para el profesional, a quién pedir la cancelación.
    pintarLugar(r, ahora, vivo) {
      const gestiona = this.rol === 'profesional' || this.admin;
      const vigente = vivo && ['pre_reservada', 'confirmada'].includes(r.estado);
      const abierta = vigente && Date.parse(r.fin) > ahora;
      this.alternar('lugar', gestiona && abierta);
      this.querySelector('[data-pide-admin]').hidden = !(this.rol === 'profesional' && vigente);
      const virtual = r.modalidad === 'virtual';
      const dato = virtual ? r.enlace : r.lugar;
      this.querySelector('[data-lugar-dt]').textContent = virtual ? 'Enlace' : 'Lugar';
      this.querySelector('[data-lugar-valor]').textContent = dato ?? '';
      this.querySelector('[data-lugar-pendiente]').hidden = Boolean(dato);
      this.querySelector('[data-abrir="lugar"]').textContent = `${dato ? 'Cambiar' : 'Registrar'} ${virtual ? 'enlace' : 'lugar'}`;
      const falta = this.querySelector('[data-lugar-falta]');
      falta.hidden = !(gestiona && abierta && !dato && Date.parse(r.inicio) - ahora < 48 * 36e5);
      if (!falta.hidden) llenarAviso(falta.querySelector('.aviso'), `Falta confirmar ${virtual ? 'el enlace' : 'el lugar'}`, 'El cliente lo espera antes de la cita.');
    }

    prepararLugar() {
      const r = this.reserva;
      this.querySelectorAll('[data-panel="lugar"] .campo-control').forEach(quitarError);
      this.querySelector('#lugar-lugar').value = r.lugar ?? '';
      this.querySelector('#lugar-enlace').value = r.enlace ?? '';
      this.querySelector(`#lugar-${r.modalidad === 'virtual' ? 'virtual' : 'presencial'}`).checked = true;
      this.cambiarModalidad();
      this.querySelector('[data-panel="lugar"] [data-consecuencia]').textContent = `Avisamos a ${persona(r.cliente)} y a ${nombreProf(r.profesional)} por correo, con el evento de calendario actualizado. Escribe solo lo que ya acordaron.`;
    }

    // El campo de la opción aparece justo después de su casilla; el foco se queda en la casilla.
    cambiarModalidad() {
      const modalidad = this.querySelector('input[name="modalidad"]:checked')?.value;
      this.querySelectorAll('[data-panel="lugar"] [data-campos]').forEach((x) => (x.hidden = x.dataset.campos !== modalidad));
    }

    lugar() {
      const r = this.reserva;
      const modalidad = this.querySelector('input[name="modalidad"]:checked')?.value;
      this.querySelectorAll('[data-panel="lugar"] [aria-invalid="true"]').forEach(quitarError);
      const campo = this.querySelector(modalidad === 'virtual' ? '#lugar-enlace' : '#lugar-lugar');
      const texto = modalidad ? campo.value.trim() : '';
      const errores = [];
      if (!modalidad) errores.push({ entrada: this.querySelector('#lugar-presencial'), mensaje: 'Elige si es presencial o virtual.', texto: 'Modalidad' });
      else if (modalidad === 'presencial' && texto.length > 300) errores.push({ entrada: campo, mensaje: 'Escribe el lugar, hasta 300 caracteres.', texto: 'Lugar' });
      else if (modalidad === 'virtual' && texto && !ENLACE_MEET.test(texto)) errores.push({ entrada: campo, mensaje: ENLACE_INVALIDO, texto: 'Enlace' });
      if (!this.validar(errores)) return;
      const cuerpo = { modalidad, [modalidad === 'virtual' ? 'enlace' : 'lugar']: texto || null };
      this.enviar(this.querySelector('[data-panel="lugar"] [type="submit"]'), 'Guardando…', () => actualizarEncuentro(r.id, cuerpo), (nueva) => this.despues(nueva, 'Guardado', `Avisamos a ${persona(r.cliente)} y a ${nombreProf(r.profesional)} por correo con el evento actualizado.`));
    }

    errorLugar(error) {
      if (error.estado === 409) {
        this.cambio((estado) => `Esta asesoría ya no admite cambios de lugar o enlace: está ${estado} o ya terminó.`);
        return true;
      }
      if (error.estado !== 422) return false;
      const virtual = this.querySelector('input[name="modalidad"]:checked')?.value === 'virtual';
      const entrada = this.querySelector(virtual ? '#lugar-enlace' : '#lugar-lugar') ?? this.querySelector('#lugar-presencial');
      this.validar([error.codigo === 'enlace_invalido' ? { entrada: this.querySelector('#lugar-enlace'), mensaje: ENLACE_INVALIDO, texto: 'Enlace' } : { entrada, mensaje: virtual ? ENLACE_INVALIDO : 'Escribe el lugar, hasta 300 caracteres.', texto: virtual ? 'Enlace' : 'Lugar' }]);
      return true;
    }

    // --- Cancelar ---

    get admin() {
      return this.rol === 'administrador';
    }

    prepararCancelar() {
      const r = this.reserva;
      this.querySelector('[data-resumen]').textContent = `${ASES ? nombreProf(r.profesional) : nombre(r.servicio)} · ${fecha(r)}, ${horario(r)}`;
      this.querySelector('[data-panel-aviso]').replaceChildren();
      this.previa = null;
      this.secuencia++;
      const parte = this.querySelector('[data-parte="admin"]');
      parte.hidden = !this.admin;
      const aviso = this.querySelector('[data-panel="cancelar"] [data-consecuencia]');
      this.querySelector('[data-confirmar-cancelar]').textContent = this.admin ? T(`Cancelar reserva ${r.folio}`) : 'Confirmar cancelación';
      if (this.admin) {
        this.querySelectorAll('[data-panel="cancelar"] input[name="por"]').forEach((x) => (x.checked = false));
        this.querySelectorAll('[data-panel="cancelar"] .campo-control').forEach((x) => { x.value = ''; quitarError(x); });
        this.querySelector('[data-previa]').hidden = true;
        this.querySelector('[data-confirmar-cancelar]').hidden = false;
        this.querySelectorAll('[data-campos]').forEach((x) => (x.hidden = true));
        aviso.textContent = '';
        this.querySelector('[data-condiciones]').closest('p').hidden = true;
        // "El cliente, por otro canal" solo antes del inicio: después, solo el estudio.
        this.querySelector('#cancelar-por-cliente').closest('.casilla').hidden = ASES && Date.parse(r.inicio) <= Date.now();
      } else {
        this.querySelector('[data-condiciones]').closest('p').hidden = false;
        this.pedirVista();
      }
    }

    // El cliente pide la vista previa al abrir; el Administrador, con el aviso_en de su mensaje.
    async pedirVista(avisoEn) {
      const n = ++this.secuencia;
      this.previa = null;
      this.querySelector('[data-panel-aviso]').replaceChildren();
      this.estadoVista('carga');
      let v;
      try {
        v = await verCancelacion(this.reserva.id, avisoEn);
      } catch (error) {
        if (n === this.secuencia) this.errorVista(error, avisoEn);
        return;
      }
      if (n !== this.secuencia) return;
      this.previa = v;
      this.estadoVista('datos');
      this.pintarVista(v);
    }

    estadoVista(estado) {
      this.querySelector('[data-previa]').hidden = estado === 'nada';
      const carga = this.querySelector('[data-previa-carga]');
      carga.hidden = estado !== 'carga';
      if (estado === 'carga') carga.setAttribute('aria-busy', 'true');
      else carga.removeAttribute('aria-busy');
      this.querySelector('[data-previa-datos]').hidden = estado !== 'datos';
      if (!this.admin) this.querySelector('[data-confirmar-cancelar]').hidden = estado !== 'datos';
      if (estado === 'carga') this.querySelector('[data-anuncio]').textContent = 'Calculando qué pasa con tu pago…';
    }

    pintarVista(v) {
      const p = this.reserva.politica;
      this.querySelector('[data-nivel]').textContent = nivelTexto(v.nivel, p);
      this.querySelector('[data-anticipacion]').textContent = anticipacionTexto(v.anticipacion_horas, this.admin ? 'la' : 'tu');
      const dl = this.querySelector('[data-dl]');
      dl.hidden = !v.nivel;
      dl.replaceChildren(
        ...filasVista(v).map(([etiqueta, valor]) => {
          const fila = document.createElement('div');
          fila.append(Object.assign(document.createElement('dt'), { textContent: etiqueta }), Object.assign(document.createElement('dd'), { textContent: valor }));
          return fila;
        }),
      );
      oculto(this.querySelector('[data-validacion]'), avisoValidacion(v.nivel, v.en_validacion));
      const enLugar = this.querySelector('[data-en-lugar]');
      enLugar.hidden = this.admin || !v.puede_reprogramar || !(this.reserva.estado === 'confirmada' || (ASES && this.reserva.estado === 'pre_reservada'));
      enLugar.querySelector('a').href = `${RUTA().reprogramar}?id=${encodeURIComponent(this.reserva.id)}`;
      if (!this.admin) this.querySelector('[data-panel="cancelar"] [data-consecuencia]').textContent = (ASES ? consecuenciaCancelarAsesoria : consecuenciaCancelar)(v.nivel, p);
      this.querySelector('[data-anuncio]').textContent = v.nivel ? `Vista previa lista: nivel ${v.nivel}, se retienen ${soles(v.retenido)}.` : 'Vista previa lista: sin pagos, cancelas gratis.';
    }

    errorVista(error, avisoEn) {
      if (error.estado === 401 || error.estado === 403) return this.sustituir(error.estado === 401 ? 'no-autenticado' : 'sin-permiso');
      if (error.estado === 404) return this.sustituir('no-encontrada');
      if (error.estado === 409) return this.cambio((estado) => `Esta reserva ya no se puede cancelar: está ${estado}.`);
      if (error.estado === 422 && this.admin) {
        this.estadoVista('nada');
        return this.validar([{ entrada: this.querySelector('#cancelar-fecha'), mensaje: AVISO_INVALIDO, texto: 'Fecha del aviso' }]);
      }
      this.estadoVista('nada');
      const aviso = this.avisoPanel('error', ...mensajeError(error), { boton: { texto: 'Reintentar', atributo: 'data-reintentar-previa' } });
      aviso.removeAttribute('role');
      this.querySelector('[data-anuncio]').textContent = aviso.textContent.replace(/\s+/g, ' ').trim();
      this.avisoReintento = avisoEn;
    }

    // Administrador: elegir quién pide cancelar muestra sus campos, sus consecuencias y, a pedido del cliente, la vista previa.
    cambiarOpcion() {
      const por = this.querySelector('input[name="por"]:checked')?.value;
      this.querySelectorAll('[data-campos]').forEach((x) => (x.hidden = x.dataset.campos !== por));
      const r = this.reserva;
      const pagos = this.conPagos();
      const nota = this.querySelector('label[for="cancelar-nota-estudio"]');
      nota.replaceChildren(pagos ? 'Nota para el cliente ' : 'Nota para el cliente', ...(pagos ? [Object.assign(document.createElement('span'), { textContent: '(obligatorio)' })] : []));
      this.querySelector('[data-condiciones]').closest('p').hidden = por !== 'cliente';
      this.querySelector('[data-panel="cancelar"] [data-consecuencia]').textContent =
        por === 'estudio'
          ? ASES ? (pagos ? `El horario se libera al momento. El cliente elegirá en la app entre reprogramar sin costo con ${nombreProf(r.profesional)} o la devolución íntegra de ${soles(r.pagado)}, que haces en un máximo de 7 días hábiles. Si prefiere a otro profesional, agenda una asesoría nueva. Avisamos al cliente y a ${nombreProf(r.profesional)} por correo.` : `El horario se libera al momento. Avisamos al cliente y a ${nombreProf(r.profesional)} por correo.`)
          : pagos ? `El horario se libera al momento. El cliente elegirá en la app entre reprogramar sin costo o la devolución íntegra de ${soles(r.pagado)}, que haces en un máximo de 7 días hábiles. Le avisamos por correo.` : 'El horario se libera al momento y avisamos al cliente por correo.'
          : 'Se aplica la misma política que si cancelara desde la app, con el nivel que corresponde a la fecha y hora de su mensaje. El horario se libera al momento y le avisamos por correo con el detalle.';
      this.secuencia++;
      this.querySelector('[data-panel-aviso]').replaceChildren();
      if (por === 'cliente') this.vistaDelAviso();
      else this.estadoVista('nada');
    }

    conPagos() {
      return positivo(this.reserva.pagado) || tienePagos(this.reserva);
    }

    // Vista previa con el aviso_en cuando fecha y hora están completas.
    vistaDelAviso() {
      const fecha = this.querySelector('#cancelar-fecha');
      const hora = this.querySelector('#cancelar-hora');
      quitarError(fecha);
      if (fecha.value && hora.value) this.pedirVista(instante(fecha.value, hora.value));
      else this.estadoVista('nada');
    }

    cancelar() {
      const r = this.reserva;
      const cuerpo = {};
      let opcion = null;
      if (this.admin) {
        const por = this.querySelector('input[name="por"]:checked')?.value;
        const errores = [];
        const nota = this.querySelector(por === 'estudio' ? '#cancelar-nota-estudio' : '#cancelar-nota-cliente');
        this.querySelectorAll('[data-panel="cancelar"] [aria-invalid="true"]').forEach(quitarError);
        if (!por) errores.push({ entrada: this.querySelector('#cancelar-por-estudio'), mensaje: 'Elige quién pide cancelar.', texto: '¿Quién pide cancelar?' });
        else {
          const texto = nota.value.trim();
          if (!texto && (por === 'cliente' || this.conPagos())) errores.push({ entrada: nota, mensaje: 'Escribe la nota para el cliente.', texto: 'Nota' });
          else if (texto.length > 300) errores.push({ entrada: nota, mensaje: 'La nota admite hasta 300 caracteres.', texto: 'Nota' });
          if (por === 'cliente') {
            const [fecha, hora] = [this.querySelector('#cancelar-fecha'), this.querySelector('#cancelar-hora')];
            if (!fecha.value || !hora.value) errores.unshift({ entrada: fecha, mensaje: 'Elige la fecha y la hora del aviso.', texto: 'Fecha del aviso' });
            else cuerpo.aviso_en = instante(fecha.value, hora.value);
          }
          Object.assign(cuerpo, { por }, texto && { nota: texto });
        }
        if (!this.validar(errores)) return;
        opcion = por;
      } else {
        // Nunca se confirma sin vista previa; con pagos va el nivel mostrado, para que un plazo cruzado no cambie lo que se acepta.
        if (!this.previa) return;
        if (this.previa.nivel) cuerpo.nivel_esperado = this.previa.nivel;
      }
      this.enviar(this.querySelector('[data-confirmar-cancelar]'), 'Cancelando…', () => cancelarReserva(r.id, cuerpo), (nueva) => this.cancelada(nueva, opcion));
    }

    // Resultado de cancelar, según quién la hizo.
    cancelada(nueva, opcion) {
      const c = nueva.cancelacion;
      if (this.admin) {
        if (ASES && opcion === 'estudio') return this.despues(nueva, 'Asesoría cancelada', `Avisamos al cliente${this.conPagos() ? ' para que elija' : ''} y a ${nombreProf(this.reserva.profesional)}.`);
        const aviso = opcion === 'cliente' ? [`Reserva cancelada a pedido del cliente (${c?.nivel ? `nivel ${c.nivel}` : 'sin pagos'}). Le avisamos con el detalle.`]
          : this.conPagos() ? ['Reserva cancelada', 'El horario quedó libre y avisamos al cliente para que elija entre reprogramar sin costo o la devolución íntegra.']
          : ['Reserva cancelada', 'El horario quedó libre y avisamos al cliente por correo.'];
        return this.despues(nueva, ...aviso);
      }
      const texto = !c?.nivel ? 'El horario quedó libre y no se te cobró nada.'
        : positivo(c.credito) ? `${soles(c.credito)} pasaron a crédito${this.previa?.credito_vence ? ` hasta el ${diaMesAnio(fechaDe(this.previa.credito_vence))}` : ''}. Te enviamos el detalle por correo.`
        : `Se retuvo lo pagado (${soles(c.retenido)}). Te enviamos el detalle por correo.`;
      this.despues(nueva, 'Reserva cancelada', texto);
    }

    errorCancelar(error) {
      if (error.estado === 409 && error.codigo === 'nivel_cambiado' && error.detalles) {
        // Se cruzó un plazo mientras leía: se repinta con la vista nueva y se pide confirmar otra vez.
        this.secuencia++;
        this.previa = error.detalles;
        this.estadoVista('datos');
        this.pintarVista(error.detalles);
        enfocarAviso(this.avisoPanel('aviso', `Mientras lo revisabas pasó un plazo: ahora es nivel ${error.detalles.nivel}`, 'Revisa qué pasa con tu pago y confirma de nuevo.'));
        return true;
      }
      if (error.estado === 409) {
        this.cambio((estado) => `Esta reserva ya no se puede cancelar: está ${estado}.`);
        return true;
      }
      if (error.estado === 422 && this.admin) {
        const por = this.querySelector('input[name="por"]:checked')?.value;
        const nota = this.querySelector(por === 'estudio' ? '#cancelar-nota-estudio' : '#cancelar-nota-cliente');
        const errores = error.codigo === 'aviso_invalido' ? [{ entrada: this.querySelector('#cancelar-fecha'), mensaje: AVISO_INVALIDO, texto: 'Fecha del aviso' }]
          : [{ entrada: nota, mensaje: error.codigo === 'nota_requerida' ? 'Escribe la nota para el cliente.' : 'La nota admite hasta 300 caracteres.', texto: 'Nota' }];
        this.validar(errores);
        return true;
      }
      return false;
    }

    // --- Elegir la devolución íntegra tras una cancelación del estudio ---

    prepararDevolucion() {
      const dueno = this.rol === 'cliente';
      this.querySelector('[data-panel="devolucion"] [data-consecuencia]').textContent = T(dueno
        ? `Te devolvemos ${soles(this.reserva.pagado ?? '0.00')} por el mismo medio con que pagaste, en un máximo de 7 días hábiles. Después ya no podrás reprogramar esta reserva.`
        : `Se devuelven ${soles(this.reserva.pagado ?? '0.00')} al cliente por el mismo medio con que pagó, en un máximo de 7 días hábiles. Después el cliente ya no podrá reprogramar esta reserva.`);
    }

    devolucion() {
      this.enviar(this.querySelector('[data-panel="devolucion"] [type="submit"]'), 'Confirmando…', () => elegirDevolucionEstudio(this.reserva.id), (nueva) => this.despues(nueva, 'Elegiste la devolución íntegra', 'Avisamos al estudio.'));
    }

    // --- Reprogramar (y "reprogramar sin costo" tras una cancelación del estudio): /app/reservas/reprogramar?id= ---

    urlDetalle() {
      return `${RUTA().detalle}?id=${encodeURIComponent(this.reserva.id)}`;
    }

    // Ruta y título con el folio; el título del sin costo es otro.
    rutaReprogramar(r) {
      const enlace = document.querySelector('.encabezado-ruta li:nth-last-child(2) a');
      if (enlace) Object.assign(enlace, { textContent: r.folio, href: this.urlDetalle() });
      document.querySelector('.encabezado-titulo')?.replaceChildren(...(this.sinCosto ? ['Elige tu nuevo horario'] : [T('Reprogramar reserva '), folioTitulo(r.folio)]));
    }

    async reprogramar() {
      const id = new URLSearchParams(location.search).get('id') ?? '';
      if (!UUID.test(id)) return this.mostrar('no-encontrada');
      let r, yo;
      try {
        [r, yo] = await Promise.all([leer(id), obtenerPerfil().catch(() => null)]);
      } catch (error) {
        if (error.estado !== 404) throw error;
        return this.mostrar('no-encontrada');
      }
      this.rol = yo?.rol ?? null;
      this.reserva = validar(r);
      this.sinCosto = r.estado === 'cancelada' && r.eleccion_estudio === 'pendiente';
      this.inicioR = null;
      this.vistaR = null;
      this.rutaReprogramar(r);
      if (!(r.estado === 'confirmada' || (ASES && r.estado === 'pre_reservada')) && !this.sinCosto) {
        this.noPermitida('Esta reserva ya no se puede reprogramar.');
        return null;
      }
      this.mostrar('datos');
      this.minutos = Math.round((Date.parse(r.fin) - Date.parse(r.inicio)) / MINUTO);
      const actual = (clave, texto) => {
        const nodo = this.querySelector(`[data-actual="${clave}"]`);
        if (!nodo) return;
        if (texto) nodo.textContent = texto;
        else nodo.closest('div').remove();
      };
      actual('folio', r.folio);
      actual('horario', `${fecha(r)}, ${horario(r)}`);
      actual('servicio', ASES ? nombreProf(r.profesional) : nombre(r.servicio));
      actual('especialistas', !ASES && (r.especialistas ?? []).map(nombre).join(', '));
      actual('duracion', ASES && duracionTexto(this.minutos));
      actual('modalidad', ASES && (MODALIDADES[r.modalidad] ?? r.modalidad));
      actual('total', soles(totalDe(r)));
      actual('pagado', soles(r.pagado ?? '0.00'));
      this.querySelector('[data-sin-costo]').hidden = !this.sinCosto;
      this.querySelector('[data-recalculo]').hidden = this.sinCosto || ASES;
      if (ASES) {
        this.querySelector('[data-tabla="precio"]').hidden = true;
        this.querySelector('[data-sin-costo] .aviso-titulo').textContent = 'Sin costo: el estudio canceló tu asesoría. Mantienes el precio y lo que pagaste.';
      }
      this.querySelector('[data-ayuda-duracion]').textContent = ASES ? `Tu asesoría dura ${duracionTexto(this.minutos)}: elige dónde empieza.` : `Tu sesión dura ${duracionReserva(this.minutos)}: elige dónde empieza.`;
      this.querySelector('[data-volver-reprog]').href = this.urlDetalle();
      // La semana de la reserva, salvo que la URL traiga otra; la sala va fija y la navegación del calendario conserva el id.
      const url = new URL(location.href);
      if (!url.searchParams.has('fecha')) {
        url.searchParams.set('fecha', fechaDe(r.inicio));
        history.replaceState(null, '', url);
      }
      const nodo = this.querySelector('template[data-plantilla="calendario"]').content.cloneNode(true);
      const calendario = nodo.querySelector('bugalu-calendario');
      if (ASES) {
        calendario.setAttribute('profesional', r.profesional.id);
        calendario.setAttribute('nombre', nombreProf(r.profesional));
        calendario.setAttribute('excluir', r.id);
      } else {
        if (r.sala?.id) calendario.setAttribute('sala', r.sala.id);
        calendario.setAttribute('sala-fija', '');
        calendario.setAttribute('excluir-reserva', r.id);
      }
      calendario.setAttribute('conservar', 'id');
      if (this.minutos) calendario.setAttribute('duracion', String(this.minutos));
      this.querySelector('[data-calendario]').replaceChildren(nodo);
      this.actualizarConfirmar();
      return `Reprogramar reserva ${r.folio}: elige el nuevo horario.`;
    }

    // Sin calendario: la reserva ya no admite reprogramarse (la API lo dijo, o su estado no lo permite).
    noPermitida(texto) {
      this.mostrar('no-permitida');
      const aviso = this.querySelector('[data-salida] .aviso');
      llenarAviso(aviso, texto);
      aviso.querySelector('.aviso-accion').href = this.urlDetalle();
      this.anunciar();
      this.enfocar();
    }

    bloquear(si) {
      super.bloquear(si);
      if (this.vista !== 'reprogramar') return;
      const calendario = this.querySelector('[data-calendario]');
      if (calendario) calendario.inert = si;
      const volver = this.querySelector('[data-volver-reprog]');
      if (si) volver?.setAttribute('aria-disabled', 'true');
      else volver?.removeAttribute('aria-disabled');
    }

    actualizarConfirmar() {
      const boton = this.querySelector('[data-confirmar-reprog]');
      const listo = this.vistaR !== null;
      if (listo) boton.removeAttribute('aria-disabled');
      else boton.setAttribute('aria-disabled', 'true');
      this.querySelector('[data-ayuda-confirmar]').hidden = listo;
    }

    // Error bajo el calendario (R1): sin vista previa.
    errorHorario(texto) {
      const caja = this.querySelector('[data-error-horario]');
      caja.hidden = !texto;
      if (!texto) return;
      const aviso = caja.querySelector('.aviso');
      aviso.querySelector('.aviso-titulo').textContent = texto;
      aviso.querySelector('.aviso-texto')?.remove();
      aviso.removeAttribute('role');
      this.querySelector('[data-anuncio]').textContent = texto;
    }

    r2(estado) {
      this.querySelector('[data-r2]').hidden = estado === 'nada';
      this.querySelector('[data-r2-carga]').hidden = estado !== 'carga';
      this.querySelector('[data-r2-datos]').hidden = estado !== 'datos';
      if (estado === 'carga') this.querySelector('[data-r2]').setAttribute('aria-busy', 'true');
      else this.querySelector('[data-r2]').removeAttribute('aria-busy');
      if (estado !== 'datos') this.querySelector('[data-r2-aviso]').replaceChildren();
      if (estado === 'carga') this.querySelector('[data-anuncio]').textContent = 'Calculando cómo queda…';
    }

    // Eligió un inicio en el calendario: valida lo que se ve sin pedir nada y, si cabe, simula.
    alInicio({ inicio, minutosMaximos }) {
      if (this.vista !== 'reprogramar' || !this.reserva || this.ocupado) return;
      this.inicioR = inicio;
      this.vistaR = null;
      this.secuencia++;
      limpiarAvisos(this);
      this.errorHorario(null);
      this.r2('nada');
      this.actualizarConfirmar();
      const url = new URL(location.href);
      url.searchParams.set('inicio', inicio);
      history.replaceState(null, '', url);
      if (minutosMaximos < this.minutos) return this.errorHorario(`${ASES ? 'Tu asesoría' : 'Tu sesión'} dura ${duracionReserva(this.minutos)} y desde las ${horaDe(inicio)} solo caben ${duracionReserva(minutosMaximos)}. Elige otro inicio.`);
      if (Date.parse(inicio) === Date.parse(this.reserva.inicio)) return this.errorHorario('Ese es tu horario actual. Elige otro.');
      this.simularR(inicio);
    }

    async simularR(inicio) {
      const n = ++this.secuencia;
      this.r2('carga');
      let v;
      try {
        v = await simularReprogramacion(this.reserva.id, inicio);
      } catch (error) {
        if (n === this.secuencia) this.errorReprogramar(error, false);
        return;
      }
      if (n !== this.secuencia) return;
      this.vistaR = v;
      this.pintarR2(v);
    }

    pintarR2(v) {
      const r = this.reserva;
      const sin = v.nivel === null || v.nivel === undefined;
      const dia = (iso) => `${nombreDia(fechaDe(iso)).slice(0, 3).toLowerCase()} ${diaMes(fechaDe(iso))}`;
      const fin = new Date(Date.parse(this.inicioR) + this.minutos * MINUTO).toISOString();
      this.r2('datos');
      this.querySelector('[data-nuevo-horario]').textContent = `Nuevo horario: ${dia(this.inicioR)}, ${horaDe(this.inicioR)}–${horaDe(fin)}`;
      this.querySelector('[data-nivel-texto]').textContent = nivelReprogramacion(sin ? null : v.nivel);
      if (!ASES) pintarPartidas(this.querySelector('[data-tabla="precio"] .tabla'), v.precio, v.precio.porcentaje_adelanto);
      const fila = (etiqueta, valor) => {
        const tr = document.createElement('tr');
        const td = Object.assign(document.createElement('td'), { className: 'tabla-num', textContent: valor });
        td.dataset.etiqueta = 'Importe';
        tr.append(Object.assign(document.createElement('th'), { scope: 'row', textContent: etiqueta }), td);
        return tr;
      };
      const pct = r.politica?.porcentaje_penalizacion_nivel_2;
      const tabla = this.querySelector('[data-tabla="saldo"] .tabla');
      if (ASES) {
        // La asesoria conserva su precio: la penalizacion de nivel 2 es un pago nuevo (cuota `al_terminar`), no se retiene de lo pagado.
        const pen = v.penalizacion ?? '0.00';
        this.querySelector('[data-nivel-texto]').textContent = nivelReprogramacion(sin ? null : v.nivel).replace('tu sesión', 'tu asesoría');
        tabla.querySelector('tbody').replaceChildren(
          fila('Precio de la asesoría (se conserva)', soles(totalDe(r))),
          fila('Ya pagaste', `− ${soles(r.pagado ?? '0.00')}`),
          ...(positivo(pen) ? [fila(`Penalización (nivel 2${pct ? `, ${porcentaje(pct)}` : ''})`, soles(pen))] : []),
        );
        tabla.querySelector('tfoot').replaceChildren(fila(positivo(pen) ? 'Pago nuevo' : 'Nada por pagar', soles(pen)));
        oculto(this.querySelector('[data-nota-pago]'), positivo(pen) ? `Se crea un pago de ${soles(pen)} que haces hasta 48 h después de tu asesoría.` : null);
        const restantes = Number(v.reprogramaciones_restantes);
        oculto(this.querySelector('[data-restantes]'), sin || !Number.isFinite(restantes) ? null : restantes === 0 ? 'Después de este cambio no te quedarán más cambios de horario.' : `Después de este cambio te ${restantes === 1 ? 'quedará 1 cambio' : `quedarán ${restantes} cambios`} de horario.`);
        this.actualizarConfirmar();
        this.querySelector('[data-anuncio]').textContent = `Nuevo horario ${dia(this.inicioR)}, ${horaDe(this.inicioR)} a ${horaDe(fin)}: ${sin ? 'sin costo' : `nivel ${v.nivel}`}, ${positivo(pen) ? `pago nuevo ${soles(pen)}` : 'nada por pagar'}.`;
        return;
      }
      tabla.querySelector('tbody').replaceChildren(
        fila('Nuevo total', soles(v.precio.total)),
        ...(positivo(v.penalizacion) ? [fila(`Penalización (nivel 2${pct ? `, ${porcentaje(pct)}` : ''})`, soles(v.penalizacion))] : []),
        fila('Ya pagaste', `− ${soles(r.pagado ?? '0.00')}`),
      );
      tabla.querySelector('tfoot').replaceChildren(
        fila(positivo(v.saldo) ? 'Saldo por pagar' : 'Nada por pagar', soles(v.saldo)),
        ...(positivo(v.credito) ? [fila('Pasa a crédito', soles(v.credito))] : []),
      );
      const n = Number(v.reprogramaciones_restantes);
      oculto(this.querySelector('[data-restantes]'), sin || !Number.isFinite(n) ? null : n === 0 ? 'Después de este cambio no te quedarán más cambios de horario.' : `Después de este cambio te ${n === 1 ? 'quedará 1 cambio' : `quedarán ${n} cambios`} de horario.`);
      this.actualizarConfirmar();
      this.querySelector('[data-anuncio]').textContent = `Nuevo horario ${dia(this.inicioR)}, ${horaDe(this.inicioR)} a ${horaDe(fin)}: ${sin ? 'sin costo' : `nivel ${v.nivel}`}, saldo ${soles(v.saldo)}${positivo(v.credito) ? `, pasan ${soles(v.credito)} a crédito` : ''}.`;
    }

    confirmarReprogramacion() {
      const v = this.vistaR;
      if (!v) {
        this.querySelector('[data-anuncio]').textContent = this.querySelector('[data-ayuda-confirmar]').textContent;
        return;
      }
      const cuerpo = { inicio: this.inicioR, nivel_esperado: v.nivel ?? null, total_esperado: ASES ? totalDe(this.reserva) : v.precio.total };
      // Sala: lo que pasa a credito; asesoria: la penalizacion que queda por pagar (para el aviso del detalle).
      const credito = ASES ? (positivo(v.penalizacion) ? v.penalizacion : '0.00') : positivo(v.credito) ? v.credito : '0.00';
      this.enviar(this.querySelector('[data-confirmar-reprog]'), 'Reprogramando…', () => reprogramarReserva(this.reserva.id, cuerpo), () => {
        try { sessionStorage.setItem(claveReprogramada(this.reserva.id), credito); } catch {}
        location.href = `${RUTA().detalle}?${new URLSearchParams({ id: this.reserva.id, aviso: ASES ? 'asesoria-reprogramada' : 'reserva-reprogramada' })}`;
      }, true);
    }

    // Errores de simular (`confirmando` false) y de confirmar; devuelve true: siempre queda tratado.
    errorReprogramar(error, confirmando) {
      const { estado, codigo } = error;
      if (estado === 401 || estado === 403) this.sustituir(estado === 401 ? 'no-autenticado' : 'sin-permiso');
      else if (estado === 404) this.sustituir('no-encontrada');
      // Un plazo cruzado a nivel 3 ya no deja reprogramar (no es "sin costo": ese caso es nivel null).
      else if (estado === 409 && codigo === 'nivel_cambiado' && error.detalles?.nivel === 3) this.noPermitida(sinReprogramar('reprogramacion_no_permitida', this.reserva.politica));
      else if (estado === 409 && (codigo === 'reprogramacion_no_permitida' || codigo === 'limite_reprogramaciones')) this.noPermitida(sinReprogramar(codigo, this.reserva.politica));
      else if (ASES && estado === 409 && codigo === 'no_cancelable') this.noPermitida('Tu asesoría ya empezó: ya no se puede reprogramar.');
      else if (estado === 409 && (codigo === 'tramo_no_disponible' || codigo === 'horario_no_disponible')) {
        this.inicioR = null;
        this.vistaR = null;
        this.secuencia++;
        this.r2('nada');
        this.actualizarConfirmar();
        const url = new URL(location.href);
        url.searchParams.delete('inicio');
        history.replaceState(null, '', url);
        this.querySelector('bugalu-calendario')?.reiniciar();
        mostrarAviso(this, 'error', ASES ? 'Alguien agendó ese horario hace un momento. Elige otro.' : 'Alguien reservó ese horario hace un momento. Elige otro.');
        this.enfocar();
      } else if (estado === 409 && (codigo === 'nivel_cambiado' || codigo === 'precio_cambiado') && error.detalles?.precio) {
        // Se cruzó un plazo o cambió una tarifa mientras leía: se repinta con la vista nueva y se pide confirmar otra vez.
        this.vistaR = error.detalles;
        this.pintarR2(error.detalles);
        const n = error.detalles.nivel;
        const aviso = mostrarAviso(this, 'aviso', codigo === 'nivel_cambiado' ? `Mientras revisabas pasó un plazo: ahora es ${n === 1 ? 'nivel 1, sin cargo' : n === 2 ? 'nivel 2, con penalización' : 'sin costo'}` : 'El precio de ese horario cambió mientras revisabas', codigo === 'nivel_cambiado' ? 'Revisa cómo queda y confirma de nuevo.' : 'Revisa el nuevo total y confirma de nuevo.');
        this.querySelector('[data-r2-aviso]').replaceChildren(aviso);
        enfocarAviso(aviso);
      } else if (estado === 422 && (ASES ? FRANJA_ASESORIA : FRANJA)[codigo]) {
        this.vistaR = null;
        this.r2('nada');
        this.actualizarConfirmar();
        this.errorHorario((ASES ? FRANJA_ASESORIA : FRANJA)[codigo]);
      } else {
        const que = confirmando ? 'reprogramar' : 'calcular cómo queda';
        const texto = estado === 503 ? [`No pudimos ${que}: el servicio no responde`, 'Tu elección sigue aquí; inténtalo en unos minutos.']
          : estado === 0 ? ['Sin conexión', 'Tu elección sigue aquí; revisa tu red y vuelve a intentarlo.']
          : [`No pudimos ${que}: algo salió mal`, confirmando ? 'Tu elección sigue aquí; revisa en la reserva si el cambio se hizo antes de repetir.' : 'Elige el horario otra vez.'];
        if (!confirmando) {
          this.vistaR = null;
          this.r2('nada');
          this.actualizarConfirmar();
        }
        enfocarAviso(mostrarAviso(this, 'error', ...texto));
      }
      return true;
    }

    // --- No asistió ---

    prepararInasistencia() {
      const r = this.reserva;
      const t = tolerancia(r);
      this.querySelector('[data-resumen-na]').textContent = `${r.cliente ? nombre(r.cliente) : 'El cliente'} no llegó${t === null ? ' a la sesión' : ` en los primeros ${t} minutos`}.`;
      this.querySelector('[data-panel="inasistencia"] [data-consecuencia]').textContent = `Se retiene lo pagado (${soles(r.pagado ?? '0.00')}), se anula el saldo y no hay crédito ni cobro adicional. El horario sigue ocupado. Avisamos al cliente por correo. No se puede deshacer: solo el Administrador puede tratarla después como nivel 1.`;
    }

    inasistencia() {
      this.enviar(this.querySelector('[data-panel="inasistencia"] [type="submit"]'), 'Marcando…', () => marcarInasistencia(this.reserva.id), (nueva) => {
        this.avisoNa = false;
        this.despues(nueva, 'Inasistencia registrada', 'Avisamos al cliente por correo.');
      });
    }

    // --- Tratar como nivel 1 ---

    retenidoHoy() {
      const r = this.reserva;
      return r.cancelacion?.retenido ?? r.pagado;
    }

    prepararExcepcion() {
      const campo = this.querySelector('#excepcion-motivo');
      campo.value = '';
      quitarError(campo);
      const retenido = this.retenidoHoy();
      const d = this.reserva.politica?.dias_vigencia_credito;
      this.querySelector('[data-retenido-hoy]').textContent = soles(retenido);
      this.querySelector('[data-panel="excepcion"] [data-consecuencia]').textContent = ASES ? `Lo retenido (${soles(retenido)}) pasa a un crédito de caso excepcional que vence ${d ? `${d} días` : 'unos días'} después de hoy. Nació de una asesoría: no admite devolución en dinero (sí la parte que venía de un crédito de sala). Solo una vez por asesoría.` : `Lo retenido (${soles(retenido)}) pasa a un crédito de caso excepcional que vence ${d ? `${d} días` : 'unos días'} después de hoy y admite devolución. Solo se puede hacer una vez por reserva y queda registrado quién y por qué. No se puede deshacer.`;
    }

    excepcion() {
      const campo = this.querySelector('#excepcion-motivo');
      quitarError(campo);
      const motivoTexto = campo.value.trim();
      if (!this.validar(motivoTexto.length < 10 || motivoTexto.length > 500 ? [{ entrada: campo, mensaje: MOTIVO_EXCEPCION, texto: 'Motivo' }] : [])) return;
      const retenido = this.retenidoHoy();
      this.enviar(this.querySelector('[data-panel="excepcion"] [type="submit"]'), 'Aplicando…', () => aplicarExcepcion(this.reserva.id, motivoTexto), (nueva) => this.despues(nueva, 'Tratada como nivel 1', `${soles(retenido)} pasaron a crédito del cliente, con devolución posible.`));
    }
  }

  if (!customElements.get('bugalu-reservas')) customElements.define('bugalu-reservas', BugaluReservas);
</script>

