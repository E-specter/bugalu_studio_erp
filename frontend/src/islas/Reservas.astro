---
import Panel from '../componentes/Panel.astro';
import Aviso from '../componentes/Aviso.astro';
import Boton from '../componentes/Boton.astro';
import BarraAcciones from '../componentes/BarraAcciones.astro';
import Tabla from '../componentes/Tabla.astro';
import Campo from '../componentes/Campo.astro';
import Casilla from '../componentes/Casilla.astro';
import EtiquetaTecnica from '../componentes/EtiquetaTecnica.astro';
import IndicadorEstado from '../componentes/IndicadorEstado.astro';
import EstadosIsla from '../componentes/internos/EstadosIsla.astro';
import EstilosGestion from '../componentes/internos/EstilosGestion.astro';

interface Props {
  vista: 'lista' | 'detalle';
}
const { vista } = Astro.props;
// Panel de la vista mientras carga o falla (spec RF-04-mis-reservas).
const principal = vista === 'lista' ? { titulo: 'Reservas' } : { codigo: 'D1', titulo: 'Reserva' };
const filtros = [
  { clave: 'proximas', texto: 'Próximas', href: '/app/reservas/' },
  { clave: 'historial', texto: 'Historial', href: '/app/reservas/?ver=historial' },
];
---

<EstilosGestion />

<!-- Un bloque por estado (estados-sistema): la isla clona el que toca. Sin JS, el noscript oculta la carga y avisa. -->
<bugalu-reservas class="reservas" data-gestion vista={vista}>
  <div data-avisos></div>
  <!-- Región viva estable: anuncia la carga y los umbrales del plazo, nunca cada minuto. -->
  <p class="visualmente-oculto" role="status" data-anuncio></p>
  {vista === 'lista' && <nav class="reservas-filtros" aria-label="Filtrar reservas" data-filtros hidden></nav>}
  <div data-salida><Panel {...principal} cargando /></div>

  <EstadosIsla principal={principal} />

  {vista === 'lista' && (
    <>
      {filtros.flatMap((f) => [
        <template data-filtro={f.clave} data-aplicado="no"><EtiquetaTecnica variante="filtro" texto={f.texto} href={f.href} /></template>,
        <template data-filtro={f.clave} data-aplicado="si"><EtiquetaTecnica variante="filtro" texto={f.texto} href={f.href} aplicado /></template>,
      ])}
      <template data-estado="vacio">
        <Panel titulo="Reservas">
          <p class="gestion-vacio-titulo">Aún no tienes reservas</p>
          <p>Elige un horario libre y reserva la sala en unos pasos.</p>
          <div class="reservas-accion"><Boton href="/reservar/">Reservar sala</Boton></div>
        </Panel>
      </template>
      <template data-estado="vacio-filtro">
        <Panel titulo="Reservas">
          <p class="gestion-vacio-titulo" data-vacio></p>
          <div class="reservas-accion"><Boton variante="secundario" href="#" data-otro></Boton></div>
        </Panel>
      </template>
      <template data-estado="datos">
        <Panel titulo="Reservas">
          <p class="reservas-total" data-total></p>
          <Tabla titulo="Reservas" columnas={['Reserva', 'Fecha', 'Estado', 'Total', 'Pago', '']} numericas={[3]} />
        </Panel>
      </template>
      <template data-fila>
        <tr>
          <th scope="row"><span class="reservas-folio" data-folio></span><span class="gestion-motivo" data-servicio></span></th>
          <td data-etiqueta="Fecha"><span data-fecha></span><span class="gestion-motivo" data-horario></span></td>
          <td data-etiqueta="Estado"><EtiquetaTecnica texto="Estado" /><span class="gestion-motivo" data-motivo hidden></span></td>
          <td data-etiqueta="Total" class="tabla-num" data-total-fila></td>
          <td data-etiqueta="Pago">
            <span data-limite>—</span>
            <span class="gestion-motivo" data-plazo hidden></span>
          </td>
          <td><Boton variante="secundario" href="#" data-accion>Ver reserva<span class="visualmente-oculto" data-objeto></span></Boton></td>
        </tr>
      </template>
    </>
  )}

  {vista === 'detalle' && (
    <>
      <template data-estado="no-encontrada">
        <Panel codigo="[404]" titulo="Reserva no encontrada"><Aviso variante="informacion" titulo=" " texto=" " accion={{ etiqueta: 'Volver a mis reservas', href: '/app/reservas/' }} /></Panel>
      </template>
      <template data-estado="datos">
        <div class="gestion-rejilla">
          <div class="gestion-lateral">
            <div data-estado-reserva class="reservas-estado">
              <IndicadorEstado variante="barra" texto=" " dato=" " />
              <p class="reservas-nota" data-nota hidden></p>
              <p class="reservas-nota" data-nota-estudio hidden></p>
              <div data-menos-hora hidden><Aviso variante="aviso" titulo=" " texto=" " /></div>
            </div>
            <div data-pagar hidden><Boton href="#">Registrar pago</Boton></div>

            <!-- Acciones del lateral: un botón por acción; al abrirla, su panel lo sustituye (una sola a la vez). -->
            <div class="reservas-estado" data-boton="inasistencia" hidden>
              <Boton variante="peligro" data-abrir="inasistencia">Marcar no asistió</Boton>
              <p class="gestion-ayuda" id="reservas-ayuda-inasistencia" data-ayuda-na hidden></p>
            </div>
            <div data-boton="excepcion" hidden><Boton variante="secundario" data-abrir="excepcion">Tratar como nivel 1</Boton></div>
            <div data-boton="cancelar" hidden><Boton variante="peligro" data-abrir="cancelar">Solicitar cancelación</Boton></div>

            <div data-panel="inasistencia" hidden>
              <Panel titulo="Marcar inasistencia" variante="lateral" id="inasistencia">
                <form novalidate class="gestion-formulario" data-accion="inasistencia">
                  <p class="reservas-resumen" data-resumen-na></p>
                  <p data-consecuencia></p>
                  <BarraAcciones variante="decision">
                    <Boton slot="secundaria" variante="secundario" data-envio data-volver>Volver a la reserva</Boton>
                    <Boton slot="principal" variante="peligro" tipo="submit" data-envio>Marcar no asistió</Boton>
                  </BarraAcciones>
                </form>
              </Panel>
            </div>

            <div data-panel="excepcion" hidden>
              <Panel titulo="Tratar como nivel 1" variante="lateral" id="excepcion">
                <form novalidate class="gestion-formulario" data-accion="excepcion">
                  <p>Para emergencias de salud, duelos, desastres o paros que impidieron avisar a tiempo, con un sustento razonable.</p>
                  <dl class="gestion-datos"><div><dt>Retenido hoy</dt><dd data-retenido-hoy></dd></div></dl>
                  <Campo tipo="area" id="excepcion-motivo" nombre="motivo" etiqueta="Motivo" obligatorio minlength="10" maxlength="500" ayuda="Qué pasó y qué sustento recibiste. El cliente lo verá en su reserva." />
                  <p data-consecuencia></p>
                  <BarraAcciones variante="decision">
                    <Boton slot="secundaria" variante="secundario" data-envio data-volver>Volver a la reserva</Boton>
                    <Boton slot="principal" tipo="submit" data-envio>Tratar como nivel 1</Boton>
                  </BarraAcciones>
                </form>
              </Panel>
            </div>

            <div data-panel="cancelar" hidden>
              <Panel titulo="Cancelar reserva" variante="lateral" id="cancelar">
                <form novalidate class="gestion-formulario" data-accion="cancelar">
                  <div data-panel-aviso></div>
                  <p class="reservas-resumen" data-resumen></p>
                  <div data-parte="admin" hidden>
                    <div class="campo">
                      <fieldset class="gestion-grupo">
                        <legend>¿Quién pide cancelar?</legend>
                        <Casilla tipo="radio" nombre="por" valor="estudio" id="cancelar-por-estudio" aria-controls="cancelar-campos-estudio" etiqueta="El estudio" detalle="Falla técnica, ausencia del especialista o fuerza mayor." />
                        <div class="gestion-grupo" id="cancelar-campos-estudio" data-campos="estudio" hidden>
                          <Campo tipo="area" id="cancelar-nota-estudio" nombre="nota-estudio" etiqueta="Nota para el cliente" maxlength="300" />
                        </div>
                        <Casilla tipo="radio" nombre="por" valor="cliente" id="cancelar-por-cliente" aria-controls="cancelar-campos-cliente" etiqueta="El cliente, por otro canal" detalle="Te escribió por WhatsApp, correo o teléfono." />
                        <div class="gestion-grupo" id="cancelar-campos-cliente" data-campos="cliente" hidden>
                          <div class="gestion-fila-campos">
                            <Campo tipo="date" id="cancelar-fecha" nombre="fecha" etiqueta="Fecha del aviso" obligatorio ayuda="Las de su mensaje, hora de Lima." />
                            <Campo tipo="time" id="cancelar-hora" nombre="hora" etiqueta="Hora del aviso" obligatorio step="60" />
                          </div>
                          <Campo tipo="area" id="cancelar-nota-cliente" nombre="nota-cliente" etiqueta="Nota" obligatorio maxlength="300" ayuda="Canal y lo que pidió. Por ejemplo: «WhatsApp: no puede venir por un viaje»." />
                        </div>
                      </fieldset>
                    </div>
                  </div>
                  <!-- Vista previa de la política: carga, datos o error; nunca se ofrece confirmar al cliente sin ella. -->
                  <div data-previa hidden>
                    <p class="reservas-nota" data-previa-carga hidden>Calculando qué pasa con tu pago…</p>
                    <div data-previa-datos hidden>
                      <p class="reservas-nivel" data-nivel></p>
                      <p class="reservas-nota" data-anticipacion></p>
                      <dl class="gestion-datos" data-dl></dl>
                      <p class="reservas-nota" data-validacion hidden></p>
                    </div>
                  </div>
                  <p data-consecuencia></p>
                  <p class="reservas-nota"><a class="reservas-enlace" href="/legal/condiciones-de-contratacion/" data-condiciones>Leer las condiciones de cancelación</a></p>
                  <BarraAcciones variante="decision">
                    <Boton slot="secundaria" variante="secundario" data-envio data-volver>Volver a la reserva</Boton>
                    <Boton slot="principal" variante="peligro" tipo="submit" data-envio data-confirmar-cancelar hidden>Confirmar cancelación</Boton>
                  </BarraAcciones>
                </form>
              </Panel>
            </div>
          </div>
          <div class="gestion-principal">
            <Panel codigo="D1" titulo="Reserva">
              <dl class="gestion-datos">
                <div><dt>Estado</dt><dd class="reservas-estados"><EtiquetaTecnica texto="Estado" /><span data-pago-validar hidden><EtiquetaTecnica texto="Pago por validar" variante="aviso" /></span></dd></div>
                <div><dt>Fecha y horario</dt><dd data-campo="horario"></dd></div>
                <div><dt>Duración</dt><dd data-campo="duracion"></dd></div>
                <div><dt>Servicio</dt><dd data-campo="servicio"></dd></div>
                <div data-fila="especialistas"><dt>Especialistas</dt><dd data-campo="especialistas"></dd></div>
                <div><dt>Sala</dt><dd data-campo="sala"></dd></div>
                <div data-fila="cliente"><dt>Cliente</dt><dd data-campo="cliente"></dd></div>
              </dl>
            </Panel>
            <Panel codigo="D2" titulo="Precio">
              <div data-precio><Tabla titulo="Desglose del precio" columnas={['Concepto', 'Cantidad', 'Importe']} variante="partidas" numericas={[1, 2]} /></div>
              <p class="gestion-ayuda reservas-nota-precio">Precio calculado al reservar.</p>
            </Panel>
            <Panel codigo="D3" titulo="Cuotas">
              <div data-cuotas><Tabla titulo="Cuotas" columnas={['Cuota', 'Importe', 'Estado']} variante="partidas" numericas={[1]} /></div>
            </Panel>
            <div data-d4 hidden>
              <Panel codigo="D4" titulo="Cancelación">
                <dl class="gestion-datos">
                  <div><dt>Aviso</dt><dd data-d4="aviso"></dd></div>
                  <div><dt>A pedido de</dt><dd data-d4="por"></dd></div>
                  <div data-fila="registrada"><dt>Registrada por</dt><dd data-d4="registrada"></dd></div>
                  <div><dt>Nivel</dt><dd data-d4="nivel"></dd></div>
                  <div><dt>Pagado</dt><dd data-d4="pagado"></dd></div>
                  <div><dt>Retenido</dt><dd data-d4="retenido"></dd></div>
                  <div><dt>Pasó a crédito</dt><dd><span data-d4="credito"></span> <a class="reservas-enlace" href="/app/reservas/creditos" data-d4-creditos hidden>Ver mis créditos</a></dd></div>
                  <div data-fila="nota"><dt>Nota del estudio</dt><dd class="reservas-texto" data-d4="nota"></dd></div>
                  <div data-fila="excepcion"><dt>Caso excepcional</dt><dd class="reservas-texto" data-d4="excepcion"></dd></div>
                </dl>
              </Panel>
            </div>
            <div data-d5 hidden>
              <Panel codigo="D5" titulo="Reprogramaciones">
                <Tabla titulo="Reprogramaciones" columnas={['Fecha del cambio', 'Antes', 'Ahora', 'Nivel', 'Penalización', 'Total']} numericas={[4, 5]} />
              </Panel>
            </div>
          </div>
        </div>
      </template>
      <template data-fila-cuota>
        <tr>
          <th scope="row"><span data-concepto></span><span class="gestion-motivo reservas-rechazo" data-rechazo hidden></span></th>
          <td data-etiqueta="Importe" class="tabla-num" data-importe></td>
          <td data-etiqueta="Estado"><EtiquetaTecnica texto="Estado" /><span class="gestion-motivo" data-sub hidden></span></td>
        </tr>
      </template>
      <template data-fila-reprog>
        <tr>
          <th scope="row" data-en></th>
          <td data-etiqueta="Antes" data-antes></td>
          <td data-etiqueta="Ahora" data-ahora></td>
          <td data-etiqueta="Nivel" data-nivel-r></td>
          <td data-etiqueta="Penalización" class="tabla-num" data-penalizacion></td>
          <td data-etiqueta="Total" class="tabla-num" data-total-r></td>
        </tr>
      </template>
    </>
  )}
</bugalu-reservas>

<script>
  // @ts-nocheck
  import { IslaGestion, mensajeError } from '../servicios/isla-gestion.js';
  import { listarMisReservas, obtenerReserva, cancelarReserva, verCancelacion, marcarInasistencia, aplicarExcepcion, absoluta, faltan, textoCuota, ultimoRechazo, tienePagos } from '../servicios/reservas.js';
  import { nivelTexto, consecuenciaCancelar, avisoValidacion, filasVista, anticipacionTexto } from '../servicios/cancelacion.js';
  import { obtenerPerfil } from '../servicios/api.js';
  import { fechaDe, horaDe, diaMes, diaMesAnio, soles, instante, pintarPartidas } from '../servicios/formatos.js';
  import { mostrarAviso, enfocarAviso, llenarAviso, quitarError, limpiarAvisos } from '../servicios/formulario.js';

  const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const MINUTO = 60e3;
  const filtrosOrden = ['proximas', 'historial'];
  // estado -> [texto, variante de la etiqueta]
  const ESTADOS = { pre_reservada: ['Pre-reservada', 'aviso'], confirmada: ['Confirmada', 'exito'], en_curso: ['En curso', 'activa'], finalizada: ['Finalizada', 'exito'], cancelada: ['Cancelada', 'alerta'], no_asistio: ['No asistió', 'alerta'] };
  const PROXIMAS = ['pre_reservada', 'confirmada', 'en_curso'];
  const CUOTAS = { pendiente: ['Pendiente', 'aviso'], en_validacion: ['En validación', 'aviso'], pagada: ['Pagada', 'exito'], anulada: ['Anulada', 'neutra'] };
  // Panel de acción -> título (el folio se suma aparte, sin partirse).
  const TITULOS = { cancelar: 'Cancelar reserva ', inasistencia: 'Marcar inasistencia · ', excepcion: 'Tratar como nivel 1 · ' };
  const AVISO_INVALIDO = 'El aviso no puede ser futuro ni anterior a cuando se hizo la reserva.';
  const MOTIVO_EXCEPCION = 'Escribe el motivo, de 10 a 500 caracteres.';

  const nombre = (v) => v?.nombre ?? v;
  const horario = (r) => `${horaDe(r.inicio)}–${horaDe(r.fin)}`;
  const fecha = (r) => diaMesAnio(fechaDe(r.inicio));
  const duracion = (r) => {
    const min = Math.round((Date.parse(r.fin) - Date.parse(r.inicio)) / MINUTO);
    return [Math.floor(min / 60) && `${Math.floor(min / 60)} h`, min % 60 && `${min % 60} min`].filter(Boolean).join(' ') || '0 min';
  };
  // Umbrales del plazo (0 = vencido): solo al cruzarlos se anuncia.
  const umbral = (ms) => (ms <= 0 ? 0 : ms <= 15 * MINUTO ? 1 : ms <= 60 * MINUTO ? 2 : 3);
  const anuncios = [(f) => `La reserva ${f} venció sin pago.`, (f) => `La reserva ${f} vence en menos de 15 min.`, (f) => `La reserva ${f} vence en menos de 1 h.`];

  // Con un pago por validar el plazo no corre (RN-18).
  const resto = (r) => (r.estado === 'pre_reservada' && r.vence_pago && !r.pago_por_validar ? Date.parse(r.vence_pago) - Date.now() : null);
  // Una pre-reservada con el plazo vencido ya cuenta como caducada, aunque la API tarde en cancelarla.
  const caducada = (r) => resto(r) !== null && resto(r) <= 0;
  const estadoDe = (r) => (caducada(r) ? ['Caducada', 'alerta'] : ESTADOS[r.estado]);
  const motivo = (r) => {
    if (caducada(r)) return `Venció sin pago${r.vence_pago ? ` el ${absoluta(r.vence_pago)}` : ''}. El horario quedó libre.`;
    if (r.estado !== 'cancelada') return null;
    return { cliente: 'La cancelaste.', administrador: 'La canceló el estudio.' }[r.motivo_cancelacion] ?? `Caducó sin pago${r.vence_pago ? ` el ${absoluta(r.vence_pago)}` : ''}. El horario se liberó.`;
  };
  // Minutos de tolerancia de la inasistencia, de la política de la reserva; null si no llega.
  const tolerancia = (r) => (r.politica?.minutos_tolerancia_inasistencia == null ? null : Number(r.politica.minutos_tolerancia_inasistencia));
  const positivo = (monto) => Number(monto) > 0;

  // Columna PAGO de la lista: [texto, plazo restante o null].
  const pagoDe = (r, ms) => {
    if (r.estado === 'cancelada' || r.estado === 'no_asistio') return ['—', null];
    if (r.estado === 'pre_reservada') {
      if (r.pago_por_validar) return ['En validación', null];
      if (ms === null) return ['—', null];
      return ms <= 0 ? ['Venció sin pago', null] : [`Antes del ${absoluta(r.vence_pago)}`, faltan(ms)];
    }
    const resta = (r.cuotas ?? []).find((c) => c.hito === 'al_terminar');
    return [{ pendiente: `Resto: ${soles(resta?.monto)}`, en_validacion: 'En validación', pagada: 'Pagada' }[resta?.estado] ?? '—', null];
  };

  // Un dato fuera de la lista cerrada no se usa en plantillas: respuesta inesperada (cae en "Algo salió mal").
  const validar = (r) => {
    if (!r || typeof r !== 'object' || !Object.hasOwn(ESTADOS, r.estado)) throw new Error('respuesta_inesperada');
    return r;
  };

  const poner = (etiqueta, [texto, variante]) => {
    etiqueta.querySelector('span:last-child').textContent = texto;
    etiqueta.className = etiqueta.className.replace(/etiqueta-(neutra|activa|invertida|exito|aviso|alerta)/, `etiqueta-${variante}`);
  };
  const oculto = (nodo, texto) => {
    nodo.hidden = !texto;
    nodo.textContent = texto ?? '';
  };
  const folioTitulo = (folio) => Object.assign(document.createElement('span'), { className: 'reservas-folio-titulo', textContent: folio });

  class BugaluReservas extends IslaGestion {
    noEncontrada = ['No encontramos esta reserva.', ''];
    filas = [];
    reserva = null;
    rol = null;
    temporizador = 0;
    abierto = null; // panel de acción abierto: cancelar | inasistencia | excepcion
    previa = null; // VistaCancelacion mostrada (la última que llegó)
    secuencia = 0; // descarta vistas previas que llegan tarde
    avisoNa = false; // el botón de inasistencia se pulsó antes de tiempo (o la API dijo que aún no)

    iniciar() {
      this.addEventListener('click', (e) => {
        const abrir = e.target.closest('[data-abrir]');
        if (abrir) this.abrir(abrir.dataset.abrir, abrir);
        else if (e.target.closest('[data-volver]')) this.cerrar();
        else if (e.target.closest('[data-reintentar-previa]')) this.pedirVista(this.avisoReintento);
      });
      this.addEventListener('change', (e) => {
        if (e.target.matches('input[name="por"]')) this.cambiarOpcion();
        else if (e.target.matches('#cancelar-fecha, #cancelar-hora')) this.vistaDelAviso();
      });
      this.addEventListener('keydown', (e) => e.key === 'Escape' && this.abierto && !this.ocupado && this.cerrar());
    }

    disconnectedCallback() {
      clearInterval(this.temporizador);
    }

    alEnviar(formulario) {
      const accion = formulario.dataset.accion;
      if (accion === 'cancelar') this.cancelar();
      else if (accion === 'inasistencia') this.inasistencia();
      else this.excepcion();
    }

    // Solo el detalle recibe ?aviso= (lista cerrada: el texto sale de aqui).
    avisoDeUrl() {
      if (this.vista === 'detalle') {
        this.avisosUrl = {
          'pago-registrado': ['Pago registrado. Queda pendiente de validación', 'Te avisaremos por correo cuando el estudio lo revise.'],
          'pagado-con-credito': ['Pagaste la cuota con tu crédito.'],
          'pagado-con-credito-confirmada': ['Pagaste la cuota con tu crédito', 'Tu reserva quedó confirmada.'],
        };
      }
      super.avisoDeUrl();
    }

    // 401 y 403 llevan el texto de esta pantalla y su propio enlace.
    mostrar(estado) {
      super.mostrar(estado);
      const aviso = this.querySelector('[data-salida] .aviso');
      if (estado === 'no-autenticado') {
        llenarAviso(aviso, 'Tu sesión no es válida', 'Inicia sesión para ver tus reservas.');
        const enlace = aviso.querySelector('.aviso-accion');
        enlace.textContent = 'Ir al acceso';
        enlace.href = `/acceso?${new URLSearchParams({ volver: location.pathname + location.search })}`;
      } else if (estado === 'sin-permiso') {
        aviso.querySelector('.aviso-titulo').textContent = this.vista === 'detalle' ? 'Esta reserva no es tuya.' : 'No tienes permiso para ver estas reservas.';
        aviso.querySelector('.aviso-texto')?.remove();
        const enlace = aviso.querySelector('.aviso-accion');
        enlace.textContent = 'Volver a mis reservas';
        enlace.href = '/app/reservas/';
      }
    }

    // --- Lista ---

    async lista() {
      const ver = new URLSearchParams(location.search).get('ver') === 'historial' ? 'historial' : 'proximas';
      const todas = (await listarMisReservas()).map(validar);
      const encabezado = document.querySelector('[data-accion-encabezado]');
      const nav = this.querySelector('[data-filtros]');
      if (!todas.length) {
        encabezado?.remove();
        nav.hidden = true;
        this.mostrar('vacio');
        return 'Aún no tienes reservas';
      }
      nav.replaceChildren(...filtrosOrden.map((clave) => this.querySelector(`template[data-filtro="${clave}"][data-aplicado="${clave === ver ? 'si' : 'no'}"]`).content.cloneNode(true)));
      nav.hidden = false;
      const mias = todas.filter((r) => PROXIMAS.includes(r.estado) === (ver === 'proximas')).sort((a, b) => (ver === 'proximas' ? 1 : -1) * (Date.parse(a.inicio) - Date.parse(b.inicio)));
      if (!mias.length) {
        this.mostrar('vacio-filtro');
        const proximas = ver === 'proximas';
        this.querySelector('[data-vacio]').textContent = proximas ? 'No tienes reservas próximas.' : 'Aún no hay reservas en tu historial.';
        const otro = this.querySelector('[data-otro]');
        otro.textContent = proximas ? 'Ver historial' : 'Ver próximas';
        otro.href = proximas ? '/app/reservas/?ver=historial' : '/app/reservas/';
        return this.querySelector('[data-vacio]').textContent;
      }
      this.mostrar('datos');
      const plantilla = this.querySelector('template[data-fila]');
      this.filas = mias.map((r) => {
        const raiz = plantilla.content.cloneNode(true).firstElementChild;
        raiz.querySelector('[data-folio]').textContent = r.folio;
        raiz.querySelector('[data-servicio]').textContent = nombre(r.servicio);
        raiz.querySelector('[data-fecha]').textContent = fecha(r);
        raiz.querySelector('[data-horario]').textContent = `${horario(r)} · ${duracion(r)}`;
        raiz.querySelector('[data-total-fila]').textContent = soles(r.precio.total);
        raiz.querySelector('[data-objeto]').textContent = ` ${r.folio}`;
        raiz.querySelector('[data-accion]').href = `/app/reservas/detalle?id=${encodeURIComponent(r.id)}`;
        const fila = { raiz, r, umbral: umbral(resto(r) ?? Infinity) };
        this.pintarFila(fila);
        return fila;
      });
      this.querySelector('tbody').replaceChildren(...this.filas.map((f) => f.raiz));
      const n = mias.length;
      this.querySelector('[data-total]').textContent = `${n} ${n === 1 ? 'reserva' : 'reservas'}`;
      clearInterval(this.temporizador);
      this.temporizador = setInterval(() => this.tic(), MINUTO);
      const tipo = ver === 'proximas' ? ['próxima', 'próximas'] : ['en el historial', 'en el historial'];
      return `${n} ${n === 1 ? 'reserva' : 'reservas'} ${tipo[n === 1 ? 0 : 1]}`;
    }

    pintarFila({ raiz, r }) {
      poner(raiz.querySelector('.etiqueta'), estadoDe(r));
      oculto(raiz.querySelector('[data-motivo]'), motivo(r));
      const [texto, plazo] = pagoDe(r, resto(r));
      raiz.querySelector('[data-limite]').textContent = texto;
      oculto(raiz.querySelector('[data-plazo]'), plazo);
    }

    // Cada minuto: recalcula sin anunciar; anuncia solo al cruzar 1 h, 15 min o el vencimiento.
    tic() {
      const avisos = [];
      for (const f of this.filas) {
        this.pintarFila(f);
        const u = umbral(resto(f.r) ?? Infinity);
        if (u < f.umbral) avisos.push(anuncios[u](f.r.folio));
        f.umbral = u;
      }
      if (avisos.length) this.querySelector('[data-anuncio]').textContent = avisos.join(' ');
    }

    // --- Detalle ---

    async detalle() {
      if (!UUID.test(new URLSearchParams(location.search).get('id') ?? '')) return this.mostrar('no-encontrada');
      const id = new URLSearchParams(location.search).get('id');
      let r, yo;
      try {
        [r, yo] = await Promise.all([obtenerReserva(id), obtenerPerfil().catch(() => null)]);
      } catch (error) {
        if (error.estado !== 404) throw error;
        return this.mostrar('no-encontrada');
      }
      this.rol = yo?.rol ?? null;
      this.abierto = null;
      this.mostrar('datos');
      this.pintar(validar(r));
      this.encabezado(`${nombre(r.servicio)} · ${fecha(r)}, ${horario(r)}`, r.folio);
      // El folio no se parte en dos lineas.
      document.querySelector('.encabezado-titulo').replaceChildren('Reserva ', folioTitulo(r.folio));
      if (this.rol && this.rol !== 'cliente') {
        const enlace = document.querySelector('.encabezado-ruta a[href="/app/reservas/"]');
        if (enlace) Object.assign(enlace, { textContent: 'Agenda', href: '/app/agenda/' });
      }
      clearInterval(this.temporizador);
      this.temporizador = setInterval(() => this.ticDetalle(), MINUTO);
      this.abrirDeUrl();
      return `Reserva ${r.folio}, ${estadoDe(r)[0].toLowerCase()}`;
    }

    // ?accion=inasistencia (desde la agenda) abre su panel solo si el botón está habilitado; si no, se ignora y queda la ayuda.
    abrirDeUrl() {
      const url = new URL(location.href);
      if (!url.searchParams.has('accion')) return;
      const accion = url.searchParams.get('accion');
      url.searchParams.delete('accion');
      history.replaceState(null, '', url);
      const boton = this.querySelector('[data-abrir="inasistencia"]');
      if (accion === 'inasistencia' && boton && !boton.closest('[data-boton]').hidden && boton.getAttribute('aria-disabled') !== 'true') this.abrir('inasistencia', boton);
    }

    llenarCuotas(r) {
      const molde = this.querySelector('template[data-fila-cuota]');
      this.querySelector('[data-cuotas] tbody').replaceChildren(
        ...(r.cuotas ?? []).map((c) => {
          const fila = molde.content.cloneNode(true).firstElementChild;
          fila.querySelector('[data-concepto]').textContent = textoCuota(c, r.precio.total);
          fila.querySelector('[data-importe]').textContent = soles(c.monto);
          poner(fila.querySelector('.etiqueta'), CUOTAS[c.estado] ?? [String(c.estado).replace(/_/g, ' ').replace(/^./, (x) => x.toUpperCase()), 'neutra']);
          const rechazo = ultimoRechazo(c);
          oculto(fila.querySelector('[data-rechazo]'), rechazo && `Pago rechazado el ${diaMes(fechaDe(rechazo.registrado_en))}: ${rechazo.motivo_rechazo}`);
          // Anulada: por qué; pendiente con algo aplicado (crédito o captura): cuánto falta, en texto.
          const pagado = Math.round(Number(c.pagado ?? 0) * 100);
          const total = Math.round(Number(c.monto) * 100);
          oculto(
            fila.querySelector('[data-sub]'),
            c.estado === 'anulada' ? (r.estado === 'no_asistio' ? 'Se anuló por la inasistencia.' : 'Se anuló al cancelar.')
            : c.estado === 'pendiente' && pagado > 0 && pagado < total ? `Pagado ${soles(c.pagado)} · falta ${soles(((total - pagado) / 100).toFixed(2))}`
            : null,
          );
          return fila;
        }),
      );
    }

    pintar(r) {
      this.reserva = r;
      // Lo que no viene quita su fila (y a la segunda pintada, tras cancelar, ya no esta).
      const campo = (c, v) => {
        const dd = this.querySelector(`[data-campo="${c}"]`);
        if (v) dd.textContent = v;
        else dd?.closest('[data-fila]')?.remove();
      };
      campo('horario', `${fecha(r)}, ${horario(r)}`);
      campo('duracion', duracion(r));
      campo('servicio', nombre(r.servicio));
      campo('sala', nombre(r.sala));
      campo('especialistas', (r.especialistas ?? []).map(nombre).join(', '));
      campo('cliente', r.cliente && nombre(r.cliente));
      const p = r.precio;
      pintarPartidas(this.querySelector('[data-precio] .tabla'), p, r.parametros_aplicados?.porcentaje_adelanto);
      this.llenarCuotas(r);
      this.pintarCancelacion(r);
      this.pintarReprogramaciones(r);
      for (const [panel, texto] of Object.entries(TITULOS)) this.querySelector(`[data-panel="${panel}"] .panel-titulo`).replaceChildren(texto, folioTitulo(r.folio));
      this.pintarEstado();
    }

    // D4: lo que se aplicó al cancelar.
    pintarCancelacion(r) {
      const c = r.cancelacion;
      const bloque = this.querySelector('[data-d4]');
      bloque.hidden = !c;
      if (!c) return;
      const dueno = this.rol === 'cliente';
      const d4 = (clave, texto) => (this.querySelector(`[data-d4="${clave}"]`).textContent = texto);
      d4('aviso', absoluta(c.aviso_en));
      d4('por', c.por === 'estudio' ? 'Del estudio' : c.por === 'inasistencia' ? 'Inasistencia' : dueno ? 'Tuyo' : 'Del cliente');
      oculto(this.querySelector('[data-d4="registrada"]'), c.registrada_por?.nombre);
      this.querySelector('[data-d4="registrada"]').closest('div').hidden = !c.registrada_por?.nombre;
      d4('nivel', nivelTexto(c.nivel, r.politica).replace(/^Sin pagos: cancelas gratis\.$/, 'Sin pagos'));
      d4('pagado', soles(c.pagado));
      d4('retenido', soles(c.retenido));
      d4('credito', positivo(c.credito) ? soles(c.credito) : 'Nada');
      this.querySelector('[data-d4-creditos]').hidden = !(dueno && positivo(c.credito));
      const nota = this.querySelector('[data-d4="nota"]');
      oculto(nota, c.nota);
      nota.closest('div').hidden = !c.nota;
      const ex = this.querySelector('[data-d4="excepcion"]');
      oculto(ex, c.excepcion && `Tratada como nivel 1 el ${diaMes(fechaDe(c.excepcion.en))}: ${c.excepcion.motivo}`);
      ex.closest('div').hidden = !c.excepcion;
    }

    // D5: historial de reprogramaciones, la más reciente arriba.
    pintarReprogramaciones(r) {
      const lista = [...(r.reprogramaciones ?? [])].sort((a, b) => Date.parse(b.en) - Date.parse(a.en));
      this.querySelector('[data-d5]').hidden = !lista.length;
      const molde = this.querySelector('template[data-fila-reprog]');
      const dia = (iso) => `${diaMesAnio(fechaDe(iso))}, ${horaDe(iso)}`;
      this.querySelector('[data-d5] tbody').replaceChildren(
        ...lista.map((x) => {
          const fila = molde.content.cloneNode(true).firstElementChild;
          fila.querySelector('[data-en]').textContent = absoluta(x.en);
          fila.querySelector('[data-antes]').textContent = dia(x.anterior_inicio);
          fila.querySelector('[data-ahora]').textContent = dia(x.nuevo_inicio);
          fila.querySelector('[data-nivel-r]').textContent = x.nivel ? `Nivel ${x.nivel}` : 'Sin costo';
          fila.querySelector('[data-penalizacion]').textContent = soles(x.penalizacion);
          fila.querySelector('[data-total-r]').textContent = `${soles(x.total_anterior)} → ${soles(x.total_nuevo)}`;
          return fila;
        }),
      );
    }

    // Lo que dice la barra de estado de una reserva cancelada o con inasistencia.
    datoTerminal(r) {
      const c = r.cancelacion;
      const dueno = this.rol === 'cliente';
      const t = tolerancia(r);
      if (r.estado === 'no_asistio') {
        return `${dueno ? 'No llegaste' : 'No llegó'}${t === null ? ' a la sesión' : ` en los primeros ${t} minutos`}. Se retuvo lo pagado (${soles(r.pagado ?? c?.pagado ?? '0.00')}); no hay crédito ni cobro adicional.`;
      }
      if (!c) return '';
      if (positivo(c.credito)) return `${soles(c.credito)} pasaron a crédito${dueno ? '. Úsalo en otra reserva.' : ' del cliente.'}`;
      if (positivo(c.retenido)) return `Se retuvo lo pagado (${soles(c.retenido)}), como indican las condiciones.`;
      return '';
    }

    // Estado, barra de lo que toca y acciones segun el estado actual (y el plazo, que corre).
    pintarEstado() {
      const r = this.reserva;
      const ms = resto(r);
      const cuotas = r.cuotas ?? [];
      const resta = cuotas.find((c) => c.hito === 'al_terminar');
      const restoTexto = { en_validacion: 'Pago del resto en validación', pagada: 'Pagada' }[resta?.estado];
      poner(this.querySelector('dl .etiqueta'), estadoDe(r));
      this.querySelector('[data-pago-validar]').hidden = !r.pago_por_validar;
      let tono = 'neutro', texto = estadoDe(r)[0], dato = '';
      if (r.estado === 'pre_reservada' && r.pago_por_validar) [tono, texto, dato] = ['pendiente', 'Pago en validación', 'Registraste tu pago. No caduca mientras el estudio lo revise; te avisaremos por correo.'];
      else if (ms > 0) [tono, texto, dato] = ['pendiente', `Paga el anticipo antes del ${absoluta(r.vence_pago)}`, faltan(ms)];
      else if (caducada(r)) tono = 'problema';
      else if (r.estado === 'no_asistio') [tono, dato] = ['problema', this.datoTerminal(r)];
      else if (r.estado === 'cancelada') dato = this.datoTerminal(r);
      else if (r.estado === 'confirmada') [tono, dato] = ['correcto', restoTexto ?? 'Pagas el resto al terminar la sesión.'];
      else if (r.estado === 'en_curso') dato = restoTexto ?? 'Pagas el resto al terminar.';
      else if (r.estado === 'finalizada') {
        if (resta?.estado === 'pagada') [tono, dato] = ['correcto', 'Pagada'];
        else if (resta?.estado === 'en_validacion') [tono, texto] = ['pendiente', 'Pago del resto en validación'];
        else if (resta) [tono, texto] = ['pendiente', `Falta pagar el resto: ${soles(resta.monto)}`];
        else tono = 'correcto';
      }
      const barra = this.querySelector('[data-estado-reserva] .indicador');
      barra.className = barra.className.replace(/indicador-(correcto|pendiente|problema|neutro)/, `indicador-${tono}`);
      barra.querySelector('.indicador-texto').textContent = texto;
      oculto(barra.querySelector('.indicador-dato'), dato);
      oculto(this.querySelector('[data-nota]'), motivo(r));
      oculto(this.querySelector('[data-nota-estudio]'), !r.cancelacion && r.nota_cancelacion && `Nota del estudio: ${r.nota_cancelacion}`);
      const menos = this.querySelector('[data-menos-hora]');
      menos.hidden = !(ms > 0 && ms < 60 * MINUTO);
      if (!menos.hidden && !menos.dataset.listo) {
        menos.dataset.listo = '1';
        llenarAviso(menos.querySelector('.aviso'), `Tu reserva vence en ${Math.floor(ms / MINUTO)} min`, 'Si no registras el pago, se cancelará y el horario se liberará.');
      }
      // Registrar pago (solo el dueño): primario si la cuota toca ya; secundario si adelanta el resto.
      const pagable = this.rol === 'cliente' && !caducada(r) ? cuotas.find((c) => c.pagable) : null;
      const bloquePago = this.querySelector('[data-pagar]');
      bloquePago.hidden = !pagable;
      if (pagable) {
        const toca = pagable.hito === 'al_reservar' || r.estado === 'finalizada';
        const enlace = bloquePago.querySelector('a');
        enlace.href = `/app/reservas/pagar?id=${encodeURIComponent(r.id)}&cuota=${encodeURIComponent(pagable.id)}`;
        enlace.firstChild.textContent = toca ? 'Registrar pago' : 'Adelantar el pago del resto';
        enlace.className = enlace.className.replace(/boton-(primario|secundario)/, toca ? 'boton-primario' : 'boton-secundario');
      }
      this.pintarAcciones();
    }

    // Quién ve qué acción (spec RF-18-cancelar y RF-18-acciones-administrador). Se recalcula cada minuto: la ventana de la inasistencia corre.
    pintarAcciones() {
      const r = this.reserva;
      const admin = this.rol === 'administrador';
      const staff = admin || this.rol === 'personal';
      const ahora = Date.now();
      const inicio = Date.parse(r.inicio);
      const vivo = !caducada(r);
      const c = r.cancelacion;
      // Inasistencia: desde el inicio hasta el fin; habilitada pasada la tolerancia.
      const t = tolerancia(r);
      const habil = inicio + (t ?? 0) * MINUTO;
      const enVentana = staff && vivo && ['pre_reservada', 'confirmada', 'en_curso'].includes(r.estado) && ahora >= inicio && ahora < Date.parse(r.fin);
      const esperar = enVentana && ahora < habil;
      const boton = this.querySelector('[data-abrir="inasistencia"]');
      const ayuda = this.querySelector('[data-ayuda-na]');
      const hora = horaDe(new Date(habil).toISOString());
      boton.toggleAttribute('aria-disabled', esperar);
      if (esperar) boton.setAttribute('aria-disabled', 'true');
      oculto(ayuda, esperar || this.avisoNa ? (this.avisoNa ? `Aún no pasaron ${t} minutos desde el inicio. Podrás marcarlo desde las ${hora}.` : `Podrás marcarlo desde las ${hora}, ${t} minutos después del inicio.`) : null);
      if (ayuda.hidden) boton.removeAttribute('aria-describedby');
      else boton.setAttribute('aria-describedby', ayuda.id);
      this.alternar('inasistencia', enVentana);
      // Tratar como nivel 1: solo el Administrador, una vez por reserva.
      const excepcion = admin && ((r.estado === 'cancelada' && c?.por === 'cliente' && [2, 3].includes(c.nivel) && positivo(c.retenido) && !c.excepcion) || (r.estado === 'no_asistio' && c?.por === 'inasistencia' && positivo(c.retenido) && !c.excepcion));
      this.alternar('excepcion', excepcion);
      // Cancelar: el dueño la solicita; el Administrador la hace por el estudio o a pedido del cliente. Solo antes del inicio.
      const cancelable = vivo && ['pre_reservada', 'confirmada'].includes(r.estado) && inicio > ahora && (this.rol === 'cliente' || admin);
      this.querySelector('[data-abrir="cancelar"]').textContent = admin ? 'Cancelar reserva' : 'Solicitar cancelación';
      this.alternar('cancelar', cancelable);
    }

    // Muestra el botón de la acción (si aplica y su panel no está abierto) o su panel (si está abierto); si la acción ya no aplica, cierra su panel.
    alternar(nombre, aplica) {
      if (!aplica && this.abierto === nombre) this.abierto = null;
      this.querySelector(`[data-boton="${nombre}"]`).hidden = !aplica || this.abierto === nombre;
      this.querySelector(`[data-panel="${nombre}"]`).hidden = !(aplica && this.abierto === nombre);
    }

    ticDetalle() {
      if (!this.reserva || !this.querySelector('[data-estado-reserva]')) return;
      const vencia = !caducada(this.reserva);
      this.pintarEstado();
      if (vencia && caducada(this.reserva)) this.querySelector('[data-anuncio]').textContent = `La reserva ${this.reserva.folio} venció sin pago.`;
    }

    // --- Paneles de acción: confirmacion en la misma pantalla, con foco y Escape ---

    abrir(nombre, boton) {
      if (this.ocupado) return;
      if (boton?.getAttribute('aria-disabled') === 'true') {
        // Deshabilitado pero enfocable: explica por qué en lugar de abrir.
        this.avisoNa = true;
        this.pintarAcciones();
        this.querySelector('[data-anuncio]').textContent = this.querySelector('[data-ayuda-na]').textContent;
        return;
      }
      limpiarAvisos(this);
      this.abierto = nombre;
      this.pintarAcciones();
      const titulo = this.querySelector(`[data-panel="${nombre}"] .panel-titulo`);
      titulo.tabIndex = -1;
      titulo.focus();
      if (nombre === 'cancelar') this.prepararCancelar();
      else if (nombre === 'inasistencia') this.prepararInasistencia();
      else this.prepararExcepcion();
    }

    cerrar() {
      if (this.ocupado) return;
      const nombre = this.abierto;
      this.abierto = null;
      this.pintarAcciones();
      this.querySelector(`[data-abrir="${nombre}"]`)?.focus();
    }

    // Aviso dentro del panel de cancelar (sobre su contenido); devuelve el nodo.
    avisoPanel(variante, titulo, texto, opciones) {
      const aviso = mostrarAviso(this, variante, titulo, texto, opciones);
      this.querySelector('[data-panel-aviso]').replaceChildren(aviso);
      return aviso;
    }

    // Tras una acción que cambia la reserva: se repinta con la respuesta y se avisa del resultado.
    despues(nueva, ...aviso) {
      this.abierto = null;
      limpiarAvisos(this);
      this.pintar(validar(nueva));
      enfocarAviso(mostrarAviso(this, 'exito', ...aviso));
    }

    // 409: la reserva cambió desde otra sesión; se vuelve a leer y se explica.
    async cambio(texto) {
      this.abierto = null;
      try {
        this.pintar(validar(await obtenerReserva(this.reserva.id)));
      } catch {}
      enfocarAviso(mostrarAviso(this, 'informacion', typeof texto === 'function' ? texto(estadoDe(this.reserva)[0].toLowerCase()) : texto));
    }

    errorEnvio(error) {
      const accion = this.abierto;
      if (error.estado === 404) {
        this.sustituir('no-encontrada');
        return true;
      }
      if (accion === 'cancelar') return this.errorCancelar(error);
      if (accion === 'inasistencia' && error.estado === 409) {
        if (error.codigo === 'tolerancia_no_cumplida') {
          this.abierto = null;
          this.avisoNa = true;
          this.pintarAcciones();
          this.querySelector('[data-abrir="inasistencia"]').focus();
        } else this.cambio((estado) => `Esta reserva ya no admite marcar la inasistencia: está ${estado}.`);
        return true;
      }
      if (accion === 'excepcion') {
        if (error.estado === 409) {
          this.cambio(error.codigo === 'excepcion_ya_aplicada' ? 'Esta reserva ya se trató como nivel 1, quizá desde otra sesión.' : 'Esta reserva no admite el caso excepcional.');
          return true;
        }
        if (error.estado === 422) {
          this.validar([{ entrada: this.querySelector('#excepcion-motivo'), mensaje: MOTIVO_EXCEPCION, texto: 'Motivo' }]);
          return true;
        }
      }
      return false;
    }

    // --- Cancelar ---

    get admin() {
      return this.rol === 'administrador';
    }

    prepararCancelar() {
      const r = this.reserva;
      this.querySelector('[data-resumen]').textContent = `${nombre(r.servicio)} · ${fecha(r)}, ${horario(r)}`;
      this.querySelector('[data-panel-aviso]').replaceChildren();
      this.previa = null;
      this.secuencia++;
      const parte = this.querySelector('[data-parte="admin"]');
      parte.hidden = !this.admin;
      const aviso = this.querySelector('[data-panel="cancelar"] [data-consecuencia]');
      this.querySelector('[data-confirmar-cancelar]').textContent = this.admin ? `Cancelar reserva ${r.folio}` : 'Confirmar cancelación';
      if (this.admin) {
        this.querySelectorAll('[data-panel="cancelar"] input[name="por"]').forEach((x) => (x.checked = false));
        this.querySelectorAll('[data-panel="cancelar"] .campo-control').forEach((x) => { x.value = ''; quitarError(x); });
        this.querySelector('[data-previa]').hidden = true;
        this.querySelector('[data-confirmar-cancelar]').hidden = false;
        this.querySelectorAll('[data-campos]').forEach((x) => (x.hidden = true));
        aviso.textContent = '';
        this.querySelector('[data-condiciones]').closest('p').hidden = true;
      } else {
        this.querySelector('[data-condiciones]').closest('p').hidden = false;
        this.pedirVista();
      }
    }

    // El cliente pide la vista previa al abrir; el Administrador, con el aviso_en de su mensaje.
    async pedirVista(avisoEn) {
      const n = ++this.secuencia;
      this.previa = null;
      this.querySelector('[data-panel-aviso]').replaceChildren();
      this.estadoVista('carga');
      let v;
      try {
        v = await verCancelacion(this.reserva.id, avisoEn);
      } catch (error) {
        if (n === this.secuencia) this.errorVista(error, avisoEn);
        return;
      }
      if (n !== this.secuencia) return;
      this.previa = v;
      this.estadoVista('datos');
      this.pintarVista(v);
    }

    estadoVista(estado) {
      this.querySelector('[data-previa]').hidden = estado === 'nada';
      const carga = this.querySelector('[data-previa-carga]');
      carga.hidden = estado !== 'carga';
      if (estado === 'carga') carga.setAttribute('aria-busy', 'true');
      else carga.removeAttribute('aria-busy');
      this.querySelector('[data-previa-datos]').hidden = estado !== 'datos';
      if (!this.admin) this.querySelector('[data-confirmar-cancelar]').hidden = estado !== 'datos';
      if (estado === 'carga') this.querySelector('[data-anuncio]').textContent = 'Calculando qué pasa con tu pago…';
    }

    pintarVista(v) {
      const p = this.reserva.politica;
      this.querySelector('[data-nivel]').textContent = nivelTexto(v.nivel, p);
      this.querySelector('[data-anticipacion]').textContent = anticipacionTexto(v.anticipacion_horas, this.admin ? 'la' : 'tu');
      const dl = this.querySelector('[data-dl]');
      dl.hidden = !v.nivel;
      dl.replaceChildren(
        ...filasVista(v).map(([etiqueta, valor]) => {
          const fila = document.createElement('div');
          fila.append(Object.assign(document.createElement('dt'), { textContent: etiqueta }), Object.assign(document.createElement('dd'), { textContent: valor }));
          return fila;
        }),
      );
      oculto(this.querySelector('[data-validacion]'), avisoValidacion(v.nivel, v.en_validacion));
      if (!this.admin) this.querySelector('[data-panel="cancelar"] [data-consecuencia]').textContent = consecuenciaCancelar(v.nivel, p);
      this.querySelector('[data-anuncio]').textContent = v.nivel ? `Vista previa lista: nivel ${v.nivel}, se retienen ${soles(v.retenido)}.` : 'Vista previa lista: sin pagos, cancelas gratis.';
    }

    errorVista(error, avisoEn) {
      if (error.estado === 401 || error.estado === 403) return this.sustituir(error.estado === 401 ? 'no-autenticado' : 'sin-permiso');
      if (error.estado === 404) return this.sustituir('no-encontrada');
      if (error.estado === 409) return this.cambio((estado) => `Esta reserva ya no se puede cancelar: está ${estado}.`);
      if (error.estado === 422 && this.admin) {
        this.estadoVista('nada');
        return this.validar([{ entrada: this.querySelector('#cancelar-fecha'), mensaje: AVISO_INVALIDO, texto: 'Fecha del aviso' }]);
      }
      this.estadoVista('nada');
      const aviso = this.avisoPanel('error', ...mensajeError(error), { boton: { texto: 'Reintentar', atributo: 'data-reintentar-previa' } });
      aviso.removeAttribute('role');
      this.querySelector('[data-anuncio]').textContent = aviso.textContent.replace(/\s+/g, ' ').trim();
      this.avisoReintento = avisoEn;
    }

    // Administrador: elegir quién pide cancelar muestra sus campos, sus consecuencias y, a pedido del cliente, la vista previa.
    cambiarOpcion() {
      const por = this.querySelector('input[name="por"]:checked')?.value;
      this.querySelectorAll('[data-campos]').forEach((x) => (x.hidden = x.dataset.campos !== por));
      const r = this.reserva;
      const pagos = this.conPagos();
      const nota = this.querySelector('label[for="cancelar-nota-estudio"]');
      nota.replaceChildren(pagos ? 'Nota para el cliente ' : 'Nota para el cliente', ...(pagos ? [Object.assign(document.createElement('span'), { textContent: '(obligatorio)' })] : []));
      this.querySelector('[data-condiciones]').closest('p').hidden = por !== 'cliente';
      this.querySelector('[data-panel="cancelar"] [data-consecuencia]').textContent =
        por === 'estudio'
          ? pagos ? `El horario se libera al momento. El cliente elegirá en la app entre reprogramar sin costo o la devolución íntegra de ${soles(r.pagado)}, que haces en un máximo de 7 días hábiles. Le avisamos por correo.` : 'El horario se libera al momento y avisamos al cliente por correo.'
          : 'Se aplica la misma política que si cancelara desde la app, con el nivel que corresponde a la fecha y hora de su mensaje. El horario se libera al momento y le avisamos por correo con el detalle.';
      this.secuencia++;
      this.querySelector('[data-panel-aviso]').replaceChildren();
      if (por === 'cliente') this.vistaDelAviso();
      else this.estadoVista('nada');
    }

    conPagos() {
      return positivo(this.reserva.pagado) || tienePagos(this.reserva);
    }

    // Vista previa con el aviso_en cuando fecha y hora están completas.
    vistaDelAviso() {
      const fecha = this.querySelector('#cancelar-fecha');
      const hora = this.querySelector('#cancelar-hora');
      quitarError(fecha);
      if (fecha.value && hora.value) this.pedirVista(instante(fecha.value, hora.value));
      else this.estadoVista('nada');
    }

    cancelar() {
      const r = this.reserva;
      const cuerpo = {};
      let opcion = null;
      if (this.admin) {
        const por = this.querySelector('input[name="por"]:checked')?.value;
        const errores = [];
        const nota = this.querySelector(por === 'estudio' ? '#cancelar-nota-estudio' : '#cancelar-nota-cliente');
        this.querySelectorAll('[data-panel="cancelar"] [aria-invalid="true"]').forEach(quitarError);
        if (!por) errores.push({ entrada: this.querySelector('#cancelar-por-estudio'), mensaje: 'Elige quién pide cancelar.', texto: '¿Quién pide cancelar?' });
        else {
          const texto = nota.value.trim();
          if (!texto && (por === 'cliente' || this.conPagos())) errores.push({ entrada: nota, mensaje: 'Escribe la nota para el cliente.', texto: 'Nota' });
          else if (texto.length > 300) errores.push({ entrada: nota, mensaje: 'La nota admite hasta 300 caracteres.', texto: 'Nota' });
          if (por === 'cliente') {
            const [fecha, hora] = [this.querySelector('#cancelar-fecha'), this.querySelector('#cancelar-hora')];
            if (!fecha.value || !hora.value) errores.unshift({ entrada: fecha, mensaje: 'Elige la fecha y la hora del aviso.', texto: 'Fecha del aviso' });
            else cuerpo.aviso_en = instante(fecha.value, hora.value);
          }
          Object.assign(cuerpo, { por }, texto && { nota: texto });
        }
        if (!this.validar(errores)) return;
        opcion = por;
      } else {
        // Nunca se confirma sin vista previa; con pagos va el nivel mostrado, para que un plazo cruzado no cambie lo que se acepta.
        if (!this.previa) return;
        if (this.previa.nivel) cuerpo.nivel_esperado = this.previa.nivel;
      }
      this.enviar(this.querySelector('[data-confirmar-cancelar]'), 'Cancelando…', () => cancelarReserva(r.id, cuerpo), (nueva) => this.cancelada(nueva, opcion));
    }

    // Resultado de cancelar, según quién la hizo.
    cancelada(nueva, opcion) {
      const c = nueva.cancelacion;
      if (this.admin) {
        const aviso = opcion === 'cliente' ? [`Reserva cancelada a pedido del cliente (${c?.nivel ? `nivel ${c.nivel}` : 'sin pagos'}). Le avisamos con el detalle.`]
          : this.conPagos() ? ['Reserva cancelada', 'El horario quedó libre y avisamos al cliente para que elija entre reprogramar sin costo o la devolución íntegra.']
          : ['Reserva cancelada', 'El horario quedó libre y avisamos al cliente por correo.'];
        return this.despues(nueva, ...aviso);
      }
      const texto = !c?.nivel ? 'El horario quedó libre y no se te cobró nada.'
        : positivo(c.credito) ? `${soles(c.credito)} pasaron a crédito${this.previa?.credito_vence ? ` hasta el ${diaMesAnio(fechaDe(this.previa.credito_vence))}` : ''}. Te enviamos el detalle por correo.`
        : `Se retuvo lo pagado (${soles(c.retenido)}). Te enviamos el detalle por correo.`;
      this.despues(nueva, 'Reserva cancelada', texto);
    }

    errorCancelar(error) {
      if (error.estado === 409 && error.codigo === 'nivel_cambiado' && error.detalles) {
        // Se cruzó un plazo mientras leía: se repinta con la vista nueva y se pide confirmar otra vez.
        this.secuencia++;
        this.previa = error.detalles;
        this.estadoVista('datos');
        this.pintarVista(error.detalles);
        enfocarAviso(this.avisoPanel('aviso', `Mientras lo revisabas pasó un plazo: ahora es nivel ${error.detalles.nivel}`, 'Revisa qué pasa con tu pago y confirma de nuevo.'));
        return true;
      }
      if (error.estado === 409) {
        this.cambio((estado) => `Esta reserva ya no se puede cancelar: está ${estado}.`);
        return true;
      }
      if (error.estado === 422 && this.admin) {
        const por = this.querySelector('input[name="por"]:checked')?.value;
        const nota = this.querySelector(por === 'estudio' ? '#cancelar-nota-estudio' : '#cancelar-nota-cliente');
        const errores = error.codigo === 'aviso_invalido' ? [{ entrada: this.querySelector('#cancelar-fecha'), mensaje: AVISO_INVALIDO, texto: 'Fecha del aviso' }]
          : [{ entrada: nota, mensaje: error.codigo === 'nota_requerida' ? 'Escribe la nota para el cliente.' : 'La nota admite hasta 300 caracteres.', texto: 'Nota' }];
        this.validar(errores);
        return true;
      }
      return false;
    }

    // --- No asistió ---

    prepararInasistencia() {
      const r = this.reserva;
      const t = tolerancia(r);
      this.querySelector('[data-resumen-na]').textContent = `${r.cliente ? nombre(r.cliente) : 'El cliente'} no llegó${t === null ? ' a la sesión' : ` en los primeros ${t} minutos`}.`;
      this.querySelector('[data-panel="inasistencia"] [data-consecuencia]').textContent = `Se retiene lo pagado (${soles(r.pagado ?? '0.00')}), se anula el saldo y no hay crédito ni cobro adicional. El horario sigue ocupado. Avisamos al cliente por correo. No se puede deshacer: solo el Administrador puede tratarla después como nivel 1.`;
    }

    inasistencia() {
      this.enviar(this.querySelector('[data-panel="inasistencia"] [type="submit"]'), 'Marcando…', () => marcarInasistencia(this.reserva.id), (nueva) => {
        this.avisoNa = false;
        this.despues(nueva, 'Inasistencia registrada', 'Avisamos al cliente por correo.');
      });
    }

    // --- Tratar como nivel 1 ---

    retenidoHoy() {
      const r = this.reserva;
      return r.cancelacion?.retenido ?? r.pagado;
    }

    prepararExcepcion() {
      const campo = this.querySelector('#excepcion-motivo');
      campo.value = '';
      quitarError(campo);
      const retenido = this.retenidoHoy();
      const d = this.reserva.politica?.dias_vigencia_credito;
      this.querySelector('[data-retenido-hoy]').textContent = soles(retenido);
      this.querySelector('[data-panel="excepcion"] [data-consecuencia]').textContent = `Lo retenido (${soles(retenido)}) pasa a un crédito de caso excepcional que vence ${d ? `${d} días` : 'unos días'} después de hoy y admite devolución. Solo se puede hacer una vez por reserva y queda registrado quién y por qué. No se puede deshacer.`;
    }

    excepcion() {
      const campo = this.querySelector('#excepcion-motivo');
      quitarError(campo);
      const motivoTexto = campo.value.trim();
      if (!this.validar(motivoTexto.length < 10 || motivoTexto.length > 500 ? [{ entrada: campo, mensaje: MOTIVO_EXCEPCION, texto: 'Motivo' }] : [])) return;
      const retenido = this.retenidoHoy();
      this.enviar(this.querySelector('[data-panel="excepcion"] [type="submit"]'), 'Aplicando…', () => aplicarExcepcion(this.reserva.id, motivoTexto), (nueva) => this.despues(nueva, 'Tratada como nivel 1', `${soles(retenido)} pasaron a crédito del cliente, con devolución posible.`));
    }
  }

  if (!customElements.get('bugalu-reservas')) customElements.define('bugalu-reservas', BugaluReservas);
</script>

<style>
