---
// <bugalu-pago>: registrar el pago de una cuota (spec RF-05-registrar-pago). Datos de la reserva e instrucciones por la API.
import Panel from '../componentes/Panel.astro';
import Aviso from '../componentes/Aviso.astro';
import Boton from '../componentes/Boton.astro';
import Campo from '../componentes/Campo.astro';
import Casilla from '../componentes/Casilla.astro';
import EtiquetaTecnica from '../componentes/EtiquetaTecnica.astro';
import EstadosIsla from '../componentes/internos/EstadosIsla.astro';
import EstilosGestion from '../componentes/internos/EstilosGestion.astro';
import CargaArchivos from './CargaArchivos.astro';
import PlantillasResumenLegal from '../componentes/internos/PlantillasResumenLegal.astro';

const principal = { titulo: 'Registrar pago' };
const AYUDA_MONTO = 'El que pagaste de verdad, con céntimos (225,00).';
---

<EstilosGestion />

<bugalu-pago class="pago" data-gestion vista="pagar">
  <div data-avisos></div>
  <p class="visualmente-oculto" role="status" data-anuncio></p>
  <div data-salida><Panel {...principal} cargando /></div>

  <EstadosIsla principal={principal} />
  <PlantillasResumenLegal />

  <template data-estado="no-encontrada">
    <Panel codigo="[404]" titulo="Cuota no encontrada"><Aviso variante="informacion" titulo=" " texto=" " accion={{ etiqueta: 'Volver a mis reservas', href: '/app/reservas/' }} /></Panel>
  </template>
  <template data-estado="no-pagable">
    <Panel titulo="Cuota a pagar"><Aviso variante="informacion" titulo=" " texto=" " accion={{ etiqueta: 'Volver a la reserva', href: '#' }} /></Panel>
  </template>
  <template data-estado="sin-metodos">
    <Panel codigo="P1" titulo="Método de pago">
      <p class="gestion-vacio-titulo">Por ahora no hay métodos de pago disponibles</p>
      <p>Escríbele al estudio para pagar esta cuota.</p>
      <p class="pago-texto" data-contacto hidden></p>
      <div class="pago-vacio-accion"><Boton variante="secundario" href="#" data-volver>Volver a la reserva</Boton></div>
    </Panel>
  </template>
  <template data-metodo><Casilla tipo="radio" nombre="metodo" valor="" etiqueta=" " detalle=" " /></template>

  <template data-estado="datos">
    <div class="gestion-rejilla">
      <aside class="gestion-lateral">
        <Panel titulo="Cuota a pagar" variante="lateral">
          <EtiquetaTecnica texto="Pendiente" variante="aviso" />
          <dl class="gestion-datos pago-resumen">
            <div><dt>Reserva</dt><dd class="pago-folio" data-campo="folio"></dd></div>
            <div><dt>Servicio</dt><dd data-campo="servicio"></dd></div>
            <div><dt>Fecha</dt><dd data-campo="fecha"></dd></div>
            <div><dt>Cuota</dt><dd data-campo="cuota"></dd></div>
            <div data-fila="vence"><dt>Paga antes de</dt><dd data-campo="vence"></dd></div>
          </dl>
          <p class="pago-total"><span class="pago-total-etiqueta">Importe de la cuota</span><span class="pago-total-importe" data-campo="importe"></span></p>
          <dl class="gestion-datos pago-resumen pago-credito-resumen" data-aplicado hidden>
            <div><dt>Pagado</dt><dd data-campo="pagado"></dd></div>
            <div><dt>Falta pagar</dt><dd data-campo="falta"></dd></div>
          </dl>
          <p class="gestion-ayuda" data-igv hidden></p>
          <div class="pago-rechazo" data-rechazo hidden><Aviso variante="aviso" titulo=" " texto=" " /></div>
        </Panel>
      </aside>
      <div class="gestion-principal">
      <!-- RF-18: P0 va fuera del formulario para que Enter en su monto no registre el pago. -->
      <div data-p0 hidden>
        <Panel codigo="P0" titulo="Crédito">
          <div class="gestion-formulario">
            <Casilla nombre="usar_credito" id="pago-usar-credito" aria-controls="pago-credito-campos" etiqueta="Usar mi crédito" />
            <div class="gestion-formulario" id="pago-credito-campos" hidden>
              <Campo id="pago-credito-monto" nombre="monto_credito" etiqueta="Monto del crédito (S/)" inputmode="decimal" autocomplete="off" ayuda=" " />
              <div><Boton variante="secundario" data-envio data-aplicar-credito>Aplicar crédito</Boton></div>
            </div>
          </div>
        </Panel>
      </div>
      <form class="gestion-principal" novalidate enctype="multipart/form-data">
        <Panel codigo="P1" titulo="Método de pago">
          <div class="campo">
            <fieldset class="gestion-grupo">
              <legend>Método de pago</legend>
              <div class="pago-metodos" data-metodos></div>
            </fieldset>
          </div>
          <div class="pago-datos" data-datos-pago aria-live="polite"></div>
        </Panel>
        <Panel codigo="P2" titulo="Comprobante">
          <div class="gestion-formulario">
            <div class="gestion-fila-campos">
              <Campo id="pago-monto" nombre="monto" etiqueta="Monto pagado (S/)" obligatorio inputmode="decimal" autocomplete="off" ayuda={AYUDA_MONTO} />
              <Campo id="pago-operacion" class="pago-operacion" nombre="numero_operacion" etiqueta="Número de operación" obligatorio autocomplete="off" spellcheck="false" ayuda="Está en la constancia de tu app o en el voucher." />
            </div>
            <CargaArchivos id="pago-captura" nombre="captura" etiqueta="Captura del comprobante" obligatorio ayuda="JPG, PNG o PDF, hasta 5 MB. Que se lean el monto, la fecha y el número de operación." />
          </div>
        </Panel>
        <!-- RF-17: el resumen del pago va junto al boton, sin casilla (variante Lectura). -->
        <div data-resumen-legal></div>
        <div class="pago-barra">
          <div class="pago-acciones">
            <Boton variante="secundario" href="#" data-volver>Volver a la reserva</Boton>
            <Boton tipo="submit" data-envio data-registrar>Registrar pago</Boton>
          </div>
          <p class="gestion-ayuda" data-lento hidden>Subiendo la captura. Con conexión lenta puede tardar un poco.</p>
        </div>
      </form>
      </div>
    </div>
  </template>
</bugalu-pago>

<script>
  // @ts-nocheck
  import { IslaGestion } from '../servicios/isla-gestion.js';
  import { obtenerReserva, absoluta, faltan, textoCuota, ultimoRechazo } from '../servicios/reservas.js';
  import { registrarPago, obtenerInstrucciones, obtenerContacto } from '../servicios/pagos.js';
  import { listarCreditos, usarCredito, disponible } from '../servicios/creditos.js';
  import { fechaDe, horaDe, diaMesAnio, soles, porcentaje, leerImporte, mostrarImporte } from '../servicios/formatos.js';
  import { ponerError, quitarError, mostrarAviso, enfocarAviso, limpiarAvisos, llenarAviso } from '../servicios/formulario.js';
  import { listarTextosLegales } from '../servicios/textos-legales.js';
  import { vigentesDe, vigenteDe, enlaceTexto } from '../servicios/aceptaciones.js';
  import { resumenLegal } from '../servicios/resumen-legal.js';

  const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const AYUDA_MONTO = 'El que pagaste de verdad, con céntimos (225,00).';
  // Orden fijo de los metodos: [nombre, detalle].
  const METODOS = {
    transferencia: ['Transferencia bancaria'],
    yape: ['Yape'],
    plin: ['Plin'],
    tarjeta: ['Tarjeta', 'En el POS del estudio o con el enlace del banco'],
  };
  const MSG = {
    pagada: 'Esta cuota ya está pagada.',
    validacion: 'Ya registraste un pago para esta cuota. Te avisaremos por correo cuando el estudio lo revise.',
    cancelada: 'Esta reserva está cancelada: ya no admite pagos.',
    resto: 'El resto se paga cuando tu reserva esté confirmada.',
    generica: 'Esta cuota ya no admite pagos.',
  };
  const OPERACION = /^[A-Za-z0-9-]{4,40}$/;
  const centimos = (monto) => Math.round(Number(monto ?? 0) * 100);
  const decimal = (c) => (c / 100).toFixed(2);
  const tecnica = (texto) => Object.assign(document.createElement('span'), { textContent: texto });

  class BugaluPago extends IslaGestion {
    noEncontrada = ['No encontramos esta cuota en tu reserva.', ''];
    reserva = null;
    cuota = null;
    lento = 0;

    iniciar() {
      this.addEventListener('change', (e) => {
        if (e.target.matches('input[name="metodo"]')) this.datosMetodo();
        else if (e.target.id === 'pago-monto') this.ayudaMonto();
        else if (e.target.id === 'pago-usar-credito') this.querySelector('#pago-credito-campos').hidden = !e.target.checked;
      });
      this.addEventListener('click', (e) => {
        const boton = e.target.closest('[data-aplicar-credito]');
        if (boton) this.aplicarCredito(boton);
      });
      // Enter en el monto del credito aplica el credito (no registra el pago: P0 no esta en el formulario).
      this.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && e.target.id === 'pago-credito-monto') {
          e.preventDefault();
          this.aplicarCredito(this.querySelector('[data-aplicar-credito]'));
        }
      });
      this.addEventListener('focusout', (e) => e.target.id === 'pago-monto' && this.ayudaMonto());
      this.addEventListener('cambio', () => this.revisarCaptura());
    }

    disconnectedCallback() {
      clearTimeout(this.lento);
    }

    // 401 y 403 llevan el texto de esta pantalla y su propio enlace (como mis reservas).
    mostrar(estado) {
      super.mostrar(estado);
      const aviso = this.querySelector('[data-salida] .aviso');
      if (estado === 'no-autenticado') {
        llenarAviso(aviso, 'Tu sesión no es válida', 'Inicia sesión para ver tus reservas.');
        const enlace = aviso.querySelector('.aviso-accion');
        enlace.textContent = 'Ir al acceso';
        enlace.href = `/acceso?${new URLSearchParams({ volver: location.pathname + location.search })}`;
      } else if (estado === 'sin-permiso') {
        aviso.querySelector('.aviso-titulo').textContent = 'Esta reserva no es tuya.';
        aviso.querySelector('.aviso-texto')?.remove();
        const enlace = aviso.querySelector('.aviso-accion');
        enlace.textContent = 'Volver a mis reservas';
        enlace.href = '/app/reservas/';
      }
    }

    // --- Carga ---

    async pagar() {
      const url = new URLSearchParams(location.search);
      const id = url.get('id') ?? '';
      const cuota = url.get('cuota') ?? '';
      if (!UUID.test(id) || !UUID.test(cuota)) return this.mostrar('no-encontrada');
      let r, instrucciones;
      try {
        // Los creditos son un extra: sin ellos la pantalla sigue igual.
        [r, instrucciones, this.creditos] = await Promise.all([obtenerReserva(id), obtenerInstrucciones(), listarCreditos().then((l) => (Array.isArray(l) ? l : []), () => [])]);
      } catch (error) {
        if (error.estado !== 404) throw error;
        return this.mostrar('no-encontrada');
      }
      const c = (r.cuotas ?? []).find((x) => x.id === cuota);
      if (!c) return this.mostrar('no-encontrada');
      this.reserva = r;
      this.cuota = c;
      this.retocarRuta(r);
      const motivo = this.noPagable(r, c);
      if (motivo) return this.verNoPagable(motivo);
      const activos = this.activos(instrucciones);
      if (!activos.length) return this.sinMetodos();
      this.mostrar('datos');
      this.pintar(r, c, activos);
      return 'Registrar pago';
    }

    activos(instrucciones) {
      const lista = Array.isArray(instrucciones) ? instrucciones.filter((i) => i.activo !== false && Object.hasOwn(METODOS, i.metodo)) : [];
      this.textos = Object.fromEntries(lista.map((i) => [i.metodo, i.texto]));
      return Object.keys(METODOS).filter((m) => m in this.textos);
    }

    // Reserva y cuota -> mensaje de "no se puede pagar", o null si se puede. `codigo`: 409 recibido al enviar.
    noPagable(r, c, codigo) {
      if (c.estado === 'pagada' || codigo === 'cuota_pagada') return MSG.pagada;
      if (c.estado === 'en_validacion' || codigo === 'pago_en_validacion') return MSG.validacion;
      if (r.estado === 'cancelada') return MSG.cancelada;
      if (!c.pagable) return c.hito === 'al_terminar' ? MSG.resto : MSG.generica;
      return codigo ? MSG.generica : null;
    }

    verNoPagable(texto) {
      limpiarAvisos(this);
      this.mostrar('no-pagable');
      const aviso = this.querySelector('[data-salida] .aviso');
      llenarAviso(aviso, texto);
      aviso.querySelector('.aviso-accion').href = this.urlReserva();
    }

    async sinMetodos() {
      this.mostrar('sin-metodos');
      this.querySelector('[data-volver]').href = this.urlReserva();
      try {
        const { texto } = await obtenerContacto();
        const p = this.querySelector('[data-contacto]');
        if (texto && p) {
          p.textContent = texto;
          p.hidden = false;
        }
      } catch {} // el contacto es un extra: sin el, queda el mensaje
      return 'Por ahora no hay métodos de pago disponibles';
    }

    urlReserva() {
      return `/app/reservas/detalle?id=${encodeURIComponent(this.reserva.id)}`;
    }

    // Ruta: Inicio / Reservas / {folio} / Pagar.
    retocarRuta(r) {
      const enlace = document.querySelector('.encabezado-ruta li:nth-last-child(2) a');
      if (enlace) Object.assign(enlace, { textContent: r.folio, href: this.urlReserva() });
    }

    pintar(r, c, activos) {
      const campo = (nombre, valor) => (this.querySelector(`[data-campo="${nombre}"]`).textContent = valor);
      campo('folio', r.folio);
      campo('servicio', typeof r.servicio === 'object' ? r.servicio.nombre : r.servicio);
      campo('fecha', `${diaMesAnio(fechaDe(r.inicio))}, ${horaDe(r.inicio)}–${horaDe(r.fin)}`);
      campo('cuota', textoCuota(c, r.precio?.total));
      campo('importe', soles(c.monto));
      const igv = r.precio?.impuesto?.porcentaje ?? r.parametros_aplicados?.porcentaje_igv;
      const nota = this.querySelector('[data-igv]');
      nota.hidden = igv === undefined;
      if (igv !== undefined) nota.textContent = `Incluye IGV (${porcentaje(igv)}).`;
      const ms = r.estado === 'pre_reservada' && r.vence_pago && !r.pago_por_validar ? Date.parse(r.vence_pago) - Date.now() : 0;
      if (ms > 0) campo('vence', `${absoluta(r.vence_pago)} · ${faltan(ms)}`);
      else this.querySelector('[data-fila="vence"]').remove();
      const rechazo = ultimoRechazo(c);
      if (rechazo) {
        const caja = this.querySelector('[data-rechazo]');
        caja.hidden = false;
        llenarAviso(caja.querySelector('.aviso'), `Rechazamos tu pago del ${absoluta(rechazo.registrado_en)}: «${rechazo.motivo_rechazo}»`, 'Corrígelo y regístralo de nuevo.');
        caja.querySelector('.aviso').removeAttribute('role');
      }
      // Lo ya aplicado (credito o captura): el resto se paga con captura.
      this.falta = decimal(Math.max(centimos(c.monto) - centimos(c.pagado), 0));
      const aplicado = centimos(c.pagado) > 0;
      this.querySelector('[data-aplicado]').hidden = !aplicado;
      if (aplicado) {
        campo('pagado', soles(c.pagado));
        campo('falta', soles(this.falta));
      }
      this.querySelector('#pago-monto').value = mostrarImporte(this.falta);
      this.querySelector('[data-volver]').href = this.urlReserva();
      this.pintarCredito();
      this.pintarMetodos(activos);
      this.resumenPago();
    }

    // P0: solo si hay crédito disponible (sin devolución pendiente). Se puede usar hasta lo que falta de la cuota.
    pintarCredito() {
      const bloque = this.querySelector('[data-p0]');
      const disp = disponible(this.creditos ?? []);
      bloque.hidden = !(centimos(disp) > 0 && centimos(this.falta) > 0);
      if (bloque.hidden) return;
      this.maximoCredito = decimal(Math.min(centimos(disp), centimos(this.falta)));
      this.querySelector('#pago-usar-credito').closest('.casilla').querySelector('.casilla-etiqueta').textContent = `Usar mi crédito (${soles(disp)} disponible)`;
      this.querySelector('#pago-credito-monto-ayuda').textContent = `Hasta ${soles(this.maximoCredito)}. Se aplica al momento, sin validación, y no se puede deshacer.`;
      const monto = this.querySelector('#pago-credito-monto');
      if (!monto.value || centimos(leerImporte(monto.value)) > centimos(this.maximoCredito)) monto.value = mostrarImporte(this.maximoCredito);
    }

    aplicarCredito(boton) {
      const campo = this.querySelector('#pago-credito-monto');
      quitarError(campo);
      const importe = leerImporte(campo.value);
      const max = this.maximoCredito;
      this.accion = 'credito';
      if (importe === null || centimos(importe) <= 0 || centimos(importe) > centimos(max)) return this.errorMonto(`Escribe un monto mayor que 0 y de hasta ${soles(max)}.`);
      this.enviar(boton, 'Aplicando…', () => usarCredito(this.cuota.id, { monto: importe }), (r) => this.tras(r, importe));
    }

    errorMonto(mensaje) {
      this.validar([{ entrada: this.querySelector('#pago-credito-monto'), mensaje, texto: 'Monto del crédito' }]);
    }

    // Credito aplicado: si cubrio la cuota se va al detalle (la reserva ya esta confirmada si era el adelanto); si no, se recarga con lo que falta.
    async tras(r, importe) {
      const c = (r.cuotas ?? []).find((x) => x.id === this.cuota.id);
      if (!c || c.estado === 'pagada' || centimos(c.pagado) >= centimos(c.monto)) {
        const confirma = this.reserva.estado === 'pre_reservada' && r.estado === 'confirmada';
        return location.assign(`${this.urlReserva()}&aviso=${confirma ? 'pagado-con-credito-confirmada' : 'pagado-con-credito'}`);
      }
      await this.cargar();
      enfocarAviso(mostrarAviso(this, 'exito', `Aplicaste ${soles(importe)} de crédito`, `Paga los ${soles(decimal(centimos(c.monto) - centimos(c.pagado)))} que faltan con tu comprobante.`));
    }

    // Errores de aplicar el credito (spec RF-18-creditos, Estados).
    async errorCredito(error) {
      if (error.estado === 404) return this.sustituir('no-encontrada');
      if (error.estado === 422) return this.errorMonto(`Escribe un monto mayor que 0 y de hasta ${soles(this.maximoCredito)}.`);
      if (error.estado === 409 && error.codigo === 'credito_insuficiente') {
        try {
          this.creditos = await listarCreditos();
        } catch {}
        this.pintarCredito();
        return this.errorMonto(`Tu crédito cambió: ahora tienes ${soles(disponible(this.creditos ?? []))}. Revisa el monto.`);
      }
      if (error.estado === 409) return this.yaNoPagable(error.codigo === 'cuota_pagada' ? 'cuota_pagada' : 'cuota_no_pagable');
      const [titulo, texto] =
        error.estado === 0 ? ['Sin conexión', 'Tus datos siguen aquí; revisa tu red y vuelve a intentarlo.']
        : error.estado === 503 ? ['No pudimos aplicar el crédito: el servicio no responde', 'Tus datos siguen aquí; inténtalo en unos minutos.']
        : ['Algo salió mal', 'Tus datos siguen aquí; inténtalo de nuevo.'];
      enfocarAviso(mostrarAviso(this, 'error', titulo, texto));
    }

    // Resumen de lectura del pago (RF-17): es un extra, sin el se puede pagar igual.
    async resumenPago() {
      try {
        const lista = await listarTextosLegales();
        const texto = vigentesDe(lista, 'pago')[0];
        const destino = vigenteDe(lista, 'condiciones_contratacion') ?? texto;
        if (!texto) return;
        const nombre = destino.tipo === 'condiciones_contratacion' ? 'las Condiciones de contratación' : 'la Política de privacidad';
        this.querySelector('[data-resumen-legal]')?.replaceChildren(
          resumenLegal(this, { variante: 'lectura', titulo: 'Registro de un pago', resumenes: [texto.resumenes.pago], enlaces: [{ etiqueta: `Leer ${nombre} (versión ${destino.version})`, href: enlaceTexto(destino.tipo, destino.version) }] }),
        );
      } catch {}
    }

    pintarMetodos(activos, marcado) {
      const molde = this.querySelector('template[data-metodo]');
      this.querySelector('[data-metodos]').replaceChildren(
        ...activos.map((metodo) => {
          const nodo = molde.content.cloneNode(true);
          const entrada = nodo.querySelector('input');
          entrada.value = metodo;
          entrada.id = `pago-metodo-${metodo}`;
          entrada.checked = metodo === marcado || activos.length === 1;
          nodo.querySelector('.casilla-etiqueta').textContent = METODOS[metodo][0];
          const detalle = nodo.querySelector('.casilla-detalle');
          if (METODOS[metodo][1]) detalle.textContent = METODOS[metodo][1];
          else detalle.remove();
          return nodo;
        }),
      );
      this.datosMetodo();
    }

    // Datos para pagar del metodo elegido, en una region viva: se anuncian al cambiar de metodo.
    datosMetodo() {
      const elegido = this.querySelector('input[name="metodo"]:checked')?.value;
      const zona = this.querySelector('[data-datos-pago]');
      if (!elegido) {
        zona.replaceChildren(Object.assign(document.createElement('p'), { className: 'gestion-ayuda', textContent: 'Elige un método para ver los datos.' }));
        return;
      }
      zona.replaceChildren(
        Object.assign(document.createElement('h3'), { className: 'pago-datos-titulo', textContent: `Datos para pagar con ${METODOS[elegido][0]}` }),
        Object.assign(document.createElement('p'), { className: 'pago-texto', textContent: this.textos[elegido] }),
      );
    }

    // RN-04 admite pagar otro monto: la ayuda avisa, no es error.
    ayudaMonto() {
      const v = leerImporte(this.querySelector('#pago-monto').value);
      const distinto = v !== null && Number(v) > 0 && Number(v) !== Number(this.falta);
      this.querySelector('#pago-monto-ayuda').textContent = distinto ? `No coincide con la cuota (${soles(this.falta)}). Puedes registrarlo igual: el estudio lo revisará.` : AYUDA_MONTO;
    }

    revisarCaptura() {
      const carga = this.querySelector('bugalu-carga-archivos');
      quitarError(carga.entrada);
      const error = carga.error();
      if (error && carga.archivo) ponerError(this, carga.entrada, error);
    }

    // --- Envio ---

    limpiarErrores() {
      this.querySelectorAll('[aria-invalid="true"]').forEach(quitarError);
    }

    alEnviar() {
      this.accion = 'pago';
      const entradas = this.entradas();
      const { metodo, monto, operacion, carga } = entradas;
      this.limpiarErrores();
      const importe = leerImporte(monto.value);
      const numero = operacion.value.trim();
      const errores = [];
      if (!metodo) errores.push({ entrada: this.querySelector('input[name="metodo"]'), mensaje: 'Elige cómo pagaste.', texto: 'Método de pago' });
      if (importe === null || Number(importe) <= 0) errores.push({ entrada: monto, mensaje: 'Escribe el monto que pagaste, mayor que 0 (por ejemplo, 225,00).', texto: 'Monto pagado' });
      if (!numero) errores.push({ entrada: operacion, mensaje: 'Escribe el número de operación.', texto: 'Número de operación' });
      else if (!OPERACION.test(numero)) errores.push({ entrada: operacion, mensaje: 'Escribe de 4 a 40 letras, cifras o guiones.', texto: 'Número de operación' });
      const errorCaptura = carga.error();
      if (errorCaptura) errores.push({ entrada: carga.entrada, mensaje: errorCaptura, texto: 'Captura del comprobante' });
      if (!this.validar(errores)) return;
      const datos = new FormData();
      datos.append('id_cuota', this.cuota.id);
      datos.append('metodo', metodo.value);
      datos.append('monto', importe);
      datos.append('numero_operacion', numero);
      datos.append('captura', carga.archivo, carga.archivo.name);
      this.enviar(this.querySelector('[data-registrar]'), 'Registrando pago…', () => registrarPago(datos), () => {
        location.assign(`${this.urlReserva()}&aviso=pago-registrado`);
      }, true);
    }

    entradas() {
      return {
        metodo: this.querySelector('input[name="metodo"]:checked'),
        monto: this.querySelector('#pago-monto'),
        operacion: this.querySelector('#pago-operacion'),
        carga: this.querySelector('bugalu-carga-archivos'),
      };
    }

    // Durante el envio: campos y "Volver" bloqueados; a los 10 s, el aviso de subida lenta.
    bloquear(si) {
      super.bloquear(si);
      this.querySelectorAll('form input, form .archivo-accion, [data-p0] input').forEach((e) => (e.disabled = si));
      const volver = this.querySelector('form [data-volver]');
      if (si) volver?.setAttribute('aria-disabled', 'true');
      else volver?.removeAttribute('aria-disabled');
      if (volver) volver.tabIndex = si ? -1 : 0;
      const aviso = this.querySelector('[data-lento]');
      clearTimeout(this.lento);
      if (aviso) aviso.hidden = true;
      if (si) this.lento = setTimeout(() => aviso && (aviso.hidden = false), 10000);
    }

    errorEnvio(error) {
      if (this.accion === 'credito') {
        this.errorCredito(error);
        return true;
      }
      const { metodo, monto, operacion, carga } = this.entradas();
      const sobre = (entrada, mensaje, texto) => {
        this.limpiarErrores();
        this.validar([{ entrada, mensaje, texto }]);
        return true;
      };
      const estado = error.estado;
      const codigo = error.codigo;
      // El servidor cuenta 5 * 1024 * 1024 bytes, igual que la comprobacion local de CargaArchivos.
      const mb = (carga.archivo?.size ?? 0) / 1048576;
      const pesa = mb > 5 ? `La captura pesa ${String(Number(mb.toFixed(1))).replace('.', ',')} MB. Sube una de hasta 5 MB.` : 'La captura es demasiado pesada para subirla. Sube una más ligera, de hasta 5 MB.';
      const CAPTURA = { archivo_muy_grande: pesa, formato_no_admitido: 'Sube la captura en JPG, PNG o PDF.' };
      if (estado === 404) {
        this.sustituir('no-encontrada');
        return true;
      }
      if (estado === 409 && codigo === 'operacion_duplicada') {
        return sobre(operacion, `Ese número ya está registrado con ${METODOS[metodo?.value]?.[0] ?? 'ese método'}. Revisa el número del voucher.`, 'Número de operación');
      }
      if (estado === 409 && ['pago_en_validacion', 'cuota_pagada', 'cuota_no_pagable'].includes(codigo)) {
        this.yaNoPagable(codigo);
        return true;
      }
      if (estado === 413 || (estado === 422 && codigo === 'formato_no_admitido')) return sobre(carga.entrada, CAPTURA[estado === 413 ? 'archivo_muy_grande' : codigo], 'Captura del comprobante');
      if (estado === 422 && codigo === 'metodo_no_disponible') {
        this.metodoNoDisponible(metodo?.value);
        return true;
      }
      if (estado === 422 && codigo === 'datos_invalidos') {
        const destino = { monto: [monto, 'Monto pagado'], numero_operacion: [operacion, 'Número de operación'], captura: [carga.entrada, 'Captura del comprobante'], metodo: [this.querySelector('input[name="metodo"]'), 'Método de pago'] }[error.detalles?.campo];
        return destino ? sobre(destino[0], error.mensaje || 'Revisa este dato.', destino[1]) : false;
      }
      if (estado === 422) return false; // el aviso con el mensaje del servidor
      const [titulo, texto] =
        estado === 0 ? ['Sin conexión', 'Tus datos siguen aquí; revisa tu red y vuelve a intentarlo.']
        : estado === 503 ? ['No pudimos registrar el pago: el servicio no responde', 'Tus datos siguen aquí; inténtalo en unos minutos.']
        : ['Algo salió mal', 'Tus datos siguen aquí; inténtalo de nuevo.'];
      enfocarAviso(mostrarAviso(this, 'error', titulo, texto));
      return true;
    }

    // 409: se vuelve a leer la reserva para decir por que ya no se puede pagar.
    async yaNoPagable(codigo) {
      try {
        const r = await obtenerReserva(this.reserva.id);
        this.reserva = r;
        this.cuota = (r.cuotas ?? []).find((x) => x.id === this.cuota.id) ?? this.cuota;
      } catch {}
      this.verNoPagable(this.noPagable(this.reserva, this.cuota, codigo));
      this.anunciar();
      this.enfocar();
    }

    // 422: el metodo se desactivo mientras tanto; se recargan los metodos y se conserva el resto del formulario.
    async metodoNoDisponible(elegido) {
      const nombre = METODOS[elegido]?.[0] ?? 'Ese método';
      let activos = [];
      try {
        activos = this.activos(await obtenerInstrucciones());
      } catch {}
      if (!activos.length) return this.cargar();
      this.pintarMetodos(activos.filter((m) => m !== elegido), undefined);
      enfocarAviso(mostrarAviso(this, 'error', `${nombre} ya no está disponible. Elige otro método.`));
    }
  }

  if (!customElements.get('bugalu-pago')) customElements.define('bugalu-pago', BugaluPago);
</script>

