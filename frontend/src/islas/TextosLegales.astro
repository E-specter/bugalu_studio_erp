    margin-block-end: var(--espacio-4);
  }
  .textos :global(.textos-plano) {
    white-space: pre-wrap;
  }
  .textos :global([data-prellenado-aviso]:empty, [data-previa-aviso]:empty) {
    display: none;
  }
  .textos :global(.textos-celda) {
    align-items: center;
  }
  /* Editor (P2): CONTENIDO y VISTA PREVIA en dos columnas iguales desde punto-quiebre-escritorio; debajo, una tras otra. */
  .textos :global(.textos-editor) {
    display: grid;
    gap: var(--espacio-5);
    grid-template-columns: minmax(0, 1fr);
  }
  .textos :global(.textos-columna) {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-3);
    min-inline-size: 0;
  }
  .textos :global(.textos-barra) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3);
    align-items: center;
  }
  /* Control de carga sin adjunto: el aspecto del boton Secundario (captura de pago, carga-archivos.md); su foco es el del input oculto. */
  .textos :global(.textos-carga) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-2);
    box-sizing: border-box;
    min-block-size: var(--medida-control-tactil);
    padding: var(--espacio-2) var(--espacio-5);
    background: var(--color-fondo-superficie);
    border: var(--borde-grosor-base) solid var(--color-borde-fuerte);
    color: var(--color-texto-principal);
    font-family: var(--fuente-familia-titulo);
    font-weight: var(--fuente-peso-titulo);
    font-size: var(--fuente-tamano-base);
    line-height: var(--fuente-interlineado-interfaz);
    text-transform: uppercase;
    cursor: pointer;
  }
  .textos :global([data-carga-md]:focus-visible + .textos-carga) {
    outline: var(--borde-grosor-base) solid var(--color-foco-anillo);
    outline-offset: var(--borde-grosor-base);
  }
  .textos :global([data-carga-md][aria-invalid='true'] + .textos-carga) {
    border-color: var(--color-texto-alerta);
  }
  .textos :global([data-carga-md]:disabled + .textos-carga) {
    opacity: var(--efecto-opacidad-capa);
    cursor: not-allowed;
  }
  @media (hover: hover) {
    .textos :global([data-carga-md]:not(:disabled) + .textos-carga:hover) {
      background: var(--color-fondo-alerta);
      color: var(--color-texto-sobre-alerta);
    }
  }
  @media (min-width: 37.5em) { /* punto-quiebre-tableta */
    .textos :global(.textos-carga) {
      min-block-size: var(--medida-control-base);
    }
  }
  .textos :global(.textos-error-carga) {
    display: flex;
    align-items: flex-start;
    gap: var(--espacio-2);
    margin: 0;
    color: var(--color-texto-alerta);
    font-size: var(--fuente-tamano-pequeno);
  }
  .textos :global(.textos-previa) {
    box-sizing: border-box;
    padding: var(--espacio-3);
    border: var(--borde-grosor-base) solid var(--color-borde-fuerte);
    max-block-size: calc(var(--espacio-20) * 4);
    overflow: auto;
  }
  .textos :global(.textos-previa-cabecera) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espacio-3);
    margin-block-end: var(--espacio-3);
  }
  .textos :global(.textos-previa-titulo) {
    font-family: var(--fuente-familia-tecnica);
    font-size: var(--fuente-tamano-micro);
  }
  @media (min-width: 64em) { /* punto-quiebre-escritorio */
    .textos :global(.textos-editor) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Mismo alto que CONTENIDO: la vista previa se desplaza dentro de su columna. */
    .textos :global(.textos-columna-previa) {
      position: relative;
      min-block-size: calc(var(--espacio-20) * 4);
