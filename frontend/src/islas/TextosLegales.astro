---
import Panel from '../componentes/Panel.astro';
import Boton from '../componentes/Boton.astro';
import Campo from '../componentes/Campo.astro';
import Casilla from '../componentes/Casilla.astro';
import Tabla from '../componentes/Tabla.astro';
import BarraAcciones from '../componentes/BarraAcciones.astro';
import EtiquetaTecnica from '../componentes/EtiquetaTecnica.astro';
import Aviso from '../componentes/Aviso.astro';
import Icono from '../componentes/internos/Icono.astro';
import EstilosProsa from '../componentes/internos/EstilosProsa.astro';
import EstadosIsla from '../componentes/internos/EstadosIsla.astro';
import EstilosGestion from '../componentes/internos/EstilosGestion.astro';

interface Props {
  vista: 'lista' | 'publicar' | 'ver';
}
const { vista } = Astro.props;
// Panel de la vista mientras carga o falla (codigos y titulos de la spec RF-17-textos-legales).
const principal = { lista: { titulo: 'Textos' }, publicar: { codigo: 'P1', titulo: 'Versión' }, ver: { codigo: 'V1', titulo: 'Versión' } }[vista];
const cambios = [
  { valor: 'mayor', etiqueta: 'Mayor', detalle: 'Cambia derechos u obligaciones. Avisa por correo; los términos se vuelven a aceptar.' },
  { valor: 'menor', etiqueta: 'Menor', detalle: 'Aclara o añade sin cambiar lo esencial. Avisa por correo.' },
  { valor: 'parche', etiqueta: 'Parche', detalle: 'Erratas y formato. Rige al publicarla, sin aviso.' },
];
---

<EstilosGestion />
<EstilosProsa />

<!-- Un bloque por estado (estados-sistema): la isla clona el que toca. Sin JS, el noscript oculta la carga y avisa. -->
<bugalu-textos-legales class="textos" data-gestion vista={vista}>
  <div data-avisos></div>
  <!-- Region viva estable, presente antes de cualquier texto: anuncia cada carga y resultado una sola vez. -->
  <p class="visualmente-oculto" role="status" data-anuncio></p>
  <div data-salida><Panel {...principal} cargando /></div>
  <div data-revision hidden></div>

  <EstadosIsla principal={principal} noEncontrada={vista !== 'lista' ? { etiqueta: 'Volver a textos', href: '/app/textos' } : undefined} />

  {vista === 'lista' && (
    <>
      <template data-estado="datos">
        <Panel titulo="Textos">
          <Tabla titulo="Textos" columnas={['Texto', 'Vigente', 'Programada', '']} />
        </Panel>
      </template>
      <template data-fila>
        <tr>
          <th scope="row" data-nombre></th>
          <td data-etiqueta="Vigente"><div class="textos-acciones textos-celda" data-vigente></div></td>
          <td data-etiqueta="Programada"><div class="textos-acciones textos-celda" data-programada></div></td>
          <td>
            <div class="textos-acciones">
              <Boton variante="secundario" href="#" data-publicar>Publicar versión<span class="visualmente-oculto" data-objeto></span></Boton>
              <div>
                <Boton variante="secundario" aria-disabled="true" data-publicar data-bloqueado hidden>Publicar versión<span class="visualmente-oculto" data-objeto></span></Boton>
                <span class="gestion-motivo" data-motivo-publicar hidden>Retira la versión programada para publicar otra.</span>
              </div>
              <Boton variante="peligro" data-retirar hidden><span data-etiqueta-retiro></span><span class="visualmente-oculto" data-objeto></span></Boton>
            </div>
          </td>
        </tr>
      </template>
      <template data-ver><Boton variante="secundario" href="#">Ver<span class="visualmente-oculto" data-objeto></span></Boton></template>
      <template data-sello="sin-publicar"><EtiquetaTecnica variante="aviso" texto="SIN PUBLICAR" /></template>
      <template data-estado="retirar">
        <Panel titulo="Retirar versión">
          <p class="textos-retiro-texto">Se borra el contenido y no se puede recuperar. La versión vigente sigue rigiendo.</p>
          <BarraAcciones variante="decision">
            <Boton slot="secundaria" variante="secundario" data-volver>Volver</Boton>
            <Boton slot="principal" variante="peligro" data-envio data-confirmar-retiro>Retirar versión</Boton>
          </BarraAcciones>
        </Panel>
      </template>
    </>
  )}

  {vista === 'ver' && (
    <template data-estado="datos">
      <div class="gestion-formulario">
        <Panel codigo="V1" titulo="Versión">
          <dl class="gestion-datos">
            <div><dt>Tipo de cambio</dt><dd data-campo="tipo_cambio"></dd></div>
            <div><dt>Vigente desde</dt><dd><span data-campo="vigente_desde"></span> <span data-programada hidden><EtiquetaTecnica variante="aviso" texto="PROGRAMADA" /></span></dd></div>
            <div><dt>Publicada el</dt><dd data-campo="publicado_en"></dd></div>
            <div><dt>Resumen de cambios</dt><dd class="textos-plano" data-campo="resumen_cambios"></dd></div>
          </dl>
        </Panel>
        <Panel codigo="V2" titulo="Resúmenes"><dl class="gestion-datos" data-resumenes></dl></Panel>
        <Panel codigo="V3" titulo="Texto"><div class="prosa" data-contenido></div></Panel>
      </div>
    </template>
  )}

  {vista === 'publicar' && (
    <>
      <template data-estado="datos">
        <form novalidate method="post" class="gestion-formulario" data-formulario="publicar">
          <Panel codigo="P1" titulo="Versión">
            <div class="gestion-formulario">
              <dl class="gestion-datos">
                <div><dt>Texto</dt><dd data-campo="nombre"></dd></div>
                <div><dt>Última versión</dt><dd data-campo="ultima"></dd></div>
              </dl>
              <div class="campo">
                <fieldset class="gestion-grupo">
                  <legend>Tipo de cambio (obligatorio)</legend>
                  {cambios.map((c) => <Casilla tipo="radio" nombre="tipo_cambio" valor={c.valor} etiqueta={c.etiqueta} detalle={c.detalle} id={`cambio-${c.valor}`} />)}
                </fieldset>
              </div>
              <Campo nombre="version" etiqueta="Versión" ayuda="Tres números separados por puntos, como 1.2.0." obligatorio autocomplete="off" />
              <div data-fecha>
                <Campo tipo="date" nombre="vigente_desde" etiqueta="Vigente desde" ayuda="Mayor y menor avisan por correo: la fecha debe dar 15 días de aviso." obligatorio />
              </div>
              <p class="gestion-ayuda" data-rige-ya hidden>Rige al publicarla.</p>
            </div>
          </Panel>
          <Panel codigo="P2" titulo="Contenido">
            <div class="gestion-formulario" data-p2>
              <p class="gestion-ayuda" data-ayuda-partida hidden></p>
              <p class="gestion-ayuda" data-prellenado-cargando hidden></p>
              <div data-prellenado-aviso></div>
              <div class="textos-editor">
                <div class="textos-columna">
                  <div class="textos-barra">
                    <input type="file" id="carga-md" class="visualmente-oculto" accept=".md,text/markdown" aria-describedby="campo-contenido-ayuda" data-carga-md />
                    <label for="carga-md" class="textos-carga"><Icono nombre="upload" />Cargar archivo .md</label>
                    <Boton variante="secundario" data-envio data-actualizar-previa>Actualizar vista previa</Boton>
                  </div>
                  <p class="textos-error-carga" role="alert" id="carga-md-error" data-error-carga hidden><Icono nombre="alert-triangle" /><span></span></p>
                  <div data-confirmar-reemplazo hidden>
                    <Aviso variante="aviso" titulo=" " texto="Se pierde lo que hay escrito en CONTENIDO.">
                      <BarraAcciones variante="decision">
                        <Boton slot="secundaria" variante="secundario" data-mantener>Mantener lo escrito</Boton>
                        <Boton slot="principal" variante="peligro" data-reemplazar>Reemplazar contenido</Boton>
                      </BarraAcciones>
                    </Aviso>
                  </div>
                  <Campo tipo="area" nombre="contenido" etiqueta="Contenido" ayuda="Texto completo en Markdown: # para títulos y - para listas. Puedes cargar un archivo .md en UTF-8 de hasta 200 KB; reemplaza el contenido." obligatorio rows="14" />
                </div>
                <div class="textos-columna textos-columna-previa">
                  <div class="textos-previa" role="region" aria-labelledby="textos-previa-titulo" tabindex="0" data-previa>
                    <div class="textos-previa-cabecera">
                      <h3 id="textos-previa-titulo" class="textos-previa-titulo">Vista previa</h3>
                      <span data-desactualizada hidden><EtiquetaTecnica variante="aviso" texto="DESACTUALIZADA" /></span>
                    </div>
                    <div data-previa-aviso></div>
                    <p class="gestion-ayuda" data-previa-mensaje></p>
                    <div class="prosa" data-previa-html></div>
                  </div>
                </div>
              </div>
              <fieldset class="gestion-grupo" data-contextos>
                <legend>Resumen por paso</legend>
                <p class="gestion-ayuda">Lo que verá la persona antes de aceptar. Frases cortas, en segunda persona. El primero es obligatorio; los demás, opcionales. Sin datos de una reserva concreta.</p>
              </fieldset>
              <Campo tipo="area" nombre="resumen_cambios" etiqueta="Resumen de cambios" ayuda="Qué cambia respecto de la versión anterior. Opcional." rows="3" />
              <div><Boton tipo="submit" data-envio data-revisar>Revisar y publicar</Boton></div>
            </div>
          </Panel>
        </form>
      </template>
      <template data-campo-contexto><Campo tipo="area" nombre="contexto" etiqueta=" " rows="3" /></template>
      <template data-estado="revision">
        <Panel codigo="R1" titulo="Revisa antes de publicar">
          <div class="gestion-formulario">
            <dl class="gestion-datos">
              <div><dt>Texto</dt><dd data-campo="nombre"></dd></div>
              <div><dt>Tipo de cambio</dt><dd data-campo="tipo_cambio"></dd></div>
              <div><dt>Versión</dt><dd data-campo="version"></dd></div>
              <div><dt>Vigente desde</dt><dd data-campo="vigente_desde"></dd></div>
            </dl>
            <div class="textos-consecuencias" data-consecuencias></div>
            <dl class="gestion-datos">
              <div><dt>Resumen</dt><dd class="textos-plano" data-campo="resumen"></dd></div>
              <div><dt id="revision-contenido">Contenido</dt><dd><div class="prosa textos-desplazable" role="region" aria-labelledby="revision-contenido" tabindex="0" data-campo="contenido"></div></dd></div>
            </dl>
            <BarraAcciones variante="formulario">
              <Boton slot="secundaria" variante="secundario" data-volver-editar>Volver a editar</Boton>
              <Boton slot="principal" data-envio data-publicar-version>Publicar versión</Boton>
            </BarraAcciones>
          </div>
        </Panel>
      </template>
    </>
  )}
</bugalu-textos-legales>

<script>
  // @ts-nocheck
  import { IslaGestion } from '../servicios/isla-gestion.js';
  import { listarTextosLegales, obtenerVersionTexto, previsualizarTexto, publicarTexto, retirarVersion, tipos, contextos, delTipo, esVersion, siguienteVersion } from '../servicios/textos-legales.js';
  import { formatearFecha, mostrarAviso, enfocarAviso, quitarError } from '../servicios/formulario.js';
  import { limpiar } from '../servicios/prosa.js';
  import { mensajeError } from '../servicios/isla-gestion.js';
  import { hoyLima, sumarDias, esFecha, instante, diaMesAnio } from '../servicios/formatos.js';

  const nombresCambio = { mayor: 'Mayor', menor: 'Menor', parche: 'Parche' };
  const MAX_BYTES = 200000; // 200 KB: encaja con el limite de 300 000 caracteres de la API (RF-17, precisiones E1)
  const MAX_CARACTERES = 300000; // el mismo limite que publicar y la vista previa de la API
  const PROSA = { titulo: 2, nuevaPestana: true }; // Ver y R1: el texto cuelga de un <h2>
  const peso = (bytes) => (bytes >= 1e6 ? `${(bytes / 1e6).toFixed(1).replace('.', ',')} MB` : `${Math.ceil(bytes / 1000)} KB`);
  const excede = (texto) => texto.length > MAX_CARACTERES && [...texto].length > MAX_CARACTERES;

  class BugaluTextosLegales extends IslaGestion {
    avisosUrl = {
      'version-publicada': ['Versión publicada.'],
      'version-retirada': ['Versión retirada.'],
    };

    iniciar() {
      this.noEncontrada = [this.vista === 'ver' ? 'Esa versión ya no existe: se retiró o el enlace está mal.' : 'No encontramos este texto.'];
      this.addEventListener('click', (e) => {
        const retirar = e.target.closest('[data-retirar]');
        if (retirar) this.confirmarRetiro(retirar.dataset.tipo, retirar.dataset.version);
        else if (e.target.closest('[data-volver]')) this.volverALista();
        else if (e.target.closest('[data-confirmar-retiro]')) this.retirar();
        else if (e.target.closest('[data-volver-editar]')) this.volverAEditar();
        else if (e.target.closest('[data-publicar-version]')) this.publicarVersion();
        else if (e.target.closest('[data-actualizar-previa]')) this.actualizarPrevia();
        else if (e.target.closest('[data-mantener]')) this.mantenerEscrito();
        else if (e.target.closest('[data-reemplazar]')) this.reemplazar();
        else if (e.target.closest('[data-reintentar-previa]')) this.reintentarPrevia(e.target.closest('[data-previa-aviso]'));
        else if (e.target.closest('[data-reintentar-prellenado]')) this.prellenar();
      });
      this.addEventListener('change', (e) => {
        if (e.target.name === 'tipo_cambio') this.alCambiarTipo();
        else if (e.target.matches('[data-carga-md]')) this.cargarArchivo(e.target);
      });
      this.addEventListener('input', (e) => {
        if (e.target.name === 'version') this.versionEscrita = e.target.value !== '';
        else if (e.target.name === 'contenido') this.estadoPrevia();
      });
    }

    alEnviar(formulario) {
      if (formulario.dataset.formulario === 'publicar') this.revisar_(formulario);
    }

    // Un 401 o 403 sustituye la vista entera, incluida la revision.
    sustituir(estado) {
      this.querySelector('[data-revision]').hidden = true;
      this.querySelector('[data-salida]').hidden = false;
      super.sustituir(estado);
    }

    // --- Lista ---

    async lista() {
      this.textos = await listarTextosLegales();
      this.mostrar('datos');
      this.pintarLista();
      return `${Object.keys(tipos).length} textos`;
    }

    pintarLista() {
      const modelo = this.querySelector('template[data-fila]');
      this.querySelector('tbody').replaceChildren(...Object.entries(tipos).map(([tipo, { slug, nombre }]) => {
        const { vigente, programada } = delTipo(this.textos, tipo);
        const fila = modelo.content.cloneNode(true);
        fila.querySelector('[data-nombre]').textContent = nombre;
        const celdaVigente = fila.querySelector('[data-vigente]');
        if (vigente) celdaVigente.append(...this.versionConVer(tipo, nombre, vigente, 'versión '));
        else celdaVigente.append(this.querySelector('template[data-sello="sin-publicar"]').content.cloneNode(true));
        const celdaProgramada = fila.querySelector('[data-programada]');
        if (programada) celdaProgramada.append(...this.versionConVer(tipo, nombre, programada, ''));
        else celdaProgramada.textContent = '—';
        // Con una programada publicar daria 409 (RF-17, E1): el boton sigue a la vista, deshabilitado y con su motivo.
        const botones = [...fila.querySelectorAll('[data-publicar]')];
        const publicar = botones.find((b) => b.hasAttribute('data-bloqueado') === Boolean(programada));
        botones.filter((b) => b !== publicar).forEach((b) => (b.hasAttribute('data-bloqueado') ? b.parentElement : b).remove());
        publicar.dataset.tipo = tipo;
        publicar.querySelector('[data-objeto]').textContent = ` de ${nombre}`;
        if (programada) {
          const motivo = fila.querySelector('[data-motivo-publicar]');
          motivo.id = `motivo-publicar-${tipo}`;
          motivo.hidden = false;
          publicar.hidden = false;
          publicar.setAttribute('aria-describedby', motivo.id);
        } else publicar.href = `/app/textos/publicar?tipo=${encodeURIComponent(tipo)}`;
        const retirar = fila.querySelector('[data-retirar]');
        if (programada) {
          retirar.hidden = false;
          retirar.dataset.tipo = tipo;
          retirar.dataset.version = programada.version;
          retirar.querySelector('[data-etiqueta-retiro]').textContent = `Retirar versión ${programada.version}`;
          retirar.querySelector('[data-objeto]').textContent = ` de ${nombre}`;
        } else retirar.remove();
        return fila;
      }));
    }

    // "versión 1.0.0 · desde 1 dic 2026" y su "Ver" (a la vista del panel, no a la pagina publica).
    versionConVer(tipo, nombre, t, palabra) {
      const ver = this.querySelector('template[data-ver]').content.cloneNode(true);
      ver.querySelector('a').href = `/app/textos/ver?${new URLSearchParams({ tipo, version: t.version })}`;
      ver.querySelector('[data-objeto]').textContent = ` versión ${t.version} de ${nombre}`;
      return [`${palabra}${t.version} · desde ${formatearFecha(t.vigente_desde)}`, ver];
    }

    confirmarRetiro(tipo, version) {
      this.retiro = { tipo, version };
      this.mostrar('retirar');
      this.querySelector('[data-salida] .panel-titulo').textContent = `Retirar versión ${version} de ${tipos[tipo].nombre}`;
      this.anunciar(`Retirar la versión ${version} de ${tipos[tipo].nombre}`);
      this.enfocar();
    }

    volverALista() {
      const { tipo } = this.retiro;
      this.mostrar('datos');
      this.pintarLista();
      this.anunciar('Textos');
      this.querySelector(`[data-publicar][data-tipo="${tipo}"]`).focus();
    }

    retirar() {
      const { tipo, version } = this.retiro;
      this.enviar(this.querySelector('[data-confirmar-retiro]'), 'Retirando…', () => retirarVersion(tipo, version), () => location.assign('/app/textos?aviso=version-retirada'), true);
    }

    // La API ya no la tiene (404) o ya rige (409): se recarga la lista y se explica.
    async tras(error) {
      await this.cargar();
      const vigente = error.estado !== 404;
      enfocarAviso(mostrarAviso(this, vigente ? 'error' : 'informacion', vigente ? 'Esa versión ya está vigente y no se puede retirar.' : 'Esa versión ya no existe.'));
    }

    errorEnvio(error) {
      if (this.vista === 'lista') {
        if (error.codigo !== 'version_vigente' && error.estado !== 404) return false;
        this.tras(error);
        return true;
      }
      const f = this.formulario;
      if (error.codigo === 'version_invalida') {
        this.volverAEditar(false);
        this.validar([{ entrada: f.querySelector('[name="version"]'), mensaje: `Para un cambio ${this.valores.tipo_cambio} la versión debe ser ${siguienteVersion(this.ultima, this.valores.tipo_cambio)}${this.ultima ? `, mayor que la última (${this.ultima})` : ''}.`, texto: 'Versión' }]);
      } else if (error.codigo === 'aviso_insuficiente') {
        this.volverAEditar(false);
        this.validar([{ entrada: f.querySelector('[name="vigente_desde"]'), mensaje: `Elige una fecha desde el ${diaMesAnio(this.fechaMinima)}: los clientes necesitan 15 días de aviso.`, texto: 'Vigente desde' }]);
      } else if (error.codigo === 'version_programada') this.yaProgramada();
      else if (error.codigo === 'conflicto') enfocarAviso(mostrarAviso(this, 'error', 'Alguien publicó una versión de este texto hace un momento. Revisa la lista antes de seguir.'));
      else return false;
      return true;
    }

    // Con la programada a la vista el unico camino es volver: se esconde el formulario y queda un solo boton primario.
    async yaProgramada() {
      let { programada } = delTipo(this.textos, this.tipoTexto);
      try {
        programada = delTipo(await listarTextosLegales(), this.tipoTexto).programada ?? programada;
      } catch {}
      const cual = programada ? ` (${programada.version}, desde ${formatearFecha(programada.vigente_desde)})` : '';
      this.querySelector('[data-revision]').hidden = true;
      this.querySelector('[data-salida]').hidden = true;
      enfocarAviso(mostrarAviso(this, 'error', `Ya hay una versión programada de este texto${cual}. Retírala antes de publicar otra.`, '', { enlace: { texto: 'Volver a textos', href: '/app/textos' } }));
    }

    // --- Ver (RF-17 CA-15): el texto de una version con su formato final ---

    async ver() {
      const parametros = new URLSearchParams(location.search);
      const tipo = parametros.get('tipo');
      const version = parametros.get('version');
      if (!Object.hasOwn(tipos, tipo) || !esVersion(version)) return this.mostrar('no-encontrada');
      let t;
      try {
        t = await obtenerVersionTexto(tipo, version);
      } catch (error) {
        if (error.estado === 404) return this.mostrar('no-encontrada');
        throw error;
      }
      this.mostrar('datos');
      const { nombre } = tipos[tipo];
      const dato = (n, texto) => (this.querySelector(`[data-campo="${n}"]`).textContent = texto);
      dato('tipo_cambio', nombresCambio[t.tipo_cambio] ?? t.tipo_cambio);
      dato('vigente_desde', formatearFecha(t.vigente_desde));
      this.querySelector('[data-programada]').hidden = !t.programada;
      dato('publicado_en', t.publicado_en ? formatearFecha(t.publicado_en) : '—');
      dato('resumen_cambios', t.resumen_cambios || '—');
      this.querySelector('[data-resumenes]').replaceChildren(...Object.entries(t.resumenes ?? {}).map(([c, texto]) => {
        const fila = document.createElement('div');
        fila.append(Object.assign(document.createElement('dt'), { textContent: contextos[c] ?? c }), Object.assign(document.createElement('dd'), { textContent: texto, className: 'textos-plano' }));
        return fila;
      }));
      this.querySelector('[data-contenido]').replaceChildren(...limpiar(t.contenido_html ?? '', PROSA));
      document.querySelector('.encabezado-titulo').textContent = `${nombre} · versión ${t.version}`;
      this.encabezado('Así la leen los clientes en la página pública.', nombre);
      return `${nombre}, versión ${t.version}`;
    }

    // --- Publicar ---

    async publicar() {
      const tipo = new URLSearchParams(location.search).get('tipo');
      if (!Object.hasOwn(tipos, tipo)) return this.mostrar('no-encontrada');
      this.textos = await listarTextosLegales();
      this.tipoTexto = tipo;
      const { vigente, programada } = delTipo(this.textos, tipo);
      this.ultima = (programada ?? vigente)?.version ?? null;
      this.versionEscrita = false;
      const hoy = hoyLima();
      this.fechaMinima = this.ultima ? sumarDias(hoy, 15) : hoy; // la primera version de un texto rige sin aviso previo
      this.mostrar('datos');
      this.formulario = this.querySelector('form');
      this.querySelector('[data-campo="nombre"]').textContent = tipos[tipo].nombre;
      this.querySelector('[data-campo="ultima"]').textContent = this.ultima ?? '—';
      this.formulario.querySelector('[name="vigente_desde"]').min = this.fechaMinima;
      const modelo = this.querySelector('template[data-campo-contexto]');
      this.querySelector('[data-contextos]').append(...tipos[tipo].contextos.map((c, i) => {
        const nodo = modelo.content.cloneNode(true);
        nodo.querySelector('label').firstChild.textContent = contextos[c];
        if (i === 0) nodo.querySelector('label').append(Object.assign(document.createElement('span'), { textContent: ' (obligatorio)' }));
        const area = nodo.querySelector('textarea');
        area.name = `resumen_${c}`;
        area.id = `campo-resumen_${c}`;
        nodo.querySelector('label').htmlFor = area.id;
        return nodo;
      }));
      this.encabezado(`${tipos[tipo].nombre}: elige el tipo de cambio y desde cuándo rige.`);
      // El prellenado sale de la vigente (con programada no se puede publicar); sin versiones, los campos quedan vacios.
      this.partida = vigente ?? programada;
      this.previa = null;
      this.estadoPrevia();
      if (this.partida) this.prellenar();
      return `Publicar versión de ${tipos[tipo].nombre}`;
    }

    // --- Publicar: prellenado, archivo .md y vista previa (RF-17 CA-16 a CA-18) ---

    get contenido() {
      return this.formulario.querySelector('[name="contenido"]');
    }

    bloquearEditor(si) {
      this.formulario.querySelectorAll('[data-p2] :is(textarea, input, button)').forEach((c) => (c.disabled = si));
    }

    async prellenar() {
      const { version } = this.partida;
      const cargando = this.querySelector('[data-prellenado-cargando]');
      const ayuda = this.querySelector('[data-ayuda-partida]');
      this.querySelector('[data-prellenado-aviso]').replaceChildren();
      cargando.textContent = `Cargando la versión ${version}…`;
      cargando.setAttribute('aria-busy', 'true');
      cargando.hidden = false;
      this.bloquearEditor(true);
      let t;
      try {
        t = await obtenerVersionTexto(this.tipoTexto, version);
      } catch {
        cargando.hidden = true;
        cargando.removeAttribute('aria-busy');
        this.bloquearEditor(false);
        const aviso = mostrarAviso(this, 'error', `No pudimos cargar la versión ${version} para partir de ella`, '', { boton: { texto: 'Reintentar', atributo: 'data-reintentar-prellenado' }, destino: this.querySelector('[data-prellenado-aviso]') });
        this.anunciar(this.textoDe(aviso));
        return;
      }
      cargando.hidden = true;
      cargando.removeAttribute('aria-busy');
      this.bloquearEditor(false);
      this.contenido.value = t.contenido ?? '';
      for (const c of tipos[this.tipoTexto].contextos) this.formulario.querySelector(`[name="resumen_${c}"]`).value = t.resumenes?.[c] ?? '';
      ayuda.textContent = `Parte de la versión ${version}. Cambia solo lo necesario.`;
      ayuda.hidden = false;
      this.actualizarPrevia();
    }

    // Mensaje de la vista previa mientras no hay ninguna que mostrar.
    estadoPrevia() {
      if (!this.formulario) return;
      if (!this.previa) this.querySelector('[data-previa-mensaje]').textContent = this.contenido.value.trim() ? 'Pulsa «Actualizar vista previa» para ver el texto con su formato final.' : 'Escribe el contenido para ver la vista previa.';
      this.marcarDesactualizada();
    }

    marcarDesactualizada() {
      this.querySelector('[data-desactualizada]').hidden = !this.previa || this.previa.contenido === this.contenido.value.trim();
    }

    // Pide el HTML y lo pinta; la vista anterior sigue hasta que llega (`aria-busy`). Lanza el error de la API.
    async generarPrevia(contenido) {
      const region = this.querySelector('[data-previa]');
      region.setAttribute('aria-busy', 'true');
      try {
        const { contenido_html: html } = await previsualizarTexto(contenido);
        if (typeof html !== 'string') throw new Error('respuesta sin contenido_html');
        this.previa = { contenido, html };
      } finally {
        region.removeAttribute('aria-busy');
      }
      this.querySelector('[data-previa-aviso]').replaceChildren();
      this.querySelector('[data-previa-mensaje]').textContent = '';
      this.querySelector('[data-previa-html]').replaceChildren(...limpiar(this.previa.html, { titulo: 3, nuevaPestana: true }));
      this.marcarDesactualizada();
    }

    // Sin llamada si el contenido esta vacio o pasa de 300 000 caracteres; si no, con carga en el boton.
    actualizarPrevia() {
      if (this.ocupado) return;
      const contenido = this.contenido.value.trim();
      const mensaje = !contenido ? 'Escribe el contenido para ver la vista previa.' : excede(contenido) ? 'El contenido supera los 300 000 caracteres. Acórtalo para verlo y publicarlo.' : '';
      if (mensaje) {
        this.querySelector('[data-previa-aviso]').replaceChildren();
        this.querySelector('[data-previa-mensaje]').textContent = mensaje;
        return this.anunciar(mensaje);
      }
      this.enviar(this.querySelector('[data-actualizar-previa]'), 'Actualizando…', () => this.generarPrevia(contenido).then(() => null, (error) => ({ error })), (r) => {
        if (r?.error) this.errorPrevia(r.error, this.querySelector('[data-previa-aviso]'));
        else this.anunciar('Vista previa actualizada.');
      });
    }

    // Los errores de la vista previa. En el bloque conservan la ultima vista (con DESACTUALIZADA); en la revision (`destino` nulo) van sobre el formulario con foco.
    errorPrevia(error, destino = null) {
      const reintentar = { texto: 'Reintentar', atributo: 'data-reintentar-previa' };
      const acceso = { texto: 'Ir al acceso interno', href: `/acceso/interno?${new URLSearchParams({ volver: location.pathname + location.search })}` };
      const [titulo, texto, extra] = error.estado === 401 ? ['Tu sesión no es válida. Inicia sesión y vuelve a intentarlo.', '', { enlace: acceso, boton: reintentar }]
        : error.estado === 403 ? ['Tu cuenta ya no puede publicar textos.', '', {}]
        : error.estado === 422 ? [`El contenido supera los 300 000 caracteres. Acórtalo para ${destino ? 'verlo y publicarlo' : 'publicarlo'}.`, '', {}]
        : [...mensajeError(error), { boton: reintentar }];
      const aviso = mostrarAviso(this, 'error', titulo, texto, { ...extra, destino: destino ?? undefined });
      aviso.querySelectorAll('a.boton').forEach((a) => Object.assign(a, { target: '_blank', rel: 'noopener' })); // otra pestana: lo escrito no se pierde
      if (destino) this.anunciar(this.textoDe(aviso));
      else enfocarAviso(aviso);
      this.marcarDesactualizada();
    }

    // Titulo y texto del aviso como una frase (sin sus botones).
    textoDe(aviso) {
      return [...aviso.querySelectorAll('.aviso-titulo, .aviso-texto')].map((p) => p.textContent).join(' ').replace(/\s+/g, ' ').trim();
    }

    reintentarPrevia(enBloque) {
      if (enBloque) this.actualizarPrevia();
      else this.revisar_(this.formulario);
    }

    // --- Cargar archivo .md: se lee en el navegador, nunca se envia ---

    errorCarga(mensaje) {
      const error = this.querySelector('[data-error-carga]');
      const entrada = this.querySelector('[data-carga-md]');
      error.querySelector('span').textContent = mensaje ?? '';
      error.hidden = !mensaje;
      entrada.setAttribute('aria-describedby', `campo-contenido-ayuda${mensaje ? ' carga-md-error' : ''}`);
      if (mensaje) entrada.setAttribute('aria-invalid', 'true');
      else entrada.removeAttribute('aria-invalid');
    }

    async cargarArchivo(entrada) {
      const archivo = entrada.files[0];
      if (!archivo) return;
      this.querySelector('[data-confirmar-reemplazo]').hidden = true;
      this.errorCarga();
      const { name: nombre, size } = archivo;
      let error = !/\.md$/i.test(nombre) ? `${nombre} no es un archivo .md. Elige un archivo Markdown.`
        : size > MAX_BYTES ? `${nombre} pesa ${peso(size)}; el máximo es 200 KB.`
        : size === 0 ? `${nombre} está vacío.` : '';
      let texto = '';
      if (!error) {
        try {
          texto = new TextDecoder('utf-8', { fatal: true }).decode(await archivo.arrayBuffer()); // sin el BOM inicial
          if (!texto.trim()) error = `${nombre} está vacío.`;
        } catch {
          error = `${nombre} no está en UTF-8. Guárdalo con codificación UTF-8 y vuelve a cargarlo.`;
        }
      }
      entrada.value = ''; // se puede volver a elegir el mismo archivo
      if (error) return this.errorCarga(error);
      this.pendiente = { nombre, texto };
      if (!this.contenido.value.trim()) return this.reemplazar();
      const confirmar = this.querySelector('[data-confirmar-reemplazo]');
      const titulo = confirmar.querySelector('.aviso-titulo');
      titulo.textContent = `¿Reemplazar el contenido por ${nombre}?`;
      confirmar.querySelector('.aviso').removeAttribute('role');
      confirmar.hidden = false;
      titulo.tabIndex = -1;
      titulo.focus();
    }

    mantenerEscrito() {
      this.pendiente = null;
      this.querySelector('[data-confirmar-reemplazo]').hidden = true;
      this.querySelector('[data-carga-md]').focus();
    }

    reemplazar() {
      const { nombre, texto } = this.pendiente;
      this.pendiente = null;
      this.querySelector('[data-confirmar-reemplazo]').hidden = true;
      this.contenido.value = texto;
      this.contenido.focus();
      this.anunciar(`Contenido reemplazado por ${nombre}.`);
      this.actualizarPrevia();
    }

    get cambio() {
      return this.formulario.querySelector('[name="tipo_cambio"]:checked')?.value ?? '';
    }

    alCambiarTipo() {
      const cambio = this.cambio;
      const version = this.formulario.querySelector('[name="version"]');
      if (!this.versionEscrita) version.value = siguienteVersion(this.ultima, cambio);
      const parche = cambio === 'parche';
      this.formulario.querySelector('[data-fecha]').hidden = parche;
      this.formulario.querySelector('[data-rige-ya]').hidden = !parche;
    }

    // Lee y valida el formulario; devuelve los valores o null.
    leer(f) {
      const campo = (n) => f.querySelector(`[name="${n}"]`);
      const errores = [];
      const cambio = this.cambio;
      const cambioEntrada = f.querySelector('#cambio-mayor');
      const primero = campo(`resumen_${tipos[this.tipoTexto].contextos[0]}`);
      [cambioEntrada, campo('version'), campo('vigente_desde'), primero, campo('contenido')].forEach(quitarError);
      if (!cambio) errores.push({ entrada: cambioEntrada, mensaje: 'Elige el tipo de cambio.', texto: 'Tipo de cambio' });
      const version = campo('version').value.trim();
      if (!esVersion(version)) errores.push({ entrada: campo('version'), mensaje: 'Escribe la versión como 1.2.0.', texto: 'Versión' });
      const fecha = campo('vigente_desde').value;
      if (cambio !== 'parche') {
        if (!esFecha(fecha)) errores.push({ entrada: campo('vigente_desde'), mensaje: 'Elige desde cuándo rige.', texto: 'Vigente desde' });
        else if (fecha < this.fechaMinima) errores.push({ entrada: campo('vigente_desde'), mensaje: `Elige una fecha desde el ${diaMesAnio(this.fechaMinima)}: los clientes necesitan 15 días de aviso.`, texto: 'Vigente desde' });
      }
      if (!primero.value.trim()) errores.push({ entrada: primero, mensaje: 'Escribe el resumen.', texto: `Resumen de ${contextos[tipos[this.tipoTexto].contextos[0]].toLowerCase()}` });
      const contenido = campo('contenido').value.trim();
      if (!contenido) errores.push({ entrada: campo('contenido'), mensaje: 'Escribe el contenido.', texto: 'Contenido' });
      else if (excede(contenido)) errores.push({ entrada: campo('contenido'), mensaje: 'El contenido supera los 300 000 caracteres. Acórtalo para publicarlo.', texto: 'Contenido' });
      if (!this.validar(errores, ['campo', 'campos'])) return null;
      const resumenes = Object.fromEntries(tipos[this.tipoTexto].contextos.map((c) => [c, campo(`resumen_${c}`).value.trim()]).filter(([, v]) => v));
      const cambios = campo('resumen_cambios').value.trim();
      return {
        tipo: this.tipoTexto, version, tipo_cambio: cambio, contenido, resumenes,
        ...(cambios && { resumen_cambios: cambios }),
        ...(cambio !== 'parche' && { vigente_desde: instante(fecha, '00:00') }),
      };
    }

    revisar_(formulario) {
      if (this.ocupado) return;
      const valores = this.leer(formulario);
      if (!valores) return;
      // R1 muestra el texto ya visto: si la vista previa no corresponde al contenido, se pide antes y, si falla, no se abre.
      if (this.previa?.contenido === valores.contenido) return this.abrirRevision(valores);
      this.enviar(formulario.querySelector('[data-revisar]'), 'Preparando revisión…', () => this.generarPrevia(valores.contenido).then(() => null, (error) => ({ error })), (r) => (r?.error ? this.errorPrevia(r.error) : this.abrirRevision(valores)));
    }

    abrirRevision(valores) {
      this.valores = valores;
      const revision = this.querySelector('[data-revision]');
      revision.replaceChildren(this.querySelector('template[data-estado="revision"]').content.cloneNode(true));
      const dato = (n, t) => (revision.querySelector(`[data-campo="${n}"]`).textContent = t);
      dato('nombre', tipos[valores.tipo].nombre);
      dato('tipo_cambio', nombresCambio[valores.tipo_cambio]);
      dato('version', valores.version);
      const parche = valores.tipo_cambio === 'parche';
      const fecha = parche ? null : valores.vigente_desde.slice(0, 10);
      dato('vigente_desde', parche ? 'Al publicarla' : diaMesAnio(fecha));
      dato('resumen', Object.entries(valores.resumenes).map(([c, t]) => `${contextos[c]}: ${t}`).join('\n\n'));
      revision.querySelector('[data-campo="contenido"]').replaceChildren(...limpiar(this.previa.html, PROSA));
      const consecuencias = parche
        ? ['Al publicarla no podrás editarla ni retirarla, y rige desde ahora.']
        : [`Al publicarla no podrás editarla. Avisaremos por correo a todos los clientes y regirá desde el ${diaMesAnio(fecha)} para las operaciones nuevas.`, ...(valores.tipo === 'terminos_uso' && valores.tipo_cambio === 'mayor' ? ['Cada cliente tendrá que aceptarlos de nuevo para reservar.'] : [])];
      revision.querySelector('[data-consecuencias]').replaceChildren(...consecuencias.map((t) => Object.assign(document.createElement('p'), { textContent: t })));
      this.querySelector('[data-salida]').hidden = true;
      revision.hidden = false;
      this.anunciar('Revisa antes de publicar');
      const titulo = revision.querySelector('.panel-titulo');
      titulo.tabIndex = -1;
      titulo.focus();
    }

    // `enfocar`: false cuando un error sigue con su propio foco.
    volverAEditar(enfocar = true) {
      this.querySelector('[data-revision]').hidden = true;
      this.querySelector('[data-revision]').replaceChildren();
      this.querySelector('[data-salida]').hidden = false;
      if (enfocar) this.querySelector('[data-revisar]').focus();
    }

    publicarVersion() {
      this.enviar(this.querySelector('[data-publicar-version]'), 'Publicando…', () => publicarTexto(this.valores), () => location.assign('/app/textos?aviso=version-publicada'), true);
    }
  }

  if (!customElements.get('bugalu-textos-legales')) customElements.define('bugalu-textos-legales', BugaluTextosLegales);
</script>

<style>
