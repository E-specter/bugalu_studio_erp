---
import Panel from '../componentes/Panel.astro';
import Aviso from '../componentes/Aviso.astro';
import Boton from '../componentes/Boton.astro';
import Campo from '../componentes/Campo.astro';
import Casilla from '../componentes/Casilla.astro';
import Tabla from '../componentes/Tabla.astro';
import EtiquetaTecnica from '../componentes/EtiquetaTecnica.astro';
import Icono from '../componentes/internos/Icono.astro';
import CambioSensible from './CambioSensible.astro';
import EstadosIsla from '../componentes/internos/EstadosIsla.astro';
import EstilosGestion from '../componentes/internos/EstilosGestion.astro';

interface Props {
  vista: 'semana' | 'parametros';
}
const { vista } = Astro.props;
// Panel de la vista mientras carga o falla (codigos y titulos de la spec RF-03-franjas).
const ayudaCambio = 'Si cambias un plazo, un porcentaje o un límite, te mostraremos el impacto y te pediremos confirmarlo.';
const principal = vista === 'semana' ? { codigo: 'F1', titulo: 'Publicadas' } : { codigo: 'P1', titulo: 'Plazo para pagar' };
---

<EstilosGestion />

<!-- Un bloque por estado (estados-sistema): la isla clona el que toca. Sin JS, el noscript oculta la carga y avisa. -->
<bugalu-franjas class="franjas" data-gestion vista={vista}>
  <div data-avisos></div>
  <!-- Region viva estable, presente antes de cualquier texto: anuncia cada carga y resultado una sola vez. -->
  <p class="visualmente-oculto" role="status" data-anuncio></p>
  <div data-salida><Panel {...principal} cargando /></div>
  {vista === 'parametros' && <CambioSensible />}

  <EstadosIsla principal={principal} />

  {vista === 'semana' && (
    <>
      <template data-estado="datos">
        <div class="gestion-periodo">
          <p class="gestion-periodo-titulo" data-titulo-semana></p>
          <nav class="gestion-periodo-enlaces" aria-label="Semana" data-periodo>
            <EtiquetaTecnica texto="Semana anterior" href="#" />
            <EtiquetaTecnica texto="Esta semana" href="#" />
            <EtiquetaTecnica texto="Semana siguiente" href="#" />
          </nav>
        </div>
        <div class="gestion-campo-sala" data-sala hidden>
          <Campo tipo="selector" nombre="sala" etiqueta="Sala" />
        </div>
        <div class="gestion-rejilla">
          <div class="gestion-principal">
            <Panel codigo="F1" titulo="Publicadas">
              <div data-f1-vacio hidden>
                <p class="gestion-vacio-titulo">No hay franjas publicadas esta semana</p>
                <p data-propuesta>Abajo tienes una propuesta: edítala y publícala.</p>
              </div>
              <Tabla titulo="Franjas publicadas" columnas={['Día', 'Horario', 'Reservas', '']} />
            </Panel>
            <Panel codigo="F2" titulo="Publicar franjas">
              <form novalidate method="post" class="gestion-formulario" data-formulario="publicar">
                <div data-nota="plantilla" hidden><Aviso variante="informacion" titulo="Te proponemos la última semana publicada. Cambia lo que haga falta antes de publicar." /></div>
                <div data-nota="sin-sugerencia" hidden><Aviso variante="informacion" titulo="No hay una semana anterior que copiar. Añade las franjas de cada día." /></div>
                <p class="gestion-ayuda" data-nota="publicada" hidden>Para abrir horas extra, añade franjas y publícalas.</p>
                <div class="gestion-formulario" data-dias></div>
                <div><Boton tipo="submit" data-envio>Publicar franjas</Boton></div>
              </form>
            </Panel>
          </div>
          <div class="gestion-lateral">
            <Panel codigo="F3" titulo="Cierres" variante="lateral">
              <p data-f3-vacio hidden>No hay cierres esta semana.</p>
              <Tabla titulo="Cierres de la semana" columnas={['Fecha', 'Horario', 'Motivo', '']} variante="compacta" />
              <form novalidate method="post" class="gestion-formulario franjas-cierre" data-formulario="cierre">
                <Campo tipo="date" nombre="cierre-fecha" etiqueta="Fecha" obligatorio />
                <Casilla nombre="todo-el-dia" etiqueta="Todo el día" marcada />
                <div class="gestion-fila-campos" data-horas hidden>
                  <Campo tipo="time" nombre="cierre-desde" etiqueta="Desde" step="1800" />
                  <Campo tipo="time" nombre="cierre-hasta" etiqueta="Hasta" step="1800" />
                </div>
                <Campo nombre="cierre-motivo" etiqueta="Motivo" ayuda="p. ej. Feriado o Mantenimiento. Lo verán los clientes." obligatorio />
                <div><Boton tipo="submit" variante="secundario" data-envio>Registrar cierre</Boton></div>
              </form>
            </Panel>
          </div>
        </div>
      </template>

      <template data-icono="chevron-left"><Icono nombre="chevron-left" /></template>
      <template data-icono="chevron-right"><Icono nombre="chevron-right" /></template>

      <template data-fila-publicada>
        <tr>
          <th scope="row" data-dia></th>
          <td data-etiqueta="Horario" data-horario></td>
          <td data-etiqueta="Reservas" data-reservas></td>
          <td>
            <Boton variante="peligro" data-envio data-retirar>Retirar franja<span class="visualmente-oculto" data-objeto></span></Boton>
            <span class="gestion-motivo" data-motivo hidden>Tiene reservas vigentes</span>
          </td>
        </tr>
      </template>

      <template data-fila-cierre>
        <tr>
          <th scope="row" data-fecha></th>
          <td data-etiqueta="Horario" data-horario></td>
          <td data-etiqueta="Motivo" data-motivo-cierre></td>
          <td><Boton variante="secundario" data-envio data-quitar-cierre>Quitar cierre<span class="visualmente-oculto" data-objeto></span></Boton></td>
        </tr>
      </template>

      <template data-dia>
        <fieldset class="gestion-grupo franjas-dia" data-dia-editor>
          <legend data-leyenda></legend>
          <div class="franjas-filas" data-filas></div>
          <div><Boton variante="secundario" data-anadir>Añadir franja<span class="visualmente-oculto" data-objeto></span></Boton></div>
        </fieldset>
      </template>

      <template data-fila-edicion>
        <div class="franja" role="group">
          <Campo tipo="time" nombre="desde" etiqueta="Desde" step="1800" />
          <Campo tipo="time" nombre="hasta" etiqueta="Hasta" step="1800" />
          <Boton variante="secundario" icono="x" data-quitar aria-label="Quitar franja" />
        </div>
      </template>
    </>
  )}

  {vista === 'parametros' && (
    <template data-estado="datos">
      <form novalidate method="post" class="gestion-formulario" data-formulario="parametros">
        <div class="gestion-rejilla gestion-rejilla-simple">
          <Panel codigo="P1" titulo="Plazo para pagar">
            <div class="gestion-formulario">
              <Campo tipo="number" nombre="dias_limite_pago" etiqueta="Días antes del inicio" ayuda="Si reserva con más de estos días, puede pagar hasta este número de días antes de la sesión." obligatorio min="1" step="1" inputmode="numeric" />
              <Campo tipo="number" nombre="horas_limite_pago" etiqueta="Horas desde la solicitud" ayuda="Si reserva con menos días, tiene estas horas para pagar." obligatorio min="1" step="1" inputmode="numeric" />
            </div>
          </Panel>
          <Panel codigo="P2" titulo="Anticipación">
            <div class="gestion-formulario">
              <Campo tipo="number" nombre="anticipacion_minima_horas" etiqueta="Anticipación mínima (horas)" ayuda="Lo más tarde que se puede reservar antes del inicio." obligatorio min="1" step="1" inputmode="numeric" />
              <Campo tipo="number" nombre="anticipacion_maxima_semanas" etiqueta="Anticipación máxima (semanas)" ayuda="Lo más lejos que se puede reservar." obligatorio min="1" step="1" inputmode="numeric" />
            </div>
          </Panel>
          <Panel codigo="P3" titulo="Cancelación y adelanto">
            <div class="gestion-formulario">
              <Campo tipo="number" nombre="porcentaje_adelanto" etiqueta="Adelanto para confirmar (%)" ayuda="Parte del total que se paga para confirmar la reserva." obligatorio min="1" max="100" step="1" inputmode="numeric" />
              <Campo tipo="number" nombre="horas_nivel_1" etiqueta="Límite del nivel 1 (horas)" ayuda="Con más horas de aviso, la cancelación o reprogramación no tiene cargo." obligatorio min="1" step="1" inputmode="numeric" />
              <Campo tipo="number" nombre="horas_nivel_2" etiqueta="Límite del nivel 2 (horas)" ayuda="Entre este límite y el del nivel 1 se aplica la penalización. Debe ser menor que el nivel 1." obligatorio min="1" step="1" inputmode="numeric" />
              <Campo tipo="number" nombre="porcentaje_penalizacion_nivel_2" etiqueta="Penalización del nivel 2 (%)" ayuda="Parte del valor de la reserva que se retiene en el nivel 2." obligatorio min="0" max="100" step="1" inputmode="numeric" />
              <Campo tipo="number" nombre="minutos_tolerancia_inasistencia" etiqueta="Tolerancia de inasistencia (min)" ayuda="Minutos de espera antes de contar una inasistencia." obligatorio min="0" step="1" inputmode="numeric" />
              <Campo tipo="number" nombre="dias_vigencia_credito" etiqueta="Vigencia del crédito (días)" ayuda="Cuánto dura el crédito que deja una reserva cancelada o reprogramada." obligatorio min="1" step="1" inputmode="numeric" />
              <Campo tipo="number" nombre="reprogramaciones_nivel_1" etiqueta="Reprogramaciones del nivel 1" ayuda="Cuántas veces se puede reprogramar sin cargo." obligatorio min="0" step="1" inputmode="numeric" />
              <Campo tipo="number" nombre="reprogramaciones_nivel_2" etiqueta="Reprogramaciones del nivel 2" ayuda="Cuántas veces se puede reprogramar con penalización." obligatorio min="0" step="1" inputmode="numeric" />
            </div>
          </Panel>
        </div>
        <div><Boton tipo="submit" data-envio>Guardar parámetros</Boton><p class="gestion-ayuda">{ayudaCambio}</p></div>
      </form>
    </template>
  )}
</bugalu-franjas>

<script>
  // @ts-nocheck
  import { IslaGestion, hacerUnico } from '../servicios/isla-gestion.js';
  import { listarSalas, obtenerDisponibilidad } from '../servicios/reservas.js';
  import { obtenerSugerencia, publicarFranjas, retirarFranja, registrarCierre, quitarCierre, obtenerParametros, guardarParametros } from '../servicios/franjas.js';
  import { hoyLima, fechaDe, horaDe, instante, sumarDias, lunesDe, semanaDe, rangoSemana, diaCorto, diaLargo, diaMes, nombreDia } from '../servicios/formatos.js';
  import { mostrarAviso, enfocarAviso, limpiarAvisos, quitarError } from '../servicios/formulario.js';

  const minutos = (hora) => Number(hora.slice(0, 2)) * 60 + Number(hora.slice(3, 5));
  const plural = (n, uno, varios) => `${n} ${n === 1 ? uno : varios}`;
  const horario = (inicio, fin) => `${horaDe(inicio)}–${horaDe(fin)}`;
  const esDiaCompleto = (c) => horaDe(c.inicio) === '00:00' && (Date.parse(c.fin) - Date.parse(c.inicio)) % 864e5 === 0;
  // HASTA 00:00 es la medianoche del dia siguiente.
  const finEnMinutos = (hasta) => minutos(hasta) || 1440;
  const finInstante = (fecha, hasta) => (finEnMinutos(hasta) === 1440 ? instante(sumarDias(fecha, 1), '00:00') : instante(fecha, hasta));
  // nombre -> [minimo, maximo]. Solo la anticipacion no es sensible: los demas pasan por la revision con confirmacion escrita (RF-20).
const LIMITES = {
  dias_limite_pago: [1], horas_limite_pago: [1], anticipacion_minima_horas: [1], anticipacion_maxima_semanas: [1],
  porcentaje_adelanto: [1, 100], horas_nivel_1: [1], horas_nivel_2: [1], porcentaje_penalizacion_nivel_2: [0, 100],
  minutos_tolerancia_inasistencia: [0], dias_vigencia_credito: [1], reprogramaciones_nivel_1: [0], reprogramaciones_nivel_2: [0],
};
const PARAMETROS = Object.keys(LIMITES);
const esSensible = (nombre) => !nombre.startsWith('anticipacion_');
const errorLimite = (nombre) => {
  const [min, max] = LIMITES[nombre];
  return max ? `Escribe un número entero de ${min} a ${max}.` : min ? 'Escribe un número entero mayor que 0.' : 'Escribe un número entero de 0 o más.';
};

  class BugaluFranjas extends IslaGestion {
    contador = 0;
    sala = null;
    lunes = '';
    sujeto = 'Esa franja';
    noEncontrada = ['No encontramos esto', 'Actualizamos la semana.'];

    iniciar() {
      this.addEventListener('click', (e) => {
        const boton = e.target.closest('button');
        if (!boton || boton.getAttribute('aria-disabled') === 'true') return;
        if (boton.matches('[data-anadir]')) this.anadirFila(boton.closest('fieldset'));
        else if (boton.matches('[data-quitar]')) this.quitarFila(boton.closest('.franja'));
        else if (boton.matches('[data-retirar]')) this.retirar(boton);
        else if (boton.matches('[data-quitar-cierre]')) this.eliminarCierre(boton);
      });
      this.addEventListener('input', (e) => e.target.closest('.franja') && this.etiquetarQuitar(e.target.closest('.franja')));
      this.addEventListener('change', (e) => {
        if (e.target.name === 'todo-el-dia') this.querySelector('[data-horas]').hidden = e.target.checked;
        if (e.target.name === 'sala') location.assign(this.enlace(this.lunes, e.target.value));
      });
    }

    alEnviar(formulario) {
      const accion = formulario.dataset.formulario;
      if (accion === 'publicar') this.publicar(formulario);
      else if (accion === 'cierre') this.cerrar(formulario);
      else this.guardar(formulario);
    }

    // Resultado de un envio con exito: recarga la vista y avisa con el foco en el aviso.
    async terminado(titulo, texto) {
      await this.cargar();
      enfocarAviso(mostrarAviso(this, 'exito', titulo, texto));
    }

    errorEnvio(error) {
      const aviso = (variante, titulo, texto, extra) => enfocarAviso(mostrarAviso(this, variante, titulo, texto, extra));
      if (error.codigo === 'franja_solapada') aviso('error', 'Una de las franjas se cruza con otra ya publicada', 'Revisa las horas y vuelve a publicar.');
      else if (error.codigo === 'franja_con_reservas') aviso('error', 'Esta franja tiene reservas vigentes', 'Cancélalas o espera a que terminen antes de retirarla.');
      else if (error.codigo === 'cierre_con_reservas') {
        const reservas = error.detalles?.reservas ?? [];
        aviso('error', `No puedes cerrar ese horario: tiene ${plural(reservas.length, 'reserva vigente', 'reservas vigentes')}`, 'Resuélvelas antes de cerrarlo.', {
          enlaces: reservas.map((r) => ({ texto: `${r.folio} · ${diaMes(fechaDe(r.inicio))}, ${horaDe(r.inicio)} · ${r.cliente}`, href: `/app/reservas/detalle?id=${encodeURIComponent(r.id)}` })),
        });
      } else if (error.estado === 428 && error.codigo === 'confirmacion_requerida' && this.ctx) this.revisar(this.ctx); // red de seguridad: el backend exige la revision
      else if (error.estado === 422 && error.codigo === 'sin_cambios') aviso('informacion', 'Ya tiene esos valores. No hay nada que cambiar.');
      else if (error.estado === 422 && error.codigo === 'plazos_incoherentes') this.plazosIncoherentes();
      else if (error.estado === 404) {
        this.cargar().then(() => aviso('informacion', `${this.sujeto} ya no existe`, 'Actualizamos la semana.'));
      } else if (error.estado === 422 && error.detalles?.campo) {
        const entrada = this.querySelector(`[name="${error.detalles.campo}"]`);
        if (!entrada) return false;
        this.validar([{ entrada, mensaje: LIMITES[entrada.name] ? errorLimite(entrada.name) : 'Escribe un número entero mayor que 0.', texto: this.etiqueta(entrada) }]);
      } else return false;
      return true;
    }

    // --- Semana ---

    enlace(lunes, sala = this.sala?.id) {
      const consulta = new URLSearchParams({ semana: semanaDe(lunes), ...(this.salas?.length > 1 && { sala }) });
      return `/app/franjas?${consulta}`;
    }

    async semana() {
      const parametro = new URLSearchParams(location.search).get('semana');
      const actual = lunesDe(semanaDe(hoyLima()));
      let lunes = lunesDe(parametro) ?? actual;
      const invalida = () => mostrarAviso(this, 'informacion', 'La semana del enlace no es válida', 'Te mostramos esta semana.');
      if (parametro !== null && !lunesDe(parametro)) invalida();

      this.salas = await listarSalas();
      const pedida = new URLSearchParams(location.search).get('sala');
      this.sala = this.salas.find((s) => s.id === pedida) ?? this.salas[0];
      const pedir = (l) => obtenerDisponibilidad({ sala: this.sala.id, desde: instante(l, '00:00'), hasta: instante(sumarDias(l, 7), '00:00') });
      let disponibilidad;
      try {
        disponibilidad = await pedir(lunes);
      } catch (error) {
        if (error.estado !== 422 || lunes === actual) throw error;
        invalida();
        lunes = actual;
        disponibilidad = await pedir(lunes);
      }
      this.lunes = lunes;
      const franjas = [...disponibilidad.franjas].sort((a, b) => a.inicio.localeCompare(b.inicio));
      const sugerencia = franjas.length ? [] : await obtenerSugerencia(this.sala.id, semanaDe(lunes));

      this.mostrar('datos');
      this.pintarPeriodo(lunes);
      this.pintarPublicadas(franjas, disponibilidad.ocupados ?? [], sugerencia.length > 0);
      this.pintarEditor(lunes, franjas, sugerencia);
      this.pintarCierres(disponibilidad.cierres ?? []);
      return `${plural(franjas.length, 'franja publicada', 'franjas publicadas')} esta semana`;
    }

    pintarPeriodo(lunes) {
      const [anterior, hoy, siguiente] = this.querySelectorAll('[data-periodo] a');
      const icono = (nombre) => this.querySelector(`template[data-icono="${nombre}"]`).content.firstElementChild.cloneNode(true);
      anterior.prepend(icono('chevron-left'));
      siguiente.append(icono('chevron-right'));
      anterior.href = this.enlace(sumarDias(lunes, -7));
      siguiente.href = this.enlace(sumarDias(lunes, 7));
      hoy.href = '/app/franjas';
      this.querySelector('[data-titulo-semana]').textContent = rangoSemana(lunes);
      if (this.salas.length > 1) {
        const selector = this.querySelector('[data-sala] select');
        selector.replaceChildren(...this.salas.map((s) => new Option(s.nombre, s.id, false, s.id === this.sala.id)));
        this.querySelector('[data-sala]').hidden = false;
      }
    }

    pintarPublicadas(franjas, ocupados, hayPropuesta) {
      this.querySelector('[data-f1-vacio]').hidden = franjas.length > 0;
      if (!hayPropuesta) this.querySelector('[data-propuesta]').remove();
      const plantilla = this.querySelector('template[data-fila-publicada]');
      const tabla = this.querySelector('[data-f1-vacio]').nextElementSibling;
      tabla.hidden = franjas.length === 0;
      tabla.querySelector('tbody').replaceChildren(
        ...franjas.map((f, i) => {
          const fila = plantilla.content.cloneNode(true).firstElementChild;
          const reservas = ocupados.filter((o) => Date.parse(o.inicio) < Date.parse(f.fin) && Date.parse(o.fin) > Date.parse(f.inicio)).length;
          const fecha = fechaDe(f.inicio);
          fila.querySelector('[data-dia]').textContent = diaCorto(fecha);
          fila.querySelector('[data-horario]').textContent = horario(f.inicio, f.fin);
          fila.querySelector('[data-reservas]').textContent = reservas ? plural(reservas, 'reserva', 'reservas') : '—';
          const boton = fila.querySelector('[data-retirar]');
          boton.dataset.id = f.id;
          fila.querySelector('[data-objeto]').textContent = ` del ${nombreDia(fecha)} ${Number(fecha.slice(8))} de ${horaDe(f.inicio)} a ${horaDe(f.fin)}`;
          if (reservas) {
            const motivo = fila.querySelector('[data-motivo]');
            motivo.id = `motivo-franja-${i}`;
            motivo.hidden = false;
            boton.setAttribute('aria-disabled', 'true');
            boton.setAttribute('aria-describedby', motivo.id);
          } else fila.querySelector('[data-motivo]').remove();
          return fila;
        }),
      );
    }

    pintarCierres(cierres) {
      this.querySelector('[data-f3-vacio]').hidden = cierres.length > 0;
      const tabla = this.querySelector('[data-f3-vacio]').nextElementSibling;
      tabla.hidden = cierres.length === 0;
      const plantilla = this.querySelector('template[data-fila-cierre]');
      tabla.querySelector('tbody').replaceChildren(
        ...[...cierres].sort((a, b) => a.inicio.localeCompare(b.inicio)).map((c) => {
          const fila = plantilla.content.cloneNode(true).firstElementChild;
          const dia = diaMes(fechaDe(c.inicio));
          fila.querySelector('[data-fecha]').textContent = dia;
          fila.querySelector('[data-horario]').textContent = esDiaCompleto(c) ? 'Todo el día' : horario(c.inicio, c.fin);
          fila.querySelector('[data-motivo-cierre]').textContent = c.motivo;
          fila.querySelector('[data-quitar-cierre]').dataset.id = c.id;
          fila.querySelector('[data-objeto]').textContent = ` del ${dia}`;
          return fila;
        }),
      );
    }

    // --- Editor de franjas: un fieldset por dia, filas DESDE / HASTA ---

    pintarEditor(lunes, franjas, sugerencia) {
      const plantilla = this.querySelector('template[data-dia]');
      const dias = Array.from({ length: 7 }, (_, i) => sumarDias(lunes, i));
      this.querySelector('[data-dias]').replaceChildren(
        ...dias.map((fecha) => {
          const dia = plantilla.content.cloneNode(true).firstElementChild;
          dia.dataset.fecha = fecha;
          dia.querySelector('legend').textContent = diaLargo(fecha);
          dia.querySelector('[data-objeto]').textContent = ` al ${nombreDia(fecha)}`;
          return dia;
        }),
      );
      if (franjas.length) this.querySelector('[data-nota="publicada"]').hidden = false;
      else this.querySelector(`[data-nota="${sugerencia.length ? 'plantilla' : 'sin-sugerencia'}"]`).hidden = false;
      for (const s of sugerencia) {
        const dia = this.querySelector(`fieldset[data-fecha="${fechaDe(s.inicio)}"]`);
        if (dia) this.anadirFila(dia, horaDe(s.inicio), horaDe(s.fin), false);
      }
    }

    anadirFila(dia, desde = '', hasta = '', enfocar = true) {
      const fila = this.querySelector('template[data-fila-edicion]').content.cloneNode(true);
      hacerUnico(fila, `f${++this.contador}`);
      const grupo = fila.firstElementChild;
      grupo.setAttribute('aria-label', `Franja del ${nombreDia(dia.dataset.fecha)}`);
      grupo.querySelector('[name="desde"]').value = desde;
      grupo.querySelector('[name="hasta"]').value = hasta;
      dia.querySelector('[data-filas]').append(fila);
      this.etiquetarQuitar(grupo);
      if (enfocar) grupo.querySelector('[name="desde"]').focus();
    }

    quitarFila(fila) {
      const dia = fila.closest('fieldset');
      fila.remove();
      dia.querySelector('[data-anadir]').focus();
    }

    etiquetarQuitar(fila) {
      const desde = fila.querySelector('[name="desde"]').value;
      const hasta = fila.querySelector('[name="hasta"]').value;
      const dia = nombreDia(fila.closest('fieldset').dataset.fecha);
      fila.querySelector('[data-quitar]').setAttribute('aria-label', desde && hasta ? `Quitar franja de ${desde} a ${hasta} del ${dia}` : `Quitar franja del ${dia}`);
    }

    // Valida las filas (por fila, un solo error) y publica solo las completas.
    publicar(formulario) {
      if (this.ocupado) return;
      const errores = [];
      const franjas = [];
      for (const dia of formulario.querySelectorAll('fieldset[data-fecha]')) {
        const leyenda = dia.querySelector('legend').textContent;
        const filas = [...dia.querySelectorAll('.franja')].map((f) => ({ desde: f.querySelector('[name="desde"]'), hasta: f.querySelector('[name="hasta"]') })).filter((f) => f.desde.value || f.hasta.value);
        const validas = [];
        const fallo = (entrada, mensaje, campo) => errores.push({ entrada, mensaje, texto: `${leyenda} · ${campo}` });
        for (const f of filas) {
          [f.desde, f.hasta].forEach(quitarError);
          const { value: d } = f.desde;
          const { value: h } = f.hasta;
          if (!d) fallo(f.desde, 'Elige la hora de inicio.', 'Desde');
          else if (!h) fallo(f.hasta, 'Elige la hora de fin.', 'Hasta');
          else if (minutos(d) % 30) fallo(f.desde, 'Usa horas en punto o y media.', 'Desde');
          else if (minutos(h) % 30) fallo(f.hasta, 'Usa horas en punto o y media.', 'Hasta');
          else if (finEnMinutos(h) <= minutos(d)) fallo(f.hasta, 'La hora de fin debe ser posterior a la de inicio.', 'Hasta');
          else validas.push({ ...f, ini: minutos(d), fin: finEnMinutos(h), d, h });
        }
        // Cruces del mismo dia: se marcan las dos filas que se pisan.
        const marcadas = new Set();
        validas.forEach((a, i) => validas.slice(i + 1).forEach((b) => {
          if (a.ini >= b.fin || b.ini >= a.fin) return;
          for (const [x, y] of [[a, b], [b, a]]) {
            if (marcadas.has(x)) continue;
            marcadas.add(x);
            fallo(x.desde, `Se cruza con la franja de ${y.d}–${y.h} del mismo día.`, 'Desde');
          }
        }));
        validas.forEach((f) => franjas.push({ inicio: instante(dia.dataset.fecha, f.d), fin: finInstante(dia.dataset.fecha, f.h) }));
      }
      if (!this.validar(errores, ['franja', 'franjas'])) return;
      if (!franjas.length) return enfocarAviso(mostrarAviso(this, 'error', 'Añade al menos una franja', 'Pon las horas de inicio y de fin de cada día que abras.'));
      this.enviar(formulario.querySelector('[data-envio]'), 'Publicando…', () => publicarFranjas(this.sala.id, franjas), () => this.terminado('Franjas publicadas', 'Ya se ven en el calendario.'));
    }

    retirar(boton) {
      this.sujeto = 'Esa franja';
      this.enviar(boton, 'Retirando…', () => retirarFranja(boton.dataset.id), () => this.terminado('Franja retirada.'));
    }

    // --- Cierres ---

    cerrar(formulario) {
      if (this.ocupado) return;
      const campo = (nombre) => formulario.querySelector(`[name="${nombre}"]`);
      const [fecha, desde, hasta, motivo] = ['cierre-fecha', 'cierre-desde', 'cierre-hasta', 'cierre-motivo'].map(campo);
      const todo = campo('todo-el-dia').checked;
      [fecha, desde, hasta, motivo].forEach(quitarError);
      const errores = [];
      if (!fecha.value) errores.push({ entrada: fecha, mensaje: 'Elige la fecha.', texto: 'Fecha' });
      if (!todo && !desde.value) errores.push({ entrada: desde, mensaje: 'Elige la hora de inicio.', texto: 'Desde' });
      else if (!todo && !hasta.value) errores.push({ entrada: hasta, mensaje: 'Elige la hora de fin.', texto: 'Hasta' });
      else if (!todo && (minutos(desde.value) % 30 || minutos(hasta.value) % 30)) errores.push({ entrada: minutos(desde.value) % 30 ? desde : hasta, mensaje: 'Usa horas en punto o y media.', texto: 'Horas' });
      else if (!todo && finEnMinutos(hasta.value) <= minutos(desde.value)) errores.push({ entrada: hasta, mensaje: 'La hora de fin debe ser posterior a la de inicio.', texto: 'Hasta' });
      if (!motivo.value.trim()) errores.push({ entrada: motivo, mensaje: 'Escribe el motivo; lo verán los clientes en el calendario.', texto: 'Motivo' });
      if (!this.validar(errores)) return;
      const cuerpo = {
        id_sala: this.sala.id,
        inicio: instante(fecha.value, todo ? '00:00' : desde.value),
        fin: todo ? instante(sumarDias(fecha.value, 1), '00:00') : finInstante(fecha.value, hasta.value),
        motivo: motivo.value.trim(),
      };
      this.enviar(formulario.querySelector('[data-envio]'), 'Registrando…', () => registrarCierre(cuerpo), () => this.terminado('Cierre registrado.'));
    }

    eliminarCierre(boton) {
      this.sujeto = 'Ese cierre';
      this.enviar(boton, 'Quitando…', () => quitarCierre(boton.dataset.id), () => this.terminado('Cierre quitado.'));
    }

    // --- Parametros ---

    async parametros() {
      const datos = await obtenerParametros();
      this.mostrar('datos');
      this.llenarParametros(datos);
      return 'Parámetros de reserva';
    }

    llenarParametros(datos) {
      this.cargado = datos;
      PARAMETROS.forEach((nombre) => (this.querySelector(`[name="${nombre}"]`).value = datos[nombre]));
    }

    plazosIncoherentes() {
      const uno = this.querySelector('[name="horas_nivel_1"]').value;
      this.validar([{ entrada: this.querySelector('[name="horas_nivel_2"]'), mensaje: `Debe ser menor que el límite del nivel 1 (${uno} h).`, texto: 'Límite del nivel 2' }]);
    }

    guardar(formulario) {
      if (this.ocupado) return;
      const campos = PARAMETROS.map((nombre) => formulario.querySelector(`[name="${nombre}"]`));
      campos.forEach(quitarError);
      const errores = campos.filter((c) => {
        const [min, max = Infinity] = LIMITES[c.name];
        return !/^\d+$/.test(c.value.trim()) || Number(c.value) < min || Number(c.value) > max;
      }).map((entrada) => ({ entrada, mensaje: errorLimite(entrada.name), texto: this.etiqueta(entrada) }));
      const [nivel1, nivel2] = ['horas_nivel_1', 'horas_nivel_2'].map((n) => formulario.querySelector(`[name="${n}"]`));
      if (!errores.some((e) => e.entrada === nivel1 || e.entrada === nivel2) && Number(nivel2.value) >= Number(nivel1.value)) {
        errores.push({ entrada: nivel2, mensaje: `Debe ser menor que el límite del nivel 1 (${nivel1.value} h).`, texto: this.etiqueta(nivel2) });
      }
      if (!this.validar(errores)) return;
      const cuerpo = Object.fromEntries(campos.map((c) => [c.name, Number(c.value)]));
      const cambiados = PARAMETROS.filter((n) => cuerpo[n] !== Number(this.cargado[n]));
      const sensibles = cambiados.filter(esSensible);
      const boton = formulario.querySelector('[data-envio]');
      const exito = (datos, conEnlace = false) => {
        this.llenarParametros(datos ?? cuerpo);
        limpiarAvisos(this);
        const enlace = conEnlace ? { enlace: { texto: 'Ver en el registro de cambios', href: '/app/cambios?recurso=parametros' } } : undefined;
        enfocarAviso(mostrarAviso(this, 'exito', 'Parámetros guardados', 'La anticipación ya vale en el calendario; los plazos de pago, en las reservas nuevas.', enlace));
      };
      const resto = cambiados.filter((n) => !esSensible(n));
      this.ctx = {
        formulario,
        cuerpo,
        peticion: { recurso: 'parametros', cambios: Object.fromEntries(sensibles.map((n) => [n, cuerpo[n]])) },
        resto: resto.length ? () => guardarParametros(Object.fromEntries(resto.map((n) => [n, cuerpo[n]]))) : null,
        restoNombre: 'Anticipación',
        cambiado: 'Los parámetros se cambiaron',
        exito: async () => {
          await this.cargar();
          exito(this.cargado, true);
        },
      };
      if (sensibles.length) this.revisar(this.ctx);
      else this.enviar(boton, 'Guardando…', () => guardarParametros(cuerpo), exito);
    }
  }

  if (!customElements.get('bugalu-franjas')) customElements.define('bugalu-franjas', BugaluFranjas);
</script>

