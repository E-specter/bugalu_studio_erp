    margin-block-end: var(--espacio-4);
  }
  .franjas :global(.franja) {
    display: grid;
    gap: var(--espacio-3);
    grid-template-columns: 1fr 1fr auto;
    align-items: end;
  }
  .franjas :global(.franjas-filas) {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-3);
  }
  .franjas :global(.franjas-dia) {
    padding-block-end: var(--espacio-4);
    border-block-end: var(--borde-grosor-fino) solid var(--color-borde-fuerte);
  }
  .franjas :global(.gestion-campo-sala) {
    margin-block-end: var(--espacio-4);
    max-inline-size: var(--medida-columna-lateral);
  }
</style>
