  }
  .reclamacion-leyendas p,
  .reclamacion-leyenda {
    color: var(--color-texto-cuerpo);
    font-size: var(--fuente-tamano-pequeno);
  }
  .reclamacion-subtitulo {
    margin-block-end: var(--espacio-2);
  }
  .reclamacion-revision {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-2);
  }
  .reclamacion-barra {
    display: flex;
