  }
  /* Campo trampa (CA-12): fuera de la vista y del arbol de accesibilidad, pero no display:none (los robots lo saltarian). */
  .reclamacion-sitio {
    position: absolute;
    inline-size: var(--borde-grosor-fino);
    block-size: var(--borde-grosor-fino);
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (min-width: 37.5em) { /* punto-quiebre-tableta */
    .reclamacion-acciones {
      flex-direction: row;
    }
  }
</style>
