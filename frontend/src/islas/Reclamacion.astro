  .reclamacion-previa {
    max-inline-size: var(--medida-contenedor-max);
  }
  .reclamacion-formulario :global(.campo) {
    max-inline-size: var(--medida-linea-lectura);
  }
  .reclamacion-formulario :global(.gestion-fila-campos > .campo) {
    max-inline-size: none;
  }
  .reclamacion-leyendas {
    display: flex;
    flex-direction: column;
