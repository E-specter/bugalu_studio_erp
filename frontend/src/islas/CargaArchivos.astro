---
// Variante captura de pago (carga-archivos.md): un <input type="file" name="captura"> real dentro del <form> de la pantalla, que
// lo envia en su multipart (variante foto: la subida la hace la pantalla, con su propio endpoint). Sin zona de soltar ni progreso. Sin JS queda el input nativo; la isla pone el boton y el adjunto.
import Campo from '../componentes/Campo.astro';
import Archivo from '../componentes/Archivo.astro';
import Icono from '../componentes/internos/Icono.astro';
import MensajeError from '../componentes/internos/MensajeError.astro';

interface Props {
  variante?: 'captura' | 'reclamo' | 'foto';
  maxArchivos?: number;
  etiqueta: string;
  ayuda?: string;
  nombre?: string;
  id?: string;
  accept?: string;
  maxMb?: number;
  obligatorio?: boolean;
  textoBoton?: string;
}
const { variante = 'captura', maxArchivos = 3, etiqueta, ayuda, nombre = 'captura', id = `carga-${nombre}`, accept = variante === 'foto' ? 'image/jpeg,image/png,image/webp' : 'image/jpeg,image/png,application/pdf', maxMb = variante === 'foto' ? 2 : 5, obligatorio = false, textoBoton = variante === 'foto' ? 'Elegir foto' : 'Seleccionar archivo' } = Astro.props;
const reclamo = variante === 'reclamo';
const foto = variante === 'foto';
---

<bugalu-carga-archivos variante={variante} max-mb={maxMb} max-archivos={maxArchivos} accept={accept}>
  <!-- Campo pinta <input type={tipo}> para cualquier tipo que no sea area, selector, password ni search: 'file' funciona aunque su tipado no lo liste. -->
  <Campo tipo={'file' as 'text'} {nombre} {etiqueta} {ayuda} {id} {obligatorio} accept={accept} multiple={reclamo || undefined} />
  <template data-boton><label class="carga-boton"><Icono nombre="upload" /><span data-texto>{textoBoton}</span></label></template>
  <template data-archivo><Archivo nombre=" " tipo={foto ? 'imagen' : 'pdf'} metadato=" " /></template>
  {(reclamo || foto) && <template data-plantilla="error"><MensajeError id="" texto=" " /></template>}
</bugalu-carga-archivos>

<script>
  // @ts-nocheck
  import { tamanoArchivo as tamano } from '../servicios/hoja-reclamacion.js';
  import { ponerError, quitarError } from '../servicios/formulario.js';
  const MB = 1048576;
  const TIPOS = { 'image/jpeg': 'JPG', 'image/png': 'PNG', 'image/webp': 'WEBP', 'application/pdf': 'PDF' };

  class BugaluCargaArchivos extends HTMLElement {
    static observedAttributes = ['texto-boton'];

    // Foto de perfil: el texto del control cambia con la foto guardada ("Elegir foto" / "Cambiar foto").
    attributeChangedCallback(_nombre, _antes, valor) {
      const texto = this.querySelector('.carga-boton [data-texto]');
      if (texto && valor) texto.textContent = valor;
    }

    connectedCallback() {
      this.entrada = this.querySelector('input[type="file"]');
      this.boton = this.querySelector('template[data-boton]').content.firstElementChild.cloneNode(true);
      this.boton.htmlFor = this.entrada.id;
      this.adjunto = document.createElement('div');
      this.adjunto.hidden = true;
      this.entrada.classList.add('carga-entrada', 'visualmente-oculto');
      // Region estable: anuncia el adjunto, el error o el retiro (el input oculto no lo hace por si solo).
      this.estado = Object.assign(document.createElement('div'), { className: 'visualmente-oculto' });
      this.estado.setAttribute('role', 'status');
      this.entrada.after(this.boton, this.adjunto, this.estado);
      if (this.getAttribute('variante') === 'reclamo') return this.iniciarReclamo();
      this.entrada.addEventListener('change', () => this.cambiar());
      this.adjunto.addEventListener('click', (e) => e.target.closest('.archivo-accion') && this.quitar());
      if (this.getAttribute('texto-boton')) this.attributeChangedCallback('', '', this.getAttribute('texto-boton'));
    }

    // --- Foto de perfil: una imagen que se sube aparte; la vista previa la pinta la pantalla en su avatar ---

    errorFoto(f) {
      if (f.size > Number(this.getAttribute('max-mb')) * MB) return `La foto pesa más de ${this.getAttribute('max-mb')} MB. Elige una más liviana.`;
      if (!this.getAttribute('accept').split(',').includes(f.type)) return 'Elige una foto JPG, PNG o WebP.';
      return null;
    }

    cambiarFoto(quitado) {
      const f = this.archivo;
      quitarError(this.entrada);
      this.adjunto.replaceChildren();
      const motivo = f && this.errorFoto(f);
      if (motivo) {
        this.entrada.value = '';
        ponerError(this, this.entrada, motivo);
        this.estado.textContent = motivo;
      }
      const valida = f && !motivo;
      this.adjunto.hidden = !valida;
      this.boton.hidden = Boolean(valida);
      if (valida) {
        const nodo = this.querySelector('template[data-archivo]').content.firstElementChild.cloneNode(true);
        nodo.querySelector('.archivo-nombre').textContent = f.name;
        nodo.querySelector('.archivo-nombre').title = f.name;
        nodo.querySelector('.archivo-metadato').textContent = `${TIPOS[f.type] ?? ''} · ${tamano(f.size)}`;
        nodo.querySelector('.archivo-accion').setAttribute('aria-label', `Quitar ${f.name}`);
        this.adjunto.append(nodo);
        this.estado.textContent = `Foto elegida: ${f.name}, ${tamano(f.size)}. Pulsa Subir foto para guardarla.`;
        this.entrada.tabIndex = -1;
        nodo.querySelector('.archivo-accion').focus();
      } else {
        this.entrada.removeAttribute('tabindex');
        if (!motivo) this.estado.textContent = quitado ? `Quitaste ${quitado}.` : '';
      }
      this.dispatchEvent(new CustomEvent('cambio', { bubbles: true }));
    }

    // Tras subir o quitar la foto: vuelve a "sin elegir".
    reiniciar() {
      this.entrada.value = '';
      this.cambiarFoto(null);
    }

    // --- Adjuntos de reclamo: varios archivos que se suman (hasta max-archivos) y viajan en el FormData de la pantalla ---

    iniciarReclamo() {
      this.archivos = [];
      this.maximo = Number(this.getAttribute('max-archivos'));
      this.ayuda = this.querySelector('.campo-ayuda');
      this.textoAyuda = this.ayuda?.textContent ?? '';
      this.adjunto = Object.assign(document.createElement('ul'), { className: 'carga-lista' });
      this.boton.after(this.adjunto);
      this.entrada.addEventListener('change', () => this.agregar());
      this.adjunto.addEventListener('click', (e) => {
        const boton = e.target.closest('.archivo-accion');
        if (boton) this.quitarReclamo([...this.adjunto.children].indexOf(boton.closest('li')));
      });
    }

    agregar() {
      const maxMb = Number(this.getAttribute('max-mb'));
      const tipos = this.getAttribute('accept').split(',');
      const errores = [];
      for (const f of [...this.entrada.files]) {
        if (this.archivos.length >= this.maximo) errores.push(`Puedes adjuntar hasta ${this.maximo} archivos. Quita uno para añadir ${f.name}.`);
        else if (!tipos.includes(f.type)) errores.push(`${f.name} no es PDF, JPG ni PNG. Elige otro archivo.`);
        else if (f.size > maxMb * MB) errores.push(`${f.name} pesa más de ${maxMb} MB. Elige uno más liviano.`);
        else this.archivos.push(f);
      }
      this.entrada.value = ''; // el input solo sirve para elegir: la lista vive en memoria
      this.limpiarRechazos();
      this.pintarLista();
      if (errores.length) this.errorGrupo(errores.join(' '));
      this.estado.textContent = errores.length ? errores.join(' ') : `${this.archivos.length} de ${this.maximo} archivos adjuntos.`;
      this.dispatchEvent(new CustomEvent('cambio', { bubbles: true }));
    }

    pintarLista() {
      this.vistas?.forEach((u) => URL.revokeObjectURL(u));
      this.vistas = [];
      const modelo = this.querySelector('template[data-archivo]');
      this.adjunto.replaceChildren(...this.archivos.map((f) => {
        const li = document.createElement('li');
        const nodo = modelo.content.firstElementChild.cloneNode(true);
        nodo.querySelector('.archivo-nombre').textContent = f.name;
        nodo.querySelector('.archivo-nombre').title = f.name;
        nodo.querySelector('.archivo-metadato').textContent = `${TIPOS[f.type] ?? ''} · ${tamano(f.size)}`;
        nodo.querySelector('.archivo-accion').setAttribute('aria-label', `Quitar ${f.name}`);
        if (f.type.startsWith('image/')) {
          const src = URL.createObjectURL(f);
          this.vistas.push(src);
          nodo.querySelector('.archivo-visual').replaceChildren(Object.assign(document.createElement('img'), { className: 'archivo-miniatura', src, alt: `Vista previa de ${f.name}` }));
        }
        li.append(nodo);
        return li;
      }));
      const lleno = this.archivos.length >= this.maximo;
      this.boton.hidden = lleno;
      if (this.ayuda) this.ayuda.textContent = lleno ? `Máximo ${this.maximo} archivos.` : this.textoAyuda;
    }

    quitarReclamo(i) {
      const [quitado] = this.archivos.splice(i, 1);
      this.limpiarRechazos();
      this.pintarLista();
      this.estado.textContent = `Quitaste ${quitado.name}.`;
      const botones = this.querySelectorAll('.archivo-accion');
      (botones[Math.min(i, botones.length - 1)] ?? this.entrada).focus();
      this.dispatchEvent(new CustomEvent('cambio', { bubbles: true }));
    }

    errorGrupo(texto) {
      ponerError(this, this.entrada, texto);
    }

    // El servidor rechazo el adjunto `n` (desde 1): ese archivo toma el estado Error hasta que se quite. Sin `n`, error del grupo.
    marcarRechazado(n, texto) {
      this.limpiarRechazos();
      const li = this.adjunto.children[n - 1];
      if (!li) {
        this.errorGrupo(texto);
        this.entrada.focus();
        return;
      }
      const mensaje = this.querySelector('template[data-plantilla="error"]').content.firstElementChild.cloneNode(true);
      mensaje.id = `${this.entrada.id}-rechazo-${n}`;
      mensaje.querySelector('span').textContent = texto;
      li.querySelector('.archivo').dataset.error = '';
      li.querySelector('.archivo-accion').setAttribute('aria-describedby', mensaje.id);
      li.append(mensaje);
      li.querySelector('.archivo-accion').focus();
    }

    limpiarRechazos() {
      quitarError(this.entrada);
      this.adjunto.querySelectorAll('.mensaje-error').forEach((m) => m.remove());
      this.adjunto.querySelectorAll('[data-error]').forEach((a) => a.removeAttribute('data-error'));
      this.adjunto.querySelectorAll('[aria-describedby]').forEach((a) => a.removeAttribute('aria-describedby'));
    }

    // Mientras se envia la hoja, ni se suma ni se quita nada.
    bloquear(si) {
      this.entrada.disabled = si;
      this.adjunto.querySelectorAll('.archivo-accion').forEach((b) => (b.disabled = si));
    }

    get archivo() {
      return this.entrada.files[0] ?? null;
    }

    // Primera capa en el navegador (manda la del servidor): null si no hay problema.
    error() {
      const f = this.archivo;
      const max = Number(this.getAttribute('max-mb'));
      if (!f) return this.entrada.required ? 'Adjunta la captura del comprobante.' : null;
      if (f.size > max * MB) return `La captura pesa ${String(Number((f.size / MB).toFixed(1))).replace('.', ',')} MB. Sube una de hasta ${max} MB.`;
      if (!this.getAttribute('accept').split(',').includes(f.type)) return 'Sube la captura en JPG, PNG o PDF.';
      return null;
    }

    cambiar(quitado = null) {
      if (this.getAttribute('variante') === 'foto') return this.cambiarFoto(quitado);
      const f = this.archivo;
      const enfocado = document.activeElement === this.entrada;
      URL.revokeObjectURL(this.vista ?? '');
      this.vista = null;
      this.adjunto.replaceChildren();
      this.adjunto.hidden = !f;
      this.boton.hidden = Boolean(f);
      if (f) {
        const nodo = this.querySelector('template[data-archivo]').content.firstElementChild.cloneNode(true);
        nodo.querySelector('.archivo-nombre').textContent = f.name;
        nodo.querySelector('.archivo-nombre').title = f.name;
        nodo.querySelector('.archivo-metadato').textContent = `${TIPOS[f.type] ?? (f.name.split('.').pop() || '').toUpperCase()} · ${tamano(f.size)}`;
        nodo.querySelector('.archivo-accion').setAttribute('aria-label', `Quitar ${f.name}`);
        if (f.type.startsWith('image/')) {
          this.vista = URL.createObjectURL(f);
          const img = Object.assign(document.createElement('img'), { className: 'archivo-miniatura', src: this.vista, alt: `Vista previa de la captura ${f.name}` });
          nodo.querySelector('.archivo-visual').replaceChildren(img);
        }
        this.adjunto.append(nodo);
        this.estado.textContent = this.error() ?? `Adjuntaste ${f.name} (${nodo.querySelector('.archivo-metadato').textContent})`;
        if (enfocado) nodo.querySelector('.archivo-accion').focus();
      } else this.estado.textContent = quitado ? `Quitaste ${quitado}. Elige otro archivo.` : '';
      // Con adjunto, el input sigue en el formulario pero no es parada de teclado: el control es "Quitar".
      if (f) this.entrada.tabIndex = -1;
      else this.entrada.removeAttribute('tabindex');
      this.dispatchEvent(new CustomEvent('cambio', { bubbles: true }));
    }

    quitar() {
      const nombre = this.archivo?.name;
      this.entrada.value = '';
      this.cambiar(nombre);
      this.entrada.focus();
    }
  }

  if (!customElements.get('bugalu-carga-archivos')) customElements.define('bugalu-carga-archivos', BugaluCargaArchivos);
</script>

<style>
  bugalu-carga-archivos {
    display: block;
  }
  bugalu-carga-archivos :global(.campo) {
    gap: var(--espacio-3);
  }
  /* El input real queda fuera de la vista (no display:none: sigue enfocable y en el formulario); gana a la medida del campo. */
  bugalu-carga-archivos :global(.campo-control.carga-entrada) {
    inline-size: var(--borde-grosor-fino);
    min-block-size: 0;
    padding: 0;
  }
  .carga-boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-2);
    box-sizing: border-box;
    inline-size: fit-content;
    min-block-size: var(--medida-control-tactil);
    padding: var(--espacio-2) var(--espacio-5);
    background: var(--color-fondo-superficie);
    border: var(--borde-grosor-base) solid var(--color-borde-fuerte);
    color: var(--color-texto-principal);
    font-family: var(--fuente-familia-titulo);
    font-weight: var(--fuente-peso-titulo);
    font-size: var(--fuente-tamano-base);
    line-height: var(--fuente-interlineado-interfaz);
    text-transform: uppercase;
    cursor: pointer;
  }
  .carga-lista {
    display: grid;
    gap: var(--espacio-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .carga-lista:empty {
    display: none;
  }
  .carga-lista li {
    display: grid;
    gap: var(--espacio-2);
  }
  .carga-boton[hidden] {
    display: none;
  }
  @media (min-width: 37.5em) { /* punto-quiebre-tableta */
    .carga-boton {
      min-block-size: var(--medida-control-base);
    }
  }
  /* El foco real está en el input (oculto): el anillo se ve en el botón que lo representa. */
  bugalu-carga-archivos :global(.carga-entrada:focus-visible) + .carga-boton {
    outline: var(--borde-grosor-base) solid var(--color-foco-anillo);
    outline-offset: var(--borde-grosor-base);
  }
  bugalu-carga-archivos :global(.carga-entrada[aria-invalid='true']) + .carga-boton {
    border-color: var(--color-texto-alerta);
  }
  @media (hover: hover) {
    .carga-boton:hover {
      background: var(--color-fondo-alerta);
      color: var(--color-texto-sobre-alerta);
    }
  }
</style>
