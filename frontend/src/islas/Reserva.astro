---
import Panel from '../componentes/Panel.astro';
import Aviso from '../componentes/Aviso.astro';
import Boton from '../componentes/Boton.astro';
import Campo from '../componentes/Campo.astro';
import Casilla from '../componentes/Casilla.astro';
import Tabla from '../componentes/Tabla.astro';
import Pasos from '../componentes/Pasos.astro';
import EtiquetaTecnica from '../componentes/EtiquetaTecnica.astro';
import IndicadorEstado from '../componentes/IndicadorEstado.astro';
import EncabezadoPantalla from '../componentes/EncabezadoPantalla.astro';
import MensajeError from '../componentes/internos/MensajeError.astro';
import PlantillasResumenLegal from '../componentes/internos/PlantillasResumenLegal.astro';
import Calendario from './Calendario.astro';

interface Props {
  paso: 'horario' | 'servicio' | 'cuenta' | 'confirmar' | 'listo';
}
const { paso } = Astro.props;
// Copy de la spec RF-04-reservar (tabla Copy). `n` es el paso de 5 (el 03 es la cuenta: sin sesion va al acceso).
const meta = {
  horario: { n: 1, titulo: 'Elige tu horario', descripcion: 'Elige el día, la hora de inicio y cuánto tiempo necesitas la sala.' },
  servicio: { n: 2, titulo: 'Servicio y precio', descripcion: 'Elige qué vas a hacer y quién te acompaña. El precio se calcula al momento.' },
  cuenta: { n: 3, titulo: 'Completa tus datos', descripcion: 'Antes de tu primera reserva necesitamos saber quién eres. Solo te lo pedimos una vez.' },
  confirmar: { n: 4, titulo: 'Confirma tu reserva', descripcion: 'Revisa todo antes de confirmar.' },
  listo: { n: 5, titulo: 'Reserva registrada', descripcion: 'Tu horario queda apartado mientras pagas el anticipo.' },
}[paso];
// HECHO enlaza al paso (la isla pone la consulta); la cuenta no tiene pagina y en Listo no se vuelve atras.
const rutaPaso: Record<string, string> = { Horario: '/reservar/', Servicio: '/reservar/servicio/', Confirmar: '/reservar/confirmar/' };
const etapas = ['Horario', 'Servicio', 'Cuenta', 'Confirmar', 'Listo'].map((nombre) => ({ nombre, href: paso === 'listo' ? undefined : rutaPaso[nombre] }));
const enFlujo = paso !== 'listo';
const conLateral = enFlujo && paso !== 'confirmar'; // en 04, R1 y R2 ya muestran todo
const tiposDocumento = [['dni', 'DNI'], ['ce', 'Carné de extranjería'], ['pasaporte', 'Pasaporte']];
---

<!-- Un bloque por estado (estados-sistema): el servidor pinta cada <template> y la isla clona el que toca. Sin JS, el noscript explica que hace falta. -->
<bugalu-reserva class="reserva" paso={paso}>
  <EncabezadoPantalla variante="flujo" indice={`PASO 0${meta.n} / 05`} titulo={meta.titulo} descripcion={meta.descripcion} />
  <Pasos pasos={etapas} actual={meta.n} etiqueta="Progreso de la reserva" />
  <div data-avisos></div>
  <!-- Región viva estable: anuncia el total al terminar cada simulacion. -->
  <p class="visualmente-oculto" role="status" data-anuncio></p>
  {paso !== 'horario' && (
    <noscript>
      <Aviso variante="informacion" titulo="Para reservar necesitas JavaScript. Actívalo en tu navegador y recarga la página." />
    </noscript>
  )}

  <div class:list={['res-rejilla', !conLateral && 'res-rejilla-sola']}>
    <div class="res-principal">
      {paso === 'horario' && (
        <>
          <Calendario modo="reserva" />
          <div data-cuerpo hidden>
            <Panel titulo="Tiempo de sala">
              <Campo tipo="selector" nombre="duracion" etiqueta="Duración" ayuda="Elige primero la hora de inicio." disabled><option>—</option></Campo>
            </Panel>
            <div class="res-acciones"><Boton tamano="grande" icono="arrow-right" data-continuar>Continuar</Boton></div>
          </div>
        </>
      )}

      {(paso === 'servicio' || paso === 'confirmar') && (
        <div data-cuerpo hidden>
          <div data-catalogo></div>
          <div data-datos hidden class="res-bloques">
            {paso === 'servicio' && (
              <>
                <fieldset class="res-grupo">
                  <legend>Servicio</legend>
                  <p class="res-ayuda" data-ayuda-igv hidden></p>
                  <div data-lista-servicios class="res-lista"></div>
                </fieldset>
                <fieldset class="res-grupo">
                  <legend>Especialistas</legend>
                  <p class="res-ayuda">El ingeniero de sonido viene incluido.</p>
                  <div data-lista-especialistas class="res-lista"></div>
                </fieldset>
              </>
            )}
            {paso === 'confirmar' && (
              <Panel codigo="R1" titulo="Tu reserva">
                <dl class="res-datos" data-revision></dl>
              </Panel>
            )}
            <Panel codigo={paso === 'confirmar' ? 'R2' : undefined} titulo="Precio simulado">
              <div data-precio></div>
            </Panel>
            {paso === 'confirmar' && (
              <>
                <Panel codigo="R3" titulo="Detalle">
                  <Campo tipo="area" nombre="detalle" etiqueta="Qué necesitas (opcional)" ayuda="Cuéntanos qué vas a grabar o qué equipo necesitas." maxlength="500" rows="4" />
                </Panel>
                <Panel codigo="R4" titulo="Condiciones">
                  <div data-condiciones><p class="res-ayuda" aria-busy="true">Cargando…</p></div>
                  <p class="res-ayuda" data-motivo-condiciones hidden>Necesitamos mostrarte las condiciones antes de continuar.</p>
                </Panel>
              </>
            )}
            <div class="res-acciones">
              <Boton variante="secundario" href="#" data-anterior>Anterior</Boton>
              {paso === 'servicio' && <Boton icono="arrow-right" data-continuar>Continuar</Boton>}
              {paso === 'confirmar' && <Boton data-confirmar>Confirmar reserva</Boton>}
            </div>
            {paso === 'confirmar' && <p class="res-ayuda" data-motivo hidden>Necesitamos mostrarte el precio antes de confirmar.</p>}
          </div>
        </div>
      )}

      {paso === 'cuenta' && (
        <div data-cuerpo hidden>
          <div data-cuenta-estado></div>
          <form novalidate class="res-bloques" data-formulario-cuenta hidden>
            <div data-d1 hidden>
              <Panel codigo="D1" titulo="Tus datos">
                <div class="res-campos">
                  <div data-fila-nombre><Campo nombre="nombre" etiqueta="Nombre" obligatorio autocomplete="name" /></div>
                  <div class="res-documento" data-fila-documento>
                    <Campo tipo="selector" nombre="tipo_documento" etiqueta="Tipo de documento" obligatorio>
                      <option value="">Elige una opción</option>
                      {tiposDocumento.map(([valor, nombre]) => <option value={valor}>{nombre}</option>)}
                    </Campo>
                    <Campo nombre="numero_documento" etiqueta="Número" obligatorio autocomplete="off" spellcheck="false" />
                  </div>
                  <div data-fila-telefono><Campo tipo="tel" nombre="telefono" etiqueta="Teléfono" obligatorio ayuda="Solo números; con + y código de país si no es de Perú. Lo necesitas para reservar." autocomplete="tel" /></div>
                  <Casilla nombre="es_menor" etiqueta="Soy menor de 18 años" detalle="Si lo marcas, por ahora no podrás reservar en línea: te ayudaremos por otro canal." />
                </div>
              </Panel>
            </div>
            <div data-d2 hidden>
              <Panel codigo="D2" titulo="Términos">
                <div class="res-bloques" data-bloques></div>
                <p class="res-ayuda" data-motivo-textos hidden>Necesitamos mostrarte las condiciones antes de continuar.</p>
              </Panel>
            </div>
            <div class="res-acciones">
              <Boton variante="secundario" href="#" data-anterior>Anterior</Boton>
              <Boton tipo="submit" data-guardar-cuenta>Guardar y continuar</Boton>
            </div>
          </form>
        </div>
      )}

      {paso === 'listo' && (
        <div data-cuerpo hidden>
          <div data-listo></div>
        </div>
      )}
    </div>

    {conLateral && (
      <aside class="res-lateral" data-cuerpo-lateral hidden>
        <Panel titulo="Tu reserva" variante="lateral">
          <EtiquetaTecnica texto="SIN CONFIRMAR" />
          <dl class="res-datos" data-resumen></dl>
        </Panel>
      </aside>
    )}
  </div>

  <template data-plantilla="aviso">
    <Aviso variante="error" titulo=" " accion={{ etiqueta: ' ', href: '#' }} />
  </template>
  <template data-plantilla="aviso-exito"><Aviso variante="exito" titulo=" " /></template>
  <template data-plantilla="aviso-info"><Aviso variante="informacion" titulo=" " /></template>
  <template data-plantilla="error"><MensajeError id="" texto="" /></template>
  <PlantillasResumenLegal />
  <template data-plantilla="texto-error">
    <Aviso variante="error" titulo="No pudimos cargar los textos." texto="Revisa tu conexión e inténtalo de nuevo.">
      <div class="res-acciones"><Boton variante="secundario" data-reintentar-textos>Reintentar</Boton></div>
    </Aviso>
  </template>
  <template data-plantilla="menor">
    <Aviso variante="critico" titulo="Aún no puedes reservar en línea" texto="Como eres menor de 18 años, tu madre, padre o tutor tiene que autorizar la reserva, y eso todavía no se puede hacer en la app. Escríbenos y reservamos contigo:">
      <p class="res-contacto" data-contacto hidden></p>
      <div class="res-acciones"><Boton variante="secundario" href="/">Volver al inicio</Boton></div>
    </Aviso>
  </template>
  <template data-plantilla="servicio"><Casilla tipo="radio" nombre="servicio" valor="" etiqueta=" " detalle=" " /></template>
  <template data-plantilla="especialista"><Casilla nombre="especialista" valor="" etiqueta=" " detalle=" " /></template>
  <template data-plantilla="cargando"><Panel titulo="Cargando" cargando /></template>
  <template data-plantilla="catalogo-error">
    <Aviso variante="error" titulo="No pudimos cargar los servicios." texto="Revisa tu conexión e inténtalo de nuevo.">
      <div class="res-acciones"><Boton variante="secundario" data-reintentar-catalogo>Reintentar</Boton></div>
    </Aviso>
  </template>
  <template data-plantilla="catalogo-vacio">
    <Aviso variante="informacion" titulo="Ahora no hay servicios disponibles para reservar. Vuelve pronto." />
  </template>
  <template data-plantilla="precio-calculando"><p class="res-ayuda">Calculando precio…</p></template>
  <template data-plantilla="precio-vacio"><p class="res-ayuda">Elige un servicio para ver el precio.</p></template>
  <template data-plantilla="precio">
    <Tabla titulo="Partidas" columnas={['Concepto', 'Cantidad', 'Importe']} variante="partidas" numericas={[1, 2]} />
    <Aviso variante="informacion" titulo="Esta simulación no tiene valor de cotización. El precio de tu reserva se calcula al confirmarla, con las mismas tarifas." />
  </template>
  <template data-plantilla="precio-error">
    <Aviso variante="error" titulo=" " accion={{ etiqueta: ' ', href: '#' }}>
      <div class="res-acciones"><Boton variante="secundario" data-reintentar-precio>Reintentar</Boton></div>
    </Aviso>
  </template>
  <template data-plantilla="listo">
    <Aviso variante="exito" titulo="Reserva registrada." />
    <Panel codigo="L1" titulo="Reserva " variante="destacado">
      <dl class="res-datos" data-datos-listo></dl>
      <IndicadorEstado variante="barra" tono="pendiente" texto="PRE-RESERVADA" dato=" " activo />
    </Panel>
    <Panel titulo="Siguientes pasos">
      <ol class="res-siguientes">
        <li data-paso-1></li>
        <li>Registra tu comprobante desde tu reserva.</li>
        <li>Cuando lo validemos, tu reserva pasará a Confirmada.</li>
      </ol>
      <p class="res-ayuda" data-correo hidden></p>
    </Panel>
    <div class="res-acciones">
      <Boton tamano="grande" href="/app/reservas/detalle?id=" data-ver>Ver mi reserva</Boton>
      <a class="res-enlace" href="/reservar/">Reservar otro horario</a>
    </div>
  </template>
  <template data-plantilla="listo-sin-datos">
    <Aviso variante="exito" titulo="Reserva registrada." texto="No pudimos mostrar el detalle ahora. Lo encuentras en tus reservas.">
      <div class="res-acciones"><Boton href="/app/reservas">Ver mis reservas</Boton></div>
    </Aviso>
  </template>
</bugalu-reserva>

<style is:global>
  bugalu-reserva { display: block; }
  bugalu-reserva .res-rejilla { display: grid; gap: var(--espacio-6); grid-template-columns: minmax(0, 1fr); align-items: start; }
  bugalu-reserva .res-principal, bugalu-reserva .res-bloques { display: grid; gap: var(--espacio-5); min-inline-size: 0; }
  bugalu-reserva [data-cuerpo] { display: grid; gap: var(--espacio-5); }
  bugalu-reserva [data-cuerpo][hidden], bugalu-reserva [hidden] { display: none; }
  bugalu-reserva .res-rejilla-sola .res-principal { max-inline-size: var(--medida-linea-lectura); }
  bugalu-reserva .res-grupo { margin: 0; padding: var(--espacio-5); border: var(--borde-grosor-base) solid var(--color-borde-fuerte); background: var(--color-fondo-superficie); min-inline-size: 0; }
  bugalu-reserva .res-grupo legend {
    padding-inline: var(--espacio-2);
    font-family: var(--fuente-familia-tecnica);
    font-size: var(--fuente-tamano-micro);
    text-transform: uppercase;
    color: var(--color-texto-principal);
  }
  bugalu-reserva .res-lista { display: grid; gap: var(--espacio-3); }
  bugalu-reserva .res-campos { display: grid; gap: var(--espacio-4); }
  bugalu-reserva .res-documento { display: grid; gap: var(--espacio-4); grid-template-columns: minmax(0, 1fr); }
  bugalu-reserva .res-contacto { margin: 0; color: var(--color-texto-sobre-alerta); }
  bugalu-reserva .res-bloques .resumen-legal + .resumen-legal { padding-block-start: var(--espacio-5); border-block-start: var(--borde-grosor-fino) solid var(--color-borde-fuerte); }
  bugalu-reserva .res-ayuda { margin: 0; color: var(--color-texto-secundario); font-size: var(--fuente-tamano-pequeno); }
  bugalu-reserva .res-datos { display: grid; gap: var(--espacio-3); margin: 0; }
  bugalu-reserva .res-datos > div { display: grid; gap: var(--espacio-1); }
  bugalu-reserva .res-datos dt {
    font-family: var(--fuente-familia-tecnica);
    font-size: var(--fuente-tamano-micro);
    text-transform: uppercase;
    color: var(--color-texto-secundario);
  }
  bugalu-reserva .res-datos dd { margin: 0; color: var(--color-texto-principal); }
  bugalu-reserva .res-aforo-regla { margin: var(--espacio-1) 0 0; color: var(--color-texto-secundario); font-size: var(--fuente-tamano-pequeno); }
  bugalu-reserva .res-acciones { display: flex; flex-direction: column; gap: var(--espacio-3); align-items: stretch; }
  bugalu-reserva .res-enlace { color: var(--color-texto-principal); }
  bugalu-reserva .res-siguientes { margin: 0; padding-inline-start: var(--espacio-5); display: grid; gap: var(--espacio-2); }
  bugalu-reserva [data-precio] > * + * { margin-block-start: var(--espacio-4); }
  bugalu-reserva [data-avisos]:not(:empty) { margin-block-end: var(--espacio-5); }
  bugalu-reserva [data-listo] { display: grid; gap: var(--espacio-5); }
  bugalu-reserva .res-lateral .etiqueta { display: flex; inline-size: fit-content; margin-block-end: var(--espacio-3); }
  @media (min-width: 37.5em) { /* punto-quiebre-tableta */
    bugalu-reserva .res-documento { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
    bugalu-reserva .res-acciones { flex-direction: row; align-items: center; flex-wrap: wrap; }
  }
  @media (min-width: 64em) { /* punto-quiebre-escritorio */
    bugalu-reserva .res-rejilla:not(.res-rejilla-sola) { grid-template-columns: minmax(0, 1fr) var(--medida-columna-lateral); }
  }
</style>

<script>
  import { obtenerToken, obtenerCliente } from '../servicios/sesion.js';
  import { listarSalas, crearReserva, obtenerReserva } from '../servicios/reservas.js';
  import { lineaAforo, personas, certificado } from '../servicios/aforo.js';
  import { listarServicios, listarEspecialistas, obtenerImpuestos, simular } from '../servicios/catalogo.js';
  import { ErrorApi, obtenerPerfil, actualizarPerfil } from '../servicios/api.js';
  import { obtenerContacto } from '../servicios/pagos.js';
  import { listarTextosLegales } from '../servicios/textos-legales.js';
  import { aceptar, pendientesDe, bloquesRegistro, bloqueReserva } from '../servicios/aceptaciones.js';
  import { resumenLegal, errorResumen, avisoResumen } from '../servicios/resumen-legal.js';
  import { validarDocumento, faltaParaReservar } from '../servicios/perfil-datos.js';
  import { normalizarTelefono } from '../servicios/sesion.js';
  import { ponerError, quitarError } from '../servicios/formulario.js';
  import { soles, porcentaje, filasPrecio, fechaDe, horaDe, instante, nombreDia, diaMes, duracionReserva, pintarPartidas, esFecha, inicioValido, duracionValida } from '../servicios/formatos.js';

  const RUTAS: Record<string, string> = { horario: '/reservar/', servicio: '/reservar/servicio/', cuenta: '/reservar/cuenta/', confirmar: '/reservar/confirmar/' };
  const ERROR_TERMINOS = 'Marca la casilla para aceptar los términos; sin ella no podemos activar tus reservas.';
  const ERROR_CONDICIONES = 'Marca la casilla para aceptar las condiciones; sin ella no podemos registrar tu reserva.';
  // La clave lleva la elección: otra sala u horario empieza vacío. `cerrarSesion` borra por este prefijo.
  const claveDetalle = ({ sala, inicio, duracion }: any) => `bugalu:reserva-detalle:${sala ?? ''}|${inicio}|${duracion}`;
  const DESCRIPCION: Record<string, string> = {
    grabacion: 'Graba voces, instrumentos o tu banda en vivo.',
    ensayo: 'Ensaya en sala. Disponible si ya tienes una sesión confirmada con nosotros.',
    live: 'Sesión en vivo grabada en sala.',
  };
  const UNIDAD: Record<string, string> = { hora: 'por hora', lapso_30: 'por media hora' };
  const dur = duracionReserva;
  const sumar = (iso: string, min: number) => {
    const d = new Date(Date.parse(iso) + min * 6e4).toISOString();
    return instante(fechaDe(d), horaDe(d));
  };
  const fechaHora = (iso: string) => `${diaMes(fechaDe(iso))}, ${horaDe(iso)}`;
  // "faltan 2 d 3 h" / "faltan 5 h 10 min" / "faltan 7 min" (plazo restante, estructura-app).
  const faltan = (iso: string) => {
    const min = Math.max(0, Math.floor((Date.parse(iso) - Date.now()) / 6e4));
    const d = Math.floor(min / 1440);
    const h = Math.floor((min % 1440) / 60);
    return `faltan ${d ? `${d} d ${h} h` : h ? `${h} h ${min % 60} min` : `${min} min`}`;
  };

  class BugaluReserva extends HTMLElement {
    paso = '';
    e: any = { esp: [] };
    max: number | null = null;
    salas: any[] = [];
    salasCargadas = false;
    salasFallo = false;
    servicios: any[] = [];
    especialistas: any[] = [];
    sim: any = null;
    simEstado = 'vacio';
    ciclo = 0;
    temporizador: any = null;
    ultimoAnuncio = '';
    enviando = false;
    condVersion: string | null = null;
    perfil: any = null;
    bloques: any[] = [];

    async connectedCallback() {
      this.paso = this.getAttribute('paso')!;
      this.leerUrl();
      // Antes de cualquier await. El calendario puede haber avisado el inicio de la URL antes de que esta isla existiera (el aviso no se repite solo): se le pide de nuevo.
      this.addEventListener('calendario-inicio', (ev) => this.alElegirInicio((ev as CustomEvent).detail));
      this.q<any>('bugalu-calendario')?.avisarInicio?.();
      if (!(await this.guardar())) return;
      this.addEventListener('click', (ev) => this.alPulsar(ev));
      this.addEventListener('submit', (ev) => {
        ev.preventDefault();
        this.guardarCuenta();
      });
      this.addEventListener('change', (ev) => this.alCambiar(ev));
      // Hijo directo: el calendario ya pintado trae su propio [data-cuerpo] antes en el DOM.
      this.q('.res-principal > [data-cuerpo]')!.hidden = false;
      const lateral = this.q('[data-cuerpo-lateral]');
      if (lateral) lateral.hidden = false;
      this.enlazarPasos();
      this.bienvenida();
      this.q('.res-acciones [data-anterior]')?.setAttribute('href', this.url(this.paso === 'confirmar' || this.paso === 'cuenta' ? 'servicio' : 'horario'));
      // Salas para el nombre del resumen (el calendario trae las suyas); un fallo no bloquea el paso.
      this.salas = await listarSalas().catch(() => { this.salasFallo = true; return []; });
      this.salasCargadas = true;
      if (this.paso === 'listo') await this.iniciarListo();
      else if (this.paso === 'cuenta') await this.iniciarCuenta();
      else if (this.paso !== 'horario') await this.cargarCatalogo();
      this.resumen();
      if (this.paso === 'listo' || this.paso === 'horario' || this.paso === 'cuenta') this.titulo().focus();
    }

    disconnectedCallback() {
      clearTimeout(this.temporizador);
    }

    q<T extends HTMLElement = HTMLElement>(selector: string) {
      return this.querySelector<T>(selector);
    }
    titulo() {
      const h1 = this.q('h1')!;
      h1.tabIndex = -1;
      return h1;
    }
    plantilla(nombre: string) {
      return (this.q<HTMLTemplateElement>(`template[data-plantilla="${nombre}"]`)!.content.cloneNode(true) as DocumentFragment);
    }

    // --- Estado en la URL (no hay borrador en el servidor) ---

    // La URL es entrada no confiable: cada dato se acepta solo con su forma válida; si no, queda vacío y guardar() manda al paso incompleto.
    leerUrl() {
      const p = new URLSearchParams(location.search);
      const fecha = p.get('fecha');
      const vista = p.get('vista');
      const id = (x: string | null) => (x && /^[\w-]{1,64}$/.test(x) ? x : null);
      this.e = {
        inicio: inicioValido(p.get('inicio')),
        duracion: duracionValida(p.get('duracion')),
        sala: id(p.get('sala')),
        servicio: id(p.get('servicio')),
        esp: (p.get('esp') ?? '').split(',').filter((x) => id(x)),
        fecha: fecha && esFecha(fecha) ? fecha : null,
        vista: ['semana', 'mes'].includes(vista ?? '') ? vista : null,
        id: id(p.get('id')),
      };
    }
    url(paso: string, extra: Record<string, string | null> = {}, aviso?: string) {
      const e = { ...this.e, ...extra };
      const p = new URLSearchParams();
      if (e.inicio) p.set('inicio', e.inicio);
      if (e.duracion) p.set('duracion', String(e.duracion));
      if (e.sala) p.set('sala', e.sala);
      if (e.servicio) p.set('servicio', e.servicio);
      if (e.esp?.length) p.set('esp', e.esp.join(','));
      if (e.fecha) p.set('fecha', e.fecha);
      if (e.vista) p.set('vista', e.vista);
      if (aviso) p.set('aviso', aviso);
      const consulta = p.toString();
      return `${RUTAS[paso]}${consulta ? `?${consulta}` : ''}`;
    }
    // Si a un paso le falta un dato de uno anterior, va al primer paso incompleto.
    async guardar() {
      const { inicio, duracion, servicio, id } = this.e;
      const falta = this.paso === 'listo' ? !id : this.paso === 'servicio' ? !inicio || !duracion : this.paso === 'confirmar' || this.paso === 'cuenta' ? !inicio || !duracion || !servicio : false;
      if (falta) {
        location.replace((this.paso === 'confirmar' || this.paso === 'cuenta') && inicio && duracion ? this.url('servicio') : this.paso === 'listo' ? '/reservar/' : this.url('horario'));
        return false;
      }
      if ((this.paso === 'confirmar' || this.paso === 'cuenta') && !(await obtenerToken())) {
        location.replace(this.rutaAcceso(this.paso));
        return false;
      }
      // Faltan datos, textos o es menor: se completa en el paso 03 con la misma eleccion. Si el perfil no responde, decide el servidor al confirmar.
      if (this.paso === 'confirmar') {
        const perfil = await obtenerPerfil().catch(() => null);
        if (perfil && faltaParaReservar(perfil)) {
          location.replace(this.url('cuenta'));
          return false;
        }
      }
      return true;
    }
    rutaAcceso(destino: string) {
      return `/acceso?${new URLSearchParams({ volver: this.url(destino) })}`;
    }
    guardarUrl() {
      history.replaceState(null, '', this.url(this.paso));
    }

    // --- Avisos, foco y región viva ---

    aviso(mensaje: string, enlace?: { etiqueta: string; href: string }, enfocar?: HTMLElement | null, informativo = false) {
      const nodo = this.plantilla(informativo ? 'aviso-info' : 'aviso');
      const caja = nodo.querySelector<HTMLElement>('.aviso')!;
      caja.querySelector('.aviso-titulo')!.textContent = mensaje;
      const accion = caja.querySelector<HTMLAnchorElement>('.aviso-accion');
      if (enlace && accion) {
        accion.textContent = enlace.etiqueta;
        accion.href = enlace.href;
      } else accion?.remove();
      this.q('[data-avisos]')!.replaceChildren(nodo);
      caja.tabIndex = -1;
      (enfocar ?? caja).focus();
    }
    sinAviso() {
      this.q('[data-avisos]')!.replaceChildren();
    }
    revisar(...pasos: string[]) {
      for (const paso of pasos) {
        const item = this.q(`.pasos [data-paso="${paso}"]`);
        const lectura = item?.querySelector('[data-lectura]');
        if (!item || !lectura) continue;
        item.dataset.estado = 'revisar';
        lectura.querySelector('.pasos-icono')?.replaceChildren();
        lectura.lastChild!.textContent = 'REVISAR';
      }
    }
    // HECHO enlaza al paso con la consulta de la URL (lo elegido viaja ahi).
    enlazarPasos() {
      for (const paso of ['horario', 'servicio', 'confirmar']) this.q<HTMLAnchorElement>(`.pasos [data-paso="${paso}"] a`)?.setAttribute('href', this.url(paso));
    }
    bienvenida() {
      const url = new URL(location.href);
      if (url.searchParams.get('aviso') !== 'cuenta-creada') return;
      url.searchParams.delete('aviso');
      history.replaceState(null, '', url);
      if (this.paso !== 'confirmar') return;
      const nodo = this.plantilla('aviso-exito');
      nodo.querySelector('.aviso-titulo')!.textContent = 'Cuenta creada. Revisa tu reserva y confírmala.';
      this.q('[data-avisos]')!.replaceChildren(nodo);
    }

    // --- Resumen persistente ---

    resumen() {
      const e = this.e;
      const sala = this.salas.find((s) => s.id === e.sala) ?? (e.sala ? null : this.salas[0]);
      const servicio = this.servicios.find((s) => s.id === e.servicio);
      const nombres = this.especialistasMarcados().map((x) => x.nombre);
      const filas: [string, string, string?][] = [
        ['Sala', sala?.nombre ?? '—'],
        ['Fecha', e.inicio ? `${nombreDia(fechaDe(e.inicio))} ${diaMes(fechaDe(e.inicio))}` : '—'],
        ['Horario', e.inicio && e.duracion ? `${horaDe(e.inicio)} – ${horaDe(sumar(e.inicio, e.duracion))}` : '—', 'horario'],
        ['Duración', e.duracion ? dur(e.duracion) : '—', 'horario'],
        ['Servicio', servicio?.nombre ?? '—', 'servicio'],
        ['Especialistas', nombres.length ? nombres.join(', ') : '—', 'servicio'],
      ];
      const precio = (this.sim && this.simEstado === 'ok' ? filasPrecio(this.sim) : this.paso === 'servicio' || this.paso === 'horario' ? [['Total', '—']] : []) as [string, string][];
      filas.push(...precio);
      for (const destino of [this.q('[data-resumen]'), this.q('[data-revision]')]) {
        if (!destino) continue;
        destino.replaceChildren(
          ...filas
            .filter(([etiqueta]) => destino.hasAttribute('data-resumen') || !precio.some((p) => p[0] === etiqueta))
            .map(([etiqueta, valor, cambiar]) => {
              const fila = document.createElement('div');
              const dt = document.createElement('dt');
              dt.textContent = etiqueta;
              const dd = document.createElement('dd');
              dd.textContent = valor;
              if (cambiar && destino.hasAttribute('data-revision')) {
                const a = document.createElement('a');
                a.href = this.url(cambiar);
                a.textContent = ' Cambiar';
                const oculto = document.createElement('span');
                oculto.className = 'visualmente-oculto';
                oculto.textContent = ` ${etiqueta.toLowerCase()}`;
                a.append(oculto);
                dd.append(' ', a);
              }
              fila.append(dt, dd);
              return fila;
            }),
        );
        if (destino.hasAttribute('data-revision')) this.filaAforo(destino, sala);
      }
    }
    // RF-03 CA-11, paso 04: fila AFORO tras SALA. Cargando "—"; si GET /salas falla, un aviso sin bloquear; sin aforo, sin fila.
    filaAforo(destino: HTMLElement, sala: any) {
      const nodos = lineaAforo(sala);
      if (this.salasCargadas && !this.salasFallo && !nodos) return;
      const dd = document.createElement('dd');
      if (!this.salasCargadas) dd.textContent = '—';
      else if (this.salasFallo) dd.textContent = 'No pudimos cargar el aforo; lo verás en el cartel de la sala.';
      else {
        const regla = document.createElement('p');
        regla.className = 'res-aforo-regla';
        regla.append('Cuenta a todas las personas dentro de la sala, también al personal del estudio. Al llegar indicas quiénes te acompañan; quien exceda el aforo espera en la recepción.');
        const cert = document.createElement('p');
        cert.className = 'res-aforo-regla';
        if (sala.itse?.certificado) cert.append(...certificado(sala.itse));
        dd.append(`Máximo ${personas(sala.aforo)}`, regla, ...(cert.childNodes.length ? [cert] : []));
      }
      const dt = document.createElement('dt');
      dt.textContent = 'Aforo';
      const fila = document.createElement('div');
      fila.append(dt, dd);
      destino.firstElementChild?.after(fila);
    }
    especialistasMarcados() {
      const defecto = this.servicios.find((s) => s.id === this.e.servicio)?.especialistas_por_defecto ?? [];
      return this.especialistas.filter((x) => defecto.includes(x.id) || this.e.esp.includes(x.id));
    }

    // --- Eventos ---

    alPulsar(ev: Event) {
      const o = ev.target as Element;
      if (o.closest('[data-continuar]')) return void this.continuar();
      if (o.closest('[data-confirmar]')) return void this.confirmar();
      if (o.closest('[data-reintentar-catalogo]')) return void this.cargarCatalogo();
      if (o.closest('[data-reintentar-precio]')) return void this.calcular();
      if (o.closest('[data-reintentar-condiciones]')) return void this.cargarCondiciones();
      if (o.closest('[data-reintentar-textos]')) return void this.reintentarCuenta();
      const casilla = o.closest<HTMLInputElement>('input[aria-disabled="true"]');
      if (casilla) ev.preventDefault(); // el especialista incluido no se quita
      const anterior = o.closest('[data-anterior]');
      if (anterior && this.enviando) ev.preventDefault();
    }
    alCambiar(ev: Event) {
      const o = ev.target as HTMLInputElement;
      if (o.name === 'duracion') {
        this.e.duracion = +o.value;
        this.duracionAlCalendario(o.value);
        this.guardarUrl();
        this.resumen();
      } else if (o.name === 'servicio') {
        this.e.servicio = o.value;
        const defecto = this.servicios.find((s) => s.id === o.value)?.especialistas_por_defecto ?? [];
        this.e.esp = this.e.esp.filter((id: string) => !defecto.includes(id));
        this.sinAviso();
        this.pintarEspecialistas();
        this.cambioPrecio();
      } else if (o.name === 'especialista') {
        this.e.esp = [...this.q('[data-lista-especialistas]')!.querySelectorAll<HTMLInputElement>('input:checked:not([aria-disabled])')].map((x) => x.value);
        this.cambioPrecio();
      }
    }
    cambioPrecio() {
      this.guardarUrl();
      this.resumen();
      this.programar();
    }

    // --- 01 Horario ---

    // Con un inicio en la URL, la duración se ofrece cuando el calendario sabe qué cabe y avisa (calendario-inicio): antes sería adivinar hasta 8 h.
    alElegirInicio(detalle: { inicio: string; minutosMaximos: number }) {
      this.e.inicio = detalle.inicio;
      this.max = detalle.minutosMaximos;
      this.sinAviso();
      this.opcionesDuracion();
    }
    // El calendario se repinta al cambiar `duracion`: se devuelve el foco a la celda que lo tenia (teclado).
    duracionAlCalendario(valor: string) {
      const cal = this.q('bugalu-calendario');
      if (!cal || cal.getAttribute('duracion') === valor) return;
      const inicio = (document.activeElement as HTMLElement | null)?.dataset?.inicio;
      cal.setAttribute('duracion', valor);
      if (!inicio) return;
      [...cal.querySelectorAll<HTMLElement>('button[data-inicio]')].find((b) => b.dataset.inicio === inicio && b.offsetParent !== null)?.focus();
    }
    opcionesDuracion() {
      const select = this.q<HTMLSelectElement>('select[name="duracion"]')!;
      const tope = Math.min(this.max ?? 480, 480);
      select.replaceChildren(...Array.from({ length: tope / 30 }, (_, i) => new Option(dur((i + 1) * 30), String((i + 1) * 30))));
      const valor = this.e.duracion >= 30 && this.e.duracion <= tope && this.e.duracion % 30 === 0 ? this.e.duracion : tope >= 60 ? 60 : 30;
      select.value = String(valor);
      select.disabled = false;
      this.e.duracion = valor;
      this.duracionAlCalendario(String(valor));
      const ayuda = this.q('#campo-duracion-ayuda');
      if (ayuda) ayuda.textContent = `Desde las ${horaDe(this.e.inicio)} caben hasta ${dur(tope)}. Tras cada sesión la sala necesita 30 min de preparación.`;
      const p = new URLSearchParams(location.search);
      p.set('inicio', this.e.inicio);
      p.set('duracion', String(valor));
      history.replaceState(null, '', `${location.pathname}?${p}`);
      this.resumen();
    }

    // --- 02 y 04: catálogo ---

    async cargarCatalogo() {
      const salida = this.q('[data-catalogo]')!;
      this.q('[data-datos]')!.hidden = true;
      salida.replaceChildren(this.plantilla('cargando'));
      try {
        // Los impuestos son solo una ayuda: si no responden, el paso sigue sin ella.
        const [servicios, especialistas, impuestos] = await Promise.all([listarServicios(), listarEspecialistas(), this.paso === 'servicio' ? obtenerImpuestos().catch(() => null) : null]);
        if (impuestos) this.ayudaIgv(impuestos);
        this.servicios = servicios.filter((s: any) => s.ocupa_sala && s.activo);
        this.especialistas = especialistas.filter((x: any) => x.activo);
      } catch {
        salida.replaceChildren(this.plantilla('catalogo-error'));
        return;
      }
      if (!this.servicios.length) return void salida.replaceChildren(this.plantilla('catalogo-vacio'));
      salida.replaceChildren();
      this.q('[data-datos]')!.hidden = false;
      if (this.paso === 'servicio') {
        this.pintarServicios();
        this.pintarEspecialistas();
      }
      if (this.paso === 'confirmar') {
        this.q('[data-confirmar]')!.setAttribute('disabled', '');
        // El detalle escrito sobrevive a ir al paso 03 y volver; se borra al reservar (CA-13).
        const area = this.q<HTMLTextAreaElement>('textarea[name="detalle"]')!;
        try { area.value = sessionStorage.getItem(claveDetalle(this.e)) ?? ''; } catch {}
        area.addEventListener('input', () => { try { sessionStorage.setItem(claveDetalle(this.e), area.value); } catch {} });
        this.cargarCondiciones();
      }
      this.resumen();
      if (this.e.servicio) this.calcular();
      else this.pintarPrecio('vacio');
      if (this.paso !== 'listo' && this.paso !== 'horario' && !this.q('h1:focus')) this.titulo().focus();
    }
    ayudaIgv({ porcentaje_igv, precios_incluyen_igv }: { porcentaje_igv: string; precios_incluyen_igv: boolean }) {
      const ayuda = this.q('[data-ayuda-igv]')!;
      const p = porcentaje(porcentaje_igv);
      ayuda.textContent = precios_incluyen_igv ? `Precios con IGV incluido (${p}).` : `Precios sin IGV: el IGV (${p}) se suma al total.`;
      ayuda.hidden = false;
    }
    pintarServicios() {
      this.q('[data-lista-servicios]')!.replaceChildren(
        ...this.servicios.map((s) => {
          const nodo = this.plantilla('servicio');
          const entrada = nodo.querySelector<HTMLInputElement>('input')!;
          entrada.value = s.id;
          entrada.checked = s.id === this.e.servicio;
          nodo.querySelector('.casilla-etiqueta')!.textContent = s.nombre;
          nodo.querySelector('.casilla-detalle')!.textContent = [DESCRIPCION[s.categoria], `${soles(s.tarifa_hora)} por hora`].filter(Boolean).join(' · ');
          return nodo;
        }),
      );
    }
    pintarEspecialistas() {
      const defecto = this.servicios.find((s) => s.id === this.e.servicio)?.especialistas_por_defecto ?? [];
      this.q('[data-lista-especialistas]')!.replaceChildren(
        ...this.especialistas.map((x) => {
          const nodo = this.plantilla('especialista');
          const entrada = nodo.querySelector<HTMLInputElement>('input')!;
          const incluido = defecto.includes(x.id);
          entrada.value = x.id;
          entrada.checked = incluido || this.e.esp.includes(x.id);
          if (incluido) entrada.setAttribute('aria-disabled', 'true');
          const tarifa = `${Number(x.monto_fijo) ? `${soles(x.monto_fijo)} + ` : ''}${soles(x.monto_variable)} ${UNIDAD[x.unidad] ?? ''}`.trim();
          nodo.querySelector('.casilla-etiqueta')!.textContent = x.nombre;
          nodo.querySelector('.casilla-detalle')!.textContent = incluido ? `${tarifa} · Incluido con este servicio` : tarifa;
          return nodo;
        }),
      );
    }

    // --- Simulación (el navegador nunca suma importes ni envía precios) ---

    programar() {
      clearTimeout(this.temporizador);
      this.pintarPrecio('calculando');
      this.temporizador = setTimeout(() => this.calcular(), 400);
    }
    async calcular() {
      clearTimeout(this.temporizador);
      const ciclo = ++this.ciclo;
      this.pintarPrecio('calculando');
      const { inicio, duracion, servicio, esp } = this.e;
      try {
        const sala = this.e.sala ?? this.salas[0]?.id;
        const sim = await simular({ id_sala: sala, id_servicio: servicio, inicio, fin: sumar(inicio, duracion), especialistas: esp });
        if (ciclo !== this.ciclo) return;
        this.sim = sim;
        this.pintarPrecio('ok');
        const texto = `Total ${soles(sim.total)}, anticipo ${soles(sim.anticipo)}`;
        if (texto !== this.ultimoAnuncio) this.q('[data-anuncio]')!.textContent = this.ultimoAnuncio = texto;
      } catch (error) {
        if (ciclo !== this.ciclo) return;
        this.sim = null;
        this.pintarPrecio('error', error);
      }
    }
    pintarPrecio(estado: string, error?: unknown) {
      this.simEstado = estado;
      const salida = this.q('[data-precio]')!;
      salida.setAttribute('aria-busy', String(estado === 'calculando'));
      if (estado === 'calculando') salida.replaceChildren(this.plantilla('precio-calculando'));
      else if (estado === 'vacio') salida.replaceChildren(this.plantilla('precio-vacio'));
      else if (estado === 'ok') salida.replaceChildren(this.tablaPrecio());
      else salida.replaceChildren(this.errorPrecio(error));
      const confirmar = this.q('[data-confirmar]');
      if (confirmar && !this.enviando) {
        this.actualizarConfirmar();
        this.q('[data-motivo]')!.hidden = estado !== 'error';
      }
      if (estado !== 'calculando') this.resumen();
      else if (estado === 'calculando') this.sim = null;
    }
    tablaPrecio() {
      const nodo = this.plantilla('precio');
      pintarPartidas(nodo.querySelector('.tabla')!, this.sim);
      return nodo;
    }
    errorPrecio(error: unknown) {
      const nodo = this.plantilla('precio-error');
      const codigo = error instanceof ErrorApi ? error.codigo : '';
      const estado = error instanceof ErrorApi ? error.estado : -1;
      let texto = 'Algo salió mal al calcular el precio.';
      let enlace: { etiqueta: string; href: string } | null = null;
      if (codigo === 'tramo_invalido') [texto, enlace] = ['Ese horario ya no es válido. Vuelve a elegirlo.', this.enlaceHorario()];
      else if (codigo === 'servicio_no_reservable') texto = 'Ese servicio no se reserva en sala. Elige otro.';
      else if (estado === 422) texto = 'No pudimos calcular el precio con estos datos. Revisa tu elección.';
      else if (estado === 503) texto = 'El servicio no responde. Inténtalo en unos minutos.';
      else if (estado === 0) texto = 'Sin conexión. Revisa tu red.';
      nodo.querySelector('.aviso-titulo')!.textContent = texto;
      const accion = nodo.querySelector<HTMLAnchorElement>('.aviso-accion')!;
      if (enlace) {
        accion.textContent = enlace.etiqueta;
        accion.href = enlace.href;
        nodo.querySelector('[data-reintentar-precio]')!.remove();
      } else {
        accion.remove();
        if (estado === 422) nodo.querySelector('[data-reintentar-precio]')!.remove();
      }
      return nodo;
    }
    enlaceHorario() {
      return { etiqueta: 'Elegir otro horario', href: this.url('horario', { inicio: null, fecha: this.e.inicio ? fechaDe(this.e.inicio) : this.e.fecha }) };
    }

    // --- Continuar ---

    async continuar() {
      if (this.paso === 'horario') {
        if (!this.e.inicio) {
          // El foco va a un control visible: en movil la tabla esta oculta y el dia sin abrir solo muestra su <summary>.
          const visible = (e: HTMLElement) => e.offsetParent !== null;
          const botones = [...this.querySelectorAll<HTMLElement>('bugalu-calendario button[data-inicio]')].filter((b) => visible(b) && !b.closest('details:not([open])'));
          const resumen = [...this.querySelectorAll<HTMLElement>('bugalu-calendario summary')].find((x) => visible(x) && /libres/.test(x.textContent ?? '') && !/Sin horas libres/.test(x.textContent ?? ''));
          const celda = botones.find((b) => b.getAttribute('tabindex') === '0') ?? botones[0] ?? resumen;
          return this.aviso('Elige una hora de inicio en el calendario.', undefined, celda);
        }
        const sala = new URLSearchParams(location.search).get('sala') ?? (await listarSalas().catch(() => []))[0]?.id;
        if (!sala) return this.aviso('No pudimos cargar la sala. Inténtalo de nuevo.');
        this.e.sala = sala;
        location.href = this.url('servicio');
      } else if (this.paso === 'servicio') {
        if (!this.e.servicio) return this.aviso('Elige un servicio.', undefined, this.q<HTMLElement>('[data-lista-servicios] input'));
        location.href = (await obtenerToken()) ? this.url('confirmar') : this.rutaAcceso('confirmar');
      }
    }

    // --- 04 Confirmar ---

    async confirmar() {
      if (this.enviando || this.simEstado !== 'ok' || !this.condVersion) return;
      const marca = this.q<HTMLInputElement>('[data-condiciones] input[type="checkbox"]')!;
      errorResumen(this.q('[data-condiciones] .resumen-legal')!, marca.checked ? '' : ERROR_CONDICIONES);
      if (!marca.checked) return marca.focus();
      this.enviando = true;
      this.sinAviso();
      const boton = this.q<HTMLButtonElement>('[data-confirmar]')!;
      const texto = boton.textContent;
      boton.disabled = true;
      boton.setAttribute('aria-busy', 'true');
      boton.textContent = 'Confirmando…';
      const anterior = this.q('[data-anterior]')!;
      anterior.setAttribute('aria-disabled', 'true');
      const detalle = this.q<HTMLTextAreaElement>('textarea[name="detalle"]')!.value.trim();
      const { inicio, duracion, servicio, esp } = this.e;
      try {
        const reserva = await crearReserva({
          id_sala: this.e.sala ?? this.salas[0]?.id,
          id_servicio: servicio,
          inicio,
          fin: sumar(inicio, duracion),
          especialistas: esp,
          ...(detalle && { detalle }),
          version_condiciones: this.condVersion,
        });
        try { sessionStorage.removeItem(claveDetalle(this.e)); } catch {}
        location.href = `/reservar/listo/?${new URLSearchParams({ id: reserva.id })}`;
        return;
      } catch (error) {
        await this.fallaAlConfirmar(error);
      }
      this.enviando = false;
      this.actualizarConfirmar();
      boton.removeAttribute('aria-busy');
      boton.textContent = texto;
      anterior.removeAttribute('aria-disabled');
    }
    async fallaAlConfirmar(error: unknown) {
      const codigo = error instanceof ErrorApi ? error.codigo : '';
      const estado = error instanceof ErrorApi ? error.estado : -1;
      const horario = this.enlaceHorario();
      const cambiarServicio = { etiqueta: 'Cambiar servicio', href: this.url('servicio') };
      const franja: Record<string, string> = {
        fuera_de_franja: 'Ese horario ya no está publicado.',
        anticipacion_insuficiente: 'Ese horario empieza demasiado pronto para reservarlo.',
        anticipacion_excesiva: 'Ese horario aún no se puede reservar: está demasiado lejos.',
        duracion_invalida: 'La duración va de 30 min a 8 h, en bloques de 30 min.',
      };
      // Orden del contrato: reaceptacion_requerida, perfil_incompleto, autorizacion_menor_pendiente, texto_desactualizado.
      if (estado === 409 && codigo === 'reaceptacion_requerida') return void location.assign(this.url('cuenta', {}, 'textos-pendientes'));
      if (estado === 409 && codigo === 'perfil_incompleto') return void location.assign(this.url('cuenta', {}, 'faltan-datos'));
      if (estado === 409 && codigo === 'autorizacion_menor_pendiente') return void location.assign(this.url('cuenta', {}, 'menor'));
      if (estado === 409 && codigo === 'texto_desactualizado') {
        const version = (error as ErrorApi).detalles?.vigente?.version;
        await this.cargarCondiciones(`Las condiciones cambiaron. Lee la versión ${version ?? 'nueva'} y vuelve a marcar la casilla.`);
        const caja = this.q('[data-condiciones] [data-aviso]:not([hidden]) .aviso');
        if (caja) {
          caja.tabIndex = -1;
          caja.focus();
        }
        return;
      }
      if (estado === 409 && codigo === 'tramo_no_disponible') {
        this.revisar('horario');
        return this.aviso('Alguien reservó ese horario hace un momento. Elige otro; lo demás se conserva.', horario);
      }
      if (estado === 403 && codigo === 'ensayo_no_disponible') {
        this.revisar('servicio');
        return this.aviso('El ensayo es para quien ya tiene una sesión confirmada con nosotros. Elige grabación o live session.', cambiarServicio);
      }
      if (estado === 422 && franja[codigo]) {
        this.revisar('horario');
        return this.aviso(franja[codigo], horario);
      }
      if (estado === 422 && codigo === 'servicio_no_reservable') {
        this.revisar('servicio');
        return this.aviso('Ese servicio no se reserva en sala. Elige otro.', cambiarServicio);
      }
      if (estado === 422) {
        if ((error as ErrorApi).detalles?.campo === 'detalle') return this.aviso('El detalle no es válido. Máximo 500 caracteres.', undefined, this.q('textarea[name="detalle"]'));
        this.revisar('horario', 'servicio');
        return this.aviso('Algo en tu reserva no es válido. Revisa los pasos.');
      }
      if (estado === 401) return this.aviso('Tu sesión caducó. Inicia sesión para confirmar; tu elección se conserva.', { etiqueta: 'Iniciar sesión', href: `/acceso?${new URLSearchParams({ volver: this.url('confirmar') })}` });
      if (estado === 503) return this.aviso('El servicio no responde. Tu reserva no se guardó; inténtalo en unos minutos.');
      if (estado === 0) return this.aviso('Sin conexión. Tu reserva no se guardó; revisa tu red.');
      this.aviso('Algo salió mal. Revisa en Mis reservas si se guardó antes de repetir.');
    }

    // --- Condiciones (paso 04) ---

    actualizarConfirmar() {
      const confirmar = this.q<HTMLButtonElement>('[data-confirmar]');
      if (confirmar) confirmar.disabled = this.simEstado !== 'ok' || !this.condVersion;
    }
    async cargarCondiciones(aviso?: string) {
      const caja = this.q('[data-condiciones]')!;
      const motivo = this.q('[data-motivo-condiciones]')!;
      this.condVersion = null;
      this.actualizarConfirmar();
      try {
        const lista = await listarTextosLegales();
        const bloque = Array.isArray(lista) ? bloqueReserva(lista) : null;
        if (!bloque) throw new Error('sin condiciones');
        const raiz = resumenLegal(this, { titulo: bloque.titulo, resumenes: bloque.resumenes, enlaces: bloque.enlaces, casillas: [bloque.casilla] });
        if (aviso) avisoResumen(raiz, aviso);
        caja.replaceChildren(raiz);
        this.condVersion = bloque.version;
        motivo.hidden = true;
      } catch {
        caja.replaceChildren(this.plantilla('texto-error'));
        caja.querySelector('[data-reintentar-textos]')?.setAttribute('data-reintentar-condiciones', '');
        motivo.hidden = false;
      }
      this.actualizarConfirmar();
    }

    // --- 03 Completa tus datos ---

    async mostrarMenor() {
      this.q('[data-formulario-cuenta]')!.hidden = true;
      const nodo = this.plantilla('menor');
      this.q('[data-cuenta-estado]')!.replaceChildren(nodo);
      const caja = this.q<HTMLElement>('[data-cuenta-estado] .aviso')!;
      const contacto = await obtenerContacto().then((c: any) => c?.texto ?? null, () => null);
      const p = this.q<HTMLElement>('[data-cuenta-estado] [data-contacto]');
      if (contacto && p) {
        p.textContent = contacto;
        p.hidden = false;
      }
      return caja;
    }
    async iniciarCuenta() {
      const estado = this.q('[data-cuenta-estado]')!;
      const url = new URL(location.href);
      const clave = url.searchParams.get('aviso');
      if (clave) {
        url.searchParams.delete('aviso');
        history.replaceState(null, '', url);
      }
      estado.replaceChildren(this.plantilla('cargando'));
      let perfil: any, lista: any[] | null;
      try {
        [perfil, lista] = await Promise.all([obtenerPerfil(), listarTextosLegales().catch(() => null)]);
      } catch (error) {
        if (error instanceof ErrorApi && error.estado === 401) return void location.replace(this.rutaAcceso('cuenta'));
        const nodo = this.plantilla('texto-error');
        nodo.querySelector('.aviso-titulo')!.textContent = 'No pudimos cargar tus datos.';
        estado.replaceChildren(nodo);
        return;
      }
      this.perfil = perfil;
      void this.cargarResumenLateral();
      estado.replaceChildren();
      if (perfil.es_menor || clave === 'menor') return void (await this.mostrarMenor());
      const pendientes = pendientesDe(perfil, 'registro').map((p: any) => p.tipo);
      const falta: Record<string, boolean> = { nombre: !perfil.nombre, documento: !perfil.documento, telefono: !perfil.telefono };
      if (!pendientes.length && !Object.values(falta).some(Boolean)) {
        if (perfil.datos_para_reservar !== false) return void location.replace(this.url('confirmar'));
        for (const c of Object.keys(falta)) falta[c] = true; // el servidor dice que falta algo que no vemos: se piden los tres
      }
      if (clave === 'faltan-datos') this.aviso('Antes de confirmar necesitamos tus datos.', undefined, null, true);
      else if (clave === 'textos-pendientes') this.aviso('Antes de confirmar necesitamos que aceptes los términos actualizados.', undefined, null, true);
      for (const [campo, visible] of Object.entries(falta)) if (!visible) this.q(`[data-fila-${campo}]`)!.remove();
      const nombre = this.q<HTMLInputElement>('[name="nombre"]');
      if (nombre) nombre.value = perfil.nombre ?? '';
      const telefono = this.q<HTMLInputElement>('[name="telefono"]');
      if (telefono) telefono.value = perfil.telefono ?? '';
      this.q('[data-d1]')!.hidden = false;
      this.pendientesTipos = pendientes;
      if (pendientes.length) {
        this.q('[data-d2]')!.hidden = false;
        this.pintarTextos(lista);
      } else this.q('[data-d2]')!.remove();
      this.q('[data-formulario-cuenta]')!.hidden = false;
    }
    pendientesTipos: string[] = [];
    // Reintentar: si el formulario ya esta, solo los textos; si no, todo el paso.
    async reintentarCuenta() {
      if (this.q('[data-formulario-cuenta]')!.hidden) return this.iniciarCuenta();
      this.pintarTextos(await listarTextosLegales().catch(() => null));
    }
    pintarTextos(lista: any[] | null, avisos: Record<string, string> = {}) {
      const caja = this.q('[data-d2] [data-bloques]')!;
      const guardar = this.q<HTMLButtonElement>('[data-guardar-cuenta]')!;
      const motivo = this.q('[data-motivo-textos]')!;
      this.bloques = Array.isArray(lista) ? bloquesRegistro(lista, this.pendientesTipos) : [];
      if (!this.bloques.length) {
        caja.replaceChildren(this.plantilla('texto-error'));
        guardar.disabled = true;
        motivo.hidden = false;
        return;
      }
      guardar.disabled = false;
      motivo.hidden = true;
      caja.replaceChildren(
        ...this.bloques.map((b) => {
          const raiz = resumenLegal(this, { titulo: b.titulo, resumenes: b.resumenes, enlaces: b.enlaces, casillas: [b.casilla] });
          raiz.dataset.clave = b.clave;
          if (avisos[b.clave]) avisoResumen(raiz, avisos[b.clave]);
          return raiz;
        }),
      );
    }
    // El resumen persistente del lateral: solo nombres, sin precio (el paso 04 lo calcula).
    async cargarResumenLateral() {
      if (!this.servicios.length) {
        const [servicios, especialistas] = await Promise.all([listarServicios().catch(() => []), listarEspecialistas().catch(() => [])]);
        this.servicios = servicios.filter((s: any) => s.ocupa_sala && s.activo);
        this.especialistas = especialistas.filter((x: any) => x.activo);
      }
      this.resumen();
    }
    async guardarCuenta() {
      if (this.enviando) return;
      this.sinAviso();
      const form = this.q<HTMLFormElement>('[data-formulario-cuenta]')!;
      const campo = (n: string) => form.querySelector<HTMLInputElement>(`[name="${n}"]`);
      form.querySelectorAll('[aria-invalid="true"]').forEach((e) => {
        if (e.closest('.resumen-legal')) errorResumen(e.closest('.resumen-legal') as HTMLElement, '');
        else quitarError(e as HTMLInputElement);
      });
      const boton = this.q<HTMLButtonElement>('[data-guardar-cuenta]')!;
      const cambios: Record<string, unknown> = {};
      if (campo('es_menor')!.checked) cambios.es_menor = true;
      else {
        const fallos: [HTMLElement, string][] = [];
        const nombre = campo('nombre');
        if (nombre) {
          if (!nombre.value.trim()) fallos.push([nombre, 'Escribe tu nombre.']);
          else cambios.nombre = nombre.value.trim();
        }
        const tipo = campo('tipo_documento');
        if (tipo) {
          const r = validarDocumento(tipo.value, campo('numero_documento')!.value) as any;
          if (r.tipo) fallos.push([tipo, r.tipo]);
          if (r.numero) fallos.push([campo('numero_documento')!, r.numero]);
          if (r.valor) cambios.documento = r.valor;
        }
        const telefono = campo('telefono');
        if (telefono) {
          const numero = telefono.value.trim() ? normalizarTelefono(telefono.value) : null;
          if (!telefono.value.trim()) fallos.push([telefono, 'Escribe tu teléfono; lo necesitas para reservar.']);
          else if (!numero) fallos.push([telefono, 'Escribe entre 9 y 15 dígitos; puedes empezar con +.']);
          else cambios.telefono = numero;
        }
        for (const [entrada, texto] of fallos) ponerError(this, entrada as HTMLInputElement, texto);
        const sinMarcar = this.bloques.filter((b) => !form.querySelector<HTMLInputElement>(`[data-clave="${b.clave}"] input`)!.checked);
        for (const b of sinMarcar) errorResumen(form.querySelector(`[data-clave="${b.clave}"]`)!, b.clave === 'terminos' ? ERROR_TERMINOS : 'Marca la casilla para registrar la agrupación.');
        const primero = fallos[0]?.[0] ?? (sinMarcar[0] && form.querySelector<HTMLElement>(`[data-clave="${sinMarcar[0].clave}"] input`));
        if (primero) return primero.focus();
      }
      this.enviando = true;
      boton.disabled = true;
      boton.setAttribute('aria-busy', 'true');
      const etiqueta = boton.textContent;
      boton.textContent = 'Guardando…';
      try {
        if (Object.keys(cambios).length) this.perfil = await actualizarPerfil(cambios);
        if (this.perfil?.es_menor && cambios.es_menor) {
          const caja = await this.mostrarMenor();
          caja.tabIndex = -1;
          caja.focus();
          return;
        }
        if (this.bloques.length && this.pendientesTipos.length) await aceptar('registro', this.bloques.flatMap((b) => b.textos));
        location.assign(this.url('confirmar'));
        return;
      } catch (error) {
        await this.fallaAlGuardarCuenta(error);
      } finally {
        this.enviando = false;
        boton.disabled = this.pendientesTipos.length > 0 && this.bloques.length === 0;
        boton.removeAttribute('aria-busy');
        boton.textContent = etiqueta;
      }
    }
    async fallaAlGuardarCuenta(error: unknown) {
      const e = error instanceof ErrorApi ? error : null;
      if (e?.estado === 409 && e.codigo === 'texto_desactualizado') {
        const lista = await listarTextosLegales().catch(() => null);
        const v = e.detalles?.vigente?.version;
        this.pintarTextos(lista, Object.fromEntries(this.bloques.map((b) => [b.clave, `Las condiciones cambiaron. Lee la versión ${v ?? 'nueva'} y vuelve a marcar la casilla.`])));
        const caja = this.q('[data-d2] [data-aviso]:not([hidden]) .aviso');
        if (caja) {
          caja.tabIndex = -1;
          caja.focus();
        }
        return;
      }
      const enlace = { etiqueta: 'Iniciar sesión', href: `/acceso?${new URLSearchParams({ volver: this.url('cuenta') })}` };
      if (e?.estado === 401) return this.aviso('Tu sesión caducó. Inicia sesión para continuar; tus datos se conservan.', enlace);
      if (e?.estado === 422) return this.aviso(e.mensaje || 'Revisa tus datos.');
      if (e?.estado === 503) return this.aviso('El servicio no responde. No se guardó nada; inténtalo en unos minutos.');
      if (e?.estado === 0) return this.aviso('Sin conexión. No se guardó nada; revisa tu red.');
      this.aviso('Algo salió mal. Inténtalo de nuevo.');
    }

    // --- 05 Listo ---

    async iniciarListo() {
      const salida = this.q('[data-listo]')!;
      let reserva: any;
      try {
        reserva = await obtenerReserva(this.e.id);
      } catch (error) {
        if (error instanceof ErrorApi && error.estado === 401) {
          salida.replaceChildren();
          return this.aviso('Tu sesión caducó. Inicia sesión para ver tu reserva.', { etiqueta: 'Iniciar sesión', href: `/acceso?${new URLSearchParams({ volver: location.pathname + location.search })}` });
        }
        return salida.replaceChildren(this.plantilla('listo-sin-datos'));
      }
      const nodo = this.plantilla('listo');
      nodo.querySelector('.panel-titulo')!.lastChild!.textContent = ` Reserva ${reserva.folio}`;
      nodo.querySelector('[data-datos-listo]')!.replaceChildren(
        ...[
          ['Fecha', `${nombreDia(fechaDe(reserva.inicio))} ${diaMes(fechaDe(reserva.inicio))}`],
          ['Horario', `${horaDe(reserva.inicio)} – ${horaDe(reserva.fin)}`],
          ['Sala', reserva.sala],
          ['Servicio', reserva.servicio],
          ...filasPrecio(reserva.precio, reserva.parametros_aplicados?.porcentaje_adelanto),
        ].map(([etiqueta, valor]) => {
          const fila = document.createElement('div');
          const dt = document.createElement('dt');
          dt.textContent = etiqueta;
          const dd = document.createElement('dd');
          dd.textContent = valor;
          fila.append(dt, dd);
          return fila;
        }),
      );
      nodo.querySelector('.indicador-dato')!.textContent = `${fechaHora(reserva.vence_pago)} · ${faltan(reserva.vence_pago)}`;
      nodo.querySelector('[data-paso-1]')!.textContent = `Paga el anticipo de ${soles(reserva.precio.anticipo)} antes del ${fechaHora(reserva.vence_pago)}.`;
      nodo.querySelector<HTMLAnchorElement>('[data-ver]')!.href = `/app/reservas/detalle?${new URLSearchParams({ id: reserva.id })}`;
      const correo = (await obtenerCliente().auth.getSession().catch(() => null))?.data?.session?.user?.email;
      const nota = nodo.querySelector<HTMLElement>('[data-correo]')!;
      if (correo) {
        nota.textContent = `Te enviamos estos datos a ${correo}.`;
        nota.hidden = false;
      }
      salida.replaceChildren(nodo);
    }
  }

  if (!customElements.get('bugalu-reserva')) customElements.define('bugalu-reserva', BugaluReserva);
</script>
