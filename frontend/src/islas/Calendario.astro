---
import Panel from '../componentes/Panel.astro';
import Aviso from '../componentes/Aviso.astro';
import Boton from '../componentes/Boton.astro';
import Campo from '../componentes/Campo.astro';
import Tabla from '../componentes/Tabla.astro';
import EtiquetaTecnica from '../componentes/EtiquetaTecnica.astro';
import Icono from '../componentes/internos/Icono.astro';

interface Props {
  modo: 'reserva' | 'personal';
}
const { modo } = Astro.props;
const filtros = ['neutra', 'exito', 'aviso', 'activa', 'alerta'] as const;
---

<!-- Un bloque por estado (estados-sistema): se pintan en servidor y la isla clona el que toca. Sin JS, el noscript oculta la carga y avisa. -->
<bugalu-calendario class="calendario" modo={modo}>
  <div data-avisos></div>
  <!-- Región viva estable y presente antes de cualquier texto: anuncia el periodo y la elección una sola vez. -->
  <p class="visualmente-oculto" role="status" data-anuncio></p>
  <div data-salida>
    <Panel titulo=" " cargando />
  </div>

  <template data-estado="cargando"><Panel titulo=" " cargando /></template>

  <template data-estado="datos">
    <Panel titulo=" " ayuda="Horario de Lima">
      <div slot="acciones" class="cal-barra" data-barra></div>
      <div data-cuerpo></div>
      <ul class="cal-leyenda" data-leyenda aria-label="Leyenda"></ul>
    </Panel>
  </template>

  <template data-estado="vacio">
    <Panel titulo=" ">
      <div slot="acciones" class="cal-barra" data-barra></div>
      <p class="cal-vacio-titulo">Aún no hay horarios publicados</p>
      <p>Publicamos la agenda semana a semana. Mira la siguiente semana o vuelve pronto.</p>
      <div class="cal-acciones">
        <Boton variante="secundario" href="#" data-siguiente>Ver semana siguiente</Boton>
        <Boton variante="secundario" href="#" data-publicar hidden>Publicar franjas de esta semana</Boton>
      </div>
    </Panel>
  </template>

  <template data-estado="error">
    <Panel titulo="Calendario">
      <Aviso variante="error" titulo=" " texto=" ">
        <div class="cal-acciones"><Boton variante="secundario" data-reintentar>Reintentar</Boton></div>
      </Aviso>
    </Panel>
  </template>
  <template data-estado="no-autenticado">
    <Panel titulo="Calendario"><Aviso variante="aviso" titulo=" " texto=" " accion={{ etiqueta: 'Ir al acceso interno', href: '/acceso/interno' }} /></Panel>
  </template>
  <template data-estado="sesion-caducada">
    <Panel titulo="Calendario"><Aviso variante="informacion" titulo=" " texto=" " accion={{ etiqueta: 'Iniciar sesión', href: '/acceso' }} /></Panel>
  </template>
  <template data-estado="sin-permiso">
    <Panel codigo="[403]" titulo="Sin permiso"><Aviso variante="error" titulo=" " texto=" " accion={{ etiqueta: 'Volver al inicio', href: '/app/' }} /></Panel>
  </template>
  <template data-estado="no-sala">
    <Panel titulo="Calendario"><Aviso variante="error" titulo=" " texto=" " accion={{ etiqueta: 'Ver la sala', href: '/' }} /></Panel>
  </template>
  <template data-estado="lista">
    <Panel titulo=" " ayuda="Horario de Lima">
      <div slot="acciones" class="cal-barra" data-barra></div>
      <Tabla titulo="Reservas" columnas={['Folio', 'Fecha', 'Cliente', 'Servicio', 'Estado', '']} />
      <p class="cal-vacio-titulo" data-sin-reservas hidden>No hay reservas en este periodo.</p>
    </Panel>
  </template>
  <template data-fila>
    <tr>
      <th scope="row" data-folio></th>
      <td data-etiqueta="Fecha" data-fecha></td>
      <td data-etiqueta="Cliente" data-cliente></td>
      <td data-etiqueta="Servicio" data-servicio></td>
      <td data-etiqueta="Estado" data-estado-reserva></td>
      <td><Boton variante="secundario" href="#" data-ver>Ver reserva<span class="visualmente-oculto" data-objeto></span></Boton><Boton variante="secundario" href="#" data-na hidden>Marcar no asistió<span class="visualmente-oculto" data-objeto-na></span></Boton></td>
    </tr>
  </template>
  <template data-aviso="informacion"><Aviso variante="informacion" titulo=" " texto=" " /></template>

  <!-- Piezas del catálogo que la isla clona al construir la cuadrícula. -->
  {filtros.map((v) => <template data-pieza={`etiqueta-${v}`}><EtiquetaTecnica variante={v} texto=" " /></template>)}
  <template data-pieza="enlace"><EtiquetaTecnica href="#" texto=" " /></template>
  <template data-pieza="vista-no"><EtiquetaTecnica variante="filtro" href="#" texto=" " /></template>
  <template data-pieza="vista-si"><EtiquetaTecnica variante="filtro" href="#" texto=" " aplicado /></template>
  <template data-pieza="selector"><Campo tipo="selector" nombre="sala" etiqueta="Sala" /></template>
  <template data-pieza="icono-chevron-left"><Icono nombre="chevron-left" /></template>
  <template data-pieza="icono-chevron-right"><Icono nombre="chevron-right" /></template>
  <template data-pieza="icono-lock"><Icono nombre="lock" /></template>
  <template data-pieza="icono-check"><Icono nombre="check" /></template>

  <noscript>
    <style is:inline>
      bugalu-calendario [data-salida] { display: none; }
    </style>
    <Panel titulo="Calendario"><Aviso variante="informacion" titulo="El calendario necesita JavaScript. Actívalo en tu navegador y recarga la página." /></Panel>
  </noscript>
</bugalu-calendario>

<script>
  import { listarSalas, obtenerDisponibilidad, listarMisReservas, listarReservas } from '../servicios/reservas.js';
  import { obtenerPerfil } from '../servicios/api.js';
  import { obtenerToken } from '../servicios/sesion.js';
  import { llenarAviso } from '../servicios/formulario.js';
  import { hoyLima, fechaDe, horaDe, instante, sumarDias, esFecha, inicioValido, duracionValida, nombreDia, diaMes, rangoSemana, semanaDe } from '../servicios/formatos.js';

  const MEDIA = 30 * 60e3;
  const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  const ESTADOS_RESERVA: Record<string, [string, string]> = {
    pre_reservada: ['Pre-reservada', 'aviso'], confirmada: ['Confirmada', 'exito'], en_curso: ['En curso', 'activa'], finalizada: ['Finalizada', 'neutra'], cancelada: ['Cancelada', 'neutra'], no_asistio: ['No asistió', 'alerta'],
  };
  // Estados con bloque unido (rowspan); la media hora libre nunca se une: cada una es un botón.
  const UNIBLES = ['ocupado', 'propio', 'cerrado', 'noreservable', 'pasado'];
  const TEXTO: Record<string, string> = { libre: 'LIBRE', ocupado: 'OCUPADO', propio: 'TU RESERVA', cerrado: 'CERRADO', noreservable: 'NO RESERVABLE', pasado: 'PASADO' };

  const dur = (m: number) => [Math.floor(m / 60) && `${Math.floor(m / 60)} h`, m % 60 && `${m % 60} min`].filter(Boolean).join(' ') || '0 min';
  const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
  const libresTexto = (m: number) => (m > 0 ? `${dur(m)} libres` : 'Sin horas libres');
  const totalTexto = (m: number) => (m % 60 === 0 ? `${m / 60} ${m / 60 === 1 ? 'hora libre' : 'horas libres'}` : `${dur(m)} libres`);
  const hm = (ms: number) => horaDe(new Date(ms).toISOString());
  const fd = (ms: number) => fechaDe(new Date(ms).toISOString());
  const largo = (f: string) => `${nombreDia(f)} ${+f.slice(8)} de ${MESES[+f.slice(5, 7) - 1]}`;
  const lunesDeFecha = (f: string) => sumarDias(f, -((new Date(`${f}T00:00:00Z`).getUTCDay() + 6) % 7));
  const primeroDelMes = (f: string, n = 0) => { const d = new Date(`${f.slice(0, 7)}-01T00:00:00Z`); d.setUTCMonth(d.getUTCMonth() + n); return d.toISOString().slice(0, 10); };
  const inicioDia = (f: string) => Date.parse(instante(f, '00:00'));
  const capital = (t: string) => t.charAt(0).toUpperCase() + t.slice(1).toLowerCase();
  const sinEspacios = (t: string) => t.replace(/\s+/g, ' ').trim();

  function h(tag: string, atributos: Record<string, any> = {}, ...hijos: any[]) {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(atributos)) if (v !== null && v !== undefined && v !== false) e.setAttribute(k, v === true ? '' : String(v));
    e.append(...hijos.flat().filter((x) => x !== null && x !== undefined && x !== false));
    return e;
  }

  const textoError = (e: any): [string, string?] =>
    e.estado === 503 ? ['El calendario no responde', 'Inténtalo de nuevo en unos minutos.'] : e.estado === 0 ? ['Sin conexión', 'Revisa tu red y vuelve a intentarlo.'] : ['Algo salió mal al cargar el calendario.'];

  class BugaluCalendario extends HTMLElement {
    static observedAttributes = ['duracion'];
    modo = 'reserva';
    estado: any = {};
    salas: any[] | null = null;
    rol = '';
    datos: any = null;
    modelo: any = null;
    propias: Record<number, any> = {};
    reservas: any[] = [];
    ciclo = 0;
    foco = '';
    avisoFecha = false;
    escucha = () => this.leerUrl(true);

    connectedCallback() {
      this.modo = this.getAttribute('modo') ?? 'reserva';
      this.leerUrl();
      addEventListener('popstate', this.escucha);
      this.addEventListener('click', (e) => this.alPulsar(e));
      this.addEventListener('keydown', (e) => this.alTeclear(e));
      this.addEventListener('change', (e) => {
        const selector = (e.target as Element).closest<HTMLSelectElement>('select[name="sala"]');
        if (selector) this.ir({ sala: selector.value });
      });
      this.cargar();
    }

    disconnectedCallback() {
      removeEventListener('popstate', this.escucha);
    }

    attributeChangedCallback(nombre: string, _antes: string | null, valor: string | null) {
      if (nombre === 'duracion' && this.estado) {
        this.estado.duracion = duracionValida(valor);
        if (this.datos) this.pintar();
      }
    }

    // --- Estado en la URL ---

    leerUrl(recargar = false) {
      const p = new URLSearchParams(location.search);
      const hoy = hoyLima();
      const fecha = p.get('fecha');
      this.avisoFecha = p.has('fecha') && !esFecha(fecha);
      const vistaUrl = p.get('vista');
      let vista = ['semana', 'mes', 'lista'].includes(vistaUrl ?? '') ? vistaUrl! : 'semana';
      if (this.modo !== 'personal' && vista === 'lista') vista = 'semana';
      // Agenda: por debajo de punto-quiebre-escritorio, sin vista en la URL abre Lista.
      if (this.modo === 'personal' && !vistaUrl && !matchMedia('(min-width: 64em)').matches) vista = 'lista';
      this.estado = {
        vista,
        fecha: this.avisoFecha || !fecha ? hoy : fecha,
        sala: this.getAttribute('sala') ?? p.get('sala') ?? '',
        inicio: inicioValido(this.getAttribute('inicio') ?? p.get('inicio')),
        duracion: duracionValida(this.getAttribute('duracion') ?? p.get('duracion')),
      };
      if (recargar) this.cargar();
    }

    url(e = this.estado) {
      const p = new URLSearchParams({ vista: e.vista, fecha: e.fecha });
      // `conservar="id"`: parametros de la pantalla anfitriona que la navegacion del calendario no debe perder.
      const actual = new URLSearchParams(location.search);
      for (const k of (this.getAttribute('conservar') ?? '').split(',').filter(Boolean)) if (actual.has(k)) p.set(k, actual.get(k)!);
      if (e.sala && (this.salas?.length ?? 0) > 1) p.set('sala', e.sala);
      if (e.inicio) p.set('inicio', e.inicio);
      if (e.duracion) p.set('duracion', e.duracion);
      return `${location.pathname}?${p}`;
    }

    ir(cambios: Record<string, string>, foco = '') {
      this.estado = { ...this.estado, ...cambios };
      this.avisoFecha = false;
      this.foco = foco;
      history.pushState(null, '', this.url());
      this.cargar();
    }

    // Periodo desplazado `n` semanas o meses desde la fecha ancla.
    desplazada(n: number) {
      const { vista, fecha } = this.estado;
      return vista === 'mes' ? primeroDelMes(fecha, n) : sumarDias(fecha, 7 * n);
    }

    rango() {
      const { vista, fecha } = this.estado;
      const desde = vista === 'mes' ? lunesDeFecha(primeroDelMes(fecha)) : lunesDeFecha(fecha);
      return { desde, hasta: sumarDias(desde, vista === 'mes' ? 42 : 7) };
    }

    tituloPeriodo() {
      const { vista, fecha } = this.estado;
      return vista === 'mes' ? `${MESES[+fecha.slice(5, 7) - 1]} ${fecha.slice(0, 4)}`.toUpperCase() : rangoSemana(lunesDeFecha(fecha));
    }

    // --- Carga y estados ---

    pieza(nombre: string): any {
      return this.querySelector<HTMLTemplateElement>(`template[data-pieza="${nombre}"]`)!.content.firstElementChild!.cloneNode(true) as HTMLElement;
    }

    mostrar(estado: string) {
      const plantilla = this.querySelector<HTMLTemplateElement>(`template[data-estado="${estado}"]`)!;
      this.querySelector('[data-salida]')!.replaceChildren(plantilla.content.cloneNode(true));
    }

    avisos() {
      const zona = this.querySelector('[data-avisos]')!;
      zona.replaceChildren();
      if (!this.avisoFecha) return;
      const aviso = (this.querySelector<HTMLTemplateElement>('template[data-aviso="informacion"]')!.content.firstElementChild!.cloneNode(true)) as HTMLElement;
      llenarAviso(aviso, 'La fecha del enlace no es válida', 'Te mostramos esta semana.');
      aviso.removeAttribute('role');
      zona.append(aviso);
    }

    enfocarTitulo() {
      const titulo = this.querySelector<HTMLElement>('[data-salida] .panel-titulo')!;
      titulo.tabIndex = -1;
      titulo.focus();
    }

    async cargar(reintento = false): Promise<void> {
      const ciclo = ++this.ciclo;
      const anuncio = this.querySelector('[data-anuncio]')!;
      anuncio.textContent = '';
      const panel = this.querySelector('[data-salida] [data-cuerpo], [data-salida] table');
      // Con un periodo ya pintado se conserva (y su foco): solo se marca ocupado.
      if (panel) this.querySelector('[data-salida] .panel-cuerpo')?.setAttribute('aria-busy', 'true');
      else {
        this.mostrar('cargando');
        this.querySelector('[data-salida] .panel-titulo')!.textContent = this.tituloPeriodo();
        this.querySelector('[data-salida] .panel-cargando')!.textContent = `Cargando ${this.estado.vista === 'mes' ? 'mes' : 'semana'}…`;
      }
      this.avisos();
      let texto: string | null = null;
      try {
        texto = await this.resolver();
      } catch (error: any) {
        if (ciclo !== this.ciclo) return;
        if (error.estado === 422 && this.estado.fecha !== hoyLima()) {
          this.avisoFecha = true;
          this.estado.fecha = hoyLima();
          history.replaceState(null, '', this.url());
          return this.cargar();
        }
        this.fallo(error);
      }
      if (ciclo !== this.ciclo) return;
      this.querySelectorAll('[data-salida] .aviso[role]').forEach((e) => e.removeAttribute('role'));
      anuncio.textContent = texto ?? sinEspacios(this.querySelector('[data-salida] .aviso')?.textContent ?? '');
      if (this.foco === 'grid') this.querySelector<HTMLElement>('[data-salida] [role="grid"] [tabindex="0"]')?.focus();
      else if (this.foco) this.querySelector<HTMLElement>(`[data-enlace="${this.foco}"]`)?.focus();
      else if (reintento) this.enfocarTitulo();
      this.foco = '';
    }

    fallo(error: any) {
      const volver = new URLSearchParams({ volver: location.pathname + location.search });
      if (error.estado === 401) {
        const interno = this.modo === 'personal';
        this.mostrar(interno ? 'no-autenticado' : 'sesion-caducada');
        const aviso = this.querySelector('[data-salida] .aviso')!;
        llenarAviso(aviso, ...((interno ? ['Tu sesión no es válida', 'Inicia sesión para continuar.'] : ['Tu sesión caducó', 'Inicia sesión para ver tus reservas en el calendario.']) as [string, string]));
        aviso.querySelector<HTMLAnchorElement>('.aviso-accion')!.href = `${interno ? '/acceso/interno' : '/acceso'}?${volver}`;
      } else if (error.estado === 403) {
        this.mostrar('sin-permiso');
        llenarAviso(this.querySelector('[data-salida] .aviso')!, 'La agenda es solo para el equipo del estudio.', undefined as any);
      } else if (error.estado === 404) this.sinSala();
      else {
        this.mostrar('error');
        llenarAviso(this.querySelector('[data-salida] .aviso')!, ...(textoError(error) as [string, string]));
      }
    }

    sinSala() {
      this.mostrar('no-sala');
      const aviso = this.querySelector('[data-salida] .aviso')!;
      const primera = this.salas?.[0]?.nombre;
      llenarAviso(aviso, 'No encontramos esa sala.', undefined as any);
      const enlace = aviso.querySelector<HTMLAnchorElement>('.aviso-accion')!;
      enlace.textContent = primera ? `Ver la sala de ${primera}` : 'Ver el calendario';
      enlace.href = this.url({ ...this.estado, sala: '' });
    }

    // Devuelve el texto del anuncio (o null si lo da el aviso del estado).
    async resolver(): Promise<string | null> {
      const { vista } = this.estado;
      if (this.modo === 'personal') {
        const yo = await obtenerPerfil();
        this.rol = yo.rol;
        if (yo.rol === 'cliente') throw Object.assign(new Error('sin permiso'), { estado: 403 });
      }
      this.salas ??= await listarSalas();
      const salas = this.salas!;
      if (!salas.length) throw new Error('sin salas');
      const sala = this.estado.sala ? salas.find((s) => s.id === this.estado.sala) : salas[0];
      if (!sala) {
        this.sinSala();
        return null;
      }
      this.sala = sala;
      const { desde, hasta } = this.rango();
      const rango = { desde: instante(desde, '00:00'), hasta: instante(hasta, '00:00') };
      if (vista === 'lista') {
        this.reservas = await listarReservas(rango);
        this.datos = null;
        this.pintarLista();
        return `${plural(this.reservas.length, 'reserva', 'reservas')} en este periodo.`;
      }
      const datos = await obtenerDisponibilidad({ sala: sala.id, ...rango, excluirReserva: this.getAttribute('excluir-reserva') });
      this.datos = datos;
      this.propias = {};
      if (this.modo === 'reserva' && datos.ocupados.some((o: any) => o.propia) && (await obtenerToken())) {
        const mias = await listarMisReservas().catch(() => []);
        datos.ocupados.forEach((o: any, i: number) => {
          if (o.propia) this.propias[i] = mias.find((r: any) => Date.parse(r.inicio) === Date.parse(o.inicio));
        });
      }
      if (!datos.franjas.length) return this.pintarVacio();
      const anuncio = this.pintar();
      this.avisarInicio();
      return anuncio;
    }

    // Un inicio restaurado desde la URL emite el mismo evento que al elegirlo, para que Reserva limite la duración.
    avisarInicio() {
      const { inicio } = this.estado;
      const ms = inicio ? Date.parse(inicio) : NaN;
      if (this.modo !== 'reserva' || !(this.modelo.estadoDe(ms)?.e === 'libre')) return;
      this.dispatchEvent(new CustomEvent('calendario-inicio', { bubbles: true, detail: { inicio, minutosMaximos: this.maximo(ms) } }));
    }

    sala: any = null;

    pintarVacio() {
      this.mostrar('vacio');
      const titulo = this.querySelector('[data-salida] .panel-titulo')!;
      titulo.textContent = this.tituloPeriodo();
      this.querySelector('[data-barra]')!.replaceChildren(...this.barra(this.vistasDisponibles()));
      const mes = this.estado.vista === 'mes';
      const siguiente = this.querySelector<HTMLAnchorElement>('[data-siguiente]')!;
      siguiente.textContent = mes ? 'Ver mes siguiente' : 'Ver semana siguiente';
      siguiente.href = this.url({ ...this.estado, fecha: this.desplazada(1) });
      siguiente.dataset.periodo = 'siguiente';
      const publicar = this.querySelector<HTMLAnchorElement>('[data-publicar]')!;
      if (this.modo === 'personal' && this.rol === 'administrador') {
        publicar.hidden = false;
        publicar.href = `/app/franjas/?semana=${semanaDe(lunesDeFecha(this.estado.fecha))}`;
      } else publicar.remove();
      return 'Aún no hay horarios publicados';
    }

    // --- Barra del periodo, vistas y sala ---

    barra(vistas: string[]) {
      const { vista } = this.estado;
      const mes = vista === 'mes';
      const unidad = mes ? 'Mes' : 'Semana';
      const enlace = (clave: string, texto: string, destino: any, icono = '') => {
        const a = this.pieza('enlace');
        a.querySelector('span')!.textContent = texto;
        a.href = this.url({ ...this.estado, ...destino });
        a.dataset.periodo = clave;
        a.dataset.enlace = clave;
        if (icono) a.prepend(this.pieza(`icono-${icono}`));
        if (icono === 'chevron-right') a.append(a.firstElementChild!.cloneNode(true)), a.firstElementChild!.remove();
        return a;
      };
      const periodo = h('div', { class: 'cal-grupo', role: 'group', 'aria-label': 'Periodo' },
        enlace('anterior', `${unidad} anterior`, { fecha: this.desplazada(-1) }, 'chevron-left'),
        enlace('hoy', mes ? 'Este mes' : 'Esta semana', { fecha: hoyLima() }),
        enlace('siguiente', `${unidad} siguiente`, { fecha: this.desplazada(1) }, 'chevron-right'));
      const vistasNav = h('nav', { class: 'cal-grupo', 'aria-label': 'Vista' }, ...vistas.map((v) => {
        const a = this.pieza(v === vista ? 'vista-si' : 'vista-no');
        a.querySelector('span:last-child')!.textContent = v.toUpperCase();
        a.href = this.url({ ...this.estado, vista: v });
        a.dataset.vista = v;
        a.dataset.enlace = `vista-${v}`;
        return a;
      }));
      const salas = this.salas!;
      let sala: HTMLElement;
      if (salas.length > 1 && !this.hasAttribute('sala-fija')) {
        const campo = this.pieza('selector');
        campo.querySelector('select')!.append(...salas.map((s) => h('option', { value: s.id, selected: s.id === this.sala.id }, s.nombre)));
        sala = campo;
      } else {
        sala = this.pieza('etiqueta-neutra');
        sala.querySelector('span')!.textContent = `SALA · ${this.sala.nombre.toUpperCase()}`;
      }
      return [sala, periodo, vistasNav];
    }

    vistasDisponibles() {
      return this.modo === 'personal' ? ['semana', 'mes', 'lista'] : ['semana', 'mes'];
    }

    // --- Cálculo de estados de cada media hora ---

    construirModelo() {
      const d = this.datos;
      const par = (x: any) => [Date.parse(x.inicio), Date.parse(x.fin)];
      const franjas = d.franjas.map(par), cierres = d.cierres.map(par), ocupados = d.ocupados.map(par);
      const desde = d.limites ? Date.parse(d.limites.desde) : -Infinity, hasta = d.limites ? Date.parse(d.limites.hasta) : Infinity;
      const ahora = Date.now();
      const choca = (lista: number[][], a: number, b: number) => lista.findIndex(([x, y]) => a < y && b > x);
      const enFranja = (s: number) => franjas.some(([a, b]: number[]) => a <= s && s + MEDIA <= b);
      const estadoDe = (s: number) => {
        if (!enFranja(s)) return null;
        const ci = choca(cierres, s, s + MEDIA);
        if (ci >= 0) return { e: 'cerrado', clave: `c${ci}`, ci, s };
        const oc = choca(ocupados, s, s + MEDIA);
        if (oc >= 0) return { e: d.ocupados[oc].propia ? 'propio' : 'ocupado', clave: `o${oc}`, oc, s };
        if (s < ahora) return { e: 'pasado', clave: 'p', s };
        const cabe = enFranja(s + MEDIA) && choca(cierres, s, s + 2 * MEDIA) < 0 && choca(ocupados, s, s + 2 * MEDIA) < 0 && s >= desde && s < hasta;
        return cabe ? { e: 'libre', clave: 'l', s } : { e: 'noreservable', clave: 'n', s };
      };
      // Minutos que caben desde un inicio: el hueco seguido menos el margen de 30 min, con tope de 8 h.
      const maximo = (s: number) => {
        let r = s;
        while (enFranja(r) && choca(cierres, r, r + MEDIA) < 0 && choca(ocupados, r, r + MEDIA) < 0) r += MEDIA;
        return Math.min(480, (r - s) / 60e3 - 30);
      };
      return { estadoDe, maximo, franjas };
    }

    minutosLibres(fecha: string) {
      return this.datos.dias.find((x: any) => x.fecha === fecha)?.minutos_libres ?? 0;
    }

    // --- Pintado ---

    // Pinta el periodo y devuelve el texto del anuncio.
    pintar() {
      const lista = this.estado.vista === 'mes';
      this.modelo = this.construirModelo();
      this.mostrar('datos');
      const titulo = this.tituloPeriodo();
      this.querySelector('[data-salida] .panel-titulo')!.textContent = titulo;
      this.querySelector('[data-barra]')!.replaceChildren(...this.barra(this.vistasDisponibles()));
      const cuerpo = this.querySelector('[data-cuerpo]')!;
      const estados = new Set<string>();
      cuerpo.replaceChildren(...(lista ? this.mes() : this.semana(estados)));
      this.querySelector('[data-leyenda]')!.replaceChildren(...[...estados].map((e) => h('li', {}, (() => { const t = this.pieza('etiqueta-neutra'); t.querySelector('span')!.textContent = TEXTO[e]; return t; })())));
      this.fijarTabulable();
      const dias = this.datos.dias.filter((x: any) => !lista || x.fecha.slice(0, 7) === this.estado.fecha.slice(0, 7));
      const total = dias.reduce((s: number, x: any) => s + x.minutos_libres, 0);
      return `${capital(titulo)}: ${totalTexto(total)}.`;
    }

    texto(el: HTMLElement | null, t: string) {
      if (el) el.textContent = t;
      return el;
    }

    etiqueta(variante: string, texto: string) {
      const e = this.pieza(`etiqueta-${variante}`);
      e.querySelector('span')!.textContent = texto;
      return e;
    }

    // Texto de estado de una reserva con su etiqueta (Personal).
    // Con pago por validar, la etiqueta de estado se sustituye por PAGO POR VALIDAR (RN-23: la Pre-reservada no caduca ni avanza).
    estadoReserva(estado: string, porValidar = false) {
      if (porValidar) return this.etiqueta('aviso', 'PAGO POR VALIDAR');
      const [texto, variante] = ESTADOS_RESERVA[estado] ?? [estado, 'neutra'];
      return this.etiqueta(variante, texto);
    }

    semana(estados: Set<string>): HTMLElement[] {
      const { fecha, inicio } = this.estado;
      const duracion = +this.estado.duracion || 0;
      const lunes = lunesDeFecha(fecha);
      const dias = [...Array(7)].map((_, i) => sumarDias(lunes, i));
      const { estadoDe, maximo, franjas } = this.modelo;
      // Filas: de la primera hora de franja a la última de la semana.
      let min = 1440, fin = 0;
      for (const [a, b] of franjas as number[][]) {
        const f = fd(a);
        if (!dias.includes(f)) continue;
        min = Math.min(min, (a - inicioDia(f)) / 60e3);
        fin = Math.max(fin, Math.min(1440, (b - inicioDia(f)) / 60e3));
      }
      if (fin <= min) { min = 0; fin = 0; }
      min = Math.floor(min / 30) * 30;
      const filas = Math.ceil((fin - min) / 30);
      const inicioMs = inicio ? Date.parse(inicio) : NaN;
      const celdas = dias.map((f) => [...Array(filas)].map((_, r) => {
        const s = inicioDia(f) + (min + r * 30) * 60e3;
        const c: any = estadoDe(s);
        if (c) c.f = f, c.min = min + r * 30;
        if (c?.e === 'libre') {
          c.inicio = s === inicioMs;
          c.tramo = !c.inicio && s > inicioMs && s < inicioMs + duracion * 60e3;
        }
        return c;
      }));
      celdas.flat().forEach((c: any) => c && estados.add(c.e));
      const grid = this.modo === 'reserva';
      const hoy = hoyLima();
      const tabla = h('table', { class: 'cal-tabla cal-tabla-semana', role: grid ? 'grid' : null },
        h('caption', { class: 'visualmente-oculto' }, this.tituloPeriodo()),
        h('thead', {}, h('tr', {},
          h('th', { scope: 'col' }, h('span', { class: 'visualmente-oculto' }, 'Hora')),
          ...dias.map((f) => h('th', { scope: 'col', class: 'cal-cab', 'aria-current': f === hoy ? 'date' : null },
            h('span', { class: 'cal-dia' }, `${nombreDia(f).slice(0, 3).toUpperCase()} ${+f.slice(8)}`),
            h('span', { class: 'cal-libres' }, libresTexto(this.minutosLibres(f))))))),
        h('tbody', {}, ...[...Array(filas)].map((_, r) => h('tr', {},
          h('th', { scope: 'row', class: 'cal-hora' }, hm(inicioDia(dias[0]) + (min + r * 30) * 60e3)),
          ...dias.map((_, i) => {
            const c = celdas[i][r];
            if (!c) return h('td', { class: 'cal-celda cal-sin-franja' });
            if (UNIBLES.includes(c.e) && r > 0 && celdas[i][r - 1]?.clave === c.clave) return null;
            let largo = 1;
            if (UNIBLES.includes(c.e)) while (celdas[i][r + largo]?.clave === c.clave) largo++;
            return this.celda(c, i, largo, grid);
          })))));
      const lista = this.listaSemana(dias, celdas, fecha);
      this.maximo = maximo;
      return [tabla, lista];
    }

    maximo: any = null;

    nombreCelda(c: any, sufijo: string) {
      return `${largo(c.f)}, ${hm(c.s)}, ${sufijo}`;
    }

    // Datos de un bloque ocupado: de personal (cliente, servicio, estado) o propio del cliente (folio y enlace).
    reservaDe(c: any) {
      const o = this.datos.ocupados[c.oc];
      if (this.modo === 'personal' && o.detalle) {
        const x = o.detalle;
        return { href: `/app/reservas/detalle?id=${encodeURIComponent(x.id_reserva)}`, cliente: x.cliente?.nombre ?? x.cliente, servicio: x.servicio?.nombre ?? x.servicio, estado: x.estado, porValidar: x.pago_por_validar === true, horas: `${hm(Date.parse(o.inicio))} a ${hm(Date.parse(o.fin))}` };
      }
      const mia = this.propias[c.oc];
      return c.e === 'propio' ? { folio: mia?.folio, href: mia ? `/app/reservas/detalle?id=${encodeURIComponent(mia.id)}` : null, horas: mia ? `${hm(Date.parse(mia.inicio))} a ${hm(Date.parse(mia.fin))}` : `${hm(Date.parse(o.inicio))} a ${hm(Date.parse(o.fin))}` } : null;
    }

    // Contenido de un bloque unido, el mismo en la tabla y en la lista de días.
    contenidoBloque(c: any): HTMLElement[] {
      if (c.e === 'cerrado') return [this.pieza('icono-lock'), h('span', { class: 'cal-texto' }, 'CERRADO', h('span', { class: 'cal-motivo' }, this.datos.cierres[c.ci].motivo))];
      if (c.e === 'ocupado' || c.e === 'propio') {
        const r = this.reservaDe(c);
        if (this.modo === 'personal' && r?.cliente) {
          return [h('a', { class: 'cal-enlace', href: r.href },
            h('span', { class: 'visualmente-oculto' }, `${largo(c.f)}, ${r.horas}, `),
            h('span', { class: 'cal-cliente' }, r.cliente), h('span', { class: 'cal-servicio' }, r.servicio ?? ''), this.estadoReserva(r.estado, r.porValidar))];
        }
        if (c.e === 'propio') {
          const etiqueta = `TU RESERVA${r?.folio ? ` ${r.folio}` : ''}`;
          return [r?.href
            ? h('a', { class: 'cal-enlace', href: r.href, 'aria-label': `${largo(c.f)}, tu reserva ${r.folio}, ${r.horas}`, 'data-nav': this.modo === 'reserva' ? '' : null, 'data-dia': c.dia, 'data-min': c.min }, etiqueta)
            : h('span', { class: 'cal-texto' }, etiqueta)];
        }
        return [this.etiqueta('neutra', 'OCUPADO')];
      }
      return [h('span', { class: 'cal-texto' }, TEXTO[c.e])];
    }

    celda(c: any, dia: number, largo: number, grid: boolean) {
      c.dia = dia;
      if (c.e === 'libre') {
        if (!grid) return h('td', { class: 'cal-celda cal-celda-libre' }, h('span', { class: 'cal-texto' }, 'LIBRE'));
        return h('td', { class: 'cal-celda' }, this.botonLibre(c));
      }
      return h('td', { class: 'cal-celda', rowspan: largo > 1 ? largo : null, 'data-estado': c.e }, ...this.contenidoBloque(c));
    }

    botonLibre(c: any) {
      const { s } = c;
      const sufijo = c.inicio ? 'libre, inicio elegido' : c.tramo ? 'en tu selección' : 'libre';
      const contenido = c.inicio ? [this.pieza('icono-check'), 'INICIO'] : c.tramo ? (this.primeroDelTramo(c) ? ['TU SELECCIÓN'] : []) : ['LIBRE'];
      return h('button', {
        type: 'button', class: 'cal-boton', 'data-nav': '', 'data-dia': c.dia, 'data-min': c.min, 'data-inicio': new Date(s).toISOString(), 'data-ms': s,
        'data-estado': c.inicio ? 'inicio' : c.tramo ? 'tramo' : 'libre', 'aria-pressed': String(Boolean(c.inicio)), tabindex: -1,
        'aria-label': this.nombreCelda(c, sufijo),
      }, ...contenido);
    }

    // "Tu selección" solo en la primera celda del tramo que sigue al inicio.
    primeroDelTramo(c: any) {
      return c.s === Date.parse(this.estado.inicio) + MEDIA;
    }

    listaSemana(dias: string[], celdas: any[][], ancla: string) {
      const hoy = hoyLima();
      return h('ul', { class: 'cal-lista-dias' }, ...dias.map((f, i) => {
        const min = this.minutosLibres(f);
        const resumen = `${nombreDia(f).slice(0, 3).toUpperCase()} ${+f.slice(8)} ${diaMes(f).slice(-3).toUpperCase()}`;
        const titulo = `${resumen} · ${celdas[i].some(Boolean) ? libresTexto(min) : 'Sin horario'}`;
        const bloques: any[] = [];
        celdas[i].forEach((c: any, r: number) => {
          if (!c) return;
          const ant = bloques[bloques.length - 1];
          if (ant && ant.clave === c.clave && celdas[i][r - 1]) ant.celdas.push(c);
          else bloques.push({ clave: c.clave, e: c.e, celdas: [c] });
        });
        const conLibres = min > 0 || (this.modo === 'personal' && bloques.length > 0);
        const item = h('li', { class: 'cal-dia-item', 'aria-current': f === hoy ? 'date' : null });
        if (!conLibres) return (item.append(h('p', { class: 'cal-dia-texto' }, titulo)), item);
        const bloquesDom = bloques.map((b) => {
          const primero = b.celdas[0], ultimo = b.celdas[b.celdas.length - 1];
          const rango = `${hm(primero.s)}–${hm(ultimo.s + MEDIA)}`;
          if (b.e === 'libre') {
            return h('li', { class: 'cal-bloque' },
              h('p', { class: 'cal-texto' }, `${rango} · LIBRE`),
              this.modo === 'reserva' ? h('div', { class: 'cal-inicios' }, ...b.celdas.map((c: any) => { c.dia = i; const x = this.botonLibre(c); x.removeAttribute('tabindex'); x.removeAttribute('data-nav'); x.textContent = hm(c.s); if (c.inicio) x.prepend(this.pieza('icono-check')); return x; })) : null);
          }
          primero.dia = i;
          return h('li', { class: 'cal-bloque' }, h('p', { class: 'cal-texto' }, `${rango} · `, ...this.contenidoLista(primero)));
        });
        return (item.append(h('details', { open: this.modo === 'personal' || f === ancla ? true : null }, h('summary', {}, titulo), h('ul', { class: 'cal-bloques' }, ...bloquesDom))), item);
      }));
    }

    // En la lista de días el bloque va en una línea de texto: sin etiquetas Neutras ni el enlace con rowspan.
    contenidoLista(c: any): any[] {
      if (c.e === 'cerrado') return [`CERRADO · ${this.datos.cierres[c.ci].motivo}`];
      if (c.e === 'ocupado' || c.e === 'propio') {
        const contenido = this.contenidoBloque(c);
        const enlace = contenido.find((x) => x.tagName === 'A') as HTMLElement | undefined;
        if (enlace) { enlace.removeAttribute('data-nav'); return [enlace]; }
        return [c.e === 'propio' ? 'TU RESERVA' : 'OCUPADO'];
      }
      return [TEXTO[c.e]];
    }

    // --- Mes ---

    mes(): HTMLElement[] {
      const { fecha } = this.estado;
      const grid = h('tbody');
      const { desde } = this.rango();
      const hoy = hoyLima();
      const personal = this.modo === 'personal';
      const filas: HTMLElement[] = [];
      for (let w = 0; w < 6; w++) {
        const fila = h('tr');
        for (let i = 0; i < 7; i++) {
          const f = sumarDias(desde, w * 7 + i);
          const { corto, larga } = this.resumenDia(f);
          const reservas = personal ? this.datos.ocupados.filter((o: any) => o.detalle && fechaDe(o.inicio) === f).length : 0;
          const extra = reservas ? plural(reservas, 'reserva', 'reservas') : '';
          fila.append(h('td', { class: 'cal-celda-mes', 'data-fuera': f.slice(0, 7) !== fecha.slice(0, 7) ? '' : null },
            h('a', {
              class: 'cal-mes-dia', href: this.url({ ...this.estado, vista: 'semana', fecha: f }), 'data-periodo': 'dia', 'data-fecha': f, 'data-nav': '', 'data-i': w * 7 + i, tabindex: -1,
              'aria-current': f === hoy ? 'date' : null,
            },
              // El nombre sale del contenido (sin aria-label): el texto visible siempre está dentro de él (WCAG 2.5.3).
              h('span', { class: 'visualmente-oculto' }, `${nombreDia(f)} `),
              h('span', { class: 'cal-num' }, String(+f.slice(8))),
              h('span', { class: 'visualmente-oculto' }, ` de ${MESES[+f.slice(5, 7) - 1]}, `),
              h('span', { class: 'visualmente-oculto cal-largo' }, larga),
              h('span', { class: 'cal-corto', 'aria-hidden': 'true' }, corto),
              extra ? h('span', { class: 'cal-reservas' }, `, ${extra}`) : null,
              h('span', { class: 'visualmente-oculto' }, ', abrir semana'))));
        }
        filas.push(fila);
      }
      grid.append(...filas);
      const tabla = h('table', { class: 'cal-tabla cal-tabla-mes', role: 'grid' },
        h('caption', { class: 'visualmente-oculto' }, this.tituloPeriodo()),
        h('thead', {}, h('tr', {}, ...['LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB', 'DOM'].map((d) => h('th', { scope: 'col' }, d)))),
        grid);
      return [tabla];
    }

    // Resumen del día: "Cerrado" si un cierre cubre todas sus franjas; sin franjas, "Sin horario"; las horas salen de la API. `corto` es el de móvil.
    resumenDia(f: string) {
      const { estadoDe } = this.modelo;
      let total = 0, cerrado = 0;
      for (let m = 0; m < 1440; m += 30) {
        const e = estadoDe(inicioDia(f) + m * 60e3);
        if (!e) continue;
        total++;
        if (e.e === 'cerrado') cerrado++;
      }
      if (!total) return { larga: 'Sin horario', corto: '—' };
      if (cerrado === total) return { larga: 'Cerrado', corto: 'Cerrado' };
      const m = this.minutosLibres(f);
      return { larga: libresTexto(m), corto: m > 0 ? dur(m) : '0 h' };
    }

    // --- Lista (personal) ---

    pintarLista() {
      this.mostrar('lista');
      this.querySelector('[data-salida] .panel-titulo')!.textContent = this.tituloPeriodo();
      this.querySelector('[data-barra]')!.replaceChildren(...this.barra(this.vistasDisponibles()));
      this.querySelector('[data-salida] caption')!.textContent = `Reservas · ${this.tituloPeriodo()}`;
      const plantilla = this.querySelector<HTMLTemplateElement>('template[data-fila]')!;
      const ordenadas = [...this.reservas].sort((a, b) => a.inicio.localeCompare(b.inicio));
      this.querySelector('[data-salida] tbody')!.replaceChildren(...ordenadas.map((r) => {
        const fila = plantilla.content.cloneNode(true) as DocumentFragment;
        const x = fila.firstElementChild as HTMLElement;
        const a = Date.parse(r.inicio), b = Date.parse(r.fin);
        x.querySelector('[data-folio]')!.textContent = r.folio;
        x.querySelector('[data-fecha]')!.textContent = `${diaMes(fd(a))}, ${hm(a)}–${hm(b)}`;
        x.querySelector('[data-cliente]')!.textContent = r.cliente?.nombre ?? r.cliente ?? '';
        x.querySelector('[data-servicio]')!.textContent = r.servicio?.nombre ?? r.servicio ?? '';
        x.querySelector('[data-estado-reserva]')!.append(this.estadoReserva(r.estado));
        // En la lista, debajo de la etiqueta de estado.
        if (r.pago_por_validar === true) x.querySelector('[data-estado-reserva]')!.append(this.estadoReserva(r.estado, true));
        x.querySelector<HTMLAnchorElement>('[data-ver]')!.href = `/app/reservas/detalle?id=${encodeURIComponent(r.id)}`;
        x.querySelector('[data-objeto]')!.textContent = ` ${r.folio}`;
        // RF-18: "Marcar no asistió" solo entre inicio + tolerancia y el fin, en un estado que lo admite.
        const t = r.politica?.minutos_tolerancia_inasistencia;
        const ahora = Date.now();
        if (t != null && ['pre_reservada', 'confirmada', 'en_curso'].includes(r.estado) && ahora >= a + Number(t) * 60e3 && ahora < b) {
          const na = x.querySelector<HTMLAnchorElement>('[data-na]')!;
          na.hidden = false;
          na.href = `/app/reservas/detalle?id=${encodeURIComponent(r.id)}&accion=inasistencia`;
          x.querySelector('[data-objeto-na]')!.textContent = ` · ${r.folio}`;
        }
        return x;
      }));
      if (!ordenadas.length) {
        this.querySelector('[data-salida] .tabla')!.remove();
        this.querySelector<HTMLElement>('[data-sin-reservas]')!.hidden = false;
      }
    }

    // --- Teclado y foco itinerante (solo la cuadrícula del modo Reserva y el mes) ---

    cuadricula() {
      return this.querySelector('[data-salida] [role="grid"]:not([hidden])');
    }

    // Un solo tabindex="0": el inicio elegido, la primera media hora libre, o el día ancla en el mes.
    fijarTabulable() {
      const grid = this.cuadricula();
      if (!grid) return;
      const todos = [...grid.querySelectorAll<HTMLElement>('[data-nav]')];
      const elegido = todos.find((x) => x.getAttribute('aria-pressed') === 'true') ?? todos.find((x) => x.dataset.fecha === this.estado.fecha) ?? todos[0];
      todos.forEach((x) => (x.tabIndex = x === elegido ? 0 : -1));
    }

    mover(a: HTMLElement | undefined) {
      if (!a) return;
      this.querySelectorAll<HTMLElement>('[role="grid"] [tabindex="0"]').forEach((x) => (x.tabIndex = -1));
      a.tabIndex = 0;
      a.focus();
    }

    alTeclear(e: KeyboardEvent) {
      const el = (e.target as Element).closest<HTMLElement>('[role="grid"] [data-nav]');
      if (!el || e.ctrlKey || e.altKey || e.metaKey) return;
      const grid = el.closest('[role="grid"]')!;
      const todos = [...grid.querySelectorAll<HTMLElement>('[data-nav]')];
      const mes = grid.classList.contains('cal-tabla-mes');
      let destino: HTMLElement | undefined;
      const k = e.key;
      if (k === 'PageUp' || k === 'PageDown') {
        e.preventDefault();
        return this.ir({ fecha: this.desplazada(k === 'PageDown' ? 1 : -1) }, 'grid');
      }
      if (mes) {
        const i = todos.indexOf(el);
        const paso: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 };
        if (k in paso) destino = todos[i + paso[k]];
        else if (k === 'Home') destino = todos[i - (i % 7)];
        else if (k === 'End') destino = todos[i - (i % 7) + 6];
        else return;
      } else {
        const dia = +el.dataset.dia!, min = +el.dataset.min!;
        const delDia = (d: number) => todos.filter((x) => +x.dataset.dia! === d).sort((a, b) => +a.dataset.min! - +b.dataset.min!);
        const cercano = (d: number) => delDia(d).sort((a, b) => Math.abs(+a.dataset.min! - min) - Math.abs(+b.dataset.min! - min))[0];
        if (k === 'ArrowDown') destino = delDia(dia).find((x) => +x.dataset.min! > min);
        else if (k === 'ArrowUp') destino = delDia(dia).reverse().find((x) => +x.dataset.min! < min);
        else if (k === 'Home') destino = delDia(dia)[0];
        else if (k === 'End') destino = delDia(dia).at(-1);
        else if (k === 'ArrowRight' || k === 'ArrowLeft') {
          const paso = k === 'ArrowRight' ? 1 : -1;
          for (let d = dia + paso; d >= 0 && d < 7 && !destino; d += paso) destino = cercano(d);
        } else return;
      }
      e.preventDefault();
      this.mover(destino ?? el);
    }

    // --- Clics: periodo y vistas (enlaces que la isla intercepta) y elección del inicio ---

    alPulsar(e: Event) {
      const objetivo = e.target as Element;
      if (objetivo.closest('[data-reintentar]')) return void this.cargar(true);
      const boton = objetivo.closest<HTMLElement>('button[data-inicio]');
      if (boton) return this.elegir(boton);
      const enlace = objetivo.closest<HTMLAnchorElement>('a[data-periodo], a[data-vista]');
      if (!enlace || (e as MouseEvent).ctrlKey || (e as MouseEvent).metaKey || (e as MouseEvent).shiftKey) return;
      e.preventDefault();
      const destino = new URL(enlace.href);
      const p = destino.searchParams;
      this.ir({ vista: p.get('vista')!, fecha: p.get('fecha')! }, enlace.dataset.enlace ?? '');
    }

    // La pantalla anfitriona quita la eleccion (p. ej. el tramo ya no esta libre) y se recarga la semana.
    reiniciar() {
      this.estado.inicio = null;
      this.cargar();
    }

    elegir(boton: HTMLElement) {
      const inicio = boton.dataset.inicio!;
      const ms = Date.parse(inicio);
      const iso = `${fd(ms)}T${hm(ms)}:00-05:00`;
      this.estado.inicio = iso;
      const minutosMaximos = this.maximo(ms);
      this.pintar();
      const nuevo = [...this.querySelectorAll<HTMLElement>('button[data-inicio]')].find((x) => x.dataset.inicio === inicio && x.offsetParent !== null);
      this.mover(nuevo);
      this.querySelector('[data-anuncio]')!.textContent = `Inicio: ${nombreDia(fd(ms))} ${diaMes(fd(ms))}, ${hm(ms)}. Hasta ${dur(minutosMaximos)} disponibles.`;
      this.dispatchEvent(new CustomEvent('calendario-inicio', { bubbles: true, detail: { inicio: iso, minutosMaximos } }));
    }
  }

  if (!customElements.get('bugalu-calendario')) customElements.define('bugalu-calendario', BugaluCalendario);
</script>

