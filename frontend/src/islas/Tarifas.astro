---
import Panel from '../componentes/Panel.astro';
import Aviso from '../componentes/Aviso.astro';
import Boton from '../componentes/Boton.astro';
import Campo from '../componentes/Campo.astro';
import Casilla from '../componentes/Casilla.astro';
import Tabla from '../componentes/Tabla.astro';
import EtiquetaTecnica from '../componentes/EtiquetaTecnica.astro';
import CambioSensible from './CambioSensible.astro';
import EstadosIsla from '../componentes/internos/EstadosIsla.astro';
import EstilosGestion from '../componentes/internos/EstilosGestion.astro';

interface Props {
  vista: 'lista' | 'servicio' | 'especialista' | 'recargos' | 'impuestos';
}
const { vista } = Astro.props;
// Panel de la vista mientras carga o falla (codigos y titulos de la spec RF-02-tarifas).
const principal = { lista: { codigo: 'T1', titulo: 'Servicios' }, servicio: { codigo: 'S1', titulo: 'Servicio' }, especialista: { codigo: 'E1', titulo: 'Especialista' }, recargos: { codigo: 'R1', titulo: 'Recargos por horario' }, impuestos: { codigo: 'I1', titulo: 'IGV' } }[vista];
const aviso = 'Los cambios valen para las simulaciones y reservas nuevas; las ya hechas guardan su precio.';
const ayudaCambio = 'Si cambias un importe o un porcentaje, te mostraremos el impacto y te pediremos confirmarlo.';
const ayudaImporte = { inputmode: 'decimal', autocomplete: 'off' };
---

<EstilosGestion />

<!-- Un bloque por estado (estados-sistema): la isla clona el que toca. Sin JS, el noscript oculta la carga y avisa. -->
<bugalu-tarifas class="tarifas" data-gestion vista={vista}>
  <div data-avisos></div>
  <!-- Region viva estable, presente antes de cualquier texto: anuncia cada carga y resultado una sola vez. -->
  <p class="visualmente-oculto" role="status" data-anuncio></p>
  <div data-salida><Panel {...principal} cargando /></div>
  <CambioSensible />

  <EstadosIsla principal={principal} noEncontrada={vista === 'servicio' || vista === 'especialista' ? { etiqueta: 'Volver a tarifas', href: '/app/tarifas' } : undefined} />

  <template data-sello="neutra"><EtiquetaTecnica texto=" " /></template>
  <template data-sello="exito"><EtiquetaTecnica variante="exito" texto=" " /></template>

  {vista === 'lista' && (
    <>
      <template data-estado="datos">
        <div class="gestion-principal">
          <Panel codigo="T1" titulo="Servicios">
            <div data-vacio="servicios" hidden>
              <p class="gestion-vacio-titulo">Aún no hay servicios cargados.</p>
              <p>Se cargan con la base de datos inicial; avisa al equipo técnico.</p>
            </div>
            <Tabla titulo="Servicios" columnas={['Servicio', 'Categoría', 'Ocupa sala', 'Tarifa por hora', 'Monto fijo', 'Por defecto', 'Estado', '']} numericas={[3, 4]} />
          </Panel>
          <Panel codigo="T2" titulo="Especialistas">
            <div data-vacio="especialistas" hidden>
              <p class="gestion-vacio-titulo">Aún no hay especialistas cargados.</p>
              <p>Se cargan con la base de datos inicial; avisa al equipo técnico.</p>
            </div>
            <Tabla titulo="Especialistas" columnas={['Especialista', 'Monto fijo', 'Monto variable', 'Unidad', 'Estado', '']} numericas={[1, 2]} />
          </Panel>
        </div>
      </template>
      <template data-fila-servicio>
        <tr>
          <th scope="row" data-nombre></th>
          <td data-etiqueta="Categoría" data-categoria></td>
          <td data-etiqueta="Ocupa sala" data-ocupa></td>
          <td class="tabla-num" data-etiqueta="Tarifa por hora" data-tarifa></td>
          <td class="tabla-num" data-etiqueta="Monto fijo" data-fijo></td>
          <td data-etiqueta="Por defecto" data-defecto></td>
          <td data-etiqueta="Estado" data-activo></td>
          <td><Boton variante="secundario" href="#" data-editar>Editar<span class="visualmente-oculto" data-objeto></span></Boton></td>
        </tr>
      </template>
      <template data-fila-especialista>
        <tr>
          <th scope="row" data-nombre></th>
          <td class="tabla-num" data-etiqueta="Monto fijo" data-fijo></td>
          <td class="tabla-num" data-etiqueta="Monto variable" data-variable></td>
          <td data-etiqueta="Unidad" data-unidad></td>
          <td data-etiqueta="Estado" data-activo></td>
          <td><Boton variante="secundario" href="#" data-editar>Editar<span class="visualmente-oculto" data-objeto></span></Boton></td>
        </tr>
      </template>
    </>
  )}

  {vista === 'servicio' && (
    <>
      <template data-estado="datos">
        <div class="gestion-rejilla">
          <Panel codigo="S1" titulo="Servicio">
            <dl class="gestion-datos">
              <div><dt>Nombre</dt><dd data-campo="nombre"></dd></div>
              <div><dt>Categoría</dt><dd data-campo="categoria"></dd></div>
              <div><dt>Ocupa sala</dt><dd data-campo="ocupa_sala"></dd></div>
            </dl>
          </Panel>
          <div class="gestion-lateral">
            <Panel codigo="S2" titulo="Tarifa" variante="lateral">
              <form novalidate method="post" class="gestion-formulario" data-formulario="servicio">
                <Aviso titulo={aviso} />
                <Campo nombre="tarifa_hora" etiqueta="Tarifa por hora (S/)" obligatorio {...ayudaImporte} />
                <Campo nombre="monto_fijo" etiqueta="Monto fijo (S/)" ayuda="Se cobra una vez por reserva." obligatorio {...ayudaImporte} />
                <fieldset class="gestion-grupo">
                  <legend>Especialistas por defecto</legend>
                  <p class="gestion-ayuda">Van incluidos y el cliente no puede quitarlos.</p>
                  <div class="gestion-grupo" data-especialistas></div>
                </fieldset>
                <Casilla nombre="activo" etiqueta="Activo" detalle="Si lo desactivas, deja de ofrecerse al reservar." />
                <div><Boton tipo="submit" data-envio>Guardar servicio</Boton><p class="gestion-ayuda">{ayudaCambio}</p></div>
              </form>
            </Panel>
          </div>
        </div>
      </template>
      <template data-casilla-especialista><Casilla nombre="especialistas_por_defecto" etiqueta=" " valor="" /></template>
    </>
  )}

  {vista === 'especialista' && (
    <template data-estado="datos">
      <div class="gestion-rejilla">
        <Panel codigo="E1" titulo="Especialista">
          <dl class="gestion-datos">
            <div><dt>Nombre</dt><dd data-campo="nombre"></dd></div>
          </dl>
        </Panel>
        <div class="gestion-lateral">
          <Panel codigo="E2" titulo="Tarifa" variante="lateral">
            <form novalidate method="post" class="gestion-formulario" data-formulario="especialista">
              <Aviso titulo={aviso} />
              <div class="gestion-fila-campos">
                <Campo nombre="monto_fijo" etiqueta="Monto fijo (S/)" ayuda="Se cobra una vez por reserva." obligatorio {...ayudaImporte} />
                <Campo nombre="monto_variable" etiqueta="Monto variable (S/)" ayuda="Se cobra por cada hora o media hora de la reserva, según la unidad." obligatorio {...ayudaImporte} />
              </div>
              <fieldset class="gestion-grupo">
                <legend>Unidad</legend>
                <Casilla tipo="radio" nombre="unidad" valor="hora" etiqueta="Por hora" />
                <Casilla tipo="radio" nombre="unidad" valor="lapso_30" etiqueta="Por media hora" />
              </fieldset>
              <Casilla nombre="activo" etiqueta="Activo" />
              <div><Boton tipo="submit" data-envio>Guardar especialista</Boton><p class="gestion-ayuda">{ayudaCambio}</p></div>
            </form>
          </Panel>
        </div>
      </div>
    </template>
  )}

  {vista === 'impuestos' && (
    <template data-estado="datos">
      <div class="gestion-rejilla">
        <Panel codigo="I1" titulo="IGV">
          <form novalidate method="post" class="gestion-formulario" data-formulario="impuestos">
            <Campo tipo="number" nombre="porcentaje_igv" etiqueta="Porcentaje de IGV (%)" obligatorio min="0" max="99.99" step="0.01" />
            <fieldset class="gestion-grupo">
              <legend>Los precios incluyen IGV</legend>
              <Casilla tipo="radio" nombre="precios_incluyen_igv" valor="si" etiqueta="Sí" detalle="El cliente ve el total; el IGV va desglosado dentro." />
              <Casilla tipo="radio" nombre="precios_incluyen_igv" valor="no" etiqueta="No" detalle="Las tarifas son netas y el total suma el IGV." />
            </fieldset>
            <div><Boton tipo="submit" data-envio>Revisar cambio</Boton><p class="gestion-ayuda">Te mostraremos el impacto y te pediremos confirmarlo.</p></div>
          </form>
        </Panel>
        <div class="gestion-lateral">
          <Panel codigo="I2" titulo="Cómo se muestra" variante="lateral">
            <p>Con IGV incluido, un total de S/ 150,00 al 18 % se muestra con base S/ 127,12 e IGV S/ 22,88. Los comprobantes se emiten fuera de la app.</p>
          </Panel>
        </div>
      </div>
    </template>
  )}

  {vista === 'recargos' && (
    <>
      <template data-estado="datos">
        <div class="gestion-rejilla">
          <Panel codigo="R1" titulo="Recargos por horario">
            <form novalidate method="post" class="gestion-formulario" data-formulario="recargos">
              <p class="gestion-ayuda">Se aplica a la parte variable de cada media hora que cae en ese horario, nunca al monto fijo.</p>
              <fieldset class="gestion-grupo">
                <legend>Noche</legend>
                <div class="gestion-fila-campos">
                  <Campo tipo="number" nombre="noche_porcentaje" etiqueta="Recargo (%)" obligatorio min="0" step="0.01" />
                  <Campo tipo="time" nombre="noche_desde" etiqueta="Desde" obligatorio step="1800" />
                  <Campo tipo="time" nombre="noche_hasta" etiqueta="Hasta" obligatorio step="1800" />
                </div>
                <p class="gestion-ayuda">Puede pasar la medianoche: de 22:00 a 06:00.</p>
              </fieldset>
              <fieldset class="gestion-grupo">
                <legend>Fin de semana</legend>
                <Campo tipo="number" nombre="fin_de_semana_porcentaje" etiqueta="Recargo (%)" obligatorio min="0" step="0.01" />
              </fieldset>
              <fieldset class="gestion-grupo">
                <legend>Feriado</legend>
                <Campo tipo="number" nombre="feriado_porcentaje" etiqueta="Recargo (%)" obligatorio min="0" step="0.01" />
              </fieldset>
              <div><Boton tipo="submit" data-envio>Guardar recargos</Boton><p class="gestion-ayuda">{ayudaCambio}</p></div>
            </form>
          </Panel>
          <div class="gestion-lateral">
            <Panel codigo="R2" titulo="Feriados" variante="lateral">
              <nav class="gestion-periodo" aria-label="Año de los feriados" data-anios>
                <EtiquetaTecnica variante="filtro" texto="0000" href="#" />
                <EtiquetaTecnica variante="filtro" texto="0000" href="#" />
              </nav>
              <p data-vacio="feriados" hidden></p>
              <Tabla titulo="Feriados" columnas={['Fecha', 'Nombre', '']} variante="compacta" />
              <form novalidate method="post" class="gestion-formulario" data-formulario="feriado">
                <Campo tipo="date" nombre="feriado-fecha" etiqueta="Fecha" obligatorio />
                <Campo nombre="feriado-nombre" etiqueta="Nombre" obligatorio />
                <div><Boton tipo="submit" variante="secundario" data-envio>Añadir feriado</Boton></div>
              </form>
            </Panel>
          </div>
        </div>
      </template>
      <template data-fila-feriado>
        <tr>
          <th scope="row" data-fecha></th>
          <td data-etiqueta="Nombre" data-nombre></td>
          <td><Boton variante="secundario" data-envio data-quitar-feriado>Quitar feriado<span class="visualmente-oculto" data-objeto></span></Boton></td>
        </tr>
      </template>
    </>
  )}
</bugalu-tarifas>

<script>
  // @ts-nocheck
  import { IslaGestion } from '../servicios/isla-gestion.js';
  import { listarServicios, actualizarServicio, listarEspecialistas, actualizarEspecialista, obtenerRecargos, guardarRecargos, obtenerImpuestos, previsualizarCambio, listarFeriados, crearFeriado, quitarFeriado } from '../servicios/catalogo.js';
  import { leerImporte, mostrarImporte, porcentaje, soles, hoyLima, esFecha, diaMes, diaMesAnio } from '../servicios/formatos.js';
  import { mostrarAviso, enfocarAviso, quitarError, limpiarAvisos } from '../servicios/formulario.js';

  const categorias = { grabacion: 'GRABACIÓN', ensayo: 'ENSAYO', live: 'LIVE', posproduccion: 'POSPRODUCCIÓN' };
  const unidades = { hora: 'por hora', lapso_30: 'por media hora' };
  const ERROR_IGV = 'Escribe un porcentaje de 0 a 99,99, con hasta dos decimales.';
  const plural = (n, uno, varios) => `${n} ${n === 1 ? uno : varios}`;
  const ERROR_IMPORTE = 'Escribe un importe de 0 o más, con hasta dos decimales, como 120,50.';
  const ERROR_PORCENTAJE = 'Escribe un porcentaje de 0 o más.';

  class BugaluTarifas extends IslaGestion {
    avisosUrl = {
      'servicio-actualizado': ['Servicio actualizado', 'El precio nuevo se aplica a las simulaciones y reservas desde ahora.'],
      'especialista-actualizado': ['Especialista actualizado', 'El precio nuevo se aplica a las simulaciones y reservas desde ahora.'],
    };

    iniciar() {
      this.registro = new URLSearchParams(location.search).get('id') ?? '';
      this.noEncontrada = [this.vista === 'servicio' ? 'No encontramos este servicio.' : 'No encontramos este especialista.'];
      this.addEventListener('click', (e) => {
        const boton = e.target.closest('[data-quitar-feriado]');
        if (boton) this.quitarElFeriado(boton);
      });
    }

    alEnviar(formulario) {
      const accion = formulario.dataset.formulario;
      if (accion === 'servicio') this.guardarServicio(formulario);
      else if (accion === 'especialista') this.guardarEspecialista(formulario);
      else if (accion === 'recargos') this.guardarRecargos(formulario);
      else if (accion === 'impuestos') this.guardarImpuestos(formulario);
      else this.anadirFeriado(formulario);
    }

    errorEnvio(error) {
      // Red de seguridad: el backend exige la revision aunque la isla no haya detectado un campo sensible.
      if (error.estado === 428 && error.codigo === 'confirmacion_requerida' && this.ctx) this.revisar(this.ctx);
      else if (error.estado === 404 && this.registro) this.sustituir('no-encontrada');
      else if (error.estado === 422 && error.codigo === 'sin_cambios') enfocarAviso(mostrarAviso(this, 'informacion', 'Ya tiene esos valores. No hay nada que cambiar.'));
      else if (error.estado === 409) this.errorCampo(this.querySelector('[name="feriado-fecha"]'), 'Ya hay un feriado en esa fecha.');
      else if (error.estado === 422 && error.detalles?.campo && this.querySelector(`[name="${error.detalles.campo.replace('.', '_')}"]`)) {
        const entrada = this.querySelector(`[name="${error.detalles.campo.replace('.', '_')}"]`);
        this.errorCampo(entrada, entrada.type === 'text' ? ERROR_IMPORTE : this.vista === 'impuestos' ? ERROR_IGV : ERROR_PORCENTAJE);
      } else return false;
      return true;
    }

    errorCampo(entrada, mensaje) {
      this.validar([{ entrada, mensaje, texto: this.etiqueta(entrada) }]);
    }

    sello(tipo, texto) {
      const nodo = this.querySelector(`template[data-sello="${tipo}"]`).content.cloneNode(true);
      nodo.querySelector('.etiqueta > span:last-child').textContent = texto;
      return nodo;
    }

    selloActivo = (activo) => this.sello(activo ? 'exito' : 'neutra', activo ? 'ACTIVO' : 'INACTIVO');

    // Filas de una tabla desde una plantilla; `vacio` explica cuando no hay nada.
    llenarTabla(clave, plantilla, registros, llenar) {
      const vacio = this.querySelector(`[data-vacio="${clave}"]`);
      const tabla = vacio.nextElementSibling;
      vacio.hidden = registros.length > 0;
      tabla.hidden = registros.length === 0;
      const modelo = this.querySelector(`template[${plantilla}]`);
      tabla.querySelector('tbody').replaceChildren(...registros.map((r) => {
        const fila = modelo.content.cloneNode(true).firstElementChild;
        llenar(fila, r);
        return fila;
      }));
    }

    // --- Cambios sensibles (RF-20): vista previa, revision en <bugalu-cambio-sensible> y, al confirmar, lo no sensible ---

    // ctx: {formulario, peticion, resto?: () => Promise, restoNombre?, exito(resultado)}
    revisar(ctx) {
      this.ctx = ctx;
      const boton = ctx.formulario.querySelector('[data-envio]');
      this.enviar(boton, 'Calculando impacto…', () => previsualizarCambio(ctx.peticion), (previa) => this.abrirRevision(previa, ctx, boton));
    }

    async abrirRevision(previa, ctx, boton) {
      const salida = this.querySelector('[data-salida]');
      salida.hidden = true;
      limpiarAvisos(this);
      const r = await this.querySelector('bugalu-cambio-sensible').abrir(previa, ctx.peticion);
      salida.hidden = false;
      if (r.estado === 'cancelado') {
        mostrarAviso(this, 'informacion', 'No se aplicó ningún cambio.');
        boton.focus();
      } else if (r.estado === 'volver') {
        if (r.recargar) await this.cargar();
        enfocarAviso(mostrarAviso(this, r.aviso[0], r.aviso[1], r.aviso[2]));
      } else if (ctx.resto) {
        try {
          await ctx.resto();
        } catch {
          await this.cargar();
          return enfocarAviso(mostrarAviso(this, 'error', `La tarifa se cambió, pero no pudimos guardar ${ctx.restoNombre}`, 'Vuelve a guardar.'));
        }
        await ctx.exito(r.resultado);
      } else await ctx.exito(r.resultado);
    }

    // --- Lista ---

    async lista() {
      const [servicios, especialistas] = await Promise.all([listarServicios(), listarEspecialistas()]);
      const nombres = new Map(especialistas.map((e) => [e.id, e.nombre]));
      this.mostrar('datos');
      this.llenarTabla('servicios', 'data-fila-servicio', servicios, (fila, s) => {
        fila.querySelector('[data-nombre]').textContent = s.nombre;
        fila.querySelector('[data-categoria]').append(this.sello('neutra', categorias[s.categoria] ?? String(s.categoria).toUpperCase()));
        fila.querySelector('[data-ocupa]').textContent = s.ocupa_sala ? 'Sí' : 'No (va por proyecto)';
        fila.querySelector('[data-tarifa]').textContent = soles(s.tarifa_hora);
        fila.querySelector('[data-fijo]').textContent = soles(s.monto_fijo);
        fila.querySelector('[data-defecto]').textContent = s.especialistas_por_defecto.map((id) => nombres.get(id)).filter(Boolean).join(', ') || '—';
        fila.querySelector('[data-activo]').append(this.selloActivo(s.activo));
        fila.querySelector('[data-editar]').href = `/app/tarifas/servicio?id=${encodeURIComponent(s.id)}`;
        fila.querySelector('[data-objeto]').textContent = ` ${s.nombre}`;
      });
      this.llenarTabla('especialistas', 'data-fila-especialista', especialistas, (fila, e) => {
        fila.querySelector('[data-nombre]').textContent = e.nombre;
        fila.querySelector('[data-fijo]').textContent = soles(e.monto_fijo);
        fila.querySelector('[data-variable]').textContent = soles(e.monto_variable);
        fila.querySelector('[data-unidad]').textContent = unidades[e.unidad] ?? e.unidad;
        fila.querySelector('[data-activo]').append(this.selloActivo(e.activo));
        fila.querySelector('[data-editar]').href = `/app/tarifas/especialista?id=${encodeURIComponent(e.id)}`;
        fila.querySelector('[data-objeto]').textContent = ` ${e.nombre}`;
      });
      return `${plural(servicios.length, 'servicio', 'servicios')} y ${plural(especialistas.length, 'especialista', 'especialistas')}`;
    }

    // --- Servicio ---

    async servicio() {
      const [servicios, especialistas] = await Promise.all([listarServicios(), listarEspecialistas()]);
      const s = servicios.find((x) => x.id === this.registro);
      if (!s) return this.mostrar('no-encontrada');
      this.cargado = s;
      this.mostrar('datos');
      this.querySelector('[data-campo="nombre"]').textContent = s.nombre;
      this.querySelector('[data-campo="categoria"]').textContent = categorias[s.categoria] ?? s.categoria;
      this.querySelector('[data-campo="ocupa_sala"]').textContent = s.ocupa_sala ? 'Sí' : 'No (va por proyecto)';
      this.querySelector('[name="tarifa_hora"]').value = mostrarImporte(s.tarifa_hora);
      this.querySelector('[name="monto_fijo"]').value = mostrarImporte(s.monto_fijo);
      this.querySelector('[name="activo"]').checked = s.activo;
      const modelo = this.querySelector('template[data-casilla-especialista]');
      this.querySelector('[data-especialistas]').replaceChildren(...especialistas.map((e) => {
        const casilla = modelo.content.cloneNode(true);
        casilla.querySelector('.casilla-etiqueta').textContent = e.nombre;
        const entrada = casilla.querySelector('input');
        entrada.value = e.id;
        entrada.checked = s.especialistas_por_defecto.includes(e.id);
        return casilla;
      }));
      this.encabezado(`Tarifa por hora y quién va incluido en ${s.nombre}.`, s.nombre);
      return `Servicio ${s.nombre}`;
    }

    // Lee importes del formulario: devuelve {valores, errores}.
    importes(formulario, nombres) {
      const valores = {};
      const errores = [];
      for (const nombre of nombres) {
        const entrada = formulario.querySelector(`[name="${nombre}"]`);
        quitarError(entrada);
        valores[nombre] = leerImporte(entrada.value);
        if (valores[nombre] === null) errores.push({ entrada, mensaje: ERROR_IMPORTE, texto: this.etiqueta(entrada) });
      }
      return { valores, errores };
    }

    guardarServicio(formulario) {
      if (this.ocupado) return;
      const { valores, errores } = this.importes(formulario, ['tarifa_hora', 'monto_fijo']);
      if (!this.validar(errores)) return;
      const s = this.cargado;
      const boton = formulario.querySelector('[data-envio]');
      const activo = formulario.querySelector('[name="activo"]').checked;
      const defecto = [...formulario.querySelectorAll('[name="especialistas_por_defecto"]:checked')].map((c) => c.value);
      const cambios = { tarifa_hora: valores.tarifa_hora, monto_fijo: valores.monto_fijo };
      const sensible = cambios.tarifa_hora !== leerImporte(s.tarifa_hora) || cambios.monto_fijo !== leerImporte(s.monto_fijo);
      const nombres = [activo !== s.activo && 'Activo', [...defecto].sort().join() !== [...s.especialistas_por_defecto].sort().join() && 'Especialistas por defecto'].filter(Boolean);
      const exito = () => location.assign('/app/tarifas?aviso=servicio-actualizado');
      this.ctx = { formulario, peticion: { recurso: 'servicio', id_recurso: this.registro, cambios }, resto: nombres.length ? () => actualizarServicio(this.registro, { activo, especialistas_por_defecto: defecto }) : null, restoNombre: nombres.join(' / '), exito };
      if (sensible) return this.revisar(this.ctx);
      this.enviar(boton, 'Guardando…', () => actualizarServicio(this.registro, { ...cambios, activo, especialistas_por_defecto: defecto }), exito, true);
    }

    // --- Especialista ---

    async especialista() {
      const e = (await listarEspecialistas()).find((x) => x.id === this.registro);
      if (!e) return this.mostrar('no-encontrada');
      this.cargado = e;
      this.mostrar('datos');
      this.querySelector('[data-campo="nombre"]').textContent = e.nombre;
      this.querySelector('[name="monto_fijo"]').value = mostrarImporte(e.monto_fijo);
      this.querySelector('[name="monto_variable"]').value = mostrarImporte(e.monto_variable);
      const unidad = this.querySelector(`[name="unidad"][value="${e.unidad === 'lapso_30' ? 'lapso_30' : 'hora'}"]`);
      unidad.checked = true;
      this.querySelector('[name="activo"]').checked = e.activo;
      this.encabezado(`Cuánto suma ${e.nombre} a cada reserva.`, e.nombre);
      return `Especialista ${e.nombre}`;
    }

    guardarEspecialista(formulario) {
      if (this.ocupado) return;
      const { valores, errores } = this.importes(formulario, ['monto_fijo', 'monto_variable']);
      if (!this.validar(errores)) return;
      const e = this.cargado;
      const activo = formulario.querySelector('[name="activo"]').checked;
      const cambios = { ...valores, unidad: formulario.querySelector('[name="unidad"]:checked').value };
      const sensible = cambios.monto_fijo !== leerImporte(e.monto_fijo) || cambios.monto_variable !== leerImporte(e.monto_variable) || cambios.unidad !== e.unidad;
      const exito = () => location.assign('/app/tarifas?aviso=especialista-actualizado');
      this.ctx = { formulario, peticion: { recurso: 'especialista', id_recurso: this.registro, cambios }, resto: activo !== e.activo ? () => actualizarEspecialista(this.registro, { activo }) : null, restoNombre: 'Activo', exito };
      if (sensible) return this.revisar(this.ctx);
      this.enviar(formulario.querySelector('[data-envio]'), 'Guardando…', () => actualizarEspecialista(this.registro, { ...cambios, activo }), exito, true);
    }

    // --- Recargos y feriados ---

    get anio() {
      const pedido = new URLSearchParams(location.search).get('anio');
      return /^\d{4}$/.test(pedido ?? '') && pedido >= 2000 && pedido <= 2100 ? pedido : hoyLima().slice(0, 4);
    }

    async recargos() {
      const [r, feriados] = await Promise.all([obtenerRecargos(), listarFeriados(this.anio)]);
      this.cargado = r;
      this.mostrar('datos');
      const poner = (nombre, valor) => (this.querySelector(`[name="${nombre}"]`).value = valor);
      poner('noche_porcentaje', Number(r.noche.porcentaje));
      poner('noche_desde', r.noche.desde);
      poner('noche_hasta', r.noche.hasta);
      poner('fin_de_semana_porcentaje', Number(r.fin_de_semana.porcentaje));
      poner('feriado_porcentaje', Number(r.feriado.porcentaje));
      const anio = Number(this.anio);
      const [anterior, siguiente] = this.querySelectorAll('[data-anios] a');
      anterior.href = `/app/tarifas/recargos?anio=${anio - 1}`;
      anterior.querySelector('span').textContent = String(anio - 1);
      siguiente.href = `/app/tarifas/recargos?anio=${anio + 1}`;
      siguiente.querySelector('span').textContent = String(anio + 1);
      this.querySelector('.panel-lateral .panel-titulo').append(` ${anio}`);
      this.pintarFeriados(feriados);
      return `Recargos y ${plural(feriados.length, 'feriado', 'feriados')} de ${anio}`;
    }

    pintarFeriados(feriados) {
      this.querySelector('[data-vacio="feriados"]').textContent = `No hay feriados en ${this.anio}.`;
      this.querySelector('[data-vacio="feriados"]').nextElementSibling.querySelector('caption').textContent = `Feriados ${this.anio}`;
      this.llenarTabla('feriados', 'data-fila-feriado', [...feriados].sort((a, b) => a.fecha.localeCompare(b.fecha)), (fila, f) => {
        fila.querySelector('[data-fecha]').textContent = diaMesAnio(f.fecha);
        fila.querySelector('[data-nombre]').textContent = f.nombre;
        fila.querySelector('[data-quitar-feriado]').dataset.fecha = f.fecha;
        fila.querySelector('[data-objeto]').textContent = ` del ${diaMes(f.fecha)}`;
      });
    }

    guardarRecargos(formulario) {
      if (this.ocupado) return;
      const campo = (nombre) => formulario.querySelector(`[name="${nombre}"]`);
      const errores = [];
      const porcentaje = (nombre) => {
        const entrada = campo(nombre);
        quitarError(entrada);
        const valor = leerImporte(entrada.value);
        if (valor === null) errores.push({ entrada, mensaje: ERROR_PORCENTAJE, texto: `${entrada.closest('fieldset').querySelector('legend').textContent} · ${this.etiqueta(entrada)}` });
        return valor;
      };
      const hora = (nombre) => {
        const entrada = campo(nombre);
        quitarError(entrada);
        if (!entrada.value) errores.push({ entrada, mensaje: 'Elige la hora.', texto: `Noche · ${this.etiqueta(entrada)}` });
        return entrada.value;
      };
      const cuerpo = {
        noche: { porcentaje: porcentaje('noche_porcentaje'), desde: hora('noche_desde'), hasta: hora('noche_hasta') },
        fin_de_semana: { porcentaje: porcentaje('fin_de_semana_porcentaje') },
        feriado: { porcentaje: porcentaje('feriado_porcentaje') },
      };
      if (!this.validar(errores)) return;
      const r = this.cargado;
      const hh = (t) => String(t).slice(0, 5);
      const sensible = cuerpo.noche.porcentaje !== leerImporte(r.noche.porcentaje) || hh(cuerpo.noche.desde) !== hh(r.noche.desde) || hh(cuerpo.noche.hasta) !== hh(r.noche.hasta)
        || cuerpo.fin_de_semana.porcentaje !== leerImporte(r.fin_de_semana.porcentaje) || cuerpo.feriado.porcentaje !== leerImporte(r.feriado.porcentaje);
      this.ctx = { formulario, peticion: { recurso: 'recargos', cambios: cuerpo }, exito: async () => { await this.cargar(); this.avisar('Recargos guardados.', '', 'recargos'); } };
      if (sensible) return this.revisar(this.ctx);
      this.enviar(formulario.querySelector('[data-envio]'), 'Guardando…', () => guardarRecargos(cuerpo), () => this.avisar('Recargos guardados.'));
    }

    // `recurso`: tras un cambio con revision, ofrece el registro de cambios de ese recurso.
    avisar(titulo, texto = '', recurso) {
      enfocarAviso(mostrarAviso(this, 'exito', titulo, texto, recurso && { enlace: { texto: 'Ver en el registro de cambios', href: `/app/cambios?recurso=${recurso}` } }));
    }

    // --- Impuestos ---

    async impuestos() {
      const i = await obtenerImpuestos();
      this.cargado = i;
      this.mostrar('datos');
      this.querySelector('[name="porcentaje_igv"]').value = Number(i.porcentaje_igv);
      this.querySelector(`[name="precios_incluyen_igv"][value="${i.precios_incluyen_igv ? 'si' : 'no'}"]`).checked = true;
      return `IGV al ${porcentaje(i.porcentaje_igv)}`;
    }

    guardarImpuestos(formulario) {
      if (this.ocupado) return;
      const entrada = formulario.querySelector('[name="porcentaje_igv"]');
      quitarError(entrada);
      const valor = leerImporte(entrada.value);
      if (valor === null || Number(valor) > 99.99) return this.validar([{ entrada, mensaje: ERROR_IGV, texto: this.etiqueta(entrada) }]);
      this.validar([]);
      const cambios = { porcentaje_igv: valor, precios_incluyen_igv: formulario.querySelector('[name="precios_incluyen_igv"]:checked').value === 'si' };
      this.revisar({ formulario, peticion: { recurso: 'impuestos', cambios }, exito: async () => { await this.cargar(); this.avisar('IGV actualizado', 'Rige para las simulaciones y reservas nuevas.', 'impuestos'); } });
    }

    async recargarFeriados(aviso) {
      this.pintarFeriados(await listarFeriados(this.anio));
      this.avisar(aviso);
    }

    anadirFeriado(formulario) {
      if (this.ocupado) return;
      const fecha = formulario.querySelector('[name="feriado-fecha"]');
      const nombre = formulario.querySelector('[name="feriado-nombre"]');
      [fecha, nombre].forEach(quitarError);
      const errores = [];
      if (!esFecha(fecha.value)) errores.push({ entrada: fecha, mensaje: 'Elige la fecha.', texto: 'Fecha' });
      if (!nombre.value.trim()) errores.push({ entrada: nombre, mensaje: 'Escribe el nombre del feriado.', texto: 'Nombre' });
      if (!this.validar(errores)) return;
      this.enviar(formulario.querySelector('[data-envio]'), 'Añadiendo…', () => crearFeriado({ fecha: fecha.value, nombre: nombre.value.trim() }), async () => {
        await this.recargarFeriados('Feriado añadido.');
        fecha.value = '';
        nombre.value = '';
      });
    }

    quitarElFeriado(boton) {
      this.enviar(boton, 'Quitando…', () => quitarFeriado(boton.dataset.fecha), () => this.recargarFeriados('Feriado quitado.'));
    }
  }

  if (!customElements.get('bugalu-tarifas')) customElements.define('bugalu-tarifas', BugaluTarifas);
</script>

<style>
  .tarifas {
    display: block;
  }
  .tarifas :global([data-avisos]:not(:empty)) {
    margin-block-end: var(--espacio-4);
  }
</style>
