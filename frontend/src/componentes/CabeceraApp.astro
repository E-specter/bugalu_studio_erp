---
import LogoApilado from '../assets/logo-apilado.svg';
import LogoIcono from '../assets/logo-icono.svg';
import Icono from './internos/Icono.astro';

interface Props {
  variante?: 'estudio' | 'portal' | 'flujo';
  producto: string;
  area?: string;
  usuario?: string;
  neutro?: boolean; // rol aún sin cargar: área vacía y oculta (el layout la muestra al conocer el rol)
}
const { variante = 'estudio', producto, area, usuario, neutro = false, class: clase } = Astro.props as Props & { class?: string };
const conContexto = Astro.slots.has('contexto');
const conMenu = Boolean(usuario) || Astro.slots.has('menu');
---

<header class:list={['cabecera', `cabecera-${variante}`, clase]}>
  <!-- Fila 1: en móvil y tableta es la parte fija (sticky) de la cabecera. -->
  <div class="cabecera-fija">
    <a class="cabecera-marca" href={variante === 'flujo' ? '/' : '/app/'}>
      <!-- logotipo.md: el icono en móvil (el apilado quedaría bajo medida-logo-min); el apilado desde escritorio. -->
      <span class="cabecera-placa"><LogoIcono class="logo-movil" aria-hidden="true" /><LogoApilado class="logo-escritorio" aria-hidden="true" /></span>
      <span class="cabecera-nombre">
        <span class="cabecera-producto">{producto}</span>
        {area && <span class="cabecera-area" data-area data-neutro={neutro ? '' : undefined}>{neutro ? '' : area}</span>}
      </span>
    </a>
    {conMenu && (
      <details class="cabecera-menu">
        <summary class="cabecera-menu-boton">
          <Icono nombre="menu" class:list={[usuario && 'menu-solo-movil']} />
          <span class:list={[usuario && 'menu-solo-movil']}>Menú</span>
          {usuario && <span class="menu-solo-escritorio">{usuario}</span>}
        </summary>
        <div class="cabecera-menu-panel">
          {usuario && <p class="cabecera-usuario menu-solo-movil">{usuario}</p>}
          <slot name="menu" />
        </div>
      </details>
    )}
  </div>
  <!-- Fila 2 en móvil (se desplaza); a la derecha en escritorio. -->
  {conContexto && (
    <div class="cabecera-contexto">
      <slot name="contexto" />
    </div>
  )}
</header>

<style>
  /* Móvil y tableta: las filas son elementos de la retícula del layout para que solo la fila 1 sea fija. */
  .cabecera {
    display: contents;
  }
  .cabecera-fija {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-3);
    box-sizing: border-box;
    block-size: var(--medida-cabecera-movil);
    padding-inline: var(--espacio-4);
    background: var(--color-fondo-superficie);
    border-block-end: var(--borde-grosor-base) solid var(--color-borde-fuerte);
  }
  .cabecera-contexto {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espacio-2) var(--espacio-3);
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--color-fondo-superficie);
    border-block-end: var(--borde-grosor-base) solid var(--color-borde-fuerte);
  }
  :global(.menu-solo-escritorio) {
    display: none;
  }

  .cabecera-marca {
    min-inline-size: 0;
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    color: var(--color-texto-principal);
    text-decoration: none;
  }
  .cabecera-placa {
    flex: none;
    box-sizing: border-box;
    inline-size: var(--medida-control-base);
    block-size: var(--medida-control-base);
    padding: var(--espacio-1-5);
    border: var(--borde-grosor-base) solid var(--color-borde-fuerte);
    color: var(--color-texto-principal);
  }
  .cabecera-placa :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }
  .cabecera-placa :global(.logo-escritorio) {
    display: none;
  }
  .cabecera-nombre {
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
  }
  .cabecera-producto {
    font-family: var(--fuente-familia-titulo);
    font-weight: var(--fuente-peso-titulo);
    font-size: var(--fuente-tamano-base);
    line-height: var(--fuente-interlineado-interfaz);
    overflow-wrap: anywhere;
  }
  .cabecera-area {
    color: var(--color-texto-secundario);
    font-family: var(--fuente-familia-tecnica);
    font-size: var(--fuente-tamano-micro);
    line-height: var(--fuente-interlineado-interfaz);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  /* Estado neutro: la línea queda reservada pero vacía y oculta. */
  .cabecera-area[data-neutro] {
    visibility: hidden;
    min-block-size: 1lh;
  }

  .cabecera-menu {
    position: static;
    flex: none;
  }
  .cabecera-menu-boton {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    box-sizing: border-box;
    min-block-size: var(--medida-control-tactil);
    padding: var(--espacio-2) var(--espacio-4);
    background: var(--color-fondo-superficie);
    border: var(--borde-grosor-base) solid var(--color-borde-fuerte);
    color: var(--color-texto-principal);
    font-family: var(--fuente-familia-titulo);
    font-weight: var(--fuente-peso-titulo);
    font-size: var(--fuente-tamano-base);
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
    transition:
      background-color var(--movimiento-duracion-rapida) var(--movimiento-curva-estandar),
      color var(--movimiento-duracion-rapida) var(--movimiento-curva-estandar);
  }
  .cabecera-menu-boton::-webkit-details-marker {
    display: none;
  }
  .cabecera-menu[open] > .cabecera-menu-boton {
    background: var(--color-fondo-destacado);
  }
  @media (hover: hover) {
    .cabecera-menu-boton:hover {
      background: var(--color-fondo-alerta);
      color: var(--color-texto-sobre-alerta);
    }
  }
  .cabecera-menu-panel {
    position: absolute;
    z-index: 20;
    inset-inline: 0;
    inset-block-start: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--espacio-3);
    padding: var(--espacio-4);
    background: var(--color-fondo-superficie);
    border-block-end: var(--borde-grosor-base) solid var(--color-borde-fuerte);
  }
  /* Enlaces de la ranura del menú: objetivo táctil. */
  .cabecera-menu-panel :global(a) {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--medida-control-tactil);
  }
  .cabecera-usuario {
    margin: 0;
    color: var(--color-texto-principal);
    font-size: var(--fuente-tamano-base);
  }

  /* Escritorio: una sola barra, no fija. */
  @media (min-width: 64em) { /* punto-quiebre-escritorio */
    .cabecera {
      grid-column: 1 / -1; /* ocupa todo el ancho de la retícula del layout */
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--espacio-4);
      box-sizing: border-box;
      min-block-size: var(--medida-cabecera-escritorio);
      padding-inline: var(--espacio-8);
      background: var(--color-fondo-superficie);
      border-block-end: var(--borde-grosor-base) solid var(--color-borde-fuerte);
    }
    .cabecera-flujo {
      padding-inline: var(--espacio-12);
    }
    /* La marca y el menú pasan a ser elementos de la barra; el menú (perfil) queda a la derecha. */
    .cabecera-fija {
      display: contents;
    }
    .cabecera-placa {
      inline-size: var(--medida-placa-marca);
      block-size: var(--medida-placa-marca);
    }
    .cabecera-placa :global(.logo-movil),
    :global(.menu-solo-movil) {
      display: none;
    }
    .cabecera-placa :global(.logo-escritorio) {
      display: block;
    }
    :global(.menu-solo-escritorio) {
      display: inline;
    }
    .cabecera-contexto {
      display: flex;
      justify-content: flex-end;
      margin-inline-start: auto;
      gap: var(--espacio-2) var(--espacio-4);
      padding: 0;
      border: 0;
      background: transparent;
    }
    .cabecera-menu {
      position: relative;
      order: 1;
    }
    .cabecera-menu-panel {
      inset-inline: auto 0;
      min-inline-size: max-content;
      border: var(--borde-grosor-base) solid var(--color-borde-fuerte);
      box-shadow: var(--sombra-plana);
    }
  }
</style>
