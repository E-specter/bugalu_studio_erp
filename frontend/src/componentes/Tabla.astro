---
interface Props {
  titulo: string;
  columnas: string[];
  variante?: 'directorio' | 'compacta' | 'partidas';
  numericas?: number[];
}
const { titulo, columnas, variante = 'directorio', numericas = [], class: clase } = Astro.props as Props & { class?: string };
const partidas = variante === 'partidas';
---

<!-- Partidas: sigue siendo tabla en movil (sin tarjetas), cabecera visible y pie <tfoot> por la ranura `pie`. Columnas numericas (indice en `numericas`) a la derecha; en las filas, la celda lleva class="tabla-num". -->
<!-- Las filas (<tr>) entran por la ranura; en cada celda, data-etiqueta da el rotulo de la tarjeta en movil. Columna "" = acciones. -->
<div class:list={['tabla', `tabla-${variante}`, clase]}>
  <table>
    <caption class="visualmente-oculto">{titulo}</caption>
    <thead class:list={['tabla-cabecera', !partidas && 'visualmente-oculto']}>
      <tr>{columnas.map((c, i) => <th scope="col" class:list={[numericas.includes(i) && 'tabla-num']}>{c || <span class="visualmente-oculto">Acciones</span>}</th>)}</tr>
    </thead>
    <tbody><slot /></tbody>
    {partidas && <tfoot><slot name="pie" /></tfoot>}
  </table>
</div>

<style>
  .tabla {
    background: var(--color-fondo-superficie);
    border: var(--borde-grosor-base) solid var(--color-borde-fuerte);
  }
  table {
    inline-size: 100%;
    border-collapse: collapse;
    text-align: start;
  }
  /* Movil: cabecera solo para lectores (clase global); cada celda lleva su rotulo. */
  .tabla:not(.tabla-partidas) :global(tr) {
    display: block;
    padding: var(--espacio-4);
    border-block-end: var(--borde-grosor-fino) solid var(--color-borde-fuerte);
  }
  /* El IGV es informativo, no un total. */
  .tabla-partidas tfoot :global(.tabla-igv > *) {
    font-weight: var(--fuente-peso-regular);
  }
  .tabla :global(tbody tr:last-child) {
    border-block-end: 0;
  }
  .tabla:not(.tabla-partidas) :global(th[scope='row']),
  .tabla:not(.tabla-partidas) :global(td) {
    display: grid;
    gap: var(--espacio-1);
    justify-items: start;
    padding: var(--espacio-1) 0;
    font-weight: var(--fuente-peso-regular);
    color: var(--color-texto-principal);
    text-align: start;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .tabla :global(th.tabla-num),
  .tabla :global(td.tabla-num) {
    font-variant-numeric: tabular-nums;
  }
  .tabla:not(.tabla-partidas) :global(td[data-etiqueta]:not([data-etiqueta='']):not(:empty)::before) {
    content: attr(data-etiqueta);
    color: var(--color-texto-secundario);
    font-family: var(--fuente-familia-tecnica);
    font-size: var(--fuente-tamano-micro);
    text-transform: uppercase;
  }
  .tabla-compacta :global(tr) {
    padding: var(--espacio-3);
  }

  /* Partidas: presentacion de tabla desde el movil. */
  .tabla-partidas :global(th),
  .tabla-partidas :global(td) {
    padding: var(--espacio-3);
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .tabla-partidas :global(tbody th[scope='row']),
  .tabla-partidas :global(tbody td) {
    font-weight: var(--fuente-peso-regular);
    color: var(--color-texto-principal);
    text-align: start;
  }
  .tabla-partidas :global(tbody tr) {
    border-block-end: var(--borde-grosor-fino) solid var(--color-borde-fuerte);
  }
  .tabla-partidas thead :global(th) {
    background: var(--color-fondo-invertido);
    color: var(--color-texto-invertido);
    font-family: var(--fuente-familia-tecnica);
    font-size: var(--fuente-tamano-micro);
    font-weight: var(--fuente-peso-medio);
    text-transform: uppercase;
    text-align: start;
  }
  .tabla-partidas thead :global(th.tabla-num),
  .tabla-partidas :global(th.tabla-num),
  .tabla-partidas :global(td.tabla-num) {
    white-space: nowrap;
    text-align: end;
  }
  .tabla-partidas :global(.etiqueta) {
    white-space: nowrap;
  }
  .tabla-partidas tfoot :global(tr:first-child > *) {
    border-block-start: var(--borde-grosor-base) solid var(--color-borde-fuerte);
  }
  .tabla-partidas tfoot :global(th),
  .tabla-partidas tfoot :global(td) {
    font-weight: var(--fuente-peso-titulo);
    color: var(--color-texto-principal);
    text-align: start;
  }
  .tabla-partidas tfoot :global(td.tabla-num) {
    text-align: end;
  }

  @media (min-width: 64em) { /* punto-quiebre-escritorio */
    .tabla-directorio thead :global(th.tabla-num),
    .tabla-compacta thead :global(th.tabla-num),
    .tabla-directorio :global(td.tabla-num),
    .tabla-compacta :global(td.tabla-num) {
      text-align: end;
    }
    .tabla-cabecera {
      position: static;
      margin: 0;
      clip-path: none;
      overflow: visible;
      white-space: normal;
      inline-size: auto;
      block-size: auto;
    }
    thead :global(th) {
      padding: var(--espacio-3) var(--espacio-4);
      background: var(--color-fondo-invertido);
      color: var(--color-texto-invertido);
      font-family: var(--fuente-familia-tecnica);
      font-size: var(--fuente-tamano-micro);
      font-weight: var(--fuente-peso-medio);
      text-transform: uppercase;
      text-align: start;
    }
    /* Misma especificidad que las reglas de tarjeta de arriba (`:not(.tabla-partidas)`), si no, nunca ganan. */
    .tabla:not(.tabla-partidas) :global(tr) {
      display: table-row;
      padding: 0;
    }
    .tabla:not(.tabla-partidas) :global(th[scope='row']),
    .tabla:not(.tabla-partidas) :global(td) {
      display: table-cell;
      padding: var(--espacio-4);
    }
    .tabla-compacta:not(.tabla-partidas) :global(th[scope='row']),
    .tabla-compacta:not(.tabla-partidas) :global(td) {
      padding: var(--espacio-3);
    }
    .tabla:not(.tabla-partidas) :global(td[data-etiqueta]:not([data-etiqueta='']):not(:empty)::before) {
      content: none;
    }
    .tabla :global(tbody tr) {
      border-block-end: var(--borde-grosor-fino) solid var(--color-borde-fuerte);
    }
  }
</style>
