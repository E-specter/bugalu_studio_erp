---
interface Props {
  variante?: 'completa' | 'acceso';
  class?: string;
}
const { variante = 'completa', class: clase } = Astro.props as Props;
const enlaces = [
  { texto: 'Términos de uso', href: '/legal/terminos-de-uso/' },
  { texto: 'Política de privacidad', href: '/legal/privacidad/' },
  { texto: 'Condiciones de contratación', href: '/legal/condiciones-de-contratacion/' },
  { texto: 'Textos legales', href: '/legal/' },
  { texto: 'Libro de Reclamaciones', href: '/libro-de-reclamaciones/' },
];
---

<footer class:list={['pie', `pie-${variante}`, clase]}>
  <div class="pie-contenido">
    <nav aria-label="Legal">
      <ul class="pie-enlaces">
        {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
      </ul>
    </nav>
    {variante === 'completa' && (
      <>
        <p class="pie-tecnica">Aural Perú E.I.R.L. · RUC 20615656128 · Av. Javier Prado Este 5920, La Molina, Lima</p>
        <p class="pie-tecnica">Bugalú Studio © 2026</p>
      </>
    )}
  </div>
</footer>

<style>
  .pie {
    padding-block: var(--espacio-6);
    background: var(--color-fondo-lienzo);
    border-block-start: var(--borde-grosor-base) solid var(--color-borde-fuerte);
  }
  .pie-contenido {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-3);
    box-sizing: border-box;
    max-inline-size: var(--medida-contenedor-max);
    margin-inline: auto;
    padding-inline: var(--espacio-4); /* misma retícula que el <main> de LayoutPublico */
  }
  .pie-enlaces {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pie-enlaces a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--medida-control-tactil);
    color: var(--color-texto-principal);
    font-size: var(--fuente-tamano-pequeno);
    text-decoration: underline;
  }
  /* Acceso: sin caja propia, va sobre el pie tecnico de la estructura. */
  .pie-acceso {
    padding: 0;
    background: none;
    border: 0;
  }
  .pie-acceso .pie-contenido {
    max-inline-size: none;
    padding-inline: 0;
  }
  .pie-acceso .pie-enlaces a {
    font-size: var(--fuente-tamano-micro);
  }
  .pie-tecnica {
    margin: 0;
    color: var(--color-texto-secundario);
    font-family: var(--fuente-familia-tecnica);
    font-size: var(--fuente-tamano-micro);
    text-transform: uppercase; /* la razon social se escribe como en los Terminos; el estilo tecnico la pone en mayusculas */
  }
  @media (min-width: 90em) { /* punto-quiebre-amplio */
    .pie-completa .pie-contenido {
      padding-inline: var(--espacio-12);
    }
  }
  @media (min-width: 37.5em) { /* punto-quiebre-tableta: en fila */
    .pie-enlaces {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: var(--espacio-4); /* la altura tactil de cada enlace ya separa las filas */
    }
  }
</style>
