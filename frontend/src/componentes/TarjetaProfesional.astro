---
// Ficha: docs/07-diseno/componentes/tarjeta-profesional.md. Los datos llegan en el navegador: la pagina la pone dentro de un <template>
// y <bugalu-directorio> la clona y la llena (nombre, avatar, etiquetas y precios). Con props, se pinta ya llena (catalogo).
import Avatar from './Avatar.astro';
import EtiquetaTecnica from './EtiquetaTecnica.astro';
import Icono from './internos/Icono.astro';
import { soles, duracionReserva } from '../servicios/formatos.js';

interface Props {
  nombre?: string;
  nombre_artistico?: string | null;
  foto?: string | null;
  especialidades?: { id: string; nombre: string }[];
  duraciones?: { minutos: number; precio: string }[];
  href?: string;
  nivel?: 2 | 3;
}
const { nombre = ' ', nombre_artistico = null, foto = null, especialidades = [], duraciones = [], href = '#', nivel = 2, class: clase } = Astro.props as Props & { class?: string };
const mostrado = nombre_artistico || nombre;
const Titulo = `h${nivel}` as 'h2';
---

<article class:list={['tarjeta-profesional', clase]}>
  <div class="tarjeta-identidad">
    <Avatar nombre={mostrado} tamano="miniatura" rol="profesional" foto={foto ?? undefined} />
    <div class="tarjeta-nombres">
      <Titulo class="tarjeta-nombre"><a class="tarjeta-enlace" {href}><span data-mostrado>{mostrado}</span><span class="visualmente-oculto">, ver perfil</span></a></Titulo>
      <p class="tarjeta-completo" data-completo hidden={!nombre_artistico}>{nombre_artistico ? nombre : ''}</p>
    </div>
  </div>
  <ul class="tarjeta-especialidades" aria-label="Especialidades">
    {especialidades.map((e) => <li><EtiquetaTecnica texto={e.nombre} /></li>)}
  </ul>
  <dl class="tarjeta-precios">
    {duraciones.map((d) => (
      <div><dt>{duracionReserva(d.minutos).toUpperCase()}</dt><dd>{soles(d.precio)}</dd></div>
    ))}
  </dl>
  <p class="tarjeta-pie" aria-hidden="true">Ver perfil <Icono nombre="arrow-right" /></p>
</article>

<style>
  .tarjeta-profesional {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--espacio-4);
    box-sizing: border-box;
    block-size: 100%;
    padding: var(--espacio-5);
    background: var(--color-fondo-superficie);
    border: var(--borde-grosor-base) solid var(--color-borde-fuerte);
  }
  @media (hover: hover) {
    .tarjeta-profesional:hover {
      background: var(--color-fondo-claro);
    }
  }
  /* Toda la tarjeta es el objetivo: el anillo se dibuja alrededor de ella, no solo del nombre. */
  .tarjeta-profesional:has(.tarjeta-enlace:focus-visible) {
    outline: var(--borde-grosor-base) solid var(--color-foco-anillo);
    outline-offset: var(--borde-grosor-base);
  }
  .tarjeta-enlace:focus-visible {
    outline: none;
  }
  .tarjeta-enlace > :global([data-mostrado]) {
    display: block;
  }
  .tarjeta-enlace::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tarjeta-identidad {
    display: flex;
    align-items: center;
    gap: var(--espacio-4);
  }
  .tarjeta-nombres {
    min-inline-size: 0;
  }
  .tarjeta-nombre {
    margin: 0;
    font-family: var(--fuente-familia-titulo);
    font-size: var(--fuente-tamano-titulo-sm);
    line-height: var(--fuente-interlineado-interfaz);
    overflow-wrap: anywhere;
  }
  .tarjeta-enlace {
    display: block;
    color: var(--color-texto-principal);
    text-decoration: none;
  }
  .tarjeta-completo {
    margin: 0;
    color: var(--color-texto-secundario);
    font-size: var(--fuente-tamano-base);
    overflow-wrap: anywhere;
  }
  .tarjeta-especialidades {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tarjeta-precios {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-5);
    margin: 0;
    font-family: var(--fuente-familia-tecnica);
  }
  .tarjeta-precios dt {
    color: var(--color-texto-secundario);
    font-size: var(--fuente-tamano-micro);
  }
  .tarjeta-precios dd {
    margin: 0;
    color: var(--color-texto-principal);
    font-size: var(--fuente-tamano-base);
    font-variant-numeric: tabular-nums;
  }
  .tarjeta-pie {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    margin: auto 0 0;
    color: var(--color-texto-principal);
    font-size: var(--fuente-tamano-pequeno);
  }
</style>
