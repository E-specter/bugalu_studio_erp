---
import Icono from './internos/Icono.astro';
import type { iconos } from './internos/lucide.js';
import EtiquetaTecnica from './EtiquetaTecnica.astro';

interface Props {
  destinos: { etiqueta: string; href: string; icono: keyof typeof iconos; vivo?: string; solo?: string }[]; // vivo: contador que un script rellena (nace oculto)
  actual?: string;
  etiqueta?: string;
}
const { destinos, actual, etiqueta = 'Principal', class: clase } = Astro.props as Props & { class?: string };
---

<nav aria-label={etiqueta} class:list={['tactil', clase]}>
  <ul class="tactil-lista">
    {/* Máximo cinco visibles: los destinos con `solo` nacen ocultos y no cuentan. */}
    {destinos.slice(0, 5 + destinos.filter((d) => d.solo).length).map((destino) => (
      <li hidden={destino.solo ? true : undefined} data-solo={destino.solo}>
        <a href={destino.href} class:list={['tactil-destino', destino.href === actual && 'tactil-actual']} aria-current={destino.href === actual ? 'page' : undefined}>
          <span class="tactil-icono">
            <Icono nombre={destino.icono} tamano="md" />
            {destino.vivo && (
              <span class="tactil-contador" data-contador={destino.vivo} hidden>
                <span aria-hidden="true"><EtiquetaTecnica variante="alerta" texto="0" /></span>
              </span>
            )}
          </span>
          <span class="tactil-etiqueta">{destino.etiqueta}</span>
          {/* Hermano posterior de la etiqueta: el nombre accesible es "Pagos 2 pagos por validar". */}
          {destino.vivo && <span class="visualmente-oculto" data-contador-texto></span>}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tactil {
    box-sizing: border-box;
    block-size: var(--medida-nav-tactil);
    background: var(--color-fondo-superficie);
    border-block-end: var(--borde-grosor-base) solid var(--color-borde-fuerte);
  }
  .tactil-lista {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    block-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tactil-destino {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    block-size: 100%;
    min-block-size: var(--medida-control-tactil);
    border-block-end: var(--borde-grosor-grueso) solid transparent;
    color: var(--color-texto-principal);
    font-family: var(--fuente-familia-tecnica);
    font-size: var(--fuente-tamano-micro);
    line-height: var(--fuente-interlineado-interfaz);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color var(--movimiento-duracion-rapida) var(--movimiento-curva-estandar);
  }
  .tactil-icono {
    block-size: var(--medida-icono-md);
    display: flex;
    align-items: center;
    gap: var(--espacio-1);
  }
  .tactil-contador[hidden] {
    display: none;
  }
  .tactil-etiqueta {
    max-inline-size: 100%;
    overflow-wrap: anywhere;
  }
  @media (hover: hover) {
    .tactil-destino:not(.tactil-actual):hover {
      background: var(--color-fondo-claro);
    }
  }
  .tactil-actual {
    background: var(--color-fondo-destacado);
    border-block-end-color: var(--color-borde-fuerte);
  }
</style>
