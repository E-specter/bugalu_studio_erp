---
import Icono from './internos/Icono.astro';
import AvisoDescartable from '../islas/AvisoDescartable.astro';

interface Props {
  variante?: 'informacion' | 'exito' | 'aviso' | 'error' | 'critico';
  titulo: string;
  texto?: string;
  accion?: { etiqueta: string; href: string };
  descartable?: boolean;
}
const { variante = 'informacion', titulo, texto, accion, descartable = false, class: clase } = Astro.props as Props & { class?: string };
const icono = { informacion: 'info', exito: 'check-circle', aviso: 'clock', error: 'alert-triangle', critico: 'alert-triangle' } as const;
// Resultado de una accion: status (informacion, exito, aviso) o alert (error, critico), presente en el DOM antes del texto.
const Envoltorio = descartable ? AvisoDescartable : Fragment;
const rol = variante === 'error' || variante === 'critico' ? 'alert' : 'status';
---

<Envoltorio>
<div class:list={['aviso', `aviso-${variante}`, clase]} role={rol}>
  <Icono nombre={icono[variante]} />
  <div class="aviso-cuerpo">
    <p class="aviso-titulo">{titulo}</p>
    {texto && <p class="aviso-texto">{texto}</p>}
    <slot />
    {accion && <a class="aviso-accion" href={accion.href}>{accion.etiqueta}</a>}
  </div>
  {descartable && (
    <button type="button" class="aviso-cerrar" aria-label="Cerrar aviso" data-cerrar-aviso hidden>
      <Icono nombre="x" />
    </button>
  )}
</div>
</Envoltorio>

<style>
  .aviso {
    display: flex;
    align-items: flex-start;
    gap: var(--espacio-3);
    box-sizing: border-box;
    padding: var(--espacio-4);
    background: var(--color-fondo-superficie);
    border: var(--borde-grosor-base) solid var(--color-borde-fuerte);
    border-radius: var(--borde-radio-ninguno);
    font-size: var(--fuente-tamano-base);
    line-height: var(--fuente-interlineado-interfaz);
  }
  .aviso > :global(.icono) {
    margin-block-start: var(--espacio-1);
  }
  .aviso-cuerpo {
    flex: 1;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: var(--espacio-1);
  }
  .aviso-titulo {
    margin: 0;
    color: var(--color-texto-principal);
    font-family: var(--fuente-familia-titulo);
    font-weight: var(--fuente-peso-titulo);
    font-size: var(--fuente-tamano-base);
  }
  .aviso-texto {
    margin: 0;
    color: var(--color-texto-cuerpo);
    font-size: var(--fuente-tamano-base);
    line-height: var(--fuente-interlineado-interfaz);
  }
  .aviso-accion {
    align-self: flex-start;
    margin-block-start: var(--espacio-2);
    color: var(--color-texto-principal);
    font-weight: var(--fuente-peso-medio);
  }
  .aviso-cerrar[hidden] {
    display: none;
  }
  .aviso-cerrar {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: var(--medida-control-tactil);
    block-size: var(--medida-control-tactil);
    margin: calc(-1 * var(--espacio-2));
    padding: 0;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
  }
  @media (hover: hover) {
    .aviso-cerrar:hover {
      background: var(--color-fondo-claro);
    }
  }

  .aviso-exito {
    border-color: var(--color-texto-exito);
  }
  .aviso-exito > :global(.icono) {
    color: var(--color-texto-exito);
  }
  .aviso-aviso {
    border-color: var(--color-texto-aviso);
  }
  .aviso-aviso > :global(.icono) {
    color: var(--color-texto-aviso);
  }
  .aviso-error {
    border-color: var(--color-texto-alerta);
  }
  .aviso-error > :global(.icono) {
    color: var(--color-texto-alerta);
  }
  .aviso-critico {
    background: var(--color-fondo-alerta);
    color: var(--color-texto-sobre-alerta);
  }
  .aviso-critico .aviso-titulo,
  .aviso-critico .aviso-texto,
  .aviso-critico .aviso-accion {
    color: var(--color-texto-sobre-alerta);
  }
</style>
