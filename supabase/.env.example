# Copia a supabase/.env (ignorado por git; el CLI lo lee al hacer `npx supabase start`). Sin valores aqui.
# Solo si activas [auth.external.google] en supabase/config.toml (cliente OAuth de Google Cloud Console).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Solo si activas [auth.external.facebook] (app de Meta for Developers).
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
