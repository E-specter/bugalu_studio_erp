# Copia a .env. Los valores salen de `npx supabase status` (stack de Bugalu, puertos 456xx).
# URL_BASE_DATOS usa el rol bugalu_api (clave de desarrollo en supabase/seed.sql, solo local).
URL_BASE_DATOS=postgresql://bugalu_api:bugalu_api_dev@127.0.0.1:45622/postgres
# Solo pruebas: superusuario local para altas y limpieza de usuarios (nunca en la API)
URL_BASE_DATOS_ADMIN=postgresql://postgres:postgres@127.0.0.1:45622/postgres
URL_SUPABASE=http://127.0.0.1:45621
# Clave publicable (PUBLISHABLE_KEY de `npx supabase status`): la API la envia a Storage junto al token del usuario;
# las pruebas la usan ademas para el alta de usuarios. Obligatoria.
CLAVE_PUBLICABLE_SUPABASE=
# Solo pruebas: SERVICE_ROLE_KEY local; borra los objetos de Storage que crean las pruebas. Nunca la usa src/.
CLAVE_SERVICIO_SUPABASE_PRUEBAS=
# Origenes del frontend (CORS), separados por comas; vacio = sin CORS. Astro dev: puerto 4321.
ORIGENES_PERMITIDOS=http://localhost:4321,http://127.0.0.1:4321
# Correo saliente de la bandeja `notificacion`: SMTP de Mailpit del stack local (supabase/config.toml).
SMTP_HOST=127.0.0.1
SMTP_PUERTO=45625
CORREO_REMITENTE=no-responder@bugalu.pe
# Segundos entre envios; 0 desactiva la tarea periodica (herramienta: python -m bugalu.herramientas.enviar_correos)
INTERVALO_ENVIO_CORREOS=30
