# Copia a .env. Los valores salen de `npx supabase status` (stack de Bugalu, puertos 456xx).
# URL_BASE_DATOS usa el rol bugalu_api (clave de desarrollo en supabase/seed.sql, solo local).
URL_BASE_DATOS=postgresql://bugalu_api:bugalu_api_dev@127.0.0.1:45622/postgres
# Solo pruebas: superusuario local para altas y limpieza de usuarios (nunca en la API)
URL_BASE_DATOS_ADMIN=postgresql://postgres:postgres@127.0.0.1:45622/postgres
URL_SUPABASE=http://127.0.0.1:45621
# Clave publicable del stack local (necesaria solo para las pruebas de integracion: alta de usuarios)
CLAVE_PUBLICABLE_SUPABASE=
# Origenes del frontend (CORS), separados por comas; vacio = sin CORS. Astro dev: puerto 4321.
ORIGENES_PERMITIDOS=http://localhost:4321,http://127.0.0.1:4321
